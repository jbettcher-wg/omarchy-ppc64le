# --- Omarchy ppc64le additions -------------------------------------------
# gum      the configurator's entire UI: gum choose/input/confirm/table.
# omarchy  provides install/provisioning/setup-form.sh -- the keyboard,
#          account, hostname and timezone prompts, shared verbatim with the
#          first-boot owner setup so a deferred install asks the same
#          questions -- and logo.txt, which the greeter measures and draws.
gum
omarchy
# omarchy-theme-power9  the POWER9 wordmark the greeter draws, plus the
#                       colours and wallpapers for the installed system.
omarchy-theme-power9
# tzdata -- setup-form.sh asks the timezone with
#           `timedatectl list-timezones | gum choose`, which enumerates
#           /usr/share/zoneinfo. Without it the list is empty and the
#           question cannot be answered.
tzdata
