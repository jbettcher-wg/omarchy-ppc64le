bluez-utils
bolt
brightnessctl
btop

# Chromium dlopens libXRes at runtime and does NOT link it -- readelf -d on the
# binary shows zero references and the package declares nothing. So neither the
# declared-dependency audit (tools/repo-gaps.py) nor the runtime ldd sweep can
# see it; the only way it surfaces is chromium failing on a machine that has
# everything else. Found exactly that way on the first real install.
#
# Do not remove this as an unreferenced entry. Nothing references it, by design.
libxres
chromium
clang
cliamp
cups
cups-filters
cups-pk-helper
ddcutil
