#
# /etc/pacman.conf -- generated by p9-install
#
# THE REPO SUBSTITUTION. Upstream Omarchy's install/post-install/pacman.sh
# copies default/pacman/pacman-stable.conf and default/pacman/mirrorlist-stable
# over /etc, which repoints the machine at pkgs.omarchy.org. That archive has
# an x86_64 tree and an aarch64 tree and no powerpc64le tree at all, so on this
# architecture that step does not merely add nothing -- it removes the only
# working package source. It is not run here, at install time or at first boot.
#
# What replaces it: Arch POWER stays the base distribution and the project's own
# packages come from a repository listed *ahead* of it, so repo order does the
# overriding and nothing in [base] has to be rebuilt.
#
# Repo order below is load-bearing: [power9] first.
#
# @P9_SIGLEVEL_NOTE@

[options]
HoldPkg     = pacman glibc
Architecture = powerpc64le
CheckSpace
ParallelDownloads = 5
DownloadUser = alpm
DisableSandbox

SigLevel    = @P9_BASE_SIGLEVEL@
LocalFileSigLevel = Optional

@P9_REPO_STANZA@
[base-any]
Server = @P9_BASE_ANY_SERVER@

[base]
Server = @P9_BASE_SERVER@
