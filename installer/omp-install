#!/usr/bin/env bash
#
# omp-install -- install Omarchy on POWER9 (ppc64le), for machines that boot
#                petitboot from firmware.
#
# This is a fork of Omarchy's install flow with four substitutions. Everything
# else -- partitioning, mkfs, pacstrap, fstab, the user step, the config layer,
# the package manifest -- is Omarchy's, carried over. The four are:
#
#   1. Bootloader   limine -> a grub.cfg petitboot parses. Nothing installed
#                   to disk.                        bin/omp-petitboot-entry
#   2. Kernel       stock `linux` -> --kernel/$OMP_KERNEL_PKG, default
#                   linux-power9.                   see --help
#   3. mkinitcpio   omarchy_hooks.conf -> share/omp-hooks.conf
#   4. Repo         pkgs.omarchy.org -> our own repo over Arch POWER. Default
#                   [omarchy-ppc64le], the baseline that runs on every ppc64le
#                   machine; [omarchy-power9] is the optimised opt-in.
#
# Read installer/README.md before changing any of them.
#
# NEVER run this on the build host. It partitions a disk.

set -euo pipefail

OMP_SELF=$(readlink -f "${BASH_SOURCE[0]}")
OMP_ROOT=$(dirname "$OMP_SELF")
OMP_SHARE="${OMP_SHARE:-$OMP_ROOT/share}"
OMP_LIBEXEC="${OMP_LIBEXEC:-$OMP_ROOT/bin}"
OMP_FIRSTBOOT="${OMP_FIRSTBOOT:-$OMP_ROOT/firstboot}"

# ---------------------------------------------------------------- defaults ---
OMP_ARCH=powerpc64le
OMP_MNT=/mnt
OMP_DRY_RUN=0
OMP_ASSUME_YES=0
OMP_DISK=""
OMP_SERIAL=""
OMP_PLATFORM=""
OMP_BOOT_SIZE=2G

# Substitution 2. linux-power9 now EXISTS: built from ~/Development/linux-7.2.2
# with `make pacman-pkg`, which ships its own PKGBUILD under scripts/package/.
# Two things that build needs and the stock target does not give you:
#
#   * PACMAN_PKGBASE=linux-power9, or it names itself linux-upstream.
#   * a CARCH override. scripts/Makefile.package hardcodes CARCH="$(UTS_MACHINE)",
#     which on this arch is `ppc64le` -- but every Arch POWER package is tagged
#     `powerpc64le`, so pacman refuses the result outright with
#     ALPM_ERR_PKG_INVALID_ARCH. We carry a one-line patch adding PACMAN_CARCH.
#
# This stays a variable, not a constant, because --kernel linux-4k (Arch POWER's
# own 4K-page kernel) is still the right choice for bring-up on a machine whose
# own kernel has not been proven yet. What any value here must satisfy:
#
#   * an Arch-shaped kernel package, i.e. one that installs
#     /usr/lib/modules/<release>/vmlinuz and, next to it, a `pkgbase` file
#     containing the package name. mkinitcpio's own pacman hook keys everything
#     on that pkgbase file -- a module directory without one is skipped, which
#     is exactly why the hand-installed 7.2.2 never got an automatic initramfs.
#   * it must therefore produce /boot/vmlinuz-<pkgbase> and, after mkinitcpio,
#     /boot/initramfs-<pkgbase>.img. omp-petitboot-entry names those files.
#   * a <pkgbase>-headers package is desirable but not required.
#
# For bring-up against Arch POWER's own kernels, pass --kernel linux-4k (4K
# pages, matching the AC922 config) or --kernel linux (64K).
#
# No fixed default here. The kernel follows the pool, resolved once the repo
# name is known (below the platform check): command line, then the environment,
# then share/kernel-pkg.conf baked by iso/build.sh, then linux-omarchy for the
# baseline and linux-power9 for omarchy-power9. A fixed linux-power9 default put
# a -mcpu=power9 kernel on POWER8 targets, and the baseline pool does not carry
# linux-power9 at all.
OMP_KERNEL_PKG="${OMP_KERNEL_PKG:-}"

# Substitution 4. Our own repository, listed ahead of Arch POWER's [base] so
# repo order does the overriding (nothing in [base] gets rebuilt).
#
# The distribution publishes two pools, and the default here is the BASELINE:
#
#   omarchy-ppc64le  built POWER8-legal (ISA 2.07), so it runs on POWER8
#                    through POWER11 -- every ppc64le machine. The default,
#                    what the ISO installs from, what testers use.
#   omarchy-power9   the POWER9-optimised build. An opt-in extra for machines
#                    known to be POWER9, layered AHEAD of the baseline with
#                    --repo-name omarchy-power9 --baseline-repo-name
#                    omarchy-ppc64le, so an optimised package wins where one
#                    exists and the baseline fills in the rest.
#
# A build is named for what it runs on, not for what it was tuned for.
OMP_REPO_NAME_SET=0
OMP_REPO_NAME_FROM_ENV="${OMP_REPO_NAME+1}"
OMP_REPO_NAME="${OMP_REPO_NAME:-omarchy-ppc64le}"
# May be given more than once. pacman tries each Server in order and falls
# through on failure, which is what makes one config correct both on the medium
# and after it is gone: the file:// entry serves the install at local speed, and
# once the ISO is unmounted pacman simply moves to the next one. Without this
# an installed machine keeps a [repo] pointing at /run/archiso/bootmnt, which
# stops existing at first reboot and breaks every pacman -Sy afterwards.
# Was the environment variable actually set, or are we looking at the default?
# Without this the two are indistinguishable and the baked-in list can never
# win over a default nobody chose -- or, worse, can never lose to one somebody
# did.
OMP_REPO_SERVER_FROM_ENV="${OMP_REPO_SERVER+1}"
OMP_REPO_SERVER="${OMP_REPO_SERVER:-file:///run/archiso/bootmnt/omp-repo/omarchy-ppc64le}"
OMP_REPO_SERVERS=()
OMP_REPO_SIGLEVEL=""   # deliberately empty -- see --repo-siglevel below

# The second, lower-priority pool. Empty by default: one pool is the normal
# case, and the baseline alone is a complete system. Set both of these to layer
# an optimised pool over the baseline; the stanza order in the rendered
# pacman.conf is OMP_REPO_NAME first, then this one.
OMP_BASELINE_REPO_NAME="${OMP_BASELINE_REPO_NAME:-}"
OMP_BASELINE_REPO_SERVERS=()
OMP_BASELINE_REPO_SIGLEVEL="${OMP_BASELINE_REPO_SIGLEVEL:-}"
OMP_BASE_SERVER="${OMP_BASE_SERVER:-https://repo.archlinuxpower.org/base/\$arch}"
OMP_BASE_ANY_SERVER="${OMP_BASE_ANY_SERVER:-https://repo.archlinuxpower.org/base/any}"
OMP_BASE_SIGLEVEL="${OMP_BASE_SIGLEVEL:-Required DatabaseOptional}"

OMP_MANIFEST="${OMP_MANIFEST:-$OMP_SHARE/omp-base.packages}"
OMP_PACSTRAP_CONF=""
OMP_LOCALE="${OMP_LOCALE:-en_US.UTF-8}"
OMP_KEYMAP="${OMP_KEYMAP:-us}"
OMP_TIMEZONE="${OMP_TIMEZONE:-UTC}"
OMP_HOSTNAME="${OMP_HOSTNAME:-omarchy}"
OMP_USER=""
OMP_PASSWORD=""
# console= twice, deliberately. The last one listed becomes /dev/console, so
# tty0 goes last and the monitor stays the primary console; hvc0 is still in
# /sys/class/tty/console/active, so systemd-getty-generator gives it a login
# too. On OPAL the serial console is always there whether or not it is named --
# naming it is what makes it usable, and a POWER server whose only console is
# the video output is one graphical failure away from needing the BMC.
#
# No video=. The ISO boots without one and runs the console at the panel's
# native mode; forcing 1920x1080 here made an AC922 drop from 4K in the
# installer to 1080p on the installed system. Hyprland sets its own mode anyway.
#
# quiet splash, as upstream Omarchy boots: Plymouth draws the Omarchy boot
# theme (the plymouth hook is in share/omp-hooks.conf). quiet also quiets
# hvc0; for a verbose boot, edit the entry at the petitboot menu.
OMP_CMDLINE="${OMP_CMDLINE:-console=hvc0 console=tty0 quiet splash loglevel=3}"
OMP_ENTRY_TITLE="${OMP_ENTRY_TITLE:-}"             # follows the pool, set below
OMP_REBOOT=0
OMP_STAGE_FIRSTBOOT=1

# shellcheck source=lib/common.sh
. "$OMP_ROOT/lib/common.sh"
# shellcheck source=lib/disk.sh
. "$OMP_ROOT/lib/disk.sh"
# shellcheck source=lib/target.sh
. "$OMP_ROOT/lib/target.sh"

usage() {
  cat <<'USAGE'
Usage: omp-install --disk /dev/DEVICE [options]
       omp-install --list-disks
       omp-install --disk /dev/DEVICE --dry-run

Target selection (the installer enumerates, you choose -- it never guesses):
  --list-disks             show the candidate devices and exit
  --disk DEVICE            whole disk to install to. DESTRUCTIVE.
  --serial SERIAL          refuse unless DEVICE reports this serial number
  --yes                    do not ask for confirmation (implies you meant it)

Boot / kernel:
  --platform powernv|pseries   default: detected from /proc/cpuinfo
  --kernel PKG                 kernel package to install (default: follows the
                               pool -- linux-omarchy for omarchy-ppc64le,
                               linux-power9 for omarchy-power9)
  --no-64k                     skip the 64K-page twin (<kernel>-64k) that is
                               otherwise installed alongside; the 4K kernel
                               stays the default boot entry either way
  --cmdline "..."              extra kernel arguments for the boot entry
  --boot-size SIZE             /boot partition size (default 2G)

Packages:
  --manifest FILE              package list (default share/omp-base.packages)
  --repo-server URL|none       [repo] Server=. May be repeated; pacman tries
                               them in order. 'none' installs from Arch POWER only
  --repo-name NAME             repository name (default omarchy-ppc64le, the
                               baseline pool; an ISO built for the other pool
                               bakes its name in and it is read from there)
  --baseline-repo-name NAME    second, lower-priority repository. Use with
                               --repo-name omarchy-power9 to layer the
                               optimised pool ahead of the baseline
  --baseline-repo-server URL   Server= for it. May be repeated
  --baseline-repo-siglevel LVL SigLevel for it (default: same as --repo-siglevel)
  --repo-siglevel LEVEL        REQUIRED, see below
  --base-server URL            Arch POWER [base] Server=
  --base-any-server URL        Arch POWER [base-any] Server=
  --pacstrap-conf FILE         use this pacman.conf for the install itself
                               (an offline mirror on the ISO, typically)

System:
  --hostname NAME  --timezone ZONE  --locale LOCALE  --keymap KEYMAP
  --user NAME      --password PASS
                   Create the account now. Omitted (the default) means Omarchy's
                   own deferred provisioning: the target asks on its first boot.
  --no-firstboot   do not stage the first-boot configuration layer
  --reboot         reboot when finished

Checking:
  --dry-run        print every command and write nothing. The disk guard still
                   runs (it only reads), so --dry-run needs a real device.

--repo-siglevel has no default on purpose. Our repository is not
signed today -- there is no signing key for it yet -- so there is no honest
default:

  --repo-siglevel required          the design's target state. Fails until the
                                    repo is signed and its keyring is trusted.
  --repo-siglevel optional-trustall PackageNever DatabaseOptional TrustAll.
                                    Installs unsigned packages without
                                    verification, and never asks for .sig
                                    files: a static host (R2) answers those
                                    with a 404 page larger than pacman's
                                    16 KiB signature limit, which aborts the
                                    whole download under plain Optional. Acceptable
                                    for a local, offline, single-operator repo
                                    on a machine you built the packages on.
                                    Not acceptable for anything you hand out.

Pick one explicitly. Nothing here will quietly turn signature checking off.
USAGE
}

# ------------------------------------------------------------------- args ----
while (($#)); do
  case "$1" in
    --list-disks)
      printf 'DEVICE\tSIZE\tMODEL\tSERIAL\n'
      list_disks
      exit 0
      ;;
    --disk) OMP_DISK="$2"; shift 2 ;;
    --serial) OMP_SERIAL="$2"; shift 2 ;;
    --platform) OMP_PLATFORM="$2"; shift 2 ;;
    --kernel) OMP_KERNEL_PKG="$2"; shift 2 ;;
    --no-64k) OMP_KERNEL_64K=""; shift ;;
    --cmdline) OMP_CMDLINE="$2"; shift 2 ;;
    --boot-size) OMP_BOOT_SIZE="$2"; shift 2 ;;
    --manifest) OMP_MANIFEST="$2"; shift 2 ;;
    --repo-server) OMP_REPO_SERVERS+=("$2"); shift 2 ;;
    --repo-name) OMP_REPO_NAME="$2"; OMP_REPO_NAME_SET=1; shift 2 ;;
    --baseline-repo-name) OMP_BASELINE_REPO_NAME="$2"; shift 2 ;;
    --baseline-repo-server) OMP_BASELINE_REPO_SERVERS+=("$2"); shift 2 ;;
    --baseline-repo-siglevel) OMP_BASELINE_REPO_SIGLEVEL="$2"; shift 2 ;;
    --repo-siglevel)
      case "$2" in
        required) OMP_REPO_SIGLEVEL="Required DatabaseOptional" ;;
        optional-trustall) OMP_REPO_SIGLEVEL="PackageNever DatabaseOptional TrustAll" ;;
        *) OMP_REPO_SIGLEVEL="$2" ;;
      esac
      shift 2
      ;;
    --base-server) OMP_BASE_SERVER="$2"; shift 2 ;;
    --base-any-server) OMP_BASE_ANY_SERVER="$2"; shift 2 ;;
    --base-siglevel) OMP_BASE_SIGLEVEL="$2"; shift 2 ;;
    --pacstrap-conf) OMP_PACSTRAP_CONF="$2"; shift 2 ;;
    --hostname) OMP_HOSTNAME="$2"; shift 2 ;;
    --timezone) OMP_TIMEZONE="$2"; shift 2 ;;
    --locale) OMP_LOCALE="$2"; shift 2 ;;
    --keymap) OMP_KEYMAP="$2"; shift 2 ;;
    --user) OMP_USER="$2"; shift 2 ;;
    --password) OMP_PASSWORD="$2"; shift 2 ;;
    --no-firstboot) OMP_STAGE_FIRSTBOOT=0; shift ;;
    --reboot) OMP_REBOOT=1; shift ;;
    --dry-run) OMP_DRY_RUN=1; shift ;;
    --yes | -y) OMP_ASSUME_YES=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
done

OMP_WORKDIR=$(mktemp -d)
trap 'rm -rf "$OMP_WORKDIR"' EXIT
OMP_LOG_FILE="${OMP_LOG_FILE:-/var/log/omp-install.log}"
mkdir -p "$(dirname "$OMP_LOG_FILE")" 2>/dev/null || true
# Redirections are applied left to right, so the 2>/dev/null has to come first
# or bash reports the failed append before stderr is silenced.
if ! (: 2>/dev/null >>"$OMP_LOG_FILE"); then
  OMP_LOG_FILE="$OMP_WORKDIR/omp-install.log"
  : >"$OMP_LOG_FILE"
fi

# ------------------------------------------------------------- preflight -----
phase "Starting installation"
step "Preflight"
((OMP_DRY_RUN)) || require_root
require_tools lsblk blkid findmnt awk sed pacman
((OMP_DRY_RUN)) || require_tools sgdisk wipefs partprobe mkfs.ext4 mkfs.btrfs \
  pacstrap genfstab arch-chroot btrfs mountpoint

[[ -n $OMP_DISK ]] || { usage >&2; die "--disk is required (try --list-disks)"; }
[[ -n $OMP_REPO_SIGLEVEL ]] ||
  die "--repo-siglevel is required. There is no default: the [$OMP_REPO_NAME]
      repository is not signed yet, so 'required' fails and 'optional-trustall'
      disables verification. Choose one and say so on the command line.
      See --help."

[[ -n $OMP_PLATFORM ]] || OMP_PLATFORM=$(detect_platform)
case "$OMP_PLATFORM" in
  powernv)
    log "platform: PowerNV -- petitboot is in firmware; no bootloader is installed"
    if ((!OMP_DRY_RUN)) && [[ ! -d /sys/firmware/opal ]]; then
      warn "platform says PowerNV but /sys/firmware/opal is missing (emulated OPAL?)"
    fi
    ;;
  pseries)
    log "platform: pSeries -- GRUB will be installed to a PReP partition"
    ;;
  *) die "unknown platform '$OMP_PLATFORM'" ;;
esac

# Which pool this ISO was built for. Same precedence as the server list below:
# command line, then the environment, then what iso/build.sh baked in. Without
# this an ISO built for the optimised pool would install under the baseline's
# name and pacman would ask a POWER9 server for omarchy-ppc64le.db.
if ((!OMP_REPO_NAME_SET)) && [[ -z $OMP_REPO_NAME_FROM_ENV && -r $OMP_SHARE/repo-name.conf ]]; then
  read -r _n < "$OMP_SHARE/repo-name.conf" || true
  _n=${_n%%#*}; _n=${_n// /}
  [[ -n $_n ]] && OMP_REPO_NAME=$_n
fi
# The kernel follows the pool, now that the pool is known. --kernel and
# $OMP_KERNEL_PKG already set it; otherwise take what iso/build.sh baked in (the
# kernel the medium booted), and failing that derive it from the repo name.
if [[ -z $OMP_KERNEL_PKG && -r $OMP_SHARE/kernel-pkg.conf ]]; then
  read -r _k < "$OMP_SHARE/kernel-pkg.conf" || true
  _k=${_k%%#*}; _k=${_k// /}
  [[ -n $_k ]] && OMP_KERNEL_PKG=$_k
fi
if [[ -z $OMP_KERNEL_PKG ]]; then
  case "$OMP_REPO_NAME" in
    omarchy-power9) OMP_KERNEL_PKG=linux-power9 ;;
    *)              OMP_KERNEL_PKG=linux-omarchy ;;
  esac
fi
log "kernel package: $OMP_KERNEL_PKG"
# Our kernels come in pairs, 4K and 64K pages, and both are installed by
# default: the named kernel is the default boot entry, its -64k twin is the
# next one. Only linux-omarchy and linux-power9 have a twin, so --kernel naming
# anything else installs just that kernel, as does --no-64k.
if [[ -z ${OMP_KERNEL_64K+x} ]]; then
  case "$OMP_KERNEL_PKG" in
    linux-omarchy | linux-power9) OMP_KERNEL_64K="$OMP_KERNEL_PKG-64k" ;;
    *)                            OMP_KERNEL_64K="" ;;
  esac
fi
[[ -n $OMP_KERNEL_64K ]] && log "64K kernel package: $OMP_KERNEL_64K"
if [[ -z $OMP_ENTRY_TITLE ]]; then
  case "$OMP_REPO_NAME" in
    omarchy-power9) OMP_ENTRY_TITLE="Omarchy POWER9" ;;
    *)              OMP_ENTRY_TITLE="Omarchy ppc64le" ;;
  esac
fi
# One SigLevel decision covers both pools unless the operator splits them.
OMP_BASELINE_REPO_SIGLEVEL="${OMP_BASELINE_REPO_SIGLEVEL:-$OMP_REPO_SIGLEVEL}"
# With nothing on the command line, take the list the ISO was built with.
# iso/build.sh writes it: an ISO carrying the repo gets the file:// entry, one
# built --no-repo gets only the network entries, and neither case needs the
# operator to remember a URL. The single-value form is the last fallback.
if ((!${#OMP_REPO_SERVERS[@]})) && [[ -n $OMP_REPO_SERVER_FROM_ENV ]]; then
  OMP_REPO_SERVERS=("$OMP_REPO_SERVER")
elif ((!${#OMP_REPO_SERVERS[@]})) && [[ -r $OMP_SHARE/repo-servers.conf ]]; then
  while read -r _l; do
    _l=${_l%%#*}; _l=${_l// /}
    [[ -n $_l ]] && OMP_REPO_SERVERS+=("$_l")
  done < "$OMP_SHARE/repo-servers.conf"
fi
((${#OMP_REPO_SERVERS[@]})) || OMP_REPO_SERVERS=("$OMP_REPO_SERVER")

# Applied to each pool's server list in turn, so the second pool gets the same
# medium-moved handling and the same target-mount guard as the first.
resolve_repo_servers() {
  local -n _list="$1"
  local _i _s _p _sub _m
  for _i in "${!_list[@]}"; do
    _s=${_list[$_i]}
    [[ $_s == file://* ]] || continue
    _p=${_s#file://}
    # A file:// repo under the install target is either about to be shadowed by
    # the target mount or is inside the filesystem being installed to; both read
    # as "works until it doesn't".
    if [[ $_p == "$OMP_MNT" || $_p == "$OMP_MNT"/* ]]; then
      die "--repo-server $_s is under the install target $OMP_MNT; mount the medium somewhere else"
    fi
    [[ -d $_p ]] && continue
    # Missing, and shaped like our bundled layout: the medium was unmounted by
    # copytoram. Go find it rather than falling straight through to the network.
    if [[ $_p == */omp-repo/* ]]; then
      _sub="omp-repo/${_p#*/omp-repo/}"
      if _m=$(find_boot_medium "$_sub"); then
        _list[$_i]="file://$_m/$_sub"
        log "boot medium moved: bundled repo found at $_m/$_sub"
      else
        warn "bundled repo $_p is gone and the boot medium could not be found"
      fi
    else
      warn "repo server $_s does not exist"
    fi
  done
}
resolve_repo_servers OMP_REPO_SERVERS
((${#OMP_BASELINE_REPO_SERVERS[@]})) && resolve_repo_servers OMP_BASELINE_REPO_SERVERS

log "repository: [$OMP_REPO_NAME]  SigLevel = $OMP_REPO_SIGLEVEL"
for _s in "${OMP_REPO_SERVERS[@]}"; do log "  Server = $_s"; done
if [[ $OMP_REPO_SIGLEVEL == *TrustAll* ]]; then
  warn "SigLevel '$OMP_REPO_SIGLEVEL' for [$OMP_REPO_NAME]: package signatures are NOT verified."
fi
if [[ -n $OMP_BASELINE_REPO_NAME ]]; then
  if ((${#OMP_BASELINE_REPO_SERVERS[@]})); then
    log "baseline repository: [$OMP_BASELINE_REPO_NAME]  SigLevel = $OMP_BASELINE_REPO_SIGLEVEL"
    log "  listed after [$OMP_REPO_NAME], so the optimised build wins where one exists"
    for _s in "${OMP_BASELINE_REPO_SERVERS[@]}"; do log "  Server = $_s"; done
  else
    warn "--baseline-repo-name $OMP_BASELINE_REPO_NAME with no --baseline-repo-server; no baseline stanza will be written"
  fi
fi

# ------------------------------------------------- pacman.conf + manifest ----
phase "Preparing live environment"
step "Resolving the package set"
render_pacman_conf "$OMP_WORKDIR/pacman.conf" 1
# --pacstrap-conf lets the ISO install from its own offline mirror; the file
# rendered above is what the *target* keeps either way.
OMP_PACSTRAP_CONF="${OMP_PACSTRAP_CONF:-$OMP_WORKDIR/pacman.conf}"
mapfile -t OMP_PACKAGES < <(read_manifest "$OMP_MANIFEST")
log "manifest: ${#OMP_PACKAGES[@]} names from $OMP_MANIFEST, plus kernel $OMP_KERNEL_PKG"
OMP_PACKAGES+=("$OMP_KERNEL_PKG")
[[ -n $OMP_KERNEL_64K ]] && OMP_PACKAGES+=("$OMP_KERNEL_64K")
# pSeries boots SLOF -> GRUB in the PReP partition, so the target needs grub
# itself: grub-install, and the powerpc-ieee1275 modules it copies into
# /boot/grub. PowerNV's petitboot only reads grub.cfg and needs none of it,
# which is why the manifest does not list it -- and why, without this, a pSeries
# install finished with no bootloader and a disk SLOF could not boot.
[[ $OMP_PLATFORM == pseries ]] && OMP_PACKAGES+=(grub)
resolve_packages "$OMP_PACSTRAP_CONF" "${OMP_PACKAGES[@]}"
# The dashboard's package bar needs the number pacstrap will actually install,
# dependencies included. resolved.txt is exactly that list, so hand it over
# rather than keeping a second count in the ISO that drifts from the repo.
if [[ -n ${OMARCHY_EXPECTED_PACKAGES_FILE:-} && -r $OMP_WORKDIR/resolved.txt ]]; then
  wc -l <"$OMP_WORKDIR/resolved.txt" >"$OMARCHY_EXPECTED_PACKAGES_FILE" 2>/dev/null || true
fi

# -------------------------------------------------------------- the disk -----
phase "Preparing install target"
step "Target: $OMP_DISK"
# The guard reads and never writes, so it runs under --dry-run too -- checking
# "would this device be refused?" is most of what a dry run is for. The cost is
# that --dry-run needs a device that actually exists.
assert_disk_is_safe "$OMP_DISK" "$OMP_SERIAL"
list_disks | grep -F "$OMP_DISK" || true
if ((!OMP_DRY_RUN)); then
  confirm "ERASE $OMP_DISK completely and install Omarchy on it?" ||
    die "aborted by operator; nothing was written"
fi

partition_disk "$OMP_DISK" "$OMP_PLATFORM" "$OMP_BOOT_SIZE"
make_filesystems
read_back_uuids
mount_target "$OMP_MNT"

# --------------------------------------------------------------- pacstrap ----
phase "Installing Arch + Omarchy"
step "pacstrap"
run_loud pacstrap -C "$OMP_PACSTRAP_CONF" -K "$OMP_MNT" "${OMP_PACKAGES[@]}" ||
  die "pacstrap failed -- see $OMP_LOG_FILE"

if ((!OMP_DRY_RUN)); then
  installed=$(pacman -r "$OMP_MNT" -Q 2>/dev/null | wc -l)
  log "target holds $installed packages"
  ((installed > 0)) || die "pacstrap reported success but the target has no packages"
fi

# pacstrap -K initialises an EMPTY keyring in the target: it creates the trust
# database but imports no keys. archpower-keyring lands in $OMP_MNT with
# everything else, yet nothing populates it there, so pacman inside the new
# root reports every [base] package as unknown trust and the first upgrade
# fails. The live medium does this for itself in
# iso/profile/airootfs/root/customize_airootfs.sh; the target needs it too, or
# --base-siglevel has to be weakened to paper over a missing step.
# --init is idempotent: -K has already made the directory, but running it keeps
# this correct if that flag ever changes.
step "keyring"
run_loud arch-chroot "$OMP_MNT" pacman-key --init ||
  die "pacman-key --init failed in the target -- see $OMP_LOG_FILE"
run_loud arch-chroot "$OMP_MNT" pacman-key --populate archpower ||
  die "pacman-key --populate archpower failed -- see $OMP_LOG_FILE"

# keep the configuration the install actually used
phase "Configuring system"
render_pacman_conf "$OMP_MNT/etc/pacman.conf" 0 1

write_fstab "$OMP_MNT"
configure_system "$OMP_MNT"
configure_initramfs "$OMP_MNT"
configure_boot "$OMP_MNT"
phase "Finalizing user"
configure_users "$OMP_MNT"
if ((OMP_STAGE_FIRSTBOOT)); then stage_firstboot "$OMP_MNT"; fi

# ------------------------------------------------------------------ done -----
step "Done"
if ((!OMP_DRY_RUN)); then
  cat <<EOF | tee -a "$OMP_LOG_FILE"

Installed to $OMP_DISK.
  /boot   $OMP_PART_BOOT  ext4   UUID=$OMP_UUID_BOOT
  /       $OMP_PART_ROOT  btrfs  UUID=$OMP_UUID_ROOT  subvol=@
  kernel  $OMP_KERNEL_PKG (default entry)${OMP_KERNEL_64K:+, $OMP_KERNEL_64K}

Nothing was written to a bootloader: on PowerNV, petitboot is in firmware and
reads /boot/grub/grub.cfg off the ext4 partition above. If the machine does not
offer the entry, check at the petitboot shell that it mounted that partition.

First boot runs, in order:
  omp-firstboot.service            the root-side configuration layer
  omarchy-provision-owner.service Omarchy's own account wizard on tty1
EOF
  umount_target "$OMP_MNT"
  # finished_at is what tells the dashboard to fill the bar, show the install
  # time and ask "Reboot Now"; it owns the reboot from here.
  phase "Installation complete" "$(date +%s)"
  if ((OMP_REBOOT)); then
    log "rebooting"
    systemctl reboot
  fi
fi
exit 0
