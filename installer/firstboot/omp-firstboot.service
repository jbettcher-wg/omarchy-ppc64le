# The root-side Omarchy configuration layer, on the target's first boot.
#
# Upstream does this work in the target chroot during the install
# (omarchy-apply-system). It runs here instead: two of its steps had to be
# replaced for ppc64le and several of the rest want a live system rather than a
# chroot (udevadm, updatedb, ufw, service enablement).
#
# Ordered before Omarchy's own account wizard, which reads the group grants and
# the browser policy directories this leaves behind, and before the display
# manager so a first login never races a half-applied configuration.

[Unit]
Description=Omarchy ppc64le first-boot system configuration
ConditionPathExists=!/var/lib/omp/firstboot-done
After=systemd-user-sessions.service local-fs.target
# sddm.service by name as well: display-manager.service is only an alias, and it
# does not exist on first boot until enable-services.sh creates it.
Before=omarchy-provision-owner.service display-manager.service sddm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omp-firstboot
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
