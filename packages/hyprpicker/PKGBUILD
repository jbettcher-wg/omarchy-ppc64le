# ppc64le: added powerpc64le to arch(). That was the only change needed.
#
# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Contributor: Jeremy Gust <jeremy AT plasticsoup DOT net>
# Contributor: Aaron Blasko <blaskoazzolaaaron [at] gmail.com>

pkgname=hyprpicker
pkgver=0.4.7
pkgrel=4
pkgdesc="A wlroots-compatible Wayland color picker that does not suck"
arch=(x86_64 powerpc64le)
url="https://github.com/hyprwm/hyprpicker"
license=(BSD-3-Clause)
depends=(
  cairo
  glibc
  hyprutils
  libgcc
  libstdc++
  libxkbcommon
  wayland
)
makedepends=(
  cmake
  hyprwayland-scanner
  libglvnd
  libjpeg-turbo
  ninja
  pango
  wayland-protocols
)
optdepends=('wl-clipboard: Allows --autocopy to automatically copy the output to the clipboard')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('cde02b92abe372187c9d59a7cb2ca07ede5c3e1a8c81ed8b209dc0d3ac5f0339')

build() {
  cd $pkgname-$pkgver
  cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_MANDIR=/usr/share/man \
    -Wno-dev
  cmake --build build
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
