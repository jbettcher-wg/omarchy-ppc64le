# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# asdcontrol -- brightness control for Apple Studio / Pro XDR displays over USB
# HID, driven by omarchy-brightness-display-apple.  Omarchy publishes it from
# their own repository and there is no PKGBUILD in Arch, Arch POWER, the AUR or
# upstream, so this recipe is written from upstream's Makefile
# (github.com/omakasui/asdcontrol).
#
# Version is Omarchy's, epoch and pkgrel included (1:0.6.0-2), because the
# install manifest is pinned to what Omarchy ships and pacman compares the
# epoch.
#
# ppc64le: adding powerpc64le to arch=() was the only change needed.  One C++
# file talking to linux/hiddev.h ioctls, nothing architecture-specific.  Two
# packaging-level differences from `make install`: makepkg's CPPFLAGS/LDFLAGS
# are passed through (the Makefile only reads CXXFLAGS), and the binary goes to
# /usr/bin, not /usr/local/bin, which is where Omarchy's sudoers rule and
# script expect it.
#
# 50-asdcontrol is Omarchy's sudoers drop-in, copied byte-for-byte out of
# asdcontrol-1:0.6.0-2-x86_64.pkg.tar.zst from pkgs.omarchy.org -- a text file,
# nothing architecture-dependent.  It lets %wheel run exactly the three
# asdcontrol invocations omarchy-brightness-display-apple makes (detect, read,
# set by percent) without a password, and denies every other argument list.
# Installed 0440 in a 0750 directory, as theirs is and as sudo requires.

pkgname=asdcontrol
epoch=1
pkgver=0.6.0
# pkgrel 2 mirrors Omarchy's own build number for this version.
pkgrel=2
pkgdesc='Control brightness on Apple Displays connected via USB-C'
arch=(powerpc64le)
url='https://github.com/omakasui/asdcontrol'
license=(GPL-2.0-or-later)
depends=(glibc gcc-libs)
makedepends=(make gcc)
backup=(etc/sudoers.d/50-asdcontrol)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        50-asdcontrol)
sha256sums=('3112a6d5fc51a204c96ef9d27187577c6efc80b952e37a77969efbd0124e81d3'
            '70d6838f91cf4b5e51974b9b62b141924cec844a2e60de79607839584ede847f')

build() {
  cd "$pkgname-$pkgver"
  make CXXFLAGS="$CPPFLAGS $CXXFLAGS $LDFLAGS"
}

check() {
  cd "$pkgname-$pkgver"
  # The binary reports the version we claim to package.
  ./asdcontrol --help 2>&1 | grep -q '0\.6\.0' || ./asdcontrol --about 2>&1 | grep -q '0\.6\.0'
  # The sudoers fragment parses.  A broken drop-in in /etc/sudoers.d makes sudo
  # refuse to run at all, so this is worth the one line.
  if command -v visudo >/dev/null; then
    visudo -c -q -f "$srcdir/50-asdcontrol"
  fi
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 asdcontrol "$pkgdir/usr/bin/asdcontrol"
  install -dm750 "$pkgdir/etc/sudoers.d"
  install -m440 "$srcdir/50-asdcontrol" "$pkgdir/etc/sudoers.d/50-asdcontrol"
}
