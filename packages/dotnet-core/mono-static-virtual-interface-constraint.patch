-		return method;
+	if (MONO_CLASS_IS_INTERFACE_INTERNAL (constrained_class)) {
+		MonoMethod *svm_impl = mono_class_get_static_virtual_impl_in_interface (constrained_class, method, error);
+		return_val_if_nok (error, NULL);
