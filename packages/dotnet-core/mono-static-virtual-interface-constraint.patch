+			MonoGenericContext svm_ctx;
+			memset (&svm_ctx, 0, sizeof (svm_ctx));
+			svm_ctx.method_inst = mono_method_get_context (method)->method_inst;
+			svm_impl = mono_class_inflate_generic_method_checked (svm_impl, &svm_ctx, error);
+			return_val_if_nok (error, NULL);
+		}
+		return svm_impl ? svm_impl : method;
+	}
 
 	mono_class_setup_vtable (base_class);
 	if (mono_class_has_failure (base_class)) {
