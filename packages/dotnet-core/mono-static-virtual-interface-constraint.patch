+/*
+ * mono_class_get_static_virtual_impl_in_interface:
+ *
+ *   A constrained call to a static virtual (or static abstract) interface method
+ * can name another interface as the constraint type: C# lets an interface supply
+ * the implementation (interface IDerived : IBase { static R IBase.M () => ...; }),
+ * and generic code like
+ *
+ *   class G<T> where T : IBase { R Call () => T.M (); }   used as G<IDerived>
+ *
+ * must end up in IDerived's implementation, as it does on CoreCLR. Search IFACE and
+ * the interfaces it inherits for a MethodImpl whose declaration is DECL, preferring
+ * the most derived interface. Returns NULL when there is none; the declaration
+ * itself is then the target (a static virtual with its own default body).
+ */
+MonoMethod*
+mono_class_get_static_virtual_impl_in_interface (MonoClass *iface, MonoMethod *decl, MonoError *error)
+{
+	MonoMethod *res = NULL;
+	MonoClass *res_class = NULL;
+	GPtrArray *parents;
+	MonoMethod *decl_def = decl->is_inflated ? ((MonoMethodInflated*)decl)->declaring : decl;
+
+	error_init (error);
+	if (!m_method_is_static (decl) || !m_method_is_virtual (decl) || !MONO_CLASS_IS_INTERFACE_INTERNAL (iface))
+		return NULL;
+
+	parents = mono_class_get_implemented_interfaces (iface, error);
+	return_val_if_nok (error, NULL);
+
+	for (int k = -1; k < (parents ? (int)parents->len : 0); k++) {
+		MonoClass *ic = k < 0 ? iface : (MonoClass*)g_ptr_array_index (parents, k);
+		MonoMethod **overrides = NULL;
+		int onum = 0;
+
+		if (res_class && mono_class_is_assignable_from_internal (ic, res_class))
+			continue; /* ic is a base of the interface that already supplied an implementation */
+
+		mono_class_get_overrides_full (m_class_get_image (ic), m_class_get_type_token (ic), &overrides, &onum, mono_class_get_context (ic), error);
+		if (!is_ok (error))
+			break;
+		for (int i = 0; i < onum; i++) {
+			MonoMethod *odecl = overrides [i * 2];
+			MonoMethod *obody = overrides [i * 2 + 1];
+			MonoMethod *odecl_def = odecl->is_inflated ? ((MonoMethodInflated*)odecl)->declaring : odecl;
+
+			if (odecl_def != decl_def)
+				continue;
+			if (odecl->klass != decl->klass &&
+			    !mono_metadata_type_equal (m_class_get_byval_arg (odecl->klass), m_class_get_byval_arg (decl->klass)))
+				continue;
+			if (mono_class_is_gtd (obody->klass)) {
+				obody = mono_class_inflate_generic_method_full_checked (obody, ic, mono_class_get_context (ic), error);
+				if (!is_ok (error))
+					break;
+			}
+			res = obody;
+			res_class = ic;
+			break;
+		}
+		g_free (overrides);
+		if (!is_ok (error))
+			break;
+	}
+
+	if (parents)
+		g_ptr_array_free (parents, TRUE);
+	return is_ok (error) ? res : NULL;
+}
