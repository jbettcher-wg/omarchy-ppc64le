# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Kristian Mosegaard <kristian@mosen.me>
# Contributor: Max Liebkies <mail@maxliebkies.de>
# Contributor: Krzysztof Bogacki <krzysztof.bogacki@leancode.pl>
#
# powerpc64le port of Arch's dotnet-core. Full write-up, for any ppc64le
# distro: docs/dotnet-ppc64le-bootstrap.md in this repo.
#
# ---------------------------------------------------------------------------
# The bootstrap chain
# ---------------------------------------------------------------------------
#
# Why a seed. The .NET VMR (github.com/dotnet/dotnet) cannot be built by a
# C/C++ toolchain alone. A source-build of version N needs, for the SAME CPU
# architecture:
#   1. a working .NET SDK of version N-1 (runs MSBuild, Roslyn, NuGet), and
#   2. N-1's Private.SourceBuilt.Artifacts tarball (the previously
#      source-built NuGet packages: Arcade, ref packs, ILAsm, ...).
# eng/Versions.props in the source tag names that N-1 as
# PrivateSourceBuiltSdkVersion. For tag v10.0.112 it is
# 10.0.111-servicing.26373.116.
#
# On x86_64 and aarch64 prep-source-build.sh downloads both from Microsoft.
# Microsoft publishes nothing for ppc64le, and CoreCLR has no ppc64le JIT, so
# ppc64le builds use the Mono runtime flavor. IBM builds .NET for s390x and
# ppc64le and publishes the SDK and the artifacts tarball with each release at
#   https://github.com/IBM/dotnet-s390x/releases   (despite the repo name)
# Release v10.0.111 carries
#   dotnet-sdk-10.0.111-linux-ppc64le.tar.gz
#   Private.SourceBuilt.Artifacts.10.0.111-servicing.linux-ppc64le.tar.gz
# The sha256sums below equal the digests GitHub records for those release
# assets (api.github.com/repos/IBM/dotnet-s390x/releases/tags/v10.0.111,
# field "digest"). IBM publishes no signatures or checksum files; the GitHub
# asset digest over TLS is the only verification there is.
#
# The seed is used only at build time: as the stage-0 SDK (--with-sdk) and
# as the previously-source-built package feed (prereqs/packages/archive/).
# Nothing from it is copied into any $pkgdir. The packages below are built
# entirely from the v10.0.112 source tag.
#
# ---------------------------------------------------------------------------
# _bootstrap: auto (default) | 1 | 0
# ---------------------------------------------------------------------------
#
#   auto  Decided when this PKGBUILD is sourced, by looking at the host:
#         - /usr/share/dotnet/sdk/$_seed_sdkver/ exists AND
#           /usr/share/dotnet/source-built-artifacts/
#             Private.SourceBuilt.Artifacts.$_seed_sdkver[-.]*.tar.gz exists
#             -> self-host (same as _bootstrap=0).
#         - no 10.0 SDK and no source-built-artifacts tarball installed
#             -> seed (same as _bootstrap=1).
#         - anything else (a 10.0 SDK or artifacts tarball of another
#           version) -> hard error naming the version needed. A mismatched
#           SDK is never used silently.
#   1     Always use IBM's seed, whatever is installed:  _bootstrap=1 makepkg
#   0     Always self-host from the installed dotnet-sdk and
#         dotnet-source-built-artifacts (Arch's normal path; no external
#         binaries). Fails in prepare() if they are missing or mismatched.
#
# Because auto looks at the host, source=() and makedepends=() differ per
# machine: seed mode adds the two IBM tarballs to source=(), self-host mode
# adds dotnet-sdk and dotnet-source-built-artifacts to makedepends=(). A
# .SRCINFO generated from this recipe is therefore host-dependent; generate
# one on a machine without .NET (or with _bootstrap=1), which is the state a
# fresh machine is in. This repo does not commit .SRCINFO files.
#
# Checksums always apply: in seed mode the IBM tarballs are in source=() with
# pinned sha256sums/b2sums, so a changed or corrupt seed fails makepkg's
# validation before prepare() runs.
#
# First build on a new ppc64le machine:
#   makepkg                       # auto -> seed, builds 10.0.12
#   install dotnet-sdk + dotnet-source-built-artifacts from the result
# Next version (10.0.13, whose Versions.props names 10.0.112):
#   bump pkgver, set _seed_sdkver=10.0.112, update the git checksum, and
#   makepkg                       # auto -> self-host; IBM is out of the loop
#
# Starting from a different N-1: find the IBM release whose tag equals the
# PrivateSourceBuiltSdkVersion prefix of the tag you are building (e.g.
# v10.0.112 for dotnet v10.0.113), set _seed_sdkver to it, and replace the
# two seed checksums with that release's asset digests. prepare() refuses to
# run if _seed_sdkver disagrees with eng/Versions.props.

pkgbase=dotnet-core
pkgname=(
 dotnet-host
 dotnet-runtime
 aspnet-runtime
 dotnet-sdk
 dotnet-targeting-pack
 aspnet-targeting-pack
 dotnet-source-built-artifacts
)
pkgver=10.0.12.sdk112
pkgrel=3
arch=(powerpc64le)
url=https://dotnet.microsoft.com
license=(MIT)
# ppc64le: clang20/llvm20 -> the distro clang/llvm/lld (22 here; clang20 is
# not in Arch POWER). init-compiler.sh accepts it, see the flags in build().
makedepends=(
  bash
  clang
  cmake
  git
  icu
  krb5
  libgit2
  libunwind
  libxml2
  lld
  lldb
  llvm
  lttng-ust2.12
  nodejs
  openssl
  systemd
  zlib
)
optdepends=('bash-completion: Bash completion support')
options=(
  !lto
  staticlibs
)
source=(git+https://github.com/dotnet/dotnet.git#tag=v${pkgver/.*.sdk/.0.}
        mono-ppc64le-elfv2-small-aggregates.patch
        mono-static-virtual-interface-constraint.patch)
b2sums=('4ae24a6cdfd7b1c13031991f2cbb12e4e24fe4a7293f5cf7a48d5d92d5b068380cc174c46dda6a11908b1230e50fe1a4dbb1acc863ba36e17b3b6123bc72c4b7'
        '5affe6666187dd7d89b098c701b6d0b65843600a185e8c637214f33a74d36ce83aea8ba895ab78d5c9e6fe25f2b86d925e8cc10e02f83f2595f2686195422794'
        '7b5b1f632b0a48da70b211e8ee0b3187f1f7884a7287f9abfcef16727cf19d2a5bf46299366050aacd97692858ad7a6f5ac92f74ecc61c637f6183033fd86fbd')
sha256sums=('SKIP'
            '53c9ac0b6ba2decbc86f47c42f9f10449cdcf3faf0cc9c64fab6785cb4674fe7'
            '6a78eff9e23d5b2c57cd4bd951987b91912e7fe66db87592c19298f76b1ec666')

# --- bootstrap selection (see header) --------------------------------------
_seed_sdkver=10.0.111
_seed_base=https://github.com/IBM/dotnet-s390x/releases/download/v${_seed_sdkver}
_seed_sdk=dotnet-sdk-${_seed_sdkver}-linux-ppc64le.tar.gz
_seed_artifacts=Private.SourceBuilt.Artifacts.${_seed_sdkver}-servicing.linux-ppc64le.tar.gz
_dotnet_root=/usr/share/dotnet

_bootstrap=${_bootstrap:-auto}
if [[ $_bootstrap == auto ]]; then
  _have_sdk=0 _have_artifacts=0 _other=()
  [[ -x $_dotnet_root/dotnet && -d $_dotnet_root/sdk/$_seed_sdkver ]] && _have_sdk=1
  compgen -G "$_dotnet_root/source-built-artifacts/Private.SourceBuilt.Artifacts.${_seed_sdkver}[-.]*.tar.gz" >/dev/null && _have_artifacts=1
  for _d in "$_dotnet_root"/sdk/10.0.*/ "$_dotnet_root"/source-built-artifacts/Private.SourceBuilt.Artifacts.*.tar.gz; do
    [[ -e $_d ]] || continue
    case $_d in
      */sdk/$_seed_sdkver/|*/Private.SourceBuilt.Artifacts.${_seed_sdkver}[-.]*) ;;
      *) _other+=("$_d") ;;
    esac
  done
  if (( _have_sdk && _have_artifacts )); then
    _bootstrap=0
  elif (( ! _have_sdk && ! _have_artifacts )) && (( ${#_other[@]} == 0 )); then
    _bootstrap=1
  else
    printf '==> ERROR: %s\n' \
      "dotnet-core: the installed .NET toolchain does not match what this source tag needs." \
      "  needed: $_dotnet_root/sdk/$_seed_sdkver/ and source-built-artifacts/Private.SourceBuilt.Artifacts.$_seed_sdkver-*.tar.gz" \
      "  found:  sdk $_seed_sdkver=$([[ $_have_sdk == 1 ]] && echo yes || echo no), artifacts $_seed_sdkver=$([[ $_have_artifacts == 1 ]] && echo yes || echo no), other: ${_other[*]:-none}" \
      "  Install dotnet-sdk/dotnet-source-built-artifacts $_seed_sdkver, or run '_bootstrap=1 makepkg' to use IBM's $_seed_sdkver seed." >&2
    return 1
  fi
  unset _have_sdk _have_artifacts _other _d
fi
case $_bootstrap in
  1)
    source+=("$_seed_base/$_seed_sdk" "$_seed_base/$_seed_artifacts")
    noextract=("$_seed_sdk" "$_seed_artifacts")
    sha256sums+=('0e887493a69ff21d4bf9bbdb7e2487f5995c8a772271c47ecf065b732b55cf3b'
                 '1c39b88c0056176075c040af4b2ab2dc4cee68ecba60d8f69f5d468dfb25b263')
    b2sums+=('5e8bf28fad6408a59a6e5589a74eb21d6f93b3f526be21096ac1ad3c1b576b4060959297ebdf7da924edbf2f5ec0a8f912d077e3d2dc8c18f53ade2542f51878'
             'ecb1b85cab679177f5a7079df1de57f957b519902f16f6f2e178162ca35183c5d667ffb398d8a972f41d12de0f44c62618ae4d01e141091f8403db1c7c7be2f2')
    ;;
  0)
    makedepends+=(dotnet-sdk dotnet-source-built-artifacts)
    ;;
  *)
    printf '==> ERROR: dotnet-core: _bootstrap must be auto, 0 or 1 (got %q)\n' "$_bootstrap" >&2
    return 1
    ;;
esac
# ---------------------------------------------------------------------------

# Keep the SDK's first-run state, NuGet caches and telemetry out of the
# builder's $HOME (~/.dotnet, ~/.nuget, ~/.local/share/NuGet).
_dotnet_env='local -x HOME="$srcdir/home" DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1; mkdir -p "$HOME"'

prepare() {
  eval "$_dotnet_env"
  cd dotnet

  # fix bootstrap
  git remote set-url origin https://github.com/dotnet/dotnet.git

  # ppc64le: Mono's ppc64 JIT returned every struct through a hidden pointer
  # and loaded small struct arguments as whole doublewords, both against ELFv2.
  # P/Invokes and callbacks returning small structs got every argument shifted
  # one register (pinta/GirCore died at startup). Upstreamable; see the header.
  patch -Np1 -d src/runtime -i "$srcdir/mono-ppc64le-elfv2-small-aggregates.patch"

  # All architectures: Mono resolved a constrained call to a static virtual
  # interface method to its bodiless declaration when the type argument is an
  # interface that implements it (GirCore bindings; pinta's actions never got
  # handlers). dotnet/runtime #82217. Upstreamable; see the header.
  patch -Np1 -d src/runtime -i "$srcdir/mono-static-virtual-interface-constraint.patch"

  local _bootstrapver=$(xmllint --xpath "string(//*[local-name()='PrivateSourceBuiltSdkVersion'])" eng/Versions.props)
  if [[ ${_bootstrapver%%-*} != "$_seed_sdkver" ]]; then
    error "eng/Versions.props wants N-1 SDK $_bootstrapver, but _seed_sdkver=$_seed_sdkver."
    error "Set _seed_sdkver to ${_bootstrapver%%-*} (and the seed checksums, see the header)."
    return 1
  fi

  # Stage-0 SDK is a private copy: the build writes into it.
  rm -rf "$srcdir/stage0-sdk" prereqs/packages/archive
  mkdir -p "$srcdir/stage0-sdk" prereqs/packages/archive
  if [[ $_bootstrap == 1 ]]; then
    msg2 "Bootstrapping from IBM's ppc64le $_seed_sdkver seed"
    bsdtar -xf "$srcdir/$_seed_sdk" -C "$srcdir/stage0-sdk" --no-same-owner
    ln -s "$srcdir/$_seed_artifacts" prereqs/packages/archive/
  else
    msg2 "Self-hosting from the installed $_seed_sdkver SDK and source-built artifacts"
    local _art=( "$_dotnet_root"/source-built-artifacts/Private.SourceBuilt.Artifacts.${_seed_sdkver}[-.]*.tar.gz )
    if [[ ! -d $_dotnet_root/sdk/$_seed_sdkver || ! -f ${_art[0]} ]]; then
      error "_bootstrap=0 needs dotnet-sdk $_seed_sdkver and dotnet-source-built-artifacts $_seed_sdkver installed."
      return 1
    fi
    cp -a "$_dotnet_root"/{dotnet,host,shared,packs,sdk,sdk-manifests,templates} "$srcdir/stage0-sdk"/ 2>/dev/null || true
    [[ -x $srcdir/stage0-sdk/dotnet && -d $srcdir/stage0-sdk/sdk/$_seed_sdkver ]] || { error "copying $_dotnet_root failed"; return 1; }
    ln -s "${_art[0]}" prereqs/packages/archive/
  fi
  "$srcdir/stage0-sdk/dotnet" --version

  # --no-sdk/--no-bootstrap: the stage-0 SDK is supplied, and the artifacts
  # already carry linux-ppc64le runtime packs (there is nothing on nuget.org
  # to "bootstrap" them from).
  ./prep-source-build.sh --no-sdk --no-bootstrap --with-sdk "$srcdir/stage0-sdk"
}

build() {
  eval "$_dotnet_env"
  cd dotnet

  export COMPlus_LTTng=0
  export VERBOSE=1
  export OPENSSL_ENABLE_SHA1_SIGNATURES=1

  # this uses malloc_usable_size, which is incompatible with fortification level 3
  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

  CFLAGS=$(echo $CFLAGS  | sed -e 's/-fstack-clash-protection//' )
  CXXFLAGS=$(echo $CXXFLAGS  | sed -e 's/-fstack-clash-protection//' )

  # ppc64le: clang newer than Arch's clang20 adds these to -Wall, and the
  # runtime builds with -Werror. Same set Fedora uses for its clang 21+.
  local _nowarn='-Wno-unknown-warning-option -Wno-jump-misses-init -Wno-implicit-void-ptr-cast -Wno-implicit-int-enum-cast -Wno-used-but-marked-unused'
  export EXTRA_CFLAGS="$CFLAGS $_nowarn"
  export EXTRA_CXXFLAGS="$CXXFLAGS $_nowarn"
  export EXTRA_LDFLAGS="$LDFLAGS"
  unset CFLAGS
  unset CXXFLAGS
  unset LDFLAGS

  # ppc64le: --with-sdk points at the stage-0 SDK. --use-mono-runtime is what
  # IBM and Fedora pass on ppc64le/s390x; Subsets.props would pick Mono anyway
  # (CoreCLR is unsupported there), but the flag also stops runtime.proj from
  # trying to build every runtime pack. The RID comes from /etc/os-release
  # (ID=arch), giving arch-ppc64le, matched by the arch-* globs below.
  # rtm branding strips out the "prerelease" tag from the version (see https://github.com/dotnet/dotnet/blob/b0f34d51fccc69fd334253924abd8d6853fad7aa/build.sh#L18)
  ./build.sh --clean-while-building --online --source-build \
    --use-mono-runtime \
    --with-sdk "$srcdir/stage0-sdk"
}

package_dotnet-host() {
  pkgdesc='A generic driver for the .NET Core Command Line Interface'
  depends=(
    glibc
    libgcc
    libstdc++
  )
  optdepends=('bash-completion: Bash completion support')

  install -dm 755 "${pkgdir}"/usr/{bin,lib,share/{dotnet,licenses/dotnet-host}}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner dotnet host
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/licenses/dotnet-host/ --no-same-owner LICENSE.txt ThirdPartyNotices.txt
  ln -s /usr/share/dotnet/dotnet "${pkgdir}"/usr/bin/dotnet
  ln -s /usr/share/dotnet/host/fxr/${pkgver%.sdk*}/libhostfxr.so "${pkgdir}"/usr/lib/libhostfxr.so
  install -Dm 644 dotnet/src/sdk/scripts/register-completions.bash "${pkgdir}"/usr/share/bash-completion/completions/dotnet
  install -Dm 644 dotnet/src/sdk/scripts/register-completions.zsh "${pkgdir}"/usr/share/zsh/site-functions/_dotnet
}

package_dotnet-runtime() {
  pkgdesc='The .NET Core runtime'
  depends=(
    dotnet-host
    glibc
    icu
    krb5
    libgcc
    libstdc++
    libunwind
    zlib
    openssl
  )
  optdepends=('lttng-ust2.12: CoreCLR tracing')
  provides=(
    dotnet-runtime=${pkgver%.*.sdk*}
    dotnet-runtime-${pkgver%.*.sdk*}
  )
  conflicts=(dotnet-runtime-${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner shared/Microsoft.NETCore.App
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-runtime
}

package_aspnet-runtime() {
  pkgdesc='The ASP.NET Core runtime'
  depends=(dotnet-runtime)
  provides=(
    aspnet-runtime=${pkgver%.*.sdk*}
    aspnet-runtime-${pkgver%.*.sdk*}
  )
  conflicts=(aspnet-runtime-${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner shared/Microsoft.AspNetCore.App
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/aspnet-runtime
}

package_dotnet-sdk() {
  pkgdesc='The .NET Core SDK'
  depends=(
    dotnet-runtime
    dotnet-targeting-pack
    glibc
    libgcc
    libstdc++
  )
  optdepends=('aspnet-targeting-pack: Build ASP.NET Core applications')
  provides=(
    dotnet-sdk=${pkgver%.*.sdk*}
    dotnet-sdk-${pkgver%.*.sdk*}
  )
  conflicts=(dotnet-sdk-${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner sdk sdk-manifests templates
  install -dm 755 "${pkgdir}"/usr/share/dotnet/metadata/workloads/${pkgver%.*.sdk*}.${pkgver#*.sdk}
  touch "${pkgdir}"/usr/share/dotnet/metadata/workloads/${pkgver%.*.sdk*}.${pkgver#*.sdk}/userlocal
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-sdk
}

package_dotnet-targeting-pack() {
  pkgdesc='The .NET Core targeting pack'
  provides=(
    dotnet-targeting-pack=${pkgver%.*.sdk*}
    dotnet-targeting-pack-${pkgver%.*.sdk*}
  )
  conflicts=(dotnet-targeting-pack-${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner packs/Microsoft.NETCore.App.{Host.arch-*,Ref}
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/dotnet-targeting-pack
}

package_aspnet-targeting-pack() {
  pkgdesc='The ASP.NET Core targeting pack'
  depends=(dotnet-targeting-pack)
  provides=(
    aspnet-targeting-pack=${pkgver%.*.sdk*}
    aspnet-targeting-pack-${pkgver%.*.sdk*}
  )
  conflicts=(aspnet-targeting-pack-${pkgver%.*.sdk*})

  install -dm 755 "${pkgdir}"/usr/share/{dotnet,licenses}
  bsdtar -xf dotnet/artifacts/assets/Release/dotnet-sdk-${pkgver%.*.sdk*}.${pkgver#*sdk}-arch-*.tar.gz -C "${pkgdir}"/usr/share/dotnet/ --no-same-owner packs/Microsoft.AspNetCore.App.Ref
  ln -s dotnet-host "${pkgdir}"/usr/share/licenses/aspnet-targeting-pack
}

package_dotnet-source-built-artifacts() {
  pkgdesc='Internal package for building the .NET Core SDK'
  provides=(
    dotnet-source-built-artifacts=${pkgver%.*.sdk*}
    dotnet-source-built-artifacts-${pkgver%.*.sdk*}
  )
  conflicts=(dotnet-source-built-artifacts-${pkgver%.*.sdk*})

  install -Dm 644 dotnet/artifacts/assets/Release/Private.SourceBuilt.Artifacts.*.tar.gz -t "${pkgdir}"/usr/share/dotnet/source-built-artifacts/
}
