+/*
+ * Store an ELFv2 aggregate returned in r3/r4 or f1..f8 into the destination whose address
+ * mono_arch_emit_call () saved in cfg->arch.vret_addr_loc. Only the bytes of the aggregate
+ * are written: the destination is a stack slot of exactly that size, so storing a whole
+ * doubleword for, say, a 3 or 12 byte struct would clobber a neighbouring local.
+ * r11 and r12 are volatile and never carry return values.
+ */
+static guint8*
+emit_save_vtype_ret (MonoCompile *cfg, CallInfo *cinfo, guint8 *code)
+{
+	MonoInst *loc = cfg->arch.vret_addr_loc;
+	ArgInfo *ainfo = &cinfo->ret;
+	int i, j;
+
+	g_assert (loc && loc->opcode == OP_REGOFFSET);
+	if (ppc_is_imm16 (loc->inst_offset)) {
+		ppc_ldptr (code, ppc_r12, loc->inst_offset, loc->inst_basereg);
+	} else {
+		ppc_load (code, ppc_r12, loc->inst_offset);
+		ppc_ldptr_indexed (code, ppc_r12, loc->inst_basereg, ppc_r12);
+	}
+
+	if (ainfo->regtype == RegTypeFPStructByVal) {
+		for (i = 0; i < ainfo->vtregs; ++i) {
+			if (ainfo->size == 4)
+				ppc_stfs (code, ainfo->reg + i, i * 4, ppc_r12);
+			else
+				ppc_stfd (code, ainfo->reg + i, i * 8, ppc_r12);
+		}
+	} else {
+		int remaining = ainfo->vtsize;
+
+		g_assert (ainfo->regtype == RegTypeStructByVal);
+		for (i = 0; i < ainfo->vtregs; ++i) {
+			int reg = ainfo->reg + i;
+			int offset = i * sizeof (target_mgreg_t);
+			int nbytes = MIN (remaining, (int)sizeof (target_mgreg_t));
+
+			switch (nbytes) {
+			case 8:
+				ppc_stptr (code, reg, offset, ppc_r12);
+				break;
+			case 4:
+				ppc_stw (code, reg, offset, ppc_r12);
