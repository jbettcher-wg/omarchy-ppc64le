+/*
+ * The 64-bit ELF ABIs require an integer argument or return value narrower than a
+ * doubleword to be sign or zero extended to 64 bits by whoever produces it, and
+ * GCC-compiled callees rely on that. A vtype of fewer than 8 bytes travelling in one
+ * register only has unspecified padding, but bindings commonly wrap a C scalar in a
+ * one-field struct (GirCore's GLib.Quark for GQuark, HarfBuzz's codepoint_t, ...), so
+ * a native callee expecting the scalar would see the bytes after the struct as part
+ * of the value. Extend such vtypes the way the wrapped scalar would be: sign-extend a
+ * single signed integer field that fills the struct, zero-extend everything else.
+ * Returns the number of low-order bits to keep, 0 if no extension applies.
+ */
+static int
+small_vtype_extension (MonoClass *klass, int size, gboolean *is_signed)
+{
+	MonoClassField *field, *single = NULL;
+	gpointer iter = NULL;
+	int nfields = 0;
+
+	*is_signed = FALSE;
+	if (!klass || size <= 0 || size >= (int)sizeof (target_mgreg_t))
+		return 0;
+
+	while ((field = mono_class_get_fields_internal (klass, &iter))) {
+		if (field->type->attrs & FIELD_ATTRIBUTE_STATIC)
+			continue;
+		single = field;
+		nfields++;
+	}
+
+	if (nfields == 1 && !m_type_is_byref (single->type)) {
+		MonoType *ftype = mini_get_underlying_type (single->type);
+		int falign;
+
+		switch (ftype->type) {
+		case MONO_TYPE_I1:
+		case MONO_TYPE_I2:
+		case MONO_TYPE_I4:
+			if (mono_type_size (ftype, &falign) == size)
+				*is_signed = TRUE;
+			break;
+		case MONO_TYPE_VALUETYPE:
+			return small_vtype_extension (mono_class_from_mono_type_internal (ftype), size, is_signed);
+		default:
+			break;
+		}
+	}
+
+	return size * 8;
+}
