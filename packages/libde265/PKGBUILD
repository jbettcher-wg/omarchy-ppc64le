# ppc64le: added powerpc64le to arch(). That was the only change needed.
#
# Not on the original Omarchy target list -- pulled in because Arch POWER's
# libheif 1.23.1 has an undefined reference to de265_get_security_limits, a
# symbol that does not exist in the libde265 1.0.18 that Arch POWER ships.
# Their libheif was evidently built against a newer libde265 than the one in
# the repo, so *anything* that links libheif fails at link time with
# --no-undefined. imv is where we hit it first; obs-studio, nautilus
# thumbnailers and the GNOME apps would all hit it later.
#
# Arch proper is on libde265 1.1.2, which does export the symbol. Building that
# version fixes the cause rather than working around it. This is an Arch POWER
# repo-consistency bug, not a portability bug, and it is worth reporting to
# them rather than upstream.
#
# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Contributor: James An <james@jamesan.ca>
# Contributor: Daniel Nagy <danielnagy at gmx de>

pkgname=libde265
pkgver=1.1.2
pkgrel=1
pkgdesc='Open h.265 video codec implementation'
arch=(x86_64 powerpc64le)
url='https://github.com/strukturag/libde265'
license=(LGPL-3.0-or-later)
depends=(glibc
         libgcc
         libstdc++)
makedepends=(cmake
             git
             sdl2-compat)
optdepends=('sdl2-compat: for the decoder tool')
source=(git+https://github.com/strukturag/libde265#tag=v$pkgver)
sha256sums=('e8d563369abc3a56a5747be68cf517d3cf1d2f431a39664224ca0162df96de32')

build() {
  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_ENCODER=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
