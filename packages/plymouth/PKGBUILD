# ppc64le: added powerpc64le to arch(), and made the Arch branding optional.
#
# Arch's PKGBUILD hard-codes /usr/share/pixmaps/archlinux-logo.png and
# archlinux-logo-text-dark.svg. Those files come from the `filesystem` package,
# and are not declared in makedepends because on Arch they are always present.
# Arch POWER ships filesystem at the *same version* with /usr/share/pixmaps
# empty -- no distro logo exists on this system at all, under any name.
#
# So both uses are guarded rather than removed. On Arch the build is byte-for-
# byte what it was; here, plymouth uses the fallback logo that its own meson
# option explicitly documents for an empty `logo` value, and the spinner theme
# is installed without a watermark. 26.134.222-3 guards the logo in the
# mkinitcpio initcpio_install hook too: it failed every mkinitcpio run that used
# the plymouth hook, which a fresh p9-install target does.
#
# Local packaging fix. The underlying report belongs to Arch POWER (their
# filesystem package drops branding that Arch's PKGBUILDs assume), not to
# plymouth upstream.
#
# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Taijian <taijian@posteo.de>
# Contributor: Sebastian Lau <lauseb644@gmail.com>
# Contributor: Damian01w <damian01w@gmail.com>
# Contributor: Padfoot <padfoot@exemail.com.au>

pkgname=plymouth
pkgver=26.134.222
pkgrel=3
pkgdesc='Graphical boot splash screen'
arch=(x86_64 powerpc64le)
url='https://www.freedesktop.org/wiki/Software/Plymouth/'
license=(GPL-2.0-or-later)
depends=(
  adwaita-fonts
  bash
  cairo
  filesystem
  fontconfig
  freetype2
  glib2
  glibc
  libdrm
  libevdev
  libpng
  libx11
  libxkbcommon
  pango
  systemd-libs
  xkeyboard-config
)
makedepends=(
  docbook-xsl
  git
  gtk3
  meson
)
optdepends=('gtk3: x11 renderer')
backup=(
  etc/logrotate.d/bootlog
  etc/plymouth/plymouthd.conf
)
install='plymouth.install'
source=(
  "git+https://gitlab.freedesktop.org/plymouth/$pkgname.git#tag=$pkgver"
  plymouth.initcpio_hook
  plymouth.initcpio_install
  plymouth-shutdown.initcpio_install
  50-plymouth.conf
)
b2sums=(
  5130dbb16d4634915b7f68542b6c29d664bd8c26f4508adf536833e93f2c78aee287208e88dc3bcf8298979c6f9811657ab5a30c1563b1e5307b7e886b6bffa2
  afb2449b542aa3e971eab6b953c907347fdf4e499b4140a5e6736a7c99557c0d8d2fed28dbee56d84c8c619335c59bd382457d85e51145884ad0616e9095f232
  0e2ea044c5369dfbad36e95e22f9b384239c8e4f93deaa6f833c9e2aa270455698fab787357727332f13150120ef9b05e7f30e90cd7a1b67b67af31fbe71000c
  063448411de837ed38ece935719f07fd17b18830680c9fa95b7bd39a097778186c40373590504c9b44144125986304311f528c73592c29d19043b8395e6f99c2
  5ab47942d222c311b495d056f24bdd9d08438162fef1ca6e51982fc00018acbf0c31e4c61164b40950fe2511e17ba2a4635894d145d83a9b349e5a8a83f8c026
)

prepare() {
  cd $pkgname

  # Fix default XKB keymap fallback overriding KEYMAP
  # https://gitlab.freedesktop.org/plymouth/plymouth/-/merge_requests/388
  git cherry-pick -n cea90be39d263e388003a07d125b469c0803d55c

  # Use mkinitcpio to update initrd
  sed -i 's/^dracut -f$/mkinitcpio -P/' scripts/plymouth-update-initrd

  # Change default theme
  sed -i 's/^Theme=spinner$/Theme=bgrt/' src/plymouthd.defaults

  # Switch from Cantarell to Adwaita Sans; set monospace font to Adwaita Mono
  sed -i 's/Cantarell/Adwaita Sans/
          /TitleFont=Adwaita/a MonospaceFont=Adwaita Mono 12' scripts/keymap-render.py themes/*/*.plymouth.desktop
}

build() {
  # Arch's distro branding lives in the `filesystem` package. Arch POWER ships
  # the same filesystem version with /usr/share/pixmaps empty, so these two
  # files do not exist here. Both uses are therefore made conditional rather
  # than hard-coded: on Arch the build is unchanged, and on Arch POWER plymouth
  # falls back to the logo its own meson option documents for an empty value.
  local _logo=/usr/share/pixmaps/archlinux-logo.png
  local _watermark=/usr/share/pixmaps/archlinux-logo-text-dark.svg

  if [[ -f $_logo ]]; then
    arch-meson $pkgname build -D logo="$_logo"
  else
    arch-meson $pkgname build
  fi
  meson compile -C build

  # Convert logo for the spinner theme
  if [[ -f $_watermark ]]; then
    rsvg-convert "$_watermark" -o archlinux-logo-text-dark.png
  fi
}

package() {
  meson install -C build --destdir "$pkgdir"
  rm -r "$pkgdir/run"

  # Install mkinitcpio hook
  install -Dm644 plymouth.initcpio_hook "$pkgdir/usr/lib/initcpio/hooks/$pkgname"
  install -Dm644 plymouth.initcpio_install "$pkgdir/usr/lib/initcpio/install/$pkgname"

  # Install mkinitcpio shutdown hook and systemd drop-in snippet
  install -Dm644 plymouth-shutdown.initcpio_install "$pkgdir/usr/lib/initcpio/install/$pkgname-shutdown"
  install -Dm644 50-plymouth.conf "$pkgdir/usr/lib/tmpfiles.d/50-plymouth.conf"
  
  # Install logo for the spinner theme, when the distro provided one
  if [[ -f archlinux-logo-text-dark.png ]]; then
    install -Dm644 archlinux-logo-text-dark.png "$pkgdir/usr/share/$pkgname/themes/spinner/watermark.png"
  fi
}
