# Maintainer: Jeremy Bettcher <thebettcher@gmail.com>
#
# Omarchy's LazyVim configuration, rebuilt so it is architecture-honest.
#
# Upstream ships omarchy-nvim as arch=any, but it is not: it vendors two
# x86-64 ELF binaries under etc/skel/.local/share/nvim/mason/packages --
# stylua and shfmt -- and nothing else in the 157 MB of plugin clones is
# machine code.  Those two are the entire binary surface of Omarchy's default
# editor, and both are packaged natively for this architecture, so the fix is
# to drop the vendored copies and point mason's bin/ links at the system
# binaries.  The package then really is arch=any, and the architecture
# dependence lives where it belongs: in depends=(stylua shfmt).
#
# The second change is configuration, not packaging: mason's registry has no
# ppc64le assets at all, so a drop-in disables its automatic installs and lets
# every tool resolve from $PATH.  See no-mason-downloads.lua.
#
# Upstream distributes this only as a built package (pkgs.omarchy.org has no
# PKGBUILD for it), so the source *is* the upstream package; package() unpacks
# it, swaps the two binaries and adds the drop-in.

pkgname=omarchy-nvim
pkgver=2026.8.13
pkgrel=4
pkgdesc='Pre-built LazyVim configuration with cached plugins (native tools, no mason downloads)'
arch=(any)
url='https://github.com/LazyVim/LazyVim'
license=(MIT)
makedepends=(file)
depends=(
  'neovim>=0.9.0'
  git
  shfmt
  stylua
)
optdepends=(
  'bash-language-server: LSP for shell scripts'
  'eslint: JavaScript/TypeScript linting'
  'gopls: LSP for Go'
  'lua-language-server: LSP for Lua'
  'marksman: LSP for Markdown'
  'ripgrep: snacks.nvim grep picker'
  'fd: snacks.nvim file picker'
  'taplo-cli: TOML formatting and LSP'
  'yaml-language-server: LSP for YAML'
  "rust: build blink.cmp's fuzzy matcher (falls back to the Lua one without it)"
)
conflicts=(omarchy-lazyvim)
source=("https://pkgs.omarchy.org/x86_64/${pkgname}-${pkgver}-1-any.pkg.tar.zst"
        no-mason-downloads.lua
        jit_startup.lua
        blink-cmp-build-fuzzy.lua)
noextract=("${pkgname}-${pkgver}-1-any.pkg.tar.zst")
sha256sums=('ff7cca4d58198ef6ea0c16ff93bd0369b307a40fae4ed300f6a2a75bb444fe1f'
            '2425c048171ccded73e92293501d66462a008ec7624f328e44f470a1a1067d5b'
            'f639707ccb384d0ad8a696ee4f2809a4b77995ba1ec4fee8ede45a9584adb3dc'
            '7cb7765e1732501c367113d2f31967c301a6a0c1943b8649eaf0b96ce3d946d4')

_mason=etc/skel/.local/share/nvim/mason

prepare() {
  rm -rf "${srcdir}/upstream"
  mkdir -p "${srcdir}/upstream"
  bsdtar -xf "${srcdir}/${pkgname}-${pkgver}-1-any.pkg.tar.zst" -C "${srcdir}/upstream" \
    --no-same-owner \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL
}

check() {
  # The premise of this package: exactly two foreign binaries, and they are
  # the two we replace.  If upstream ever vendors a third, fail loudly rather
  # than shipping it.
  local found expected
  found=$(find "${srcdir}/upstream" -type f -print0 \
    | xargs -0 file -N --mime-type 2>/dev/null \
    | awk -F': ' '$2 ~ /^application\/x-(pie-)?(executable|sharedlib)/ { print $1 }' \
    | sed "s|^${srcdir}/upstream/||" | sort)
  expected="${_mason}/packages/shfmt/shfmt_v3.13.1_linux_amd64
${_mason}/packages/stylua/stylua"
  if [ "$found" != "$expected" ]; then
    printf 'unexpected ELF payload in omarchy-nvim:\n%s\n' "$found" >&2
    return 1
  fi
  # And the replacements must exist on this machine.
  [ -x /usr/bin/stylua ] && [ -x /usr/bin/shfmt ]
}

package() {
  # Unpack straight into $pkgdir rather than copying the prepare() tree.
  # --no-same-owner: this tree is built unprivileged (no passwordless sudo on
  # the build host, so fakeroot's chown interception does not take effect in
  # the build namespace); makepkg assigns ownership when it creates the
  # package, exactly as for every other package in this repo.
  bsdtar -xf "${srcdir}/${pkgname}-${pkgver}-1-any.pkg.tar.zst" -C "${pkgdir}" \
    --no-same-owner \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL

  # Drop the vendored x86-64 binaries; mason's bin/ symlinks already point at
  # these paths, so pointing them at the system binaries keeps mason's own
  # view of the world consistent (its receipts still name the packages) while
  # what actually runs is the native build.
  local m="${pkgdir}/${_mason}"
  rm -f "${m}/packages/stylua/stylua" "${m}/packages/shfmt/shfmt_v3.13.1_linux_amd64"
  ln -sf /usr/bin/stylua "${m}/packages/stylua/stylua"
  ln -sf /usr/bin/shfmt "${m}/packages/shfmt/shfmt_v3.13.1_linux_amd64"

  # Turn mason's automatic installs off, in both copies of the config the
  # package owns (the /etc/skel seed and the /usr/share fallback).
  install -Dm644 "${srcdir}/no-mason-downloads.lua" \
    "${pkgdir}/etc/skel/.config/nvim/lua/plugins/no-mason-downloads.lua"
  install -Dm644 "${srcdir}/no-mason-downloads.lua" \
    "${pkgdir}/usr/share/omarchy-nvim/config/lua/plugins/no-mason-downloads.lua"

  # blink.cmp's Rust matcher: build it, do not download it (no ppc64le asset).
  # Header of the file has the reasoning; same two copies as above.
  install -Dm644 "${srcdir}/blink-cmp-build-fuzzy.lua" \
    "${pkgdir}/etc/skel/.config/nvim/lua/plugins/blink-cmp-build-fuzzy.lua"
  install -Dm644 "${srcdir}/blink-cmp-build-fuzzy.lua" \
    "${pkgdir}/usr/share/omarchy-nvim/config/lua/plugins/blink-cmp-build-fuzzy.lua"

  # Turn LuaJIT's trace compiler off for the duration of init.lua.  Startup
  # is run-once code, and compiling it costs about 20% of the time to first
  # dashboard: 173 traces and 100 aborted recordings, almost none of it
  # entered again in the session.  Measured on ppc64le (LuaJIT design doc
  # S7.6): 37.4 -> 30.4 ms by lazy.stats().startuptime, with every JIT-bound
  # workload unchanged.  The reasoning is architecture-neutral -- it is
  # LuaJIT's compiler, not the backend -- it is simply visible here because
  # this is where it was measured.
  local d
  for d in "${pkgdir}/etc/skel/.config/nvim" \
           "${pkgdir}/usr/share/omarchy-nvim/config"; do
    install -Dm644 "${srcdir}/jit_startup.lua" "${d}/lua/config/jit_startup.lua"
    # Upstream's init.lua is exactly a comment plus the require.  Fail the
    # build if it ever stops being that, rather than silently rewriting
    # something else.
    grep -qx 'require("config.lazy")' "${d}/init.lua"
    cat > "${d}/init.lua" <<'INIT'
-- bootstrap lazy.nvim, LazyVim and your plugins
local ljit = require("config.jit_startup")
ljit.off()
require("config.lazy")
ljit.on()
INIT
  done
}
