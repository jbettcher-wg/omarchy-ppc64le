+//! C calling convention classification for the 64-bit PowerPC ELF V2 ABI
+//! (powerpc64le-linux). Follows clang's PPC64_SVR4_ABIInfo for the ELFv2 kind
+//! (clang/lib/CodeGen/Targets/PPC.cpp), which is what GCC and rustc also do.
+
+const std = @import("std");
+const assert = std.debug.assert;
+const Type = @import("../../Type.zig");
+const Zcu = @import("../../Zcu.zig");
+
+pub const Context = enum { ret, arg };
+
+pub const Class = union(enum) {
+    /// Passed or returned as its own LLVM type: integers up to 128 bits, floats,
+    /// pointers, enums, packed containers and 128-bit vectors.
+    byval,
+    /// An integer as wide as the type: aggregates of at most 8 bytes, and
+    /// vectors narrower than 128 bits.
+    abi_sized_int,
+    /// Homogeneous floating-point or vector aggregate with this many members,
+    /// lowered as `[n x base]` (see `homogeneousAggregate`). Arguments go in
+    /// f1-f13 or v2-v13, return values in f1-f8 or v2-v9.
+    float_array: u8,
+    /// Argument only: an aggregate of 9 to 64 bytes, lowered as an array of
+    /// `len` integers of `bits` bits (64, or 128 when the aggregate is aligned
+    /// to 16 bytes or more). The array may be larger than the aggregate.
+    int_array: IntArray,
+    /// Return value only: an aggregate of 9 to 16 bytes, in r3 and r4.
+    double_integer,
+    /// Argument only: an aggregate larger than 64 bytes or an integer wider
+    /// than 128 bits, copied into the parameter save area (LLVM `byval`).
+    memory_byval,
+    /// Argument: a vector wider than 128 bits, passed as a pointer to a copy.
+    /// Return value: anything returned through a hidden pointer in r3.
+    memory,
+};
+
+pub const IntArray = struct { len: u8, bits: u8 };
+
+/// Most members a homogeneous aggregate may have; each member takes one
+/// floating-point or vector register.
+const max_hfa_members = 8;
+
+pub fn classifyType(ty: Type, zcu: *Zcu, ctx: Context) Class {
+    assert(ty.hasRuntimeBits(zcu));
+    switch (ty.zigTypeTag(zcu)) {
+        .int, .@"enum" => {
+            if (ty.intInfo(zcu).bits > 128) return switch (ctx) {
+                .arg => .memory_byval,
+                .ret => .memory,
+            };
+            return .byval;
+        },
+        .bool, .error_set, .float, .pointer, .optional => return .byval,
+        .vector => {
+            const bits = ty.bitSize(zcu);
+            if (bits > 128) return .memory;
+            if (bits == 128 or ty.childType(zcu).zigTypeTag(zcu) == .bool) return .byval;
+            if (ty.abiSize(zcu) * 8 != bits) return .byval;
+            return .abi_sized_int;
+        },
+        .@"struct", .@"union" => {
+            if (ty.containerLayout(zcu) == .@"packed") return .byval;
+            return classifyAggregate(ty, zcu, ctx);
+        },
+        .array => return classifyAggregate(ty, zcu, ctx),
+        else => unreachable,
+    }
+}
+
+fn classifyAggregate(ty: Type, zcu: *Zcu, ctx: Context) Class {
+    if (homogeneousAggregate(ty, zcu)) |hfa| return .{ .float_array = hfa.count };
+    const size = ty.abiSize(zcu);
+    if (size <= 8) return .abi_sized_int;
+    switch (ctx) {
+        .ret => return if (size <= 16) .double_integer else .memory,
+        .arg => {
+            if (size > 64) return .memory_byval;
+            // Aggregates aligned to 16 bytes or more are passed as 128-bit
+            // words, which LLVM aligns to an even parameter word.
+            const word_bytes: u64 = if (ty.abiAlignment(zcu).compare(.gte, .@"16")) 16 else 8;
+            return .{ .int_array = .{
+                .len = @intCast(std.math.divCeil(u64, size, word_bytes) catch unreachable),
+                .bits = @intCast(word_bytes * 8),
+            } };
+        },
+    }
+}
+
+pub const HomogeneousAggregate = struct {
+    /// `f32`, `f64`, `f128` or a 128-bit vector type.
+    base: Type,
+    count: u8,
+};
+
+/// A struct, union or array whose members, after flattening nested structs,
+/// unions and arrays, all have the same floating-point type, or are all
+/// 128-bit vectors, with no padding and at most 8 members.
+pub fn homogeneousAggregate(ty: Type, zcu: *Zcu) ?HomogeneousAggregate {
+    var base: ?Type = null;
+    const count = countMembers(ty, zcu, &base) orelse return null;
+    const base_ty = base orelse return null;
+    if (count == 0 or count > max_hfa_members) return null;
+    if (base_ty.abiSize(zcu) * count != ty.abiSize(zcu)) return null;
+    return .{ .base = base_ty, .count = @intCast(count) };
+}
+
+fn countMembers(ty: Type, zcu: *Zcu, base: *?Type) ?u64 {
+    const ip = &zcu.intern_pool;
+    switch (ty.zigTypeTag(zcu)) {
+        .@"struct" => {
+            if (ty.containerLayout(zcu) == .@"packed") return null;
+            var count: u64 = 0;
+            for (0..ty.structFieldCount(zcu)) |field_index| {
+                const field_ty = ty.fieldType(field_index, zcu);
+                if (!field_ty.hasRuntimeBits(zcu)) continue;
+                count += countMembers(field_ty, zcu, base) orelse return null;
+                if (count > max_hfa_members) return null;
+            }
+            return count;
+        },
+        .@"union" => {
+            if (ty.containerLayout(zcu) == .@"packed") return null;
+            const union_obj = zcu.typeToUnion(ty).?;
+            var count: u64 = 0;
+            for (union_obj.field_types.get(ip)) |field_ty_index| {
+                const field_ty: Type = .fromInterned(field_ty_index);
+                if (!field_ty.hasRuntimeBits(zcu)) continue;
+                count = @max(count, countMembers(field_ty, zcu, base) orelse return null);
+            }
+            return count;
+        },
+        .array => {
+            const len = ty.arrayLen(zcu);
+            if (len == 0) return null;
+            const elem_count = countMembers(ty.childType(zcu), zcu, base) orelse return null;
+            return std.math.mul(u64, elem_count, len) catch null;
+        },
+        .float => switch (ty.floatBits(zcu.getTarget())) {
+            32, 64, 128 => return matchBase(ty, zcu, base),
+            else => return null,
+        },
+        .vector => {
+            if (ty.bitSize(zcu) != 128 or ty.childType(zcu).zigTypeTag(zcu) == .bool) return null;
+            return matchBase(ty, zcu, base);
+        },
+        else => return null,
+    }
+}
+
+/// Floating-point members must all be the same type. Vector members only need
+/// the same size (clang treats all 128-bit vectors as one base type).
+fn matchBase(ty: Type, zcu: *Zcu, base: *?Type) ?u64 {
+    const base_ty = base.* orelse {
+        base.* = ty;
+        return 1;
+    };
+    const is_vector = ty.zigTypeTag(zcu) == .vector;
+    if ((base_ty.zigTypeTag(zcu) == .vector) != is_vector) return null;
+    if (base_ty.abiSize(zcu) != ty.abiSize(zcu)) return null;
+    return 1;
+}
