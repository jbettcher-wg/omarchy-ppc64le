pkgbase=qt6-base
pkgname=(qt6-base
         qt6-xcb-private-headers)
_pkgver=6.11.2
pkgver=${_pkgver/-/}
pkgrel=4
# powerpc64le added to arch=(): upstream Arch ships x86_64 only, and
# libalpm enforces the guard itself, so no makepkg flag gets past it.
# Every previous build of this recipe here went through `bq --fix-arch`,
# which patches the copy in the build tree and leaves the recipe wrong --
# so a plain `bq build qt6-base` failed with arch-gate. Portability fix,
# upstreamable to Arch POWER as-is; nothing else in this recipe needed
# changing for the architecture.
arch=(x86_64 powerpc64le)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='A cross-platform application and UI framework'
depends=(brotli
         dbus
         double-conversion
         fontconfig
         freetype2
         glib2
         glibc
         harfbuzz
         icu
         krb5
         libb2
         libcups
         libdrm
         libgcc
         libgl
         libice
         libinput
         libjpeg-turbo
         libpng
         libproxy
         libsm
         libstdc++
         liburing
         libx11
         libxcb
         libxkbcommon
         libxkbcommon-x11
         md4c
         mesa
         mtdev
         openssl
         pcre2
         shared-mime-info
         sqlite
         systemd-libs
         tslib
         wayland
         xcb-util-cursor
         xcb-util-image
         xcb-util-keysyms
         xcb-util-renderutil
         xcb-util-wm
         xdg-utils
         zlib
         zstd)
makedepends=(alsa-lib
             cmake
             cups
             freetds
             git
             gst-plugins-base-libs
             gtk3
             jemalloc
             libpulse
             mariadb-libs
             ninja
             postgresql
             unixodbc
             vulkan-headers
             xmlstarlet)
optdepends=('freetds: MS SQL driver'
            'gdk-pixbuf2: GTK platform plugin'
            'gtk3: GTK platform plugin'
            'mariadb-libs: MariaDB driver'
            'pango: GTK platform plugin'
            'perl: for syncqt'
            'postgresql-libs: PostgreSQL driver'
            'unixodbc: ODBC driver')
groups=(qt6)
_pkgfn=${pkgbase/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#tag=v$_pkgver
        qt6-base-cflags.patch
        qt6-base-nostrip.patch)
sha256sums=('c27a588094ea6d47f294539dbab00a7222d9f56e2d44ac00287bb44b5eed612a'
            '5411edbe215c24b30448fac69bd0ba7c882f545e8cf05027b2b6e2227abc5e78'
            '4b93f6a79039e676a56f9d6990a324a64a36f143916065973ded89adc621e094')

prepare() {
  patch -d $_pkgfn -p1 < qt6-base-cflags.patch # Use system CFLAGS
  patch -d $_pkgfn -p1 < qt6-base-nostrip.patch # Don't strip binaries with qmake

  git -C $_pkgfn cherry-pick -n e80e3f0cebae9c3a45a1b7ce81d6454c699d89c6 # Fix icon theming regression
}

build() {
  # Set no_direct_extern_access based on architecture.
  # -mno-direct-extern-access / -fno-direct-access-external-data is x86-only.
  # The upstream form allow-listed the non-x86 arches someone thought of and
  # defaulted everything else to ON, so powerpc64le fell through to the x86
  # branch, the compiler test failed, and forcing the feature ON aborted
  # configure. Gate on the architecture that actually has the flag.
  if [[ $CARCH == "x86_64" ]]; then
    _no_direct_extern_access=ON
  else
    _no_direct_extern_access=OFF
  fi

  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DINSTALL_BINDIR=lib/qt6/bin \
    -DINSTALL_PUBLICBINDIR=bin \
    -DINSTALL_LIBEXECDIR=lib/qt6 \
    -DINSTALL_DOCDIR=share/doc/qt6 \
    -DINSTALL_ARCHDATADIR=lib/qt6 \
    -DINSTALL_DATADIR=share/qt6 \
    -DINSTALL_INCLUDEDIR=include/qt6 \
    -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
    -DINSTALL_EXAMPLESDIR=share/doc/qt6/examples \
    -DFEATURE_journald=ON \
    -DFEATURE_libproxy=ON \
    -DFEATURE_openssl_linked=ON \
    -DFEATURE_system_sqlite=ON \
    -DFEATURE_system_xcb_xinput=ON \
    -DFEATURE_no_direct_extern_access=$_no_direct_extern_access \
    -DFEATURE_mimetype_database=OFF \
    -DFEATURE_openssl_hash=ON \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS
  cmake --build build
}

package_qt6-base() {
  pkgdesc='A cross-platform application and UI framework'
  depends+=(qt6-translations)
  DESTDIR="$pkgdir" cmake --install build

  # QtBuildInternalsExtra.cmake records QT_SOURCE_TREE as the absolute path of
  # this build's source tree ($srcdir/qtbase). Nothing at that path exists on an
  # installed system -- but it is not inert either. Qt6BuildInternalsConfig.cmake
  # does `if(EXISTS "${QT_SOURCE_TREE}/cmake")` and PREPENDS that directory to
  # CMAKE_MODULE_PATH for every downstream qt6 module build (qt6-declarative,
  # qt6-webengine, ...), and five more helpers prefer files under it over the
  # installed ones. So on any machine where that path happens to exist -- a
  # later qt6-base build in the same buildroot -- a module build would silently
  # load a stale qtbase's CMake. The published 6.11.2-3 ships
  # "/var/tmp/qt6t/build/qt6-base/src/qtbase" here; elf-pathguard caught it
  # on -4.
  #
  # Emptied rather than deleted, so the cache entry still exists and every
  # EXISTS check above resolves to the installed files. Building qtbase itself
  # is unaffected: QtBuildHelpers.cmake sets QT_SOURCE_TREE with FORCE from
  # QtBase_SOURCE_DIR. Local workaround; the upstreamable form is for Qt not to
  # write the variable into an installed file at all.
  local _extra="$pkgdir"/usr/lib/cmake/Qt6BuildInternals/QtBuildInternalsExtra.cmake
  sed -i -E 's|^(set\(QT_SOURCE_TREE )"[^"]*"|\1""|' "$_extra"
  # Fail here, by name, if the line format ever changes and the sed misses --
  # rather than leaving it to the guard's generic message after packaging.
  if grep -qF "$srcdir" "$_extra"; then
    error "QT_SOURCE_TREE still records the build tree in ${_extra#$pkgdir}"
    return 1
  fi

  install -Dm644 $_pkgfn/LICENSES/* -t "$pkgdir"/usr/share/licenses/$pkgbase
}

package_qt6-xcb-private-headers() {
  pkgdesc='Private headers for Qt6 Xcb'

  depends=("qt6-base=$pkgver")
  optdepends=()
  groups=()

  cd $_pkgfn
  install -d -m755 "$pkgdir"/usr/include/qt6xcb-private/gl_integrations
  cp -r src/plugins/platforms/xcb/*.h "$pkgdir"/usr/include/qt6xcb-private/
  cp -r src/plugins/platforms/xcb/gl_integrations/*.h "$pkgdir"/usr/include/qt6xcb-private/gl_integrations/
}
