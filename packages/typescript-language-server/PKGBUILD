# ppc64le: arch=any JavaScript; needs only a working node, which Arch POWER
# has, plus the pnpm this repo now builds. One change from Arch upstream: the
# node_modules prune in package() is gone. It was not an architecture problem --
#
#   npm error Cannot read properties of null (reading 'edgesOut')
#   at #loadPeerSet (.../arborist/lib/arborist/build-ideal-tree.js:1300:38)
#
# npm 11.4.1's arborist crashes building the peer-dependency graph for this
# project's devDependencies, and it does so before --omit=dev can spare it the
# work. The step was dead weight regardless: this package.json declares no
# runtime `dependencies` at all -- rollup bundles everything into lib/cli.mjs,
# whose only imports are node builtins -- and package() copies just lib and
# package.json, never node_modules. So the prune reinstalled nothing into a
# directory that was never shipped.
#
# Maintainer: Daniel M. Capella <polyzen@archlinux.org>

pkgname=typescript-language-server
pkgver=6.0.0
pkgrel=1
pkgdesc='Language Server Protocol (LSP) implementation for TypeScript using tsserver'
url=https://github.com/typescript-language-server/typescript-language-server
arch=(any)
license=(
  Apache-2.0
  MIT
)
depends=(typescript)
makedepends=(
  git
  jq
  pnpm
)
source=("git+$url.git#tag=v$pkgver")
b2sums=('922af6a0ea5bf4be5265c0584a681a1f45c55eb6de9ca707e97b1b4d9706f708bf56c47927b13af9dabdbebb53ba2f10d13031dfb2fb8a624d3ba7a744e412f1')

prepare() {
  cd $pkgname
  pnpm install --frozen-lockfile
}

build() {
  cd $pkgname
  pnpm build # Needs bin links
}

check() {
  cd $pkgname
  pnpm test:commit
}

package() {
  local mod_dir=/usr/lib/node_modules/$pkgname

  install -d "$pkgdir"/{usr/bin,$mod_dir}
  ln -s $mod_dir/lib/cli.mjs "$pkgdir"/usr/bin/$pkgname

  cd $pkgname
  cp -r lib package.json "$pkgdir"/$mod_dir
  chmod +x "$pkgdir"/$mod_dir/lib/cli.mjs
  install -Dm644 -t "$pkgdir"/usr/share/doc/$pkgname {CHANGELOG,README}.md
  install -Dm644 -t "$pkgdir"/usr/share/licenses/$pkgname LICENSE
}
