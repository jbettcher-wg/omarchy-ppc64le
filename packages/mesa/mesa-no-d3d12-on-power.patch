# Drops the d3d12 gallium driver and the dzn (microsoft-experimental) Vulkan
# driver on every architecture except x86_64, and with them the directx-headers
# makedepend and the vulkan-dzn split package.
#
# UPSTREAMABLE to Arch POWER as-is. This is a plain bug in the shipped PKGBUILD:
# arch=(x86_64 powerpc64le powerpc64 powerpc espresso), but the powerpc64le
# branch of the build() case lists d3d12, and microsoft-experimental sits in the
# unconditional vulkan-drivers list -- so all four non-x86_64 arches require
# directx-headers, which is not built for any of them. The build fails in
# prepare()/build() looking for it.
#
# Both drivers are Windows/D3D12 interop. They are meaningless on POWER.
#
# Three things have to move together, which is why the obvious one-line fix
# doesn't work:
#   1. -D gallium-drivers / -D vulkan-drivers  (the actual build config)
#   2. makedepends                             (directx-headers -> _x86_64)
#   3. the vulkan-dzn split package + its _pick lines -- _pick uses `mv`, so a
#      missing libvulkan_dzn.so fails package_mesa() rather than being skipped.
#
# Apply with: patch -p0 -i mesa-no-d3d12-on-power.patch PKGBUILD
--- PKGBUILD
+++ PKGBUILD.new
@@ -9,7 +9,6 @@
 pkgname=(
   mesa
   opencl-mesa
-  vulkan-dzn
   vulkan-gfxstream
   vulkan-nouveau
   vulkan-radeon
@@ -19,6 +18,13 @@
   vulkan-mesa-layers
   mesa-docs
 )
+
+# The d3d12 gallium driver and the dzn (microsoft-experimental) Vulkan driver
+# are Windows/D3D12 interop and need directx-headers, which is not built for
+# this architecture -- and is meaningless on it. x86_64 only.
+if [[ $CARCH == x86_64 ]]; then
+  pkgname+=(vulkan-dzn)
+fi
 case "${CARCH}" in
   powerpc64le|x86_64)
     pkgname+=(vulkan-intel)
@@ -34,7 +40,6 @@
 license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
 makedepends=(
   clang
-  directx-headers
   expat
   glibc
   libdisplay-info
@@ -89,6 +94,7 @@
   python-sphinx
   python-sphinx-hawkmoth
 )
+makedepends_x86_64=(directx-headers)  # d3d12 / dzn only
 options=(
   # GCC 14 LTO causes segfault in LLVM under si_llvm_optimize_module
   # https://gitlab.freedesktop.org/mesa/mesa/-/issues/11140
@@ -249,16 +255,16 @@
 build() {
   case "${CARCH}" in
     x86_64)
-      _platform_vulkan_drivers=',iris,intel_hasvk'
+      _platform_vulkan_drivers=',iris,intel_hasvk,microsoft-experimental'
       _platform_gallium_drivers=',crocus,i915,iris,zink,d3d12'
     ;;
     powerpc64le)
       _platform_vulkan_drivers=',intel'
-      _platform_gallium_drivers=',i915,iris,zink,d3d12'
+      _platform_gallium_drivers=',i915,iris,zink'
     ;;
     *)
       _platform_vulkan_drivers=''
-      _platform_gallium_drivers=',zink,d3d12'
+      _platform_gallium_drivers=',zink'
     ;;
   esac
 
@@ -278,7 +284,7 @@
     -D microsoft-clc=disabled
     -D valgrind=enabled
     -D video-codecs=all
-    -D vulkan-drivers=amd,nouveau,swrast,virtio,microsoft-experimental,gfxstream${_platform_vulkan_drivers}
+    -D vulkan-drivers=amd,nouveau,swrast,virtio,gfxstream${_platform_vulkan_drivers}
     -D vulkan-layers=device-select,intel-nullhw,overlay,screenshot,anti-lag,vram-report-limit
     -D vulkan-loader-rpath=
     -D vulkan-manifest-per-architecture=false
@@ -370,10 +376,12 @@
     _pick opencl $libdir/libRusticlOpenCL*
     _pick opencl etc/OpenCL/vendors/rusticl.icd
 
-    _pick vkd3d12 $libdir/libvulkan_dzn.so
-    _pick vkd3d12 $libdir/libspirv_to_dxil.*
-    _pick vkd3d12 usr/bin/spirv2dxil
-    _pick vkd3d12 usr/share/vulkan/icd.d/dzn_icd.json
+    if [[ $CARCH == x86_64 ]]; then
+      _pick vkd3d12 $libdir/libvulkan_dzn.so
+      _pick vkd3d12 $libdir/libspirv_to_dxil.*
+      _pick vkd3d12 usr/bin/spirv2dxil
+      _pick vkd3d12 usr/share/vulkan/icd.d/dzn_icd.json
+    fi
 
     _pick vkgfxstr $libdir/libvulkan_gfxstream.so
     _pick vkgfxstr usr/share/vulkan/icd.d/gfxstream_vk_icd.json
