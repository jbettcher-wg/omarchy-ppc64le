# zig0.15 -- zig 0.15.2 as a versioned build tool beside the repo's zig 0.16.
#
# Started from Arch's zig packaging at tag 0.15.2-3 (the last 0.15 release
# Arch shipped). Why it exists: herdr's vendored libghostty-vt has a comptime
# requireZig() that rejects any zig whose minor version is not 0.15, and zig
# 0.15.x pins LLVM 20, so this builds against packages/llvm20, clang20 and
# lld20.
#
# Changes from Arch's recipe (local packaging, nothing to send upstream):
#  * pkgname zig0.15. Installed under /usr/lib/zig0.15 (bin/zig, lib/zig) with
#    a /usr/bin/zig-0.15 symlink, so it owns nothing that zig 0.16 owns and
#    conflicts with nothing. zig locates its lib dir from its resolved
#    executable path, so the symlink works. Use it as ZIG=/usr/bin/zig-0.15.
#  * arch=() gains powerpc64le.
#  * lib32-glibc moves to checkdepends_x86_64; it does not exist on ppc64le.
#  * ZIG_TARGET_MCPU follows makepkg.conf's -mcpu=powerN on powerpc64le (pwr9
#    here, pwr8 for a POWER8 build); x86_64 keeps baseline. As in packages/zig.
#  * CMAKE_PREFIX_PATH=/usr/lib/llvm20 as a cache variable, so Findclang and
#    Findlld cannot pick up the host's clang/lld 22 through bq's
#    CMAKE_PREFIX_PATH=/usr environment. As in packages/zig.
#  * ZIG_GLOBAL_CACHE_DIR / ZIG_LOCAL_CACHE_DIR under $srcdir, so the build
#    writes nothing into ~/.cache/zig. As in packages/zig.
#  * zig2-function-sections-powerpc.patch: zig2.c's single .text section is
#    larger than a PowerPC relative branch reaches (+/-32 MiB), and GNU as
#    fails with "operand out of range". Backports zig 0.16.0's CMakeLists
#    block that builds zig1/zig2 with -ffunction-sections -fdata-sections on
#    powerpc/arm hosts (plus -fno-strict-aliasing). Portability fix already
#    upstream in 0.16; see the patch header.
#
# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Arch zig recipe: Daurnimator <daurnimator@archlinux.org>
# Contributor: Marc Tiehuis <marctiehuis@gmail.com>

pkgname=zig0.15
_zigname=zig
pkgver=0.15.2
pkgrel=1
pkgdesc='a general-purpose programming language and toolchain (version 0.15, installed as zig-0.15)'
arch=('x86_64' 'powerpc64le')
url='https://ziglang.org/'
license=('MIT')
options=('!lto')
depends=('clang20' 'lld20' 'llvm20-libs')
makedepends=('cmake' 'llvm20')
checkdepends_x86_64=('lib32-glibc')
source=("https://ziglang.org/download/$pkgver/$_zigname-$pkgver.tar.xz"
        "skip-localhost-test.patch"
        "skip-futex2-test.patch"
        "zig2-function-sections-powerpc.patch")
sha256sums=('d9b30c7aa983fcff5eed2084d54ae83eaafe7ff3a84d8fb754d854165a6e521c'
            'eeb5f0f72035c52bf558ffc77a171a3ddf93eac7d663ef0c82826007763717a8'
            'eb30e0eb00e6ced4c99383f0658a0351f42882e303300ed1828d162d27171cd0'
            '58836f0bcf1dfc76f67d7abb7e8a65d7625c2afbc2e042f32994cf418f844f41')

_prefix=/usr/lib/zig0.15

_zigcache() {
    export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"
    export ZIG_LOCAL_CACHE_DIR="$srcdir/zig-local-cache"
}

prepare() {
    cd "$_zigname-$pkgver"

    patch -p1 -i ../skip-localhost-test.patch
    patch -p1 -i ../skip-futex2-test.patch
    patch -p1 -i ../zig2-function-sections-powerpc.patch
}

build() {
    cd "$_zigname-$pkgver"
    _zigcache

    local _mcpu=baseline
    if [[ $CARCH == powerpc64le && $CFLAGS =~ -mcpu=power([0-9]+) ]]; then
        _mcpu=pwr${BASH_REMATCH[1]}
    fi

    local cmake_vars=(
        CMAKE_INSTALL_PREFIX=$_prefix
        CMAKE_PREFIX_PATH=/usr/lib/llvm20

        # The zig CMakeLists uses build type Debug if not set
        # override it back to None so makepkg env vars are respected
        CMAKE_BUILD_TYPE=None

        ZIG_PIE=ON
        ZIG_SHARED_LLVM=ON
        ZIG_USE_LLVM_CONFIG=ON

        ZIG_TARGET_TRIPLE=native-linux.6.6-gnu.2.40
        ZIG_TARGET_MCPU=$_mcpu
    )
    cmake -B build "${cmake_vars[@]/#/-D}" .
    cmake --build build
}

check() {
    cd "$_zigname-$pkgver"
    _zigcache
    # ugly workaround until test target is provided
    # https://github.com/ziglang/zig/issues/14240
    DESTDIR="./testinstall" cmake --install build
    ./testinstall$_prefix/bin/zig build test -Dconfig_h=build/config.h \
      -Dstatic-llvm=false \
      -Denable-llvm=true \
      -Dskip-non-native=true
}

package() {
    cd "$_zigname-$pkgver"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    DESTDIR="$pkgdir" cmake --install build

    install -d "$pkgdir/usr/bin"
    ln -s "$_prefix/bin/zig" "$pkgdir/usr/bin/zig-0.15"
}
