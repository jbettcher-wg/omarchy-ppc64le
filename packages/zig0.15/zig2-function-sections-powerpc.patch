Build zig1/zig2 with -ffunction-sections -fdata-sections on powerpc and arm
hosts, and with -fno-strict-aliasing.

zig2.c, the C translation of the compiler that the CMake bootstrap compiles
at -O0, is large enough that its single .text section exceeds the +/-32 MiB
reach of a PowerPC relative branch. GNU as then fails on thousands of
intra-object branches:
  Error: operand out of range (0xfffffffffda36f1c is not between
  0xfffffffffe000000 and 0x1fffffc)
With one section per function those branches become relocations and the
linker inserts long-branch stubs.

Backport of zig 0.16.0's CMakeLists.txt, which carries exactly this block
(including -fno-strict-aliasing for zig1/zig2); zig 0.15.2 predates it.
Portability fix already upstream; nothing to send.

--- a/CMakeLists.txt	2026-09-13 14:27:10.076584942 -0600
+++ b/CMakeLists.txt	2026-09-13 14:27:10.090326700 -0600
@@ -792,8 +792,13 @@
   set(ZIG2_LINK_FLAGS "/STACK:16777216 /FORCE:MULTIPLE")
 else()
   set(ZIG_WASM2C_COMPILE_FLAGS "-std=c99 -O2")
-  set(ZIG1_COMPILE_FLAGS "-std=c99 -Os")
-  set(ZIG2_COMPILE_FLAGS "-std=c99 -O0 -fno-sanitize=undefined -fno-stack-protector")
+  set(ZIG1_COMPILE_FLAGS "-std=c99 -Os -fno-strict-aliasing")
+  set(ZIG2_COMPILE_FLAGS "-std=c99 -O0 -fno-sanitize=undefined -fno-stack-protector -fno-strict-aliasing")
+  # Must match the condition in build.zig.
+  if(ZIG_HOST_TARGET_ARCH MATCHES "^(arm|thumb)(eb)?$" OR ZIG_HOST_TARGET_ARCH MATCHES "^powerpc(64)?(le)?$")
+    set(ZIG1_COMPILE_FLAGS "${ZIG1_COMPILE_FLAGS} -ffunction-sections -fdata-sections")
+    set(ZIG2_COMPILE_FLAGS "${ZIG2_COMPILE_FLAGS} -ffunction-sections -fdata-sections")
+  endif()
   if(APPLE)
     set(ZIG2_LINK_FLAGS "-Wl,-stack_size,0x10000000")
   elseif(MINGW)
