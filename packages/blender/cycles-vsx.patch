diff -ruN -x obj a/intern/cycles/util/optimization.h b/intern/cycles/util/optimization.h
--- a/intern/cycles/util/optimization.h	2026-02-09 18:22:40.000000000 -0700
+++ b/intern/cycles/util/optimization.h	2026-09-10 21:54:11.229911480 -0600
@@ -42,6 +42,20 @@
 #    define __KERNEL_SSE3__
 #    define __KERNEL_SSE42__
 
+/* PowerPC64 VSX
+ *
+ * Compile a SSE4.2 kernel through the compiler's SSE-on-VSX compatibility
+ * headers (GCC >= 8, clang). All the SSE code is shared; __KERNEL_VSX__
+ * marks the few places that differ. */
+
+#  elif defined(__powerpc64__) && defined(__VSX__) && defined(WITH_SSE2VSX)
+
+#    define __KERNEL_VSX__
+#    define __KERNEL_SSE__
+#    define __KERNEL_SSE2__
+#    define __KERNEL_SSE3__
+#    define __KERNEL_SSE42__
+
 #  endif
 
 #endif
diff -ruN -x obj a/intern/cycles/util/simd.h b/intern/cycles/util/simd.h
--- a/intern/cycles/util/simd.h	2026-02-08 22:15:57.000000000 -0700
+++ b/intern/cycles/util/simd.h	2026-09-10 21:54:11.230245225 -0600
@@ -25,6 +25,38 @@
 #elif defined(__KERNEL_NEON__)
 #  define SSE2NEON_PRECISE_MINMAX 1
 #  include <sse2neon.h>
+#elif defined(__KERNEL_VSX__)
+/* GCC and clang implement SSE..SSE4.2 on VSX in these headers. They refuse to
+ * compile unless the port is acknowledged with NO_WARN_X86_INTRINSICS. */
+#  ifndef NO_WARN_X86_INTRINSICS
+#    define NO_WARN_X86_INTRINSICS 1
+#  endif
+#  include <mmintrin.h>
+#  include <xmmintrin.h>
+#  include <emmintrin.h>
+#  include <pmmintrin.h>
+#  include <tmmintrin.h>
+#  include <smmintrin.h>
+#  include <nmmintrin.h>
+
+/* The one SSE4.1 intrinsic Cycles uses that the compatibility headers do not
+ * provide. imm8 is a constant at every call site, so the masks fold. */
+static inline __m128 __attribute__((always_inline))
+_mm_dp_ps(const __m128 a, const __m128 b, const int imm8)
+{
+  const __m128 in_mask = _mm_castsi128_ps(_mm_set_epi32((imm8 & 0x80) ? -1 : 0,
+                                                        (imm8 & 0x40) ? -1 : 0,
+                                                        (imm8 & 0x20) ? -1 : 0,
+                                                        (imm8 & 0x10) ? -1 : 0));
+  const __m128 out_mask = _mm_castsi128_ps(_mm_set_epi32((imm8 & 0x08) ? -1 : 0,
+                                                         (imm8 & 0x04) ? -1 : 0,
+                                                         (imm8 & 0x02) ? -1 : 0,
+                                                         (imm8 & 0x01) ? -1 : 0));
+  __m128 m = _mm_and_ps(_mm_mul_ps(a, b), in_mask);
+  m = _mm_hadd_ps(m, m);
+  m = _mm_hadd_ps(m, m);
+  return _mm_and_ps(m, out_mask);
+}
 #endif
 
 /* Floating Point Control, for Embree. */
@@ -392,6 +424,50 @@
 }
 #  endif
 
+#elif defined(__GNUC__) || defined(__clang__)
+/* Intrinsic functions from compiler builtins (POWER, ARM, ...). Same results
+ * as the x86 assembly above, including __btc complementing the bit. */
+
+__forceinline uint32_t __bsf(const uint32_t v)
+{
+  return __builtin_ctz(v);
+}
+
+__forceinline uint32_t __bsr(const uint32_t v)
+{
+  return 31 - __builtin_clz(v);
+}
+
+__forceinline uint32_t __btc(const uint32_t v, const uint32_t i)
+{
+  return v ^ (1U << i);
+}
+
+__forceinline uint64_t __bsf(const uint64_t v)
+{
+  return __builtin_ctzll(v);
+}
+
+__forceinline uint64_t __bsr(const uint64_t v)
+{
+  return 63 - __builtin_clzll(v);
+}
+
+__forceinline uint64_t __btc(const uint64_t v, const uint64_t i)
+{
+  return v ^ (1ULL << i);
+}
+
+__forceinline uint32_t bitscan(const uint32_t v)
+{
+  return __builtin_ctz(v);
+}
+
+__forceinline uint64_t bitscan(const uint64_t v)
+{
+  return __builtin_ctzll(v);
+}
+
 #else
 /* Intrinsic functions fallback for arbitrary processor. */
 __forceinline uint32_t __bsf(const uint32_t x)
