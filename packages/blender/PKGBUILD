prepare() {
  cd "$pkgname-$pkgver"

  # Arch POWER ships ffmpeg 9 (libavcodec 62): AVCodec::sample_fmts is gone.
  # Arch's own fix, from the blender 5.2.1 recipe.
  patch -Np1 -i "$srcdir"/ffmpeg-9.patch

  # Cycles' CPU kernel on VSX: native, or the SSE kernel through GCC's
  # x86-intrinsic compatibility headers.  See README.md and the patch header.
  patch -Np1 -i "$srcdir"/cycles-vsx.patch

  # Cycles and the compositor gate OIDN on an x86 cpuid SSE4.2 probe, which
  # is always false here; without this the linked denoiser stays hidden.
  patch -Np1 -i "$srcdir"/oidn-ppc64le-supported.patch

  # Cycles lists the CPU as "Unknown CPU": it reads "model name" from
  # /proc/cpuinfo, which POWER lacks.  Name it "IBM POWER9 (VSX)".
  patch -Np1 -i "$srcdir"/cycles-power-cpu-name.patch

  # TODO Dirty hack / workaround to fix faulty manpage generation.. arguably an upstream issue.
  # https://gitlab.archlinux.org/archlinux/packaging/packages/blender/-/issues/19
  sed -i "/blender_help = subprocess/i\    blender_env = {\"LD_LIBRARY_PATH\": \"${pkgdir}/usr/share/blender/lib\"}" \
    doc/manpage/blender.1.py
}

# ppc64le: which Cycles CPU kernel (cycles-vsx.patch, README.md):
#   native  the 4-wide kernel written on VSX (default)
#   sse     the x86 SSE4.2 kernel through GCC's SSE-on-VSX compat headers
#   scalar  no SIMD kernel
# Output parity of all three is verified; render speed is not yet measured
# on an idle machine.
_cycles_vsx=native

_get_pyver() {
  python -c 'import sys; print(str(sys.version_info[0]) + "." + str(sys.version_info[1]))'
}

build() {
  # This should fix #13.
  export CXXFLAGS=${CXXFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS/}
  CXXFLAGS+=' --param=max-vartrack-size=640000000'

  local cmake_options=(
    -B build
    -C "$pkgname-$pkgver/build_files/cmake/config/blender_release.cmake"
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    # ppc64le: mold 2.x cannot parse GCC 16's libatomic_asneeded.so linker
    # script ("INPUT ( AS_NEEDED ( -latomic ) )" -> "library not found:
    # AS_NEEDED"); every link fails.  Use the default ld.
    -D WITH_LINKER_MOLD=OFF
    -D PYTHON_VERSION="$(_get_pyver)"
    -D WITH_INSTALL_PORTABLE=OFF
    -D WITH_PYTHON_INSTALL=OFF
    # ppc64le: one glog/gflags, the system's.  Blender bundles its own copies
    # for libmv but links Arch POWER's ceres-solver, which brings the system
    # google-glog; with both, the binary aborts at startup with
    # "flag 'logtostderr' was defined more than once" (README.md).
    -D WITH_SYSTEM_GFLAGS=ON
    -D WITH_SYSTEM_GLOG=ON
    # ppc64le: Cycles on the CPU with Embree BVH traversal and the
    # OpenImageDenoise denoiser (both from this repo).  Arch POWER builds
    # WITH_CYCLES=OFF because neither library existed for ppc64le.
    -D WITH_CYCLES=ON
    -D WITH_CYCLES_EMBREE=ON
    -D CYCLES_PPC64LE_SIMD=$(case "$_cycles_vsx" in native) echo VSX;; sse) echo SSE2VSX;; *) echo SCALAR;; esac)
    -D WITH_CYCLES_OSL=ON
    -D WITH_OPENIMAGEDENOISE=ON
    # ppc64le: not packaged for POWER -- openpgl (path guiding), usd.
    -D WITH_CYCLES_PATH_GUIDING=OFF
    -D WITH_USD=OFF
    -D WITH_HYDRA=OFF
    # ppc64le: the HIP device is compiled in but dormant.  hipew dlopens
    # libamdhip64.so at runtime and, with HIP_BINARIES=OFF, Cycles compiles
    # its GPU kernels at runtime with hipcc -- so a ROCm/HIP port landing
    # later activates the GPU path with no Blender rebuild (README.md).
    # HIPRT needs the HIP RT SDK at build time: off.
    -D WITH_CYCLES_DEVICE_HIP=ON
    -D WITH_CYCLES_HIP_BINARIES=OFF
    -D WITH_CYCLES_DEVICE_HIPRT=OFF
    # ppc64le: no CUDA/OptiX or oneAPI stack exists for POWER.
    -D WITH_CYCLES_DEVICE_CUDA=OFF
    -D WITH_CYCLES_CUDA_BINARIES=OFF
    -D WITH_CYCLES_DEVICE_OPTIX=OFF
    -D WITH_CYCLES_DEVICE_ONEAPI=OFF
    -D WITH_CYCLES_ONEAPI_BINARIES=OFF
    -G Ninja
    -S "$pkgname-$pkgver"
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  cd "$pkgname-$pkgver"

  install -Dm755 release/bin/blender-softwaregl "${pkgdir}/usr/bin/blender-softwaregl"
  python -m compileall "${pkgdir}/usr/share/blender"
  python -O -m compileall "${pkgdir}/usr/share/blender"

  install -Dm644 release/freedesktop/org.blender.Blender.metainfo.xml "${pkgdir}/usr/share/metainfo/org.blender.Blender.metainfo.xml"

  install -vDm 644 doc/license/{BSD-{2,3}-Clause,MIT,Zlib}-license.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
