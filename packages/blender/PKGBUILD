options=('!lto')
# ppc64le: the release source tarball instead of Arch's git+LFS checkout
# (see README.md).  md5 matches upstream's published .md5sum.
source=("https://download.blender.org/source/$pkgname-$pkgver.tar.xz"
        ffmpeg-9.patch
        cycles-vsx.patch
        oidn-ppc64le-supported.patch
        cycles-power-cpu-name.patch)
