# ppc64le: build oxc-parser's N-API binding from source.
#
# prettier's build imports every plugin it ships in order to enumerate the
# parsers/printers for the .d.ts files (scripts/build/build-types.js,
# buildPluginTypes()).  One of those plugins, packages/plugin-oxc, imports
# `oxc-parser`, which is a Rust N-API module.  Upstream publishes prebuilt
# `.node` bindings on npm for x64/arm64/armv7/s390x/riscv64 only, so on
# powerpc64le `yarn build` dies with
#
#     Cannot find module './parser.linux-ppc64-gnu.node'
#
# before it writes anything.  There is nothing wrong with oxc on this
# architecture -- upstream already gates its one architecture-sensitive path
# (raw transfer) on `target_pointer_width = "64"` + `target_endian = "little"`,
# which powerpc64le satisfies, and it already ships a big-endian s390x build --
# the binding simply is not published for us.  So build it: fetch oxc at the
# tag matching the `oxc-parser` version prettier pins, `cargo build` the
# `oxc_parser_napi` cdylib, and drop it next to oxc-parser's bindings.js under
# the name that its own platform table already looks for.
#
# This is build-time only.  The installed package is unchanged and still
# arch=any: dist/prettier contains no oxc plugin and no ELF (verified by
# running the built dist/prettier against js/ts/css/md/json/yaml/html with no
# node_modules present).  `@prettier/plugin-oxc` is published separately and is
# not part of this package, upstream or here.
#
# Local workaround, not an upstream patch: the fix upstream would be for
# oxc-project to add powerpc64le-unknown-linux-gnu to napi/parser's target
# list.  Nothing here is a source change to prettier or to oxc.
#
# Known defect in the binding this builds, which does NOT affect prettier and
# is NOT architecture-specific: oxc-parser's `experimentalRawTransfer` /
# `experimentalLazy` deserializers are generated against one specific rustc
# niche layout.  oxc 0.99.0 pins rustc 1.91.1, whose `Option<Expression>`
# `None` tag byte is 51; rustc 1.97.1 (what Arch POWER ships) uses 255, and
# raw transfer then dies with "Unexpected discriminant 255 for Expression".
# Measured here, and oxc-parser 0.149.0's own generated deserializer now
# expects 255 -- i.e. upstream hit the same rustc change.  Prettier never
# passes those options (src/language-js/parse/oxc.js uses the plain N-API
# path), and the .node never leaves the build tree, so nothing here is
# affected.  Do not lift this recipe's binding for any other consumer without
# rechecking that.
#
# Maintainer: Daniel M. Capella <polyzen@archlinux.org>
# Contributor: Jerome Leclanche <jerome@leclan.ch>
# Contributor: Maxim Baz <archlinux at maximbaz dot com>

pkgname=prettier
pkgver=3.8.1
pkgrel=2
pkgdesc='An opinionated code formatter'
arch=(any)
url=https://prettier.io
license=(MIT)
depends=(nodejs)
makedepends=(
  gcc
  git
  make
  python
  rust
  yarn
)
checkdepends=(npm)
# Must equal the `oxc-parser` version in prettier's package.json; prepare()
# asserts it rather than letting a silent mismatch through.
_oxcver=0.99.0
source=("git+https://github.com/$pkgname/$pkgname.git#tag=$pkgver"
        "oxc-$_oxcver.tar.gz::https://github.com/oxc-project/oxc/archive/refs/tags/crates_v$_oxcver.tar.gz")
b2sums=('05fc139397351b23cc65901754e91ca83f465f7183c33e1681594b565019a07ba2695eded58f05eaa9ebb21b7b6288fe9f499816bf479bbca3f2edd094468987'
        'cb9b5303ace0df60d47e516f7f6dffe86b0a04c07cde8057f635e4ec2d608f8de5adcaf83b927403ea17ace5fff9ef3caaba915d828bb58bbc2cf8533847d4fd')

# The filename oxc-parser's src-js/bindings.js requires, derived exactly the
# way bindings.js derives it: `process.arch` is "ppc64" on powerpc64le.
_napi_platform() {
  printf 'linux-%s-gnu' "$(node -p 'process.arch')"
}

prepare() {
  cd $pkgname
  yarn install --immutable

  # Causes tests to hang
  git revert --no-commit 0f5fee8fac59b3520c28dc2e21192aae83e97ebf

  local declared
  declared=$(node -p "require('./package.json').dependencies['oxc-parser']")
  if [[ $declared != "$_oxcver" ]]; then
    echo "prettier pins oxc-parser $declared but this PKGBUILD fetches oxc $_oxcver" >&2
    echo "update _oxcver (and its b2sum) to match" >&2
    return 1
  fi

  # A future oxc-parser could drop the branch we rely on; fail here, loudly,
  # instead of building a .node nothing will ever load.
  if ! grep -qF "./parser.$(_napi_platform).node" \
       node_modules/oxc-parser/src-js/bindings.js; then
    echo "oxc-parser's bindings.js has no $(_napi_platform) entry" >&2
    return 1
  fi

  cd "$srcdir/oxc-crates_v$_oxcver"
  # Arch ships plain rustc, not rustup, so this file is inert here -- but if a
  # rustup toolchain is ever on PATH it would try to download the pinned
  # channel mid-build.
  rm -f rust-toolchain.toml
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$srcdir/oxc-crates_v$_oxcver"
  cargo build --release --frozen -p oxc_parser_napi
  install -Dm644 target/release/liboxc_parser_napi.so \
    "$srcdir/$pkgname/node_modules/oxc-parser/src-js/parser.$(_napi_platform).node"

  cd "$srcdir/$pkgname"
  yarn build
}

check() {
  cd $pkgname
  # Flaky test
  mv tests/integration/__tests__/ignore-path.js{,.bak}
  yarn test:production
  mv tests/integration/__tests__/ignore-path.js{.bak,}
}

package() {
  local mod_dir=/usr/lib/node_modules/$pkgname

  install -d "$pkgdir"/{usr/bin,usr/share/licenses/$pkgname,$mod_dir}
  ln -s $mod_dir/bin/$pkgname.cjs "$pkgdir"/usr/bin/$pkgname
  ln -s $mod_dir/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE

  cd $pkgname
  cp -a dist/$pkgname/* "$pkgdir"/$mod_dir
}
