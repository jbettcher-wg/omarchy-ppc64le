# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
pkgname=omarchy-theme-power9
pkgver=1.0
pkgrel=3
pkgdesc='POWER9 theme for Omarchy: IBM Blue 60 and POWER9 green, with ppc64le branding'
arch=('any')
url='https://omarchy.org'
license=('MIT')
depends=('omarchy')
source=('omarchy-theme-power9-branding')
sha256sums=('SKIP')

# Omarchy reads themes from $OMARCHY_PATH/themes/<name>/ and lists them with
# `omarchy theme list`. colors.toml is the only colour source -- alacritty,
# btop, hyprland, neovim, kitty, ghostty, foot, helix, chromium and vscode are
# all generated from it by $OMARCHY_PATH/default/themed/*.tpl on `theme set`.
# Do not ship generated files here; they would be overwritten anyway.
#
# The theme ships two things that are NOT part of the theme spec:
#
#   ascii/      banner, issue, motd, splash, die, chip. Branding, not theming.
#               The ISO profile installs issue/motd/banner onto the live medium
#               separately -- see iso/profile/airootfs.
#   fastfetch/  config.jsonc plus two raw-ANSI logos. Kept for reference only:
#               Omarchy 4 gives fastfetch no theme hook at all. Its
#               /etc/fastfetch/config.jsonc (from omarchy-settings) hardcodes
#               the logo as ~/.config/omarchy/branding/about.txt, so a theme
#               cannot supply one. See branding/ below for what actually works.
#   branding/   about.txt, sized to the slot Omarchy reads: the OpenPOWER cube
#               with the Omarchy swirl on every face. Applied to accounts
#               p9-install creates; an account that already exists applies it
#               with omarchy-theme-power9-branding. No screensaver.txt: the
#               screensaver keeps Omarchy's own logo (1.0-3 dropped the POWER9
#               wordmark there).
#
# Both are installed under the theme directory so `omarchy theme set power9`
# keeps them together with the colours they match, and so a user can find them.

package() {
  local themedir="$pkgdir/usr/share/omarchy/themes/power9"
  install -dm755 "$themedir"
  cp -a "$srcdir/../power9/." "$themedir/"

  # The shipped fastfetch config points at ~/.config/omarchy/themes/, which was
  # the Omarchy 3 theme location. Nothing reads this file, but leaving a path
  # that cannot resolve in a shipped config is a trap for whoever tries.
  sed -i 's#~/.config/omarchy/themes/power9#/usr/share/omarchy/themes/power9#' \
    "$themedir/fastfetch/config.jsonc"

  # Documentation belongs with the docs, not in the theme picker's directory.
  install -Dm644 "$themedir/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  rm -f "$themedir/README.md"

  install -Dm644 "$pkgdir/usr/share/omarchy/themes/power9/ascii/banner.txt" \
    "$pkgdir/usr/share/doc/$pkgname/banner.txt"

  # Branding, sized to the slot Omarchy reads.
  #
  #   about.txt       26 rows x 54 cols budget -- omarchy-launch-about measures
  #                   the logo and sizes the window to it, so an oversized file
  #                   does not crop, it opens a window wider than the screen.
  #                   die.txt is 12x44.
  #
  # fastfetch/logo-cube.txt is 32x111 and does not fit; it stays a splash asset.
  # btop.theme is kept. omarchy-theme-set-templates only renders a template
  # when the theme does not already ship that file (`[[ ! -f $output_path ]]`),
  # so this hand-written btop theme wins over btop.theme.tpl, and it survives
  # `omarchy theme install` from git too. (1.0-1 deleted it on the wrong belief
  # that the generator overwrites it.)

  # obsidian/ is an optional standalone Obsidian theme, not part of the Omarchy
  # theme spec: Omarchy already generates Obsidian colours from colors.toml via
  # obsidian.css.tpl. Ship it as documentation to copy into a vault by hand.
  if [ -d "$themedir/obsidian" ]; then
    install -dm755 "$pkgdir/usr/share/doc/$pkgname/obsidian"
    cp -a "$themedir/obsidian/." "$pkgdir/usr/share/doc/$pkgname/obsidian/"
    rm -rf "$themedir/obsidian"
  fi

  install -dm755 "$themedir/branding"
  # The OpenPOWER cube with the Omarchy swirl through it, drawn for this slot:
  # 20 rows x 50 display columns against a 26x54 budget, every row centred. At
  # 20 rows the About window is max(20+2, 28)+1 = 29 rows -- the same as
  # Omarchy's own icon, so it costs nothing to use. Do not widen past 54: the
  # window is sized to the logo, so an over-wide logo opens an over-wide window
  # rather than cropping.
  #
  # The -50 variant carries its own ANSI colour, so /etc/fastfetch/config.jsonc's
  # "color": { "1": "green" } does not repaint it -- that mapping only recolours
  # art that has no colour of its own. Measure this file with the escapes
  # stripped; raw `wc -L` reports 105 and is meaningless here.
  install -m644 "$themedir/fastfetch/logo-cube-50.txt" "$themedir/branding/about.txt"

  # For accounts that already exist; p9-install handles the ones it creates.
  install -Dm755 "$srcdir/omarchy-theme-power9-branding" \
    "$pkgdir/usr/bin/omarchy-theme-power9-branding"
}
