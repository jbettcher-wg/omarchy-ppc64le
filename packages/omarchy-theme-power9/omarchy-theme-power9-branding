#!/bin/bash
# Apply the POWER9 theme's branding to the current user.
#
# Omarchy has no hook for this. /etc/fastfetch/config.jsonc reads the logo from
# ~/.config/omarchy/branding/about.txt, which is per-user and so cannot be set
# by a package; and omarchy-branding-about offers only image/text/reset, where
# reset restores Omarchy's own icon rather than the active theme's.
#
# Accounts created by p9-install get this applied automatically. This is for
# accounts that already existed.
set -euo pipefail

src=/usr/share/omarchy/themes/power9/branding
dst="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/branding"

[[ -d $src ]] || { echo "omarchy-theme-power9 is not installed" >&2; exit 1; }
mkdir -p "$dst"

# about.txt only; the screensaver keeps Omarchy's own logo
# (omarchy branding screensaver reset restores it).
for f in about; do
  if [[ -r $src/$f.txt ]]; then
    cp "$src/$f.txt" "$dst/$f.txt"
    printf 'applied %s.txt\n' "$f"
  else
    printf 'missing %s/%s.txt\n' "$src" "$f" >&2
  fi
done

printf 'run omarchy-launch-about to see it\n'
