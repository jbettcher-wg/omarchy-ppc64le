# ppc64le: added powerpc64le to arch(), retargeted to .NET 10, and dropped the
# self-contained publish.
#
# nvim-tooling.md called marksman "the one genuine question mark" of the editor
# tooling, because it is the only .NET tool in the set and the runtime's ppc64le
# story was untested. It turns out to work: marksman builds and runs on the
# ppc64le (Mono flavor) .NET runtime.
#
# Retarget to net10.0 (pkgrel 5). Upstream 2026-02-08 targets net9.0. Arch POWER
# only ever had .NET 9.0.100-rc.2; this repo now ships a source-built .NET
# 10.0.12 (packages/dotnet/dotnet-core), which replaces that 9.0 runtime on upgrade.
# .NET does not roll a net9.0 app forward onto a 10.0 runtime by default, so
# marksman is rebuilt for net10.0 rather than papered over with
# RollForward=Major. The source change is only the five
# <TargetFramework>net9.0</TargetFramework> lines (four F# projects and the C#
# MarkdigPatches library), rewritten in prepare().
# The net10.0 build compiles with 0 errors.
#
# The remaining detail is structural rather than cosmetic: `make publish` asks
# for a self-contained trimmed single-file binary, which needs Microsoft's
# Microsoft.AspNetCore.App.Runtime.linux-ppc64le runtime pack from nuget.org.
# Microsoft publishes no such pack, so self-contained publishing is not
# available on this architecture. The build does a framework-dependent publish,
# which runs against the packaged runtime.
#
# Maintainer: Jelle van der Waa <jelle@archlinux.org>

pkgname=marksman
pkgver=20260208
pkgrel=5
_dotnet_version=10.0
pkgdesc="Write Markdown with code assist and intelligence in the comfort of your favourite editor."
arch=('x86_64' 'powerpc64le')
url="https://github.com/artempyanykh/marksman"
license=('MIT')
makedepends=("dotnet-sdk-$_dotnet_version" 'git')
# Off x86_64 the binary is framework-dependent, so the runtime is a hard
# requirement rather than a remnant of the self-contained publish.
depends=("dotnet-runtime-$_dotnet_version")
options=('!strip')
source=("$pkgname"::git+https://github.com/artempyanykh/marksman.git#tag="${pkgver:0:4}-${pkgver:4:2}-${pkgver:6:2}"
        0001-Makefile-recognise-ppc64le-riscv64-and-s390x.patch)
b2sums=('c237ee8837b184735496335302889fe54c1a8618b1fec9427f5a69af6b01be958e8e948e3b47c8764a8b4c5b1dfc8da847d8e92247d2de467c500b35628e9724'
        'SKIP')

prepare() {
  cd "marksman"

  # marksman's global.json pins "version": "9.0.100" with rollForward
  # latestFeature, which never crosses a major version, so a 10.0 SDK is
  # refused. The TargetFramework rewrite below is the real constraint now;
  # global.json has nothing left to express.
  rm -f global.json

  # Retarget every project (Marksman, LanguageServerProtocol, Tests,
  # Benchmarks, and the C# MarkdigPatches library Marksman references) from
  # net9.0 to net10.0. A -p:TargetFramework global property would not reach
  # ProjectReferences cleanly, so edit the five lines and check that exactly
  # those changed and no project file still says net9.0. Local workaround
  # until upstream moves to .NET 10; not a portability fix.
  local _projects=(Marksman/Marksman.fsproj LanguageServerProtocol/LanguageServerProtocol.fsproj
                   Tests/Tests.fsproj Benchmarks/Benchmarks.fsproj
                   MarkdigPatches/MarkdigPatches.csproj)
  sed -i "s|<TargetFramework>net9\.0</TargetFramework>|<TargetFramework>net$_dotnet_version</TargetFramework>|" "${_projects[@]}"
  if grep -rn --include='*.fsproj' --include='*.csproj' --include='*.props' --include='*.targets' 'net9\.0' .; then
    error "net9.0 references left after the retarget"
    return 1
  fi
  [[ $(grep -l "<TargetFramework>net$_dotnet_version</TargetFramework>" "${_projects[@]}" | wc -l) == 5 ]]

  # Teaches the Makefile's uname -m -> .NET RID table about ppc64le. Without it
  # the RID becomes "linux-" and the build fails with NETSDK1083 a long way
  # downstream. Portability fix worth sending upstream; see the patch header.
  patch -Np1 -i "$srcdir/0001-Makefile-recognise-ppc64le-riscv64-and-s390x.patch"
}

build() {
  cd "marksman"

  # Disable dotnet telemetry, and keep the SDK's first-run state and NuGet
  # caches out of the builder's $HOME.
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
  export HOME="$srcdir/home"
  mkdir -p "$HOME"

  make build

  if [[ $CARCH == x86_64 ]]; then
    make publish
  else
    # `make publish` asks for a self-contained, trimmed, single-file binary,
    # which makes NuGet fetch Microsoft.AspNetCore.App.Runtime.<RID> from
    # nuget.org. Microsoft publishes no ppc64le runtime pack, so a
    # self-contained publish is impossible here regardless of how the RID is
    # spelled.
    #
    # A framework-dependent publish is, and it runs against the packaged
    # dotnet-runtime. The cost is that marksman needs that runtime installed
    # rather than being one standalone file.
    dotnet publish -c Release --no-self-contained \
      -p:DebugType=embedded \
      -o publish Marksman/Marksman.fsproj
  fi
}

package() {
  cd "marksman"
  if [[ $CARCH == x86_64 ]]; then
    install -Dm755 Marksman/bin/Release/net*/linux-*/publish/marksman $pkgdir/usr/bin/marksman
  else
    # Framework-dependent output: an apphost plus its managed assemblies.
    install -d "$pkgdir/usr/lib/marksman"
    cp -rT publish "$pkgdir/usr/lib/marksman"
    chmod 755 "$pkgdir/usr/lib/marksman/marksman"
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/marksman/marksman "$pkgdir/usr/bin/marksman"
  fi
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
