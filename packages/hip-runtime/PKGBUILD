# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: acxz <akashpatel2008 at yahoo dot com>

# ppc64le: AMD half only, CLR patched for POWER, hipcc checkout shared with
# rocm-llvm.  README.md lists every deviation from Arch's recipe and why.

pkgbase=hip-runtime
pkgname=(hip-runtime-amd)
pkgver=7.2.4
pkgrel=2
_pkgdesc="Heterogeneous Interface for Portability"
arch=('x86_64' 'powerpc64le')
url='https://rocm.docs.amd.com/projects/HIP/en/latest/'
license=('MIT')
_amd_depends=('rocm-core' 'bash' 'perl' 'glibc' 'libgcc' 'numactl'
         'mesa' 'comgr' 'rocminfo' 'rocm-llvm' 'libelf' 'rocprofiler-register')
makedepends=('git' 'cmake' 'python' 'python-cppheaderparser'
             "${_amd_depends[@]}")
_tag="tag=rocm-$pkgver"
# HIPCC compiler wrapper.  Arch names this checkout "$pkgbase-hipcc", which
# makes makepkg mirror the whole 4.5 GiB ROCm llvm-project a second time
# into SRCDEST; naming it "rocm-llvm" reuses the mirror rocm-llvm's build
# already made.  Same URL, same tag, same tree.
_hipcc='https://github.com/ROCm/llvm-project'
source=("rocm-$pkgver.tar.gz::https://github.com/ROCm/rocm-systems/archive/refs/tags/rocm-$pkgver.tar.gz"
        "rocm-llvm::git+$_hipcc#$_tag"
        '0001-clr-ppc64le-arch-fences-and-spin-hint.patch'
        '0002-clr-char-vectors-signed-on-unsigned-char-hosts.patch')
sha256sums=('817f9c136125b8d162757a18cdc25b18b1efeb8ef36a948c85e4a672fd149de5'
            'cda215d04dfb6ede38c542d4604711d4a4623267df0f3d678491cd9fbcc32fd9'
            'eb1f12a81bb4633ff5ad691806690b525c3aa4327f8b278c8837113dcb424b99'
            'bb8dc8e154667b252e6e8ef1d68ccea8b93fab61e8a00c04905ffbe92a2f572d')
_projectBaseDir="rocm-systems-rocm-$pkgver/projects"

options=(!lto)

prepare() {
  # ppc64le: CLR has no arch branch for POWER and calls x86 fence intrinsics
  # unguarded.  Patch header says what and why.
  patch -Np1 -d "$_projectBaseDir/clr" -i "$srcdir/0001-clr-ppc64le-arch-fences-and-spin-hint.patch"
  # ppc64le: char1..char4 are built from plain char, which is unsigned here
  # (CUDA uses signed char).  Broke llama.cpp's quantized matmuls outright.
  patch -Np1 -d "$_projectBaseDir/clr" -i "$srcdir/0002-clr-char-vectors-signed-on-unsigned-char-hosts.patch"
}

build() {
  local hipcc_amd_args=(
    -Wno-dev
    -S "$srcdir/rocm-llvm/amd/hipcc"
    -D CMAKE_BUILD_TYPE=None
    -B build-amd-hipcc
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
  )
  cmake "${hipcc_amd_args[@]}"
  cmake --build build-amd-hipcc

  local hip_amd_args=(
    -Wno-dev
    -S "$srcdir/$_projectBaseDir/clr"
    -B build-amd
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/opt/rocm/
    -DHIP_PLATFORM=amd
    -DHIP_COMMON_DIR="$srcdir/$_projectBaseDir/hip"
    -DHIPCC_BIN_DIR="$srcdir/build-amd-hipcc"
    -DHIPNV_DIR="$srcdir/$_projectBaseDir/hipother/hipnv"
    -DHIP_CATCH_TEST=0
    -DCLR_BUILD_HIP=ON
    -DCLR_BUILD_OCL=OFF
  )
  cmake "${hip_amd_args[@]}"
  cmake --build build-amd

  # Arch also builds hip-runtime-nvidia here.  It needs the `cuda` package,
  # which does not exist for ppc64le (NVIDIA dropped POWER after CUDA 11),
  # so that half is gone rather than gated.
}

package_hip-runtime-amd() {
  pkgdesc="$_pkgdesc (AMD runtime)"
  depends=("${_amd_depends[@]}")
  optdepends=('inetutils: Print hostname in hipconfig')
  replaces=("hip")
  provides=("hip=${pkgver}")
  DESTDIR="$pkgdir" cmake --install build-amd
  install -Dm644 "$srcdir/$_projectBaseDir/hip/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
