# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Based on the Arch qwen-code PKGBUILD (contributors below).
# ppc64le: pinned to 0.22.3, the version running on the second POWER9 box. From
# 0.23 the CLI's HTML export (web-templates) imports web-shell's transcript
# build, which needs the lightningcss/oxide native modules; 0.22.3 does not.
# ppc64le: upstream source, unmodified; the qwen checkout on the second POWER9 box
# runs the same way. npm pulls ppc64 prebuilts where they exist (sharp, rollup,
# oxc). @lydell/node-pty and @teddyzhu/clipboard ship no ppc64 binaries, so those
# optional features are absent here.
# Contributor: Shengyun Wang <leo_wsy@outlook.com>
# Contributor: noureddinex
# Contributor: envolution
# Contributor: Aaron Coach <aur@awc.id.au>
# shellcheck shell=bash disable=SC2034,SC2154

pkgname=qwen-code
pkgver=0.22.3
pkgrel=1
pkgdesc='Open-source AI agent for the terminal, optimized for Qwen-Coder'
url='https://github.com/QwenLM/qwen-code'
arch=(x86_64 powerpc64le)
license=(Apache-2.0)
depends=(
  libgcc
  libstdc++
  glibc
  nodejs
  ripgrep
)
makedepends=(
  file
  git
  jq
  npm
)
optdepends=(
  'alsa-utils: voice dictation recording via arecord'
  'npm: optional computer-use tools via npx'
  'sox: voice dictation recording'
)
source=("git+https://github.com/QwenLM/qwen-code.git#tag=v${pkgver}")
sha256sums=('3e50d6c0a726b162d2767c53d661734bd8bffc14f11498b54770fbbdcfaeb718')
b2sums=('bad3948d9a3ffa633521b4b2c2af28a5f6392ffb5f329589a58b4ec6fd6d1481b57b42b448dbc7e275130b92b02bb84e031c1da896e5e566131d997ddb5b1c4c')

prepare() {
  cd $pkgname
  # Upstream's ranged override currently resolves newer than package-lock.json.
  npm pkg set 'overrides.@types/react=19.2.10'
  npm clean-install \
    --registry=https://registry.npmjs.org \
    --replace-registry-host=always \
    --include=optional \
    --ignore-scripts
  # Upstream postinstall applies dependency patches; install scripts are disabled above.
  ./node_modules/.bin/patch-package
}

build() {
  cd $pkgname
  # ppc64le: CLI only for now. The web UI packages (webui, web-shell) need the
  # lightningcss and @tailwindcss/oxide native modules, which publish no
  # linux-ppc64 builds. 0.22.3's scripts/build.js already has --cli-only, which
  # leaves them out; that is how the qwen checkout on the second POWER9 box was
  # built. Re-enable the full build once those modules are built for ppc64le.
  local _build_args=()
  [[ $CARCH == powerpc64le ]] && _build_args=(-- --cli-only)
  npm run build "${_build_args[@]}"
  npm run bundle
  local bundled=$(jq '.dependencies + .optionalDependencies | keys' package.json)
  npm pkg set --json bundledDependencies="$bundled"
  # npm refuses to pack bundled modules while overrides target bundled deps.
  npm pkg delete overrides
  npm pack --ignore-scripts
}

check() {
  cd $pkgname
  # Node 26 exposes Web Storage only when localStorage has a backing file.
  export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--localstorage-file=$PWD/.node-localstorage"
  # Skip remaining clean-chroot failures; no narrow upstream fixes are available.
  # Keep one glob because sdk-typescript's Vitest rejects repeated --exclude.
  local test_exclude='**/{qwenConnectionHandler,useAtCompletion,pid-descendants,'
  test_exclude+='serve/acp-http/transport,i18n/index,ui/auth/AuthDialog,'
  test_exclude+='ui/utils/clipboardUtils,'
  # mock-fs fails at import time on Node 26.8+:
  # https://github.com/tschaub/mock-fs/issues/447
  test_exclude+='services/FileCommandLoader,services/FileCommandLoader-extension,'
  test_exclude+='lsp/LspConfigLoader,utils/pathReader}.test.*'
  # yargs 17.7.3 fixes c8's require('yargs/yargs') on Node 26.
  # https://github.com/yargs/yargs/pull/2514
  cp node_modules/yargs/yargs node_modules/yargs/yargs.cjs
  jq '.exports["./yargs"][0].require = "./yargs.cjs" |
      .exports["./yargs"][1] = "./yargs.cjs"' \
    node_modules/yargs/package.json > yargs-package.json
  mv yargs-package.json node_modules/yargs/package.json
  # mobile-mcp tests run from the workspace source tree, so point them at npm's
  # hoisted mobilecli binary instead of the package-local path used after install.
  if [[ $CARCH == x86_64 ]]; then
    export MOBILECLI_PATH="$PWD/node_modules/mobilecli/bin/mobilecli-linux-amd64"
    npm run test --workspace=@qwen-code/mobile-mcp
  fi
  # mobile-mcp uses Playwright; run it above without passing Vitest-only flags.
  npm pkg set 'workspaces[]=!packages/mobile-mcp'
  # NODE_OPTIONS gives Node's Web Storage one shared backing file; keep Vitest
  # files serial so another jsdom test cannot clear draft storage mid-test.
  npm run test --workspaces --if-present -- --testTimeout=30000 --no-file-parallelism --exclude="$test_exclude"
}

package() {
  cd $pkgname
  npm install --global --offline --ignore-scripts --prefix "$pkgdir/usr" \
    $pkgname-$pkgname-$pkgver.tgz
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  # Upstream vendors ripgrep for x64-linux and arm64-linux only. qwen tries the
  # bundled binary for its own arch first and falls back to the system `rg`
  # (packages/core/src/utils/ripgrepUtils.ts), and ripgrep is in depends=(), so
  # the foreign binaries are dead weight here. Drop them and refuse to ship any
  # ELF that is not for this architecture.
  if [[ $CARCH == powerpc64le ]]; then
    rm -rf "$pkgdir/usr/lib/node_modules/@qwen-code/qwen-code/dist/vendor/ripgrep"
    local _foreign
    _foreign=$(find "$pkgdir" -type f -print0 | xargs -0 file -N 2>/dev/null |
      grep ELF | grep -v "64-bit PowerPC" || true)
    [[ -z $_foreign ]] || { printf "foreign ELF in package:\n%s\n" "$_foreign" >&2; return 1; }
  fi
}
