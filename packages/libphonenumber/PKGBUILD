pkgname=libphonenumber
pkgver=9.0.39
pkgrel=1
epoch=1
pkgdesc="Google's common library for parsing, formatting, and validating international phone numbers"
url="https://github.com/googlei18n/libphonenumber"
arch=(x86_64)
license=('Apache-2.0 AND BSD-3-Clause')
depends=(
  abseil-cpp
  glibc
  icu
  libgcc
  libstdc++
  protobuf
)
makedepends=(
  cmake
  git
  gtest
  jre-openjdk-headless
)
source=(
  "git+$url#tag=v$pkgver"
  0001-Use-find_package-for-protobuf.patch
  0002-Remove-Werror.patch
  0003-Fix-BUILD_STATIC_LIB-OFF.patch
)
b2sums=('88a2202e056c8e51595944e3423437f3c7a6a0de8c1e1bfe83558bbf0a26c1b4404784ce1ab1cc2db3d5d21b80667e9f65a1ad66143dedf97b27999f33aae2c8'
        '44be662cd62d87f4f0ceedc7c98cf4dedd1428bc5792288a4a861022e31a03a231b513bde125a95437871e69d3f7aba08db17b601dd6806b502cfe03bfda2f4b'
        '24854002196053b9758705b251a6dc2763fa6db5055c2b8ee0c7bd6a0adcb64eecab7f03ebec4fade42c4f19671e85ee4ca6450c13a9581118705c983f5d3a00'
        '190e9f1d452542fe11ae3800747dd786cb1481a728531f41b5605084fe378584f2df46438c9e24042d0e9effa09eface4e28f8d6e75b66692629fa353f318eeb')

prepare() {
  cd $pkgname

  # Use official protobuf cmake target instead of
  # custom one, fixes build with protobuf 23
  git apply -3 ../0001-Use-find_package-for-protobuf.patch

  # Don't use -Werror; fixes build with GCC 15
  git apply -3 ../0002-Remove-Werror.patch

  # Fix building test with BUILD_STATIC_LIB=OFF
  git apply -3 ../0003-Fix-BUILD_STATIC_LIB-OFF.patch
}

build() {
  # A staged JDK is not on PATH. Arch ships the runtime at
  # /usr/lib/jvm/java-N-openjdk/bin/java and creates /usr/bin/java as a symlink
  # from `archlinux-java set`, which is a post-install action -- no package owns
  # that path. Under bq the JDK is extracted into the sysroot but never
  # activated, so cmake's find_program(java) fails with
  #   Can't find Java Runtime Environment: can't locate java
  # even though sysroot/usr/lib/jvm/java-26-openjdk/bin/java exists. Put the
  # newest staged JVM on PATH ourselves rather than depend on host state.
  _jvm=$(ls -d /usr/lib/jvm/java-*-openjdk 2>/dev/null | sort -V | tail -1)
  if [ -n "$_jvm" ]; then
    export JAVA_HOME="$_jvm"
    export PATH="$_jvm/bin:$PATH"
  fi
  local cmake_options=(
    -D BUILD_STATIC_LIB=OFF
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_CXX_STANDARD=17
    -D CMAKE_INSTALL_PREFIX=/usr
    -D USE_BOOST=OFF
    -D USE_STDMUTEX=ON
  )

  cmake -S $pkgname/cpp -B build "${cmake_options[@]}"
  cmake --build build
}

check() {
  cmake --build build --target tests
}

package() {
  depends+=(
    libicu{uc,i18n}.so
    libprotobuf.so
  )
  provides+=(
    libgeocoding.so
    libphonenumber.so
  )

  DESTDIR="$pkgdir" cmake --install build

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgname/LICENSE.Chromium
}

