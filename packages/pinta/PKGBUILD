# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: NicoHood <archlinux {cat} nicohood {dog} de>
# Contributor: Fabio 'Lolix' Loli <fabio.loli@disroot.org> -> https://github.com/FabioLolix
# Contributor: Konrad <konrad AT knauber DOT name>
# Contributor: Javier Steinaker <jsteinaker@gmail.com>
#
# powerpc64le: arch=(any) is unchanged. Pinta is managed code; on ppc64le it
# runs on the Mono flavor of dotnet-runtime 10.0, from packages/dotnet-core.
# Changes from Arch:
#   - depends += dotnet-host webp-pixbuf-loader, to match the runtime
#     depends Omarchy's own pinta package carries.
#   - HOME points into $srcdir during the build, so dotnet restore/publish do
#     not write ~/.dotnet, ~/.nuget or ~/.local/share/NuGet.

pkgname=pinta
pkgver=3.1.2
_dotnet_version=10.0
pkgrel=2
pkgdesc="Drawing/editing program modeled after Paint.NET. It's goal is to provide a simplified alternative to GIMP for casual users"
arch=(any)
url='https://pinta-project.com/'
license=(MIT)
depends=(
  bash
  cairo
  dotnet-host
  "dotnet-runtime-$_dotnet_version"
  gdk-pixbuf2
  glib2
  graphene
  gtk4
  harfbuzz
  hicolor-icon-theme
  libadwaita
  pango
  webp-pixbuf-loader
)
makedepends=(
  autoconf-archive
  "dotnet-sdk-$_dotnet_version"
  git
  intltool
)
source=("git+https://github.com/PintaProject/Pinta.git?signed#tag=$pkgver")
b2sums=(0fc96492d6005ebca331d68d7815d1f8035336215c0d9e5ab16998155b7300981112f99ba5ff23676a7f136542a8b60fa7ddb052c3fab8604a8996ce16ea188f)
validpgpkeys=(5BDA30D0C2E985E598089E444CF80E80E77C5C35) # Cameron White

_dotnet_env='local -x HOME="$srcdir/home" DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1; mkdir -p "$HOME"'

prepare() {
  eval "$_dotnet_env"
  cd Pinta
  TargetFramework="net$_dotnet_version" dotnet restore Pinta/Pinta.csproj
  sed -i 's|"/icons"|"/pinta/icons"|' Pinta/Main.cs
  autoreconf -fiv
}

build() {
  eval "$_dotnet_env"
  cd Pinta
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  eval "$_dotnet_env"
  cd Pinta
  make DESTDIR="$pkgdir" install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" license-*.txt

  # Install generic icons into private directory to avoid collision with other packages
  # https://github.com/PintaProject/Pinta/issues/2237
  install -dm755 "$pkgdir"/usr/share/pinta/icons/hicolor/{16x16,scalable}
  mv "$pkgdir"/usr/share/{,pinta/}icons/hicolor/16x16/actions
  mv "$pkgdir"/usr/share/{,pinta/}icons/hicolor/scalable/actions
}
