# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Maintainer: Bruno Pagani <archange@archlinux.org>
# Contributor: Lukas Jirkovsky <l.jirkovsky@gmail.com>
# ppc64le: Omarchy ppc64le -- see README.md

pkgname=embree
pkgver=4.4.1
pkgrel=1
pkgdesc="Collection of high-performance ray tracing kernels"
arch=('x86_64' 'powerpc64le')
url="https://embree.github.io/"
license=('Apache-2.0')
depends=('glibc' 'libgcc' 'libstdc++' 'intel-tbb')
makedepends=('cmake' 'ispc' 'freeglut' 'libxmu' 'ninja')
source=(https://github.com/embree/embree/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz
        embree-ppc64le.patch
        embree-ppc64le-smoke.c)
sha256sums=('dcf338cc61b636c871ccf370e673bfd380c5ecb71ce49ad50f28e1d4ec9995dc'
            'SKIP'
            'SKIP')

# Embree detects actual ISA at runtime but we have to set a high maximum
# buildtime version as it would otherwise default to the builder processor.
case "$CARCH" in
  i*86|x86_64*)
      _MAX_ISA=AVX512SKX
      _ISA_OPTS=()
      ;;
  arm*|aarch64)
      _MAX_ISA=NEON2X
      _ISA_OPTS=()
      ;;
  powerpc64le)
      # SSE kernels on VSX (see embree-ppc64le.patch).  Every POWER8+ has
      # VSX, so there is nothing to dispatch on: build the SSE4.2 tier only,
      # the way the ARM port builds a single NEON tier.  Let makepkg's
      # CXXFLAGS (-mcpu=power9) through instead of Embree's own flag set.
      _MAX_ISA=NONE
      _ISA_OPTS=(-DEMBREE_ISA_SSE2=OFF -DEMBREE_ISA_SSE42=ON
                 -DEMBREE_IGNORE_CMAKE_CXX_FLAGS=OFF)
      ;;
  *)
      # Upstream currently doesn't have any support for non-arm/x86
      _MAX_ISA=NONE
      _ISA_OPTS=()
      ;;
esac

prepare() {
    cd ${pkgname}-${pkgver}
    patch -Np1 -i "$srcdir"/embree-ppc64le.patch
}

build() {
    cmake \
      -B build \
      -G Ninja \
      -S ${pkgname}-${pkgver} \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release \
      -DEMBREE_ISPC_SUPPORT=ON \
      -DEMBREE_TUTORIALS=OFF \
      -DEMBREE_MAX_ISA="${_MAX_ISA}" \
      "${_ISA_OPTS[@]}" \
      -DEMBREE_BACKFACE_CULLING=OFF
    ninja -C build
    # Maybe enable these later once they are out of beta:
      # -DEMBREE_SYCL_SUPPORT=ON \
      # -DEMBREE_SYCL_LARGEGRF=ON
}

check() {
    # Build a tiny client against the just-built library and trace rays.
    gcc -O2 -o build/smoke "$srcdir"/embree-ppc64le-smoke.c \
        -I ${pkgname}-${pkgver}/include -L build -lembree4 -lm
    LD_LIBRARY_PATH=build ./build/smoke
}

package() {
    DESTDIR="${pkgdir}" ninja -C build install

    mkdir "${pkgdir}"/usr/bin/
    mv "${pkgdir}"/usr/embree-vars.* "${pkgdir}"/usr/bin/
}
