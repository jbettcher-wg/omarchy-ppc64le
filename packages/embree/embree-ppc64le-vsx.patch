+++ embree-4.4.1/common/simd/vboolf4_vsx.h	2026-09-11 11:23:38.211609697 -0600
@@ -0,0 +1,182 @@
+// Copyright 2009-2021 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// powerpc64le: 4-wide bool type on VSX (see vsx/vsx.h).  Lanes are canonical
+// masks (all-ones or all-zero) in a __vector unsigned int.
+
+#pragma once
+
+#define vboolf vboolf_impl
+#define vboold vboold_impl
+#define vint vint_impl
+#define vuint vuint_impl
+#define vllong vllong_impl
+#define vfloat vfloat_impl
+#define vdouble vdouble_impl
+
+namespace embree
+{
+  /* 4-wide VSX bool type */
+  template<>
+  struct vboolf<4>
+  {
+    ALIGNED_STRUCT_(16);
+
+    typedef vboolf4 Bool;
+    typedef vint4   Int;
+    typedef vfloat4 Float;
+
+    enum  { size = 4 };                   // number of SIMD elements
+    union { vsx::u32x4 v; int i[4]; };    // data
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constructors, Assignment & Cast Operators
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline vboolf() {}
+    __forceinline vboolf(const vboolf4& other) { v = other.v; }
+    __forceinline vboolf4& operator =(const vboolf4& other) { v = other.v; return *this; }
+
+    __forceinline vboolf(vsx::u32x4 input) : v(input) {}
+    __forceinline operator const vsx::u32x4&() const { return v; }
+
+    __forceinline vboolf(bool a)
+      : v(vsx::splat_mask(a)) {}
+    __forceinline vboolf(bool a, bool b)
+      : v((vsx::u32x4){ a ? ~0u : 0u, b ? ~0u : 0u, a ? ~0u : 0u, b ? ~0u : 0u }) {}
+    __forceinline vboolf(bool a, bool b, bool c, bool d)
+      : v((vsx::u32x4){ a ? ~0u : 0u, b ? ~0u : 0u, c ? ~0u : 0u, d ? ~0u : 0u }) {}
+    __forceinline vboolf(int mask) { assert(mask >= 0 && mask < 16); v = vsx_lookupmask[mask]; }
+    __forceinline vboolf(unsigned int mask) { assert(mask < 16); v = vsx_lookupmask[mask]; }
+
+    /* return int32 mask */
+    __forceinline vsx::i32x4 mask32() const {
+      return (vsx::i32x4)v;
+    }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constants
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline vboolf(FalseTy) : v(vec_splats(0u)) {}
+    __forceinline vboolf(TrueTy)  : v(vec_splats(~0u)) {}
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Array Access
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline bool operator [](size_t index) const { assert(index < 4); return i[index] < 0; }
+    __forceinline int& operator [](size_t index)       { assert(index < 4); return i[index]; }
+  };
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Unary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4 operator !(const vboolf4& a) { return vec_nor(a.v, a.v); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Binary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4 operator &(const vboolf4& a, const vboolf4& b) { return vec_and(a.v, b.v); }
+  __forceinline vboolf4 operator |(const vboolf4& a, const vboolf4& b) { return vec_or (a.v, b.v); }
+  __forceinline vboolf4 operator ^(const vboolf4& a, const vboolf4& b) { return vec_xor(a.v, b.v); }
+
+  __forceinline vboolf4 andn(const vboolf4& a, const vboolf4& b) { return vec_andc(a.v, b.v); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Assignment Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4& operator &=(vboolf4& a, const vboolf4& b) { return a = a & b; }
+  __forceinline vboolf4& operator |=(vboolf4& a, const vboolf4& b) { return a = a | b; }
+  __forceinline vboolf4& operator ^=(vboolf4& a, const vboolf4& b) { return a = a ^ b; }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Comparison Operators + Select
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4 operator !=(const vboolf4& a, const vboolf4& b) { return vec_xor(a.v, b.v); }
+  __forceinline vboolf4 operator ==(const vboolf4& a, const vboolf4& b) { return (vsx::u32x4)vec_cmpeq(a.v, b.v); }
+
+  __forceinline vboolf4 select(const vboolf4& m, const vboolf4& t, const vboolf4& f) {
+    return vec_sel(f.v, t.v, m.v);
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Movement/Shifting/Shuffling Functions
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4 unpacklo(const vboolf4& a, const vboolf4& b) { return vec_mergeh(a.v, b.v); }
+  __forceinline vboolf4 unpackhi(const vboolf4& a, const vboolf4& b) { return vec_mergel(a.v, b.v); }
+
+  template<int i0, int i1, int i2, int i3>
+  __forceinline vboolf4 shuffle(const vboolf4& v) {
+    return __builtin_shuffle(v.v, (vsx::u32x4){i0, i1, i2, i3});
+  }
+
+  template<int i0, int i1, int i2, int i3>
+  __forceinline vboolf4 shuffle(const vboolf4& a, const vboolf4& b) {
+    return __builtin_shuffle(a.v, b.v, (vsx::u32x4){i0, i1, 4+i2, 4+i3});
+  }
+
+  template<int i0>
+  __forceinline vboolf4 shuffle(const vboolf4& v) {
+    return vec_splat(v.v, i0);
+  }
+
+  template<> __forceinline vboolf4 shuffle<1, 0, 3, 2>(const vboolf4& v) { return (vsx::u32x4)vec_rl((vsx::u64x2)v.v, vec_splats(32ull)); }
+  template<> __forceinline vboolf4 shuffle<1, 2, 3, 0>(const vboolf4& v) { return vec_sld(v.v, v.v, 12); }
+  template<> __forceinline vboolf4 shuffle<3, 0, 1, 2>(const vboolf4& v) { return vec_sld(v.v, v.v, 4); }
+
+  template<int dst, int src, int clr> __forceinline vboolf4 insert(const vboolf4& a, const vboolf4& b) {
+    vsx::u32x4 r = __builtin_shuffle(a.v, b.v, (vsx::u32x4){ dst==0 ? 4+src : 0, dst==1 ? 4+src : 1, dst==2 ? 4+src : 2, dst==3 ? 4+src : 3 });
+    if (clr) r = vec_andc(r, vsx::blend_mask<clr>());
+    return r;
+  }
+  template<int dst, int src> __forceinline vboolf4 insert(const vboolf4& a, const vboolf4& b) { return insert<dst, src, 0>(a, b); }
+  template<int dst> __forceinline vboolf4 insert(const vboolf4& a, const bool b) { return insert<dst, 0>(a, vboolf4(b)); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Reduction Operations
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline bool reduce_and(const vboolf4& a) { return vsx::all(a.v); }
+  __forceinline bool reduce_or (const vboolf4& a) { return vsx::any(a.v); }
+
+  __forceinline bool all (const vboolf4& b) { return vsx::all(b.v); }
+  __forceinline bool any (const vboolf4& b) { return vsx::any(b.v); }
+  __forceinline bool none(const vboolf4& b) { return vsx::none(b.v); }
+
+  __forceinline bool all (const vboolf4& valid, const vboolf4& b) { return all((!valid) | b); }
+  __forceinline bool any (const vboolf4& valid, const vboolf4& b) { return any(valid & b); }
+  __forceinline bool none(const vboolf4& valid, const vboolf4& b) { return none(valid & b); }
+
+  __forceinline size_t movemask(const vboolf4& a) { return vsx::movemask(a.v); }
+  __forceinline size_t popcnt(const vboolf4& a) { return __builtin_popcount(vsx::movemask(a.v)); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Get/Set Functions
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline bool get(const vboolf4& a, size_t index) { return a[index]; }
+  __forceinline void set(vboolf4& a, size_t index)       { a[index] = -1; }
+  __forceinline void clear(vboolf4& a, size_t index)     { a[index] =  0; }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Output Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline embree_ostream operator <<(embree_ostream cout, const vboolf4& a) {
+    return cout << "<" << a[0] << ", " << a[1] << ", " << a[2] << ", " << a[3] << ">";
+  }
+}
