+// Copyright 2009-2021 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// powerpc64le: Vec3fa / Vec3fx on VSX (see ../simd/vsx/vsx.h).  The storage
+// member keeps its name m128 because common/math/vec3.h and the tutorials
+// reach into it; it is a __vector float.
+
+#pragma once
+
+#include "../sys/alloc.h"
+#include "emath.h"
+#include "../simd/sse.h"
+
+namespace embree
+{
+  ////////////////////////////////////////////////////////////////////////////////
+  /// VSX Vec3fa Type
+  ////////////////////////////////////////////////////////////////////////////////
+
+  struct __aligned(16) Vec3fa
+  {
+    ALIGNED_STRUCT_(16);
+
+    typedef float Scalar;
+    enum { N = 3 };
+    union {
+      vsx::f32x4 m128;
+      struct { float x,y,z; };
+    };
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constructors, Assignment & Cast Operators
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline Vec3fa( ) {}
+    __forceinline Vec3fa( const vsx::f32x4 a ) : m128(a) {}
+
+    __forceinline Vec3fa            ( const Vec3<float>& other ) { m128 = (vsx::f32x4){other.x, other.y, other.z, 0.0f}; }
+
+    __forceinline Vec3fa            ( const Vec3fa& other ) { m128 = other.m128; }
+    __forceinline Vec3fa& operator =( const Vec3fa& other ) { m128 = other.m128; return *this; }
+
+    __forceinline explicit Vec3fa( const float a ) : m128(vec_splats(a)) {}
+    __forceinline          Vec3fa( const float x, const float y, const float z) : m128((vsx::f32x4){x, y, z, 0.0f}) {}
+
+    __forceinline explicit Vec3fa( const vsx::i32x4 a ) : m128(vec_ctf(a, 0)) {}
+
+    __forceinline explicit operator const vfloat4() const { return vfloat4(m128); }
+    __forceinline explicit operator const   vint4() const { return vint4(vsx::cvt_nearest(m128)); }
+    __forceinline explicit operator const  Vec2fa() const { return Vec2fa(m128); }
+    __forceinline explicit operator const  Vec3ia() const { return Vec3ia(vsx::cvt_nearest(m128)); }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Loads and Stores
+    ////////////////////////////////////////////////////////////////////////////////
+
+    static __forceinline Vec3fa load( const void* const a ) {
+      const vsx::u32x4 xyz = { ~0u, ~0u, ~0u, 0u };
+      return Vec3fa(vec_and(vec_xl(0, (const float*)a), (vsx::f32x4)xyz));
+    }
+
+    static __forceinline Vec3fa loadu( const void* const a ) {
+      return Vec3fa(vec_xl(0, (const float*)a));
+    }
+
+    static __forceinline void storeu ( void* ptr, const Vec3fa& v ) {
+      vec_xst(v.m128, 0, (float*)ptr);
+    }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constants
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline Vec3fa( ZeroTy   ) : m128(vec_splats(0.0f)) {}
+    __forceinline Vec3fa( OneTy    ) : m128(vec_splats(1.0f)) {}
+    __forceinline Vec3fa( PosInfTy ) : m128(vec_splats((float)pos_inf)) {}
+    __forceinline Vec3fa( NegInfTy ) : m128(vec_splats((float)neg_inf)) {}
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Array Access
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline const float& operator []( const size_t index ) const { assert(index < 3); return (&x)[index]; }
+    __forceinline       float& operator []( const size_t index )       { assert(index < 3); return (&x)[index]; }
+  };
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Unary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline Vec3fa operator +( const Vec3fa& a ) { return a; }
+  __forceinline Vec3fa operator -( const Vec3fa& a ) { return vec_neg(a.m128); }
+  __forceinline Vec3fa abs  ( const Vec3fa& a ) { return vec_abs(a.m128); }
+  __forceinline Vec3fa sign ( const Vec3fa& a ) {
+    return vec_sel(vec_splats(1.0f), vec_splats(-1.0f), vec_cmplt(a.m128, vec_splats(0.0f)));
+  }
+
