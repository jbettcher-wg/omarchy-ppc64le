-  MESSAGE(STATUS "Building for ppc64le (SSE kernels on VSX via the compiler's compatibility headers)")
   SET(EMBREE_PPC64LE ON)
+  # The 4-wide SIMD layer written directly on VSX (common/simd/vsx, *_vsx.h);
