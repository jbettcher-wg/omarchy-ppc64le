diff -ruN -x rtcore_config.h -x config.h -x hash.h -x README.md embree-4.4.1.orig/common/simd/vuint4_vsx.h embree-4.4.1/common/simd/vuint4_vsx.h
--- embree-4.4.1.orig/common/simd/vuint4_vsx.h	1969-12-31 17:00:00.000000000 -0700
+++ embree-4.4.1/common/simd/vuint4_vsx.h	2026-09-11 11:25:51.511393783 -0600
@@ -0,0 +1,257 @@
+// Copyright 2009-2021 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// powerpc64le: 4-wide unsigned int type on VSX (see vsx/vsx.h).
+
+#pragma once
+
+#include "../math/emath.h"
+
+#define vboolf vboolf_impl
+#define vboold vboold_impl
+#define vint vint_impl
+#define vuint vuint_impl
+#define vllong vllong_impl
+#define vfloat vfloat_impl
+#define vdouble vdouble_impl
+
+namespace embree
+{
+  /* 4-wide VSX unsigned integer type */
+  template<>
+  struct vuint<4>
+  {
+    ALIGNED_STRUCT_(16);
+
+    typedef vboolf4 Bool;
+    typedef vuint4   Int;
+    typedef vfloat4 Float;
+
+    enum  { size = 4 }; // number of SIMD elements
+    union { vsx::u32x4 v; unsigned int i[4]; }; // data
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constructors, Assignment & Cast Operators
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline vuint() {}
+    __forceinline vuint(const vuint4& a) { v = a.v; }
+    __forceinline vuint4& operator =(const vuint4& a) { v = a.v; return *this; }
+
+    __forceinline vuint(const vsx::u32x4 a) : v(a) {}
+    __forceinline operator const vsx::u32x4&() const { return v; }
+    __forceinline operator       vsx::u32x4&()       { return v; }
+
+    __forceinline vuint(unsigned int a) : v(vec_splats(a)) {}
+    __forceinline vuint(unsigned int a, unsigned int b, unsigned int c, unsigned int d) : v((vsx::u32x4){a, b, c, d}) {}
+
+    __forceinline explicit vuint(const vboolf4& a) : v(a.v) {}
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constants
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline vuint(ZeroTy)   : v(vec_splats(0u)) {}
+    __forceinline vuint(OneTy)    : v(vec_splats(1u)) {}
+    __forceinline vuint(PosInfTy) : v(vec_splats(unsigned(pos_inf))) {}
+    __forceinline vuint(StepTy)   : v((vsx::u32x4){0, 1, 2, 3}) {}
+    __forceinline vuint(TrueTy)   : v(vec_splats(~0u)) {}
+    __forceinline vuint(UndefinedTy) : v(vec_splats(0u)) {}
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Loads and Stores
+    ////////////////////////////////////////////////////////////////////////////////
+
+    static __forceinline vuint4 load (const void* a) { return vec_xl(0, (const unsigned int*)a); }
+    static __forceinline vuint4 loadu(const void* a) { return vec_xl(0, (const unsigned int*)a); }
+
+    static __forceinline void store (void* ptr, const vuint4& v) { vec_xst(v.v, 0, (unsigned int*)ptr); }
+    static __forceinline void storeu(void* ptr, const vuint4& v) { vec_xst(v.v, 0, (unsigned int*)ptr); }
+
+    static __forceinline vuint4 load (const vbool4& mask, const void* a) { return vec_and(load (a).v, mask.v); }
+    static __forceinline vuint4 loadu(const vbool4& mask, const void* a) { return vec_and(loadu(a).v, mask.v); }
+
+    static __forceinline void store (const vboolf4& mask, void* ptr, const vuint4& i) { store (ptr,select(mask,i,load (ptr))); }
+    static __forceinline void storeu(const vboolf4& mask, void* ptr, const vuint4& i) { storeu(ptr,select(mask,i,loadu(ptr))); }
+
+    static __forceinline vuint4 load(const unsigned char* ptr) {
+      return vsx::load4u8(ptr);
+    }
+
+    static __forceinline vuint4 loadu(const unsigned char* ptr) {
+      return vsx::load4u8(ptr);
+    }
+
+    static __forceinline vuint4 load(const unsigned short* ptr) {
+      return vsx::load4u16(ptr);
+    }
+
+    static __forceinline vuint4 load_nt(void* ptr) {
+      return load(ptr);
+    }
+
+    static __forceinline void store_nt(void* ptr, const vuint4& v) {
+      store(ptr, v);
+    }
+
+    template<int scale = 4>
+    static __forceinline vuint4 gather(const unsigned int* ptr, const vint4& index) {
+      return vuint4(
+          *(unsigned int*)(((char*)ptr)+scale*index[0]),
+          *(unsigned int*)(((char*)ptr)+scale*index[1]),
+          *(unsigned int*)(((char*)ptr)+scale*index[2]),
+          *(unsigned int*)(((char*)ptr)+scale*index[3]));
+    }
+
+    template<int scale = 4>
+    static __forceinline vuint4 gather(const vboolf4& mask, const unsigned int* ptr, const vint4& index) {
+      vuint4 r = zero;
+      if (likely(mask[0])) r[0] = *(unsigned int*)(((char*)ptr)+scale*index[0]);
+      if (likely(mask[1])) r[1] = *(unsigned int*)(((char*)ptr)+scale*index[1]);
+      if (likely(mask[2])) r[2] = *(unsigned int*)(((char*)ptr)+scale*index[2]);
+      if (likely(mask[3])) r[3] = *(unsigned int*)(((char*)ptr)+scale*index[3]);
+      return r;
+    }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Array Access
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline const unsigned int& operator [](size_t index) const { assert(index < 4); return i[index]; }
+    __forceinline       unsigned int& operator [](size_t index)       { assert(index < 4); return i[index]; }
+
+    friend __forceinline vuint4 select(const vboolf4& m, const vuint4& t, const vuint4& f) {
+      return vec_sel(f.v, t.v, m.v);
+    }
+  };
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Unary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4 asBool(const vuint4& a) { return vboolf4(a.v); }
+
+  __forceinline vuint4 operator +(const vuint4& a) { return a; }
+  __forceinline vuint4 operator -(const vuint4& a) { return vec_splats(0u) - a.v; }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Binary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vuint4 operator +(const vuint4& a, const vuint4& b) { return a.v + b.v; }
+  __forceinline vuint4 operator +(const vuint4& a, unsigned int  b) { return a + vuint4(b); }
+  __forceinline vuint4 operator +(unsigned int  a, const vuint4& b) { return vuint4(a) + b; }
+
+  __forceinline vuint4 operator -(const vuint4& a, const vuint4& b) { return a.v - b.v; }
+  __forceinline vuint4 operator -(const vuint4& a, unsigned int  b) { return a - vuint4(b); }
+  __forceinline vuint4 operator -(unsigned int  a, const vuint4& b) { return vuint4(a) - b; }
+
+  __forceinline vuint4 operator &(const vuint4& a, const vuint4& b) { return vec_and(a.v, b.v); }
+  __forceinline vuint4 operator &(const vuint4& a, unsigned int  b) { return a & vuint4(b); }
+  __forceinline vuint4 operator &(unsigned int  a, const vuint4& b) { return vuint4(a) & b; }
+
+  __forceinline vuint4 operator |(const vuint4& a, const vuint4& b) { return vec_or(a.v, b.v); }
+  __forceinline vuint4 operator |(const vuint4& a, unsigned int  b) { return a | vuint4(b); }
+  __forceinline vuint4 operator |(unsigned int  a, const vuint4& b) { return vuint4(a) | b; }
+
+  __forceinline vuint4 operator ^(const vuint4& a, const vuint4& b) { return vec_xor(a.v, b.v); }
+  __forceinline vuint4 operator ^(const vuint4& a, unsigned int  b) { return a ^ vuint4(b); }
+  __forceinline vuint4 operator ^(unsigned int  a, const vuint4& b) { return vuint4(a) ^ b; }
+
+  __forceinline vuint4 operator <<(const vuint4& a, unsigned int n) { return vec_sl(a.v, vec_splats(n)); }
+  __forceinline vuint4 operator >>(const vuint4& a, unsigned int n) { return vec_sr(a.v, vec_splats(n)); }
+
+  __forceinline vuint4 sll (const vuint4& a, unsigned int b) { return vec_sl (a.v, vec_splats(b)); }
+  __forceinline vuint4 sra (const vuint4& a, unsigned int b) { return (vsx::u32x4)vec_sra((vsx::i32x4)a.v, vec_splats(b)); }
+  __forceinline vuint4 srl (const vuint4& a, unsigned int b) { return vec_sr (a.v, vec_splats(b)); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Assignment Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vuint4& operator +=(vuint4& a, const vuint4& b) { return a = a + b; }
+  __forceinline vuint4& operator +=(vuint4& a, unsigned int  b) { return a = a + b; }
+
+  __forceinline vuint4& operator -=(vuint4& a, const vuint4& b) { return a = a - b; }
+  __forceinline vuint4& operator -=(vuint4& a, unsigned int  b) { return a = a - b; }
+
+  __forceinline vuint4& operator &=(vuint4& a, const vuint4& b) { return a = a & b; }
+  __forceinline vuint4& operator &=(vuint4& a, unsigned int  b) { return a = a & b; }
+
+  __forceinline vuint4& operator |=(vuint4& a, const vuint4& b) { return a = a | b; }
+  __forceinline vuint4& operator |=(vuint4& a, unsigned int  b) { return a = a | b; }
+
+  __forceinline vuint4& operator <<=(vuint4& a, unsigned int  b) { return a = a << b; }
+  __forceinline vuint4& operator >>=(vuint4& a, unsigned int  b) { return a = a >> b; }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Comparison Operators + Select
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4 operator ==(const vuint4& a, const vuint4& b) { return (vsx::u32x4)vec_cmpeq(a.v, b.v); }
+  __forceinline vboolf4 operator !=(const vuint4& a, const vuint4& b) { return !(a == b); }
+
+  __forceinline vboolf4 operator ==(const vuint4& a, unsigned int  b) { return a == vuint4(b); }
+  __forceinline vboolf4 operator ==(unsigned int  a, const vuint4& b) { return vuint4(a) == b; }
+
+  __forceinline vboolf4 operator !=(const vuint4& a, unsigned int  b) { return a != vuint4(b); }
+  __forceinline vboolf4 operator !=(unsigned int  a, const vuint4& b) { return vuint4(a) != b; }
+
+  __forceinline vboolf4 eq(const vuint4& a, const vuint4& b) { return a == b; }
+  __forceinline vboolf4 ne(const vuint4& a, const vuint4& b) { return a != b; }
+
+  __forceinline vboolf4 eq(const vboolf4& mask, const vuint4& a, const vuint4& b) { return mask & (a == b); }
+  __forceinline vboolf4 ne(const vboolf4& mask, const vuint4& a, const vuint4& b) { return mask & (a != b); }
+
+  template<int mask>
+  __forceinline vuint4 select(const vuint4& t, const vuint4& f) {
+    return vec_sel(f.v, t.v, vsx::blend_mask<mask>());
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  // Movement/Shifting/Shuffling Functions
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vuint4 unpacklo(const vuint4& a, const vuint4& b) { return vec_mergeh(a.v, b.v); }
+  __forceinline vuint4 unpackhi(const vuint4& a, const vuint4& b) { return vec_mergel(a.v, b.v); }
+
+  template<int i0, int i1, int i2, int i3>
+  __forceinline vuint4 shuffle(const vuint4& v) {
+    return __builtin_shuffle(v.v, (vsx::u32x4){i0, i1, i2, i3});
+  }
+
+  template<int i0, int i1, int i2, int i3>
+  __forceinline vuint4 shuffle(const vuint4& a, const vuint4& b) {
+    return __builtin_shuffle(a.v, b.v, (vsx::u32x4){i0, i1, 4+i2, 4+i3});
+  }
+
+  template<int i>
+  __forceinline vuint4 shuffle(const vuint4& v) {
+    return vec_splat(v.v, i);
+  }
+
+  template<> __forceinline vuint4 shuffle<1, 0, 3, 2>(const vuint4& v) { return (vsx::u32x4)vec_rl((vsx::u64x2)v.v, vec_splats(32ull)); }
+  template<> __forceinline vuint4 shuffle<1, 2, 3, 0>(const vuint4& v) { return vec_sld(v.v, v.v, 12); }
+  template<> __forceinline vuint4 shuffle<3, 0, 1, 2>(const vuint4& v) { return vec_sld(v.v, v.v, 4); }
+
+  template<int src> __forceinline unsigned int extract(const vuint4& b) { return vec_extract(b.v, src); }
+  template<int dst> __forceinline vuint4 insert(const vuint4& a, const unsigned b) { return vec_insert(b, a.v, dst); }
+
+  __forceinline unsigned int toScalar(const vuint4& v) { return vec_extract(v.v, 0); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Output Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline embree_ostream operator <<(embree_ostream cout, const vuint4& a) {
+    return cout << "<" << a[0] << ", " << a[1] << ", " << a[2] << ", " << a[3] << ">";
+  }
+}
+
+#undef vboolf
+#undef vboold
+#undef vint
+#undef vuint
+#undef vllong
+#undef vfloat
+#undef vdouble
