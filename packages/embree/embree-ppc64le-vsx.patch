diff -ruN -x rtcore_config.h -x config.h -x hash.h -x README.md embree-4.4.1.orig/common/math/color_vsx.h embree-4.4.1/common/math/color_vsx.h
--- embree-4.4.1.orig/common/math/color_vsx.h	1969-12-31 17:00:00.000000000 -0700
+++ embree-4.4.1/common/math/color_vsx.h	2026-09-11 12:03:00.853054760 -0600
@@ -0,0 +1,224 @@
+// Copyright 2009-2021 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// powerpc64le: Color / Color4 on VSX (see ../simd/vsx/vsx.h).
+
+#pragma once
+
+#include "constants.h"
+#include "col3.h"
+#include "col4.h"
+
+#include "../simd/sse.h"
+
+namespace embree
+{
+  ////////////////////////////////////////////////////////////////////////////////
+  /// VSX RGBA Color Class
+  ////////////////////////////////////////////////////////////////////////////////
+
+  struct Color4
+  {
+    union {
+      vsx::f32x4 m128;
+      struct { float r,g,b,a; };
+    };
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Construction
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline Color4 () {}
+    __forceinline Color4 ( const vsx::f32x4 a ) : m128(a) {}
+
+    __forceinline explicit Color4 (const float v) : m128(vec_splats(v)) {}
+    __forceinline          Color4 (const float r, const float g, const float b, const float a) : m128((vsx::f32x4){r, g, b, a}) {}
+
+    __forceinline explicit Color4 ( const Col3uc& other ) { m128 = (vsx::f32x4){(float)other.r, (float)other.g, (float)other.b, 255.0f} * vec_splats(one_over_255); }
+    __forceinline explicit Color4 ( const Col3f&  other ) { m128 = (vsx::f32x4){other.r, other.g, other.b, 1.0f}; }
+    __forceinline explicit Color4 ( const Col4uc& other ) { m128 = (vsx::f32x4){(float)other.r, (float)other.g, (float)other.b, (float)other.a} * vec_splats(one_over_255); }
+    __forceinline explicit Color4 ( const Col4f&  other ) { m128 = (vsx::f32x4){other.r, other.g, other.b, other.a}; }
+
+    __forceinline Color4           ( const Color4& other ) : m128(other.m128) {}
+    __forceinline Color4& operator=( const Color4& other ) { m128 = other.m128; return *this; }
+
+    __forceinline operator const vsx::f32x4&() const { return m128; }
+    __forceinline operator       vsx::f32x4&()       { return m128; }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Set
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline void set(Col3f& d) const { d.r = r; d.g = g; d.b = b; }
+    __forceinline void set(Col4f& d) const { d.r = r; d.g = g; d.b = b; d.a = a; }
+    __forceinline void set(Col3uc& d) const
+    {
+      vfloat4 s = clamp(vfloat4(m128))*255.0f;
+      d.r = (unsigned char)(s[0]);
+      d.g = (unsigned char)(s[1]);
+      d.b = (unsigned char)(s[2]);
+    }
+    __forceinline void set(Col4uc& d) const
+    {
+      vfloat4 s = clamp(vfloat4(m128))*255.0f;
+      d.r = (unsigned char)(s[0]);
+      d.g = (unsigned char)(s[1]);
+      d.b = (unsigned char)(s[2]);
+      d.a = (unsigned char)(s[3]);
+    }
+    __forceinline void set(float &f) const
+    {
+      f = 0.2126f*r+0.7125f*g+0.0722f*b; // sRGB luminance.
+    }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constants
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline Color4( ZeroTy   ) : m128(vec_splats(0.0f)) {}
+    __forceinline Color4( OneTy    ) : m128(vec_splats(1.0f)) {}
+    __forceinline Color4( PosInfTy ) : m128(vec_splats((float)pos_inf)) {}
+    __forceinline Color4( NegInfTy ) : m128(vec_splats((float)neg_inf)) {}
+  };
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// VSX RGB Color Class
+  ////////////////////////////////////////////////////////////////////////////////
+
+  struct Color
+  {
+    union {
+      vsx::f32x4 m128;
+      struct { float r,g,b; };
+    };
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Construction
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline Color () {}
+    __forceinline Color ( const vsx::f32x4 a ) : m128(a) {}
+
+    __forceinline explicit Color  (const float v)                               : m128(vec_splats(v)) {}
+    __forceinline          Color  (const float r, const float g, const float b) : m128((vsx::f32x4){r, g, b, 0.0f}) {}
+
+    __forceinline Color           ( const Color& other ) : m128(other.m128) {}
+    __forceinline Color& operator=( const Color& other ) { m128 = other.m128; return *this; }
+
+    __forceinline Color           ( const Color4& other ) : m128(other.m128) {}
+    __forceinline Color& operator=( const Color4& other ) { m128 = other.m128; return *this; }
+
+    __forceinline operator const vsx::f32x4&() const { return m128; }
+    __forceinline operator       vsx::f32x4&()       { return m128; }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Set
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline void set(Col3f& d) const { d.r = r; d.g = g; d.b = b; }
+    __forceinline void set(Col4f& d) const { d.r = r; d.g = g; d.b = b; d.a = 1.0f; }
+    __forceinline void set(Col3uc& d) const
+    {
+      vfloat4 s = clamp(vfloat4(m128))*255.0f;
+      d.r = (unsigned char)(s[0]);
+      d.g = (unsigned char)(s[1]);
+      d.b = (unsigned char)(s[2]);
+    }
+    __forceinline void set(Col4uc& d) const
+    {
+      vfloat4 s = clamp(vfloat4(m128))*255.0f;
+      d.r = (unsigned char)(s[0]);
+      d.g = (unsigned char)(s[1]);
+      d.b = (unsigned char)(s[2]);
+      d.a = 255;
+    }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constants
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline Color( ZeroTy   ) : m128(vec_splats(0.0f)) {}
+    __forceinline Color( OneTy    ) : m128(vec_splats(1.0f)) {}
+    __forceinline Color( PosInfTy ) : m128(vec_splats((float)pos_inf)) {}
+    __forceinline Color( NegInfTy ) : m128(vec_splats((float)neg_inf)) {}
+  };
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Unary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline const Color operator +( const Color& a ) { return a; }
+  __forceinline const Color operator -( const Color& a ) { return vec_neg(a.m128); }
+  __forceinline const Color abs  ( const Color& a ) { return vec_abs(a.m128); }
+  __forceinline const Color rcp  ( const Color& a ) { return vsx::rcp(a.m128); }
+  __forceinline const Color rsqrt( const Color& a ) { return vsx::rsqrt(a.m128); }
+  __forceinline const Color sqrt ( const Color& a ) { return vec_sqrt(a.m128); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Binary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline const Color operator +( const Color& a, const Color& b ) { return a.m128 + b.m128; }
+  __forceinline const Color operator -( const Color& a, const Color& b ) { return a.m128 - b.m128; }
+  __forceinline const Color operator *( const Color& a, const Color& b ) { return a.m128 * b.m128; }
+  __forceinline const Color operator *( const Color& a, const float  b ) { return a * Color(b); }
+  __forceinline const Color operator *( const float  a, const Color& b ) { return Color(a) * b; }
+  __forceinline const Color operator /( const Color& a, const Color& b ) { return a * rcp(b); }
+  __forceinline const Color operator /( const Color& a, const float  b ) { return a * rcp(b); }
+
+  __forceinline const Color min( const Color& a, const Color& b ) { return vsx::fmin(a.m128, b.m128); }
+  __forceinline const Color max( const Color& a, const Color& b ) { return vsx::fmax(a.m128, b.m128); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Assignment Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline const Color operator+=(Color& a, const Color& b) { return a = a + b; }
+  __forceinline const Color operator-=(Color& a, const Color& b) { return a = a - b; }
+  __forceinline const Color operator*=(Color& a, const Color& b) { return a = a * b; }
+  __forceinline const Color operator/=(Color& a, const Color& b) { return a = a / b; }
+  __forceinline const Color operator*=(Color& a, const float b      ) { return a = a * b; }
+  __forceinline const Color operator/=(Color& a, const float b      ) { return a = a / b; }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Reductions
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline float reduce_add(const Color& v) { return v.r+v.g+v.b; }
+  __forceinline float reduce_mul(const Color& v) { return v.r*v.g*v.b; }
+  __forceinline float reduce_min(const Color& v) { return min(v.r,v.g,v.b); }
+  __forceinline float reduce_max(const Color& v) { return max(v.r,v.g,v.b); }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Comparison Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline bool operator ==( const Color& a, const Color& b ) { return (vsx::movemask((vsx::u32x4)vec_cmpeq(a.m128, b.m128)) & 7) == 7; }
+  __forceinline bool operator !=( const Color& a, const Color& b ) { return (vsx::movemask((vsx::u32x4)vec_cmpeq(a.m128, b.m128)) & 7) != 7; }
+  __forceinline bool operator < ( const Color& a, const Color& b ) {
+    if (a.r != b.r) return a.r < b.r;
+    if (a.g != b.g) return a.g < b.g;
+    if (a.b != b.b) return a.b < b.b;
+    return false;
+  }
+
+   ////////////////////////////////////////////////////////////////////////////////
+  /// Select
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline const Color select( bool s, const Color& t, const Color& f ) {
+    return vec_sel(f.m128, t.m128, vsx::splat_mask(s));
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Special Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  /*! computes luminance of a color */
+  __forceinline float luminance (const Color& a) { return madd(0.212671f,a.r,madd(0.715160f,a.g,0.072169f*a.b)); }
+
+  /*! output operator */
+  __forceinline embree_ostream operator<<(embree_ostream cout, const Color& a) {
+    return cout << "(" << a.r << ", " << a.g << ", " << a.b << ")";
+  }
+}
