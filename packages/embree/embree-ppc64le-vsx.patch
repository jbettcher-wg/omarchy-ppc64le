+// Copyright 2009-2021 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// powerpc64le: 4-wide float type on VSX (see vsx/vsx.h).
+//
+// Semantics decided here, where VSX and SSE differ:
+//  - madd/msub/nmadd/nmsub are fused (xvmadd*/xvmsub*/xvnmsub*/xvnmadd*),
+//    as on the AVX2 and NEON tiers; the SSE4.2 tier computes them unfused.
+//  - min/max keep SSE minps/maxps NaN semantics (second operand when the
+//    compare is unordered) via compare+select; see vsx::fmin.
+//  - vint4(vfloat4) rounds to nearest even (xvrspic + vctsxs) like cvtps2dq;
+//    out-of-range saturates where SSE returns 0x80000000.
+//  - rcp/rsqrt: xvresp/xvrsqrtesp estimates plus one Newton step (24/23 bits).
+//  - !=, >, >= are IEEE ordered/unordered as on the NEON tier: != is true
+//    for NaN operands, > and >= are false.
+
+#pragma once
+
+#define vboolf vboolf_impl
+#define vboold vboold_impl
+#define vint vint_impl
+#define vuint vuint_impl
+#define vllong vllong_impl
+#define vfloat vfloat_impl
+#define vdouble vdouble_impl
+
+namespace embree
+{
+  /* 4-wide VSX float type */
+  template<>
+  struct vfloat<4>
+  {
+    ALIGNED_STRUCT_(16);
+
+    typedef vboolf4 Bool;
+    typedef vint4   Int;
+    typedef vfloat4 Float;
+
+    enum  { size = 4 };                            // number of SIMD elements
+    union { vsx::f32x4 v; float f[4]; int i[4]; }; // data
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constructors, Assignment & Cast Operators
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline vfloat() {}
+    __forceinline vfloat(const vfloat4& other) { v = other.v; }
+
+    __forceinline vfloat4& operator =(const vfloat4& other) { v = other.v; return *this; }
+
+    __forceinline vfloat(vsx::f32x4 a) : v(a) {}
+    __forceinline operator const vsx::f32x4&() const { return v; }
+    __forceinline operator       vsx::f32x4&()       { return v; }
+
+    __forceinline vfloat(float a) : v(vec_splats(a)) {}
+    __forceinline vfloat(float a, float b, float c, float d) : v((vsx::f32x4){a, b, c, d}) {}
+
+    __forceinline explicit vfloat(const vint4& a) : v(vec_ctf(a.v, 0)) {}
+    __forceinline explicit vfloat(const vuint4& x) : v(vec_ctf(x.v, 0)) {}
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Constants
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline vfloat(ZeroTy)   : v(vec_splats(0.0f)) {}
+    __forceinline vfloat(OneTy)    : v(vec_splats(1.0f)) {}
+    __forceinline vfloat(PosInfTy) : v(vec_splats((float)pos_inf)) {}
+    __forceinline vfloat(NegInfTy) : v(vec_splats((float)neg_inf)) {}
+    __forceinline vfloat(StepTy)   : v((vsx::f32x4){0.0f, 1.0f, 2.0f, 3.0f}) {}
+    __forceinline vfloat(NaNTy)    : v(vec_splats((float)nan)) {}
+    __forceinline vfloat(UndefinedTy) : v(vec_splats(0.0f)) {}
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Loads and Stores
+    ////////////////////////////////////////////////////////////////////////////////
+
+    static __forceinline vfloat4 load (const void* a) { return vec_xl(0, (const float*)a); }
+    static __forceinline vfloat4 loadu(const void* a) { return vec_xl(0, (const float*)a); }
+
+    static __forceinline void store (void* ptr, const vfloat4& v) { vec_xst(v.v, 0, (float*)ptr); }
+    static __forceinline void storeu(void* ptr, const vfloat4& v) { vec_xst(v.v, 0, (float*)ptr); }
+
+    static __forceinline vfloat4 load (const vboolf4& mask, const void* ptr) { return vec_and(load (ptr).v, (vsx::f32x4)mask.v); }
+    static __forceinline vfloat4 loadu(const vboolf4& mask, const void* ptr) { return vec_and(loadu(ptr).v, (vsx::f32x4)mask.v); }
+
+    static __forceinline void store (const vboolf4& mask, void* ptr, const vfloat4& v) { store (ptr,select(mask,v,load (ptr))); }
+    static __forceinline void storeu(const vboolf4& mask, void* ptr, const vfloat4& v) { storeu(ptr,select(mask,v,loadu(ptr))); }
+
+    static __forceinline vfloat4 broadcast(const void* a) { return vec_splats(*(const float*)a); }
+
+    static __forceinline vfloat4 load_nt (const float* ptr) {
+      return load(ptr);
+    }
+
+    static __forceinline vfloat4 load(const char* ptr) {
+      return vec_ctf(vsx::load4s8((const signed char*)ptr), 0);
+    }
+
+    static __forceinline vfloat4 load(const unsigned char* ptr) {
+      return vec_ctf(vsx::load4u8(ptr), 0);
+    }
+
+    static __forceinline vfloat4 load(const short* ptr) {
+      return vec_ctf(vsx::load4s16(ptr), 0);
+    }
+
+    static __forceinline vfloat4 load(const unsigned short* ptr) {
+      return vec_ctf(vsx::load4u16(ptr), 0) * vec_splats(1.0f/65535.0f);
+    }
+
+    static __forceinline void store_nt(void* ptr, const vfloat4& v)
+    {
+      store(ptr, v);
+    }
+
+    template<int scale = 4>
+    static __forceinline vfloat4 gather(const float* ptr, const vint4& index) {
+      return vfloat4(
+        *(float*)(((char*)ptr)+scale*index[0]),
+        *(float*)(((char*)ptr)+scale*index[1]),
+        *(float*)(((char*)ptr)+scale*index[2]),
+        *(float*)(((char*)ptr)+scale*index[3]));
+    }
+
+    template<int scale = 4>
+    static __forceinline vfloat4 gather(const vboolf4& mask, const float* ptr, const vint4& index) {
+      vfloat4 r = zero;
+      if (likely(mask[0])) r[0] = *(float*)(((char*)ptr)+scale*index[0]);
+      if (likely(mask[1])) r[1] = *(float*)(((char*)ptr)+scale*index[1]);
+      if (likely(mask[2])) r[2] = *(float*)(((char*)ptr)+scale*index[2]);
+      if (likely(mask[3])) r[3] = *(float*)(((char*)ptr)+scale*index[3]);
+      return r;
+    }
+
+    template<int scale = 4>
+    static __forceinline void scatter(void* ptr, const vint4& index, const vfloat4& v)
+    {
+      *(float*)(((char*)ptr)+scale*index[0]) = v[0];
+      *(float*)(((char*)ptr)+scale*index[1]) = v[1];
+      *(float*)(((char*)ptr)+scale*index[2]) = v[2];
+      *(float*)(((char*)ptr)+scale*index[3]) = v[3];
+    }
+
+    template<int scale = 4>
+    static __forceinline void scatter(const vboolf4& mask, void* ptr, const vint4& index, const vfloat4& v)
+    {
+      if (likely(mask[0])) *(float*)(((char*)ptr)+scale*index[0]) = v[0];
+      if (likely(mask[1])) *(float*)(((char*)ptr)+scale*index[1]) = v[1];
+      if (likely(mask[2])) *(float*)(((char*)ptr)+scale*index[2]) = v[2];
+      if (likely(mask[3])) *(float*)(((char*)ptr)+scale*index[3]) = v[3];
+    }
+
+    static __forceinline void store(const vboolf4& mask, char* ptr, const vint4& ofs, const vfloat4& v) {
+      scatter<1>(mask,ptr,ofs,v);
+    }
+    static __forceinline void store(const vboolf4& mask, float* ptr, const vint4& ofs, const vfloat4& v) {
+      scatter<4>(mask,ptr,ofs,v);
+    }
+
+    ////////////////////////////////////////////////////////////////////////////////
+    /// Array Access
+    ////////////////////////////////////////////////////////////////////////////////
+
+    __forceinline const float& operator [](size_t index) const { assert(index < 4); return f[index]; }
+    __forceinline       float& operator [](size_t index)       { assert(index < 4); return f[index]; }
+
+    friend __forceinline vfloat4 select(const vboolf4& m, const vfloat4& t, const vfloat4& f) {
+      return vec_sel(f.v, t.v, m.v);
+    }
+  };
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Load/Store
+  ////////////////////////////////////////////////////////////////////////////////
+
+  template<> struct mem<vfloat4>
+  {
+    static __forceinline vfloat4 load (const vboolf4& mask, const void* ptr) { return vfloat4::load (mask,ptr); }
+    static __forceinline vfloat4 loadu(const vboolf4& mask, const void* ptr) { return vfloat4::loadu(mask,ptr); }
+
+    static __forceinline void store (const vboolf4& mask, void* ptr, const vfloat4& v) { vfloat4::store (mask,ptr,v); }
+    static __forceinline void storeu(const vboolf4& mask, void* ptr, const vfloat4& v) { vfloat4::storeu(mask,ptr,v); }
+  };
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Unary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4 asFloat(const vint4&   a) { return (vsx::f32x4)a.v; }
+  __forceinline vint4   asInt  (const vfloat4& a) { return (vsx::i32x4)a.v; }
+  __forceinline vuint4  asUInt (const vfloat4& a) { return (vsx::u32x4)a.v; }
+
+  __forceinline vint4   toInt  (const vfloat4& a) { return vint4(a); }
+  __forceinline vfloat4 toFloat(const vint4&   a) { return vfloat4(a); }
+
+  __forceinline vfloat4 operator +(const vfloat4& a) { return a; }
+  __forceinline vfloat4 operator -(const vfloat4& a) { return vec_neg(a.v); }
+
+  __forceinline vfloat4 abs(const vfloat4& a) { return vec_abs(a.v); }
+
+  __forceinline vfloat4 sign(const vfloat4& a) { return vec_sel(vec_splats(1.0f), vec_splats(-1.0f), vec_cmplt(a.v, vec_splats(0.0f))); }
+
+  __forceinline vfloat4 signmsk(const vfloat4& a) { return vec_and(a.v, (vsx::f32x4)vec_splats(0x80000000u)); }
+
+  __forceinline vfloat4 rcp(const vfloat4& a) { return vsx::rcp(a.v); }
+  __forceinline vfloat4 sqr (const vfloat4& a) { return a.v * a.v; }
+  __forceinline vfloat4 sqrt(const vfloat4& a) { return vec_sqrt(a.v); }
+  __forceinline vfloat4 rsqrt(const vfloat4& a) { return vsx::rsqrt(a.v); }
+
+  __forceinline vboolf4 isnan(const vfloat4& a) {
+    const vsx::i32x4 b = vec_and((vsx::i32x4)a.v, vec_splats(0x7fffffff));
+    return (vsx::u32x4)vec_cmpgt(b, vec_splats(0x7f800000));
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Binary Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4 operator +(const vfloat4& a, const vfloat4& b) { return a.v + b.v; }
+  __forceinline vfloat4 operator +(const vfloat4& a, float          b) { return a + vfloat4(b); }
+  __forceinline vfloat4 operator +(float          a, const vfloat4& b) { return vfloat4(a) + b; }
+
+  __forceinline vfloat4 operator -(const vfloat4& a, const vfloat4& b) { return a.v - b.v; }
+  __forceinline vfloat4 operator -(const vfloat4& a, float          b) { return a - vfloat4(b); }
+  __forceinline vfloat4 operator -(float          a, const vfloat4& b) { return vfloat4(a) - b; }
+
+  __forceinline vfloat4 operator *(const vfloat4& a, const vfloat4& b) { return a.v * b.v; }
+  __forceinline vfloat4 operator *(const vfloat4& a, float          b) { return a * vfloat4(b); }
+  __forceinline vfloat4 operator *(float          a, const vfloat4& b) { return vfloat4(a) * b; }
+
+  __forceinline vfloat4 operator /(const vfloat4& a, const vfloat4& b) { return a.v / b.v; }
+  __forceinline vfloat4 operator /(const vfloat4& a, float          b) { return a/vfloat4(b); }
+  __forceinline vfloat4 operator /(float          a, const vfloat4& b) { return vfloat4(a)/b; }
+
+  __forceinline vfloat4 operator &(const vfloat4& a, const vfloat4& b) { return vec_and(a.v, b.v); }
+  __forceinline vfloat4 operator |(const vfloat4& a, const vfloat4& b) { return vec_or (a.v, b.v); }
+  __forceinline vfloat4 operator ^(const vfloat4& a, const vfloat4& b) { return vec_xor(a.v, b.v); }
+  __forceinline vfloat4 operator ^(const vfloat4& a, const vint4&   b) { return vec_xor(a.v, (vsx::f32x4)b.v); }
+
+  __forceinline vfloat4 min(const vfloat4& a, const vfloat4& b) { return vsx::fmin(a.v, b.v); }
+  __forceinline vfloat4 min(const vfloat4& a, float          b) { return min(a, vfloat4(b)); }
+  __forceinline vfloat4 min(float          a, const vfloat4& b) { return min(vfloat4(a), b); }
+
+  __forceinline vfloat4 max(const vfloat4& a, const vfloat4& b) { return vsx::fmax(a.v, b.v); }
+  __forceinline vfloat4 max(const vfloat4& a, float          b) { return max(a, vfloat4(b)); }
+  __forceinline vfloat4 max(float          a, const vfloat4& b) { return max(vfloat4(a), b); }
+
+  /* integer min/max on the float bit patterns (valid for the non-negative
+     and same-sign inputs the traversal feeds them): vminsw/vmaxsw */
+  __forceinline vfloat4 mini(const vfloat4& a, const vfloat4& b) {
+    return (vsx::f32x4)vec_min((vsx::i32x4)a.v, (vsx::i32x4)b.v);
+  }
+
+  __forceinline vfloat4 maxi(const vfloat4& a, const vfloat4& b) {
+    return (vsx::f32x4)vec_max((vsx::i32x4)a.v, (vsx::i32x4)b.v);
+  }
+
+  __forceinline vfloat4 minui(const vfloat4& a, const vfloat4& b) {
+    return (vsx::f32x4)vec_min((vsx::u32x4)a.v, (vsx::u32x4)b.v);
+  }
+
+  __forceinline vfloat4 maxui(const vfloat4& a, const vfloat4& b) {
+    return (vsx::f32x4)vec_max((vsx::u32x4)a.v, (vsx::u32x4)b.v);
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Ternary Operators (fused)
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4 madd (const vfloat4& a, const vfloat4& b, const vfloat4& c) { return vec_madd (a.v, b.v, c.v); }  //  a*b+c
+  __forceinline vfloat4 msub (const vfloat4& a, const vfloat4& b, const vfloat4& c) { return vec_msub (a.v, b.v, c.v); }  //  a*b-c
+  __forceinline vfloat4 nmadd(const vfloat4& a, const vfloat4& b, const vfloat4& c) { return vec_nmsub(a.v, b.v, c.v); }  // -a*b+c
+  __forceinline vfloat4 nmsub(const vfloat4& a, const vfloat4& b, const vfloat4& c) { return vec_nmadd(a.v, b.v, c.v); }  // -a*b-c
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Assignment Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4& operator +=(vfloat4& a, const vfloat4& b) { return a = a + b; }
+  __forceinline vfloat4& operator +=(vfloat4& a, float          b) { return a = a + b; }
+
+  __forceinline vfloat4& operator -=(vfloat4& a, const vfloat4& b) { return a = a - b; }
+  __forceinline vfloat4& operator -=(vfloat4& a, float          b) { return a = a - b; }
+
+  __forceinline vfloat4& operator *=(vfloat4& a, const vfloat4& b) { return a = a * b; }
+  __forceinline vfloat4& operator *=(vfloat4& a, float          b) { return a = a * b; }
+
+  __forceinline vfloat4& operator /=(vfloat4& a, const vfloat4& b) { return a = a / b; }
+  __forceinline vfloat4& operator /=(vfloat4& a, float          b) { return a = a / b; }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Comparison Operators + Select
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vboolf4 operator ==(const vfloat4& a, const vfloat4& b) { return (vsx::u32x4)vec_cmpeq(a.v, b.v); }
+  __forceinline vboolf4 operator !=(const vfloat4& a, const vfloat4& b) { const vsx::u32x4 e = (vsx::u32x4)vec_cmpeq(a.v, b.v); return vec_nor(e, e); }
+  __forceinline vboolf4 operator < (const vfloat4& a, const vfloat4& b) { return (vsx::u32x4)vec_cmplt(a.v, b.v); }
+  __forceinline vboolf4 operator >=(const vfloat4& a, const vfloat4& b) { return (vsx::u32x4)vec_cmpge(a.v, b.v); }
+  __forceinline vboolf4 operator > (const vfloat4& a, const vfloat4& b) { return (vsx::u32x4)vec_cmpgt(a.v, b.v); }
+  __forceinline vboolf4 operator <=(const vfloat4& a, const vfloat4& b) { return (vsx::u32x4)vec_cmple(a.v, b.v); }
+
+  __forceinline vboolf4 operator ==(const vfloat4& a, float          b) { return a == vfloat4(b); }
+  __forceinline vboolf4 operator ==(float          a, const vfloat4& b) { return vfloat4(a) == b; }
+
+  __forceinline vboolf4 operator !=(const vfloat4& a, float          b) { return a != vfloat4(b); }
+  __forceinline vboolf4 operator !=(float          a, const vfloat4& b) { return vfloat4(a) != b; }
+
+  __forceinline vboolf4 operator < (const vfloat4& a, float          b) { return a <  vfloat4(b); }
+  __forceinline vboolf4 operator < (float          a, const vfloat4& b) { return vfloat4(a) <  b; }
+
+  __forceinline vboolf4 operator >=(const vfloat4& a, float          b) { return a >= vfloat4(b); }
+  __forceinline vboolf4 operator >=(float          a, const vfloat4& b) { return vfloat4(a) >= b; }
+
+  __forceinline vboolf4 operator > (const vfloat4& a, float          b) { return a >  vfloat4(b); }
+  __forceinline vboolf4 operator > (float          a, const vfloat4& b) { return vfloat4(a) >  b; }
+
+  __forceinline vboolf4 operator <=(const vfloat4& a, float          b) { return a <= vfloat4(b); }
+  __forceinline vboolf4 operator <=(float          a, const vfloat4& b) { return vfloat4(a) <= b; }
+
+  __forceinline vboolf4 eq(const vfloat4& a, const vfloat4& b) { return a == b; }
+  __forceinline vboolf4 ne(const vfloat4& a, const vfloat4& b) { return a != b; }
+  __forceinline vboolf4 lt(const vfloat4& a, const vfloat4& b) { return a <  b; }
+  __forceinline vboolf4 ge(const vfloat4& a, const vfloat4& b) { return a >= b; }
+  __forceinline vboolf4 gt(const vfloat4& a, const vfloat4& b) { return a >  b; }
+  __forceinline vboolf4 le(const vfloat4& a, const vfloat4& b) { return a <= b; }
+
+  __forceinline vboolf4 eq(const vboolf4& mask, const vfloat4& a, const vfloat4& b) { return mask & (a == b); }
+  __forceinline vboolf4 ne(const vboolf4& mask, const vfloat4& a, const vfloat4& b) { return mask & (a != b); }
+  __forceinline vboolf4 lt(const vboolf4& mask, const vfloat4& a, const vfloat4& b) { return mask & (a <  b); }
+  __forceinline vboolf4 ge(const vboolf4& mask, const vfloat4& a, const vfloat4& b) { return mask & (a >= b); }
+  __forceinline vboolf4 gt(const vboolf4& mask, const vfloat4& a, const vfloat4& b) { return mask & (a >  b); }
+  __forceinline vboolf4 le(const vboolf4& mask, const vfloat4& a, const vfloat4& b) { return mask & (a <= b); }
+
+  template<int mask>
+    __forceinline vfloat4 select(const vfloat4& t, const vfloat4& f)
+  {
+    return vec_sel(f.v, t.v, vsx::blend_mask<mask>());
+  }
+
+  __forceinline vfloat4 lerp(const vfloat4& a, const vfloat4& b, const vfloat4& t) {
+    return madd(t,b-a,a);
+  }
+
+  __forceinline bool isvalid(const vfloat4& v) {
+    return all((v > vfloat4(-FLT_LARGE)) & (v < vfloat4(+FLT_LARGE)));
+  }
+
+  __forceinline bool is_finite(const vfloat4& a) {
+    return all((a >= vfloat4(-FLT_MAX)) & (a <= vfloat4(+FLT_MAX)));
+  }
+
+  __forceinline bool is_finite(const vboolf4& valid, const vfloat4& a) {
+    return all(valid, (a >= vfloat4(-FLT_MAX)) & (a <= vfloat4(+FLT_MAX)));
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Rounding Functions
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4 floor(const vfloat4& a) { return vec_floor(a.v); }  // xvrspim
+  __forceinline vfloat4 ceil (const vfloat4& a) { return vec_ceil (a.v); }  // xvrspip
+  __forceinline vfloat4 trunc(const vfloat4& a) { return vec_trunc(a.v); }  // xvrspiz
+  __forceinline vfloat4 round(const vfloat4& a) { return vec_rint (a.v); }  // xvrspic: nearest even, as _MM_FROUND_TO_NEAREST_INT
+  __forceinline vfloat4 frac(const vfloat4& a) { return a-floor(a); }
+
+  __forceinline vint4 floori(const vfloat4& a) {
+    return vint4(floor(a));
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Movement/Shifting/Shuffling Functions
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4 unpacklo(const vfloat4& a, const vfloat4& b) { return vec_mergeh(a.v, b.v); }
+  __forceinline vfloat4 unpackhi(const vfloat4& a, const vfloat4& b) { return vec_mergel(a.v, b.v); }
+
+  template<int i0, int i1, int i2, int i3>
+  __forceinline vfloat4 shuffle(const vfloat4& v) {
+    return __builtin_shuffle(v.v, (vsx::u32x4){i0, i1, i2, i3});
+  }
+
+  template<int i0, int i1, int i2, int i3>
+  __forceinline vfloat4 shuffle(const vfloat4& a, const vfloat4& b) {
+    return __builtin_shuffle(a.v, b.v, (vsx::u32x4){i0, i1, 4+i2, 4+i3});
+  }
+
+  template<int i>
+  __forceinline vfloat4 shuffle(const vfloat4& v) {
+    return vec_splat(v.v, i);
+  }
+
+  /* the permutes GCC does not fold to one instruction from __builtin_shuffle */
+  template<> __forceinline vfloat4 shuffle<1, 0, 3, 2>(const vfloat4& v) { return vsx::swap_pairs(v.v); }   // vrld 32
+  template<> __forceinline vfloat4 shuffle<1, 2, 3, 0>(const vfloat4& v) { return vec_sld(v.v, v.v, 12); }  // vsldoi
+  template<> __forceinline vfloat4 shuffle<3, 0, 1, 2>(const vfloat4& v) { return vec_sld(v.v, v.v, 4); }   // vsldoi
+
+  template<int i> __forceinline float extract   (const vfloat4& a) { return vec_extract(a.v, i); }
+
+  template<int dst, int src, int clr> __forceinline vfloat4 insert(const vfloat4& a, const vfloat4& b) {
+    vsx::f32x4 r = __builtin_shuffle(a.v, b.v, (vsx::u32x4){ dst==0 ? 4+src : 0, dst==1 ? 4+src : 1, dst==2 ? 4+src : 2, dst==3 ? 4+src : 3 });
+    if (clr) r = vec_andc(r, (vsx::f32x4)vsx::blend_mask<clr>());
+    return r;
+  }
+  template<int dst, int src> __forceinline vfloat4 insert(const vfloat4& a, const vfloat4& b) { return insert<dst, src, 0>(a, b); }
+  template<int dst> __forceinline vfloat4 insert(const vfloat4& a, const float b) { return vec_insert(b, a.v, dst); }
+
+  __forceinline float toScalar(const vfloat4& v) { return vec_extract(v.v, 0); }
+
+  __forceinline vfloat4 shift_right_1(const vfloat4& x) {
+    return vec_sld(vec_splats(0.0f), x.v, 12);   // {x1,x2,x3,0}
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Sorting Network
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4 sort_ascending(const vfloat4& v)
+  {
+    const vfloat4 a0 = v;
+    const vfloat4 b0 = shuffle<1,0,3,2>(a0);
+    const vfloat4 c0 = min(a0,b0);
+    const vfloat4 d0 = max(a0,b0);
+    const vfloat4 a1 = select<0x5 /* 0b0101 */>(c0,d0);
+    const vfloat4 b1 = shuffle<2,3,0,1>(a1);
+    const vfloat4 c1 = min(a1,b1);
+    const vfloat4 d1 = max(a1,b1);
+    const vfloat4 a2 = select<0x3 /* 0b0011 */>(c1,d1);
+    const vfloat4 b2 = shuffle<0,2,1,3>(a2);
+    const vfloat4 c2 = min(a2,b2);
+    const vfloat4 d2 = max(a2,b2);
+    const vfloat4 a3 = select<0x2 /* 0b0010 */>(c2,d2);
+    return a3;
+  }
+
+  __forceinline vfloat4 sort_descending(const vfloat4& v)
+  {
+    const vfloat4 a0 = v;
+    const vfloat4 b0 = shuffle<1,0,3,2>(a0);
+    const vfloat4 c0 = max(a0,b0);
+    const vfloat4 d0 = min(a0,b0);
+    const vfloat4 a1 = select<0x5 /* 0b0101 */>(c0,d0);
+    const vfloat4 b1 = shuffle<2,3,0,1>(a1);
+    const vfloat4 c1 = max(a1,b1);
+    const vfloat4 d1 = min(a1,b1);
+    const vfloat4 a2 = select<0x3 /* 0b0011 */>(c1,d1);
+    const vfloat4 b2 = shuffle<0,2,1,3>(a2);
+    const vfloat4 c2 = max(a2,b2);
+    const vfloat4 d2 = min(a2,b2);
+    const vfloat4 a3 = select<0x2 /* 0b0010 */>(c2,d2);
+    return a3;
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Transpose (eight single-instruction merges: xxmrglw/xxmrghw)
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline void transpose(const vfloat4& r0, const vfloat4& r1, const vfloat4& r2, const vfloat4& r3, vfloat4& c0, vfloat4& c1, vfloat4& c2, vfloat4& c3)
+  {
+    vfloat4 l02 = unpacklo(r0,r2);
+    vfloat4 h02 = unpackhi(r0,r2);
+    vfloat4 l13 = unpacklo(r1,r3);
+    vfloat4 h13 = unpackhi(r1,r3);
+    c0 = unpacklo(l02,l13);
+    c1 = unpackhi(l02,l13);
+    c2 = unpacklo(h02,h13);
+    c3 = unpackhi(h02,h13);
+  }
+
+  __forceinline void transpose(const vfloat4& r0, const vfloat4& r1, const vfloat4& r2, const vfloat4& r3, vfloat4& c0, vfloat4& c1, vfloat4& c2)
+  {
+    vfloat4 l02 = unpacklo(r0,r2);
+    vfloat4 h02 = unpackhi(r0,r2);
+    vfloat4 l13 = unpacklo(r1,r3);
+    vfloat4 h13 = unpackhi(r1,r3);
+    c0 = unpacklo(l02,l13);
+    c1 = unpackhi(l02,l13);
+    c2 = unpacklo(h02,h13);
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Reductions (SSE association: lane 0 = (v0 op v1) op (v2 op v3), all lanes equal)
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline vfloat4 vreduce_min(const vfloat4& v) { vfloat4 h = min(shuffle<1,0,3,2>(v),v); return min(shuffle<2,3,0,1>(h),h); }
+  __forceinline vfloat4 vreduce_max(const vfloat4& v) { vfloat4 h = max(shuffle<1,0,3,2>(v),v); return max(shuffle<2,3,0,1>(h),h); }
+  __forceinline vfloat4 vreduce_add(const vfloat4& v) { vfloat4 h = shuffle<1,0,3,2>(v)   + v ; return shuffle<2,3,0,1>(h)   + h ; }
+
+  __forceinline float reduce_min(const vfloat4& v) { return toScalar(vreduce_min(v)); }
+  __forceinline float reduce_max(const vfloat4& v) { return toScalar(vreduce_max(v)); }
+  __forceinline float reduce_add(const vfloat4& v) { return toScalar(vreduce_add(v)); }
+
+  __forceinline size_t select_min(const vboolf4& valid, const vfloat4& v)
+  {
+    const vfloat4 a = select(valid,v,vfloat4(pos_inf));
+    const vbool4 valid_min = valid & (a == vreduce_min(a));
+    return bsf(movemask(any(valid_min) ? valid_min : valid));
+  }
+  __forceinline size_t select_max(const vboolf4& valid, const vfloat4& v)
+  {
+    const vfloat4 a = select(valid,v,vfloat4(neg_inf));
+    const vbool4 valid_max = valid & (a == vreduce_max(a));
+    return bsf(movemask(any(valid_max) ? valid_max : valid));
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Euclidean Space Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline float dot(const vfloat4& a, const vfloat4& b) {
+    return reduce_add(a*b);
+  }
+
+  __forceinline vfloat4 cross(const vfloat4& a, const vfloat4& b)
+  {
+    const vfloat4 a0 = a;
+    const vfloat4 b0 = shuffle<1,2,0,3>(b);
+    const vfloat4 a1 = shuffle<1,2,0,3>(a);
+    const vfloat4 b1 = b;
+    return shuffle<1,2,0,3>(msub(a0,b0,a1*b1));
+  }
+
+  ////////////////////////////////////////////////////////////////////////////////
+  /// Output Operators
+  ////////////////////////////////////////////////////////////////////////////////
+
+  __forceinline embree_ostream operator <<(embree_ostream cout, const vfloat4& a) {
+    return cout << "<" << a[0] << ", " << a[1] << ", " << a[2] << ", " << a[3] << ">";
+  }
+
+}
