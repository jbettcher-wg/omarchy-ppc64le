+++ embree-4.4.1/common/simd/vsx/vsx.h	2026-09-11 12:02:45.144577108 -0600
@@ -0,0 +1,226 @@
+// Copyright 2009-2021 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// powerpc64le: the native VSX base for Embree's 4-wide SIMD layer.
+//
+// This header replaces <immintrin.h> when EMBREE_PPC64LE_VSX is defined.  No
+// x86 SIMD intrinsic exists in this build: the vfloat4/vint4/vuint4/vboolf4
+// types (common/simd/*_vsx.h) and the Vec3fa/Vec3ia/Vec3ba/Vec2fa/Color
+// types (common/math/*_vsx.h) are written on GCC's vector extensions and the
+// altivec builtins, so any surviving _mm_* spelling is a compile error.  The
+// only x86 spellings kept are the *non-SIMD* platform hints Embree's system
+// layer calls by name (_mm_pause, _mm_prefetch, _mm_malloc/_mm_free and the
+// MXCSR accessors), defined at the end of this file.
+//
+// ISA floor is POWER8 (ISA 2.07): everything here lowers to 2.07 instructions
+// at -mcpu=power8.  -mcpu=power9 lets GCC pick ISA 3.0 forms (lxvwsx,
+// xxinsertw, xxextractuw, mtvsrws, vextuwrx) for the same builtins; no
+// _ARCH_PWR9 conditionals are needed in this layer for correctness.
+//
+// Lane-level facts this layer relies on were established by
+// probes/vsx_lane_probe.cpp (powerpc64le-handbook) on POWER9 with GCC 16:
+//  - vbpermq with control {96,64,32,0,0x80...} gathers the four word sign
+//    bits into bits 0..3 of doubleword 1 in x86 _mm_movemask_ps order;
+//  - vec_sld(zero, x, 12) == {x1,x2,x3,0} (SSE _mm_srli_si128(x,4));
+//    vec_sld(a,a,12) == {a1,a2,a3,a0}, vec_sld(a,a,4) == {a3,a0,a1,a2};
+//  - vec_mergeh(a,b) == {a0,b0,a1,b1} (SSE unpacklo), vec_mergel == unpackhi;
+//  - vec_cts(vec_rint(x)) rounds to nearest-even like SSE cvtps2dq;
+//  - vec_rl on doublewords by 32 == shuffle<1,0,3,2>;
+//  - xvresp / xvrsqrtesp estimates carry 14.6 / 15.4 bits (x86: 12), one
+//    Newton step gives 24.0 / 23.4 bits.
+
+#pragma once
+
+#include "../../sys/platform.h"
+
+#include <altivec.h>
+#include <cstdlib>
+#include <cstring>
+
+/* altivec.h defines these as macros; 'bool' as a macro breaks every C++
+   header that follows.  GCC's own comment says they may be undefined for
+   C++ compatibility.  Vector bool types are spelled __vector __bool below. */
+#undef vector
+#undef pixel
+#undef bool
+
+namespace embree
+{
+  namespace vsx
+  {
+    typedef __vector float               f32x4;
+    typedef __vector signed int          i32x4;
+    typedef __vector unsigned int        u32x4;
+    typedef __vector __bool int          b32x4;
+    typedef __vector signed short        i16x8;
+    typedef __vector unsigned short      u16x8;
+    typedef __vector signed char         i8x16;
+    typedef __vector unsigned char       u8x16;
+    typedef __vector unsigned long long  u64x2;
+
+    /* movemask: bit i of the result is the sign bit of lane i, x86 order.
+       vbpermq (ISA 2.07) gathers the four sign bits with one permute; the
+       control vector is a constant the compiler hoists. */
+    __forceinline unsigned movemask(u32x4 m)
+    {
+      const u8x16 ctrl = { 96, 64, 32, 0, 0x80,0x80,0x80,0x80, 0x80,0x80,0x80,0x80, 0x80,0x80,0x80,0x80 };
+      const u64x2 r = (u64x2)vec_bperm((u8x16)m, ctrl);
+      return (unsigned)r[1];
+    }
+
+    /* Masks in this layer are canonical (every lane all-ones or all-zero),
+       so "any lane nonzero" is "any sign bit set".  These are record-form
+       compares (vcmpequw.) that feed CR6 straight into a branch. */
+    __forceinline bool any (u32x4 m) { return vec_any_ne(m, (u32x4)vec_splats(0u)); }
+    __forceinline bool none(u32x4 m) { return vec_all_eq(m, (u32x4)vec_splats(0u)); }
+    __forceinline bool all (u32x4 m) { return vec_all_eq(m, (u32x4)vec_splats(~0u)); }
+
+    __forceinline u32x4 splat_mask(bool b) { return vec_splats(b ? ~0u : 0u); }
+
+    /* min/max with SSE minps/maxps semantics: the second operand whenever
+       the comparison is unordered, so a NaN in either operand propagates
+       (min(x,NaN) = NaN, min(NaN,x) = x).  xvminsp/xvmaxsp return the
+       non-NaN operand instead, and the kernels depend on propagation:
+       OBBNode::clear() marks empty children with NaN transforms and culls
+       them through max(ray.tnear, tNearXYZ) <= min(ray.tfar, tFarXYZ).
+       Two instructions (xvcmpgtsp + xxsel) instead of one. */
+    __forceinline f32x4 fmin(f32x4 a, f32x4 b) { return vec_sel(b, a, vec_cmplt(a, b)); }
+    __forceinline f32x4 fmax(f32x4 a, f32x4 b) { return vec_sel(b, a, vec_cmpgt(a, b)); }
+
+    template<int mask>
+    __forceinline u32x4 blend_mask() {
+      return (u32x4){ (mask & 1) ? ~0u : 0u, (mask & 2) ? ~0u : 0u, (mask & 4) ? ~0u : 0u, (mask & 8) ? ~0u : 0u };
+    }
+
+    /* vfloat4::load(const unsigned char*) and friends: four narrow lanes
+       widened to 32 bits without a memory constant (two merges with zero,
+       or two sign-extending unpacks). */
+    __forceinline u32x4 load4u8(const unsigned char* p) {
+      unsigned w; memcpy(&w, p, 4);
+      const u8x16 b = (u8x16)vec_splats(w);
+      const u16x8 h = (u16x8)vec_mergeh(b, (u8x16)vec_splats((unsigned char)0));
+      return (u32x4)vec_mergeh(h, (u16x8)vec_splats((unsigned short)0));
+    }
+    __forceinline i32x4 load4s8(const signed char* p) {
+      unsigned w; memcpy(&w, p, 4);
+      const i8x16 b = (i8x16)vec_splats(w);
+      return vec_unpackh(vec_unpackh(b));
+    }
+    __forceinline u32x4 load4u16(const unsigned short* p) {
+      unsigned long long w; memcpy(&w, p, 8);
+      const u16x8 h = (u16x8)vec_splats(w);
+      return (u32x4)vec_mergeh(h, (u16x8)vec_splats((unsigned short)0));
+    }
+    __forceinline i32x4 load4s16(const short* p) {
+      unsigned long long w; memcpy(&w, p, 8);
+      return vec_unpackh((i16x8)vec_splats(w));
+    }
+    /* SSE _mm_packus_epi32 + _mm_packus_epi16: signed words saturated to
+       unsigned bytes. */
+    __forceinline void store4u8(unsigned char* p, i32x4 v) {
+      const u16x8 h = vec_packsu(v, v);
+      const u8x16 b = vec_packsu((i16x8)h, (i16x8)h);
+      const unsigned w = vec_extract((u32x4)b, 0);
+      memcpy(p, &w, 4);
+    }
+    /* vint4::store(unsigned short*) is a plain (unsigned short) cast per
+       lane upstream: modulo, not saturating -- vpkuwum keeps the low halfword */
+    __forceinline void store4u16(unsigned short* p, i32x4 v) {
+      const u16x8 h = (u16x8)vec_pack(v, v);
+      const unsigned long long w = vec_extract((u64x2)h, 0);
+      memcpy(p, &w, 8);
+    }
+
+    /* SSE cvtps2dq: round to nearest even, then convert.  VSX only truncates
+       (vctsxs), so round first.  Out-of-range values saturate here where SSE
+       returns 0x80000000. */
+    __forceinline i32x4 cvt_nearest(f32x4 a) { return vec_cts(vec_rint(a), 0); }
+
+    /* rcp = estimate refined with one Newton step, the shape of the SSE
+       code: r + r*(1 - a*r), both steps fused. */
+    __forceinline f32x4 rcp(f32x4 a) {
+      const f32x4 r = vec_re(a);
+      return vec_madd(r, vec_nmsub(a, r, vec_splats(1.0f)), r);
+    }
+    /* rsqrt = estimate refined with one Newton step: r*(1.5 - 0.5*a*r*r). */
+    __forceinline f32x4 rsqrt(f32x4 a) {
+      const f32x4 r  = vec_rsqrte(a);
+      const f32x4 ar = a * r;
+      return r * vec_nmsub(ar * r, vec_splats(0.5f), vec_splats(1.5f));
+    }
+
+    /* Horizontal reductions, SSE association: lane 0 = (v0+v1)+(v2+v3),
+       all lanes equal.  shuffle<1,0,3,2> is a doubleword rotate by 32
+       (vrld), shuffle<2,3,0,1> a doubleword swap (xxswapd). */
+    __forceinline f32x4 swap_pairs(f32x4 v) { return (f32x4)vec_rl((u64x2)v, vec_splats(32ull)); }
+    __forceinline f32x4 swap_halves(f32x4 v) { return __builtin_shuffle(v, (u32x4){2,3,0,1}); }
+    __forceinline i32x4 swap_pairs(i32x4 v) { return (i32x4)vec_rl((u64x2)v, vec_splats(32ull)); }
+    __forceinline i32x4 swap_halves(i32x4 v) { return __builtin_shuffle(v, (u32x4){2,3,0,1}); }
+
+    /* (a0*b0 + a1*b1) + a2*b2, lane 3 ignored: what the SSE4.1 build gets
+       from _mm_dp_ps(a,b,0x7F) through the compat-header emulation. */
+    __forceinline float dot3(f32x4 a, f32x4 b) {
+      const f32x4 t = a * b;
+      const f32x4 s = (t + vec_splat(t, 1)) + vec_splat(t, 2);
+      return vec_extract(s, 0);
+    }
+  }
+}
+
+////////////////////////////////////////////////////////////////////////////////
+/// Non-SIMD platform hints that Embree's system layer spells the x86 way.
+/// None of these touch vector state; they are here so common/sys, the task
+/// scheduler and the device code compile unchanged.
+////////////////////////////////////////////////////////////////////////////////
+
+/* spin-wait hint: lower the SMT thread priority for a moment ("or 27,27,27"
+   is the ISA's medium-low priority nop). */
+__forceinline void _mm_pause(void) { __asm__ __volatile__ ("or 27,27,27" ::: "memory"); }
+
+/* full memory fence (the BVH builders publish nodes with it): hwsync */
+__forceinline void _mm_mfence(void) { __sync_synchronize(); }
+
+#define _MM_HINT_T0  3
+#define _MM_HINT_T1  2
+#define _MM_HINT_T2  1
+#define _MM_HINT_NTA 0
+__forceinline void _mm_prefetch(const char* p, int hint) { __builtin_prefetch(p, 0, hint); }
+
+__forceinline void* _mm_malloc(size_t size, size_t align)
+{
+  void* ptr = nullptr;
+  if (align < sizeof(void*)) align = sizeof(void*);
+  if (posix_memalign(&ptr, align, size) != 0) return nullptr;
+  return ptr;
+}
+__forceinline void _mm_free(void* ptr) { free(ptr); }
+
+/* MXCSR does not exist on POWER.  Embree only touches it to enable FTZ/DAZ,
+   an x86 performance hint; POWER handles denormals in hardware at full
+   speed.  Report both as always on and accept writes as no-ops, so the
+   FTZ/DAZ warning in Device::print() stays quiet and Scene::commit()'s
+   save/restore is harmless. */
+#define _MM_FLUSH_ZERO_MASK     0x8000
+#define _MM_FLUSH_ZERO_ON       0x8000
+#define _MM_FLUSH_ZERO_OFF      0x0000
+#define _MM_DENORMALS_ZERO_MASK 0x0040
+#define _MM_DENORMALS_ZERO_ON   0x0040
+#define _MM_DENORMALS_ZERO_OFF  0x0000
+#define _MM_EXCEPT_MASK         0x003f
+#define _MM_MASK_MASK           0x1f80
+#define _MM_MASK_INVALID        0x0080
+#define _MM_MASK_DENORM         0x0100
+#define _MM_MASK_DIV_ZERO       0x0200
+#define _MM_MASK_OVERFLOW       0x0400
+#define _MM_MASK_UNDERFLOW      0x0800
+#define _MM_MASK_INEXACT        0x1000
+
+__forceinline unsigned int _mm_getcsr(void) { return _MM_MASK_MASK | _MM_FLUSH_ZERO_ON | _MM_DENORMALS_ZERO_ON; }
+__forceinline void _mm_setcsr(unsigned int) {}
+
