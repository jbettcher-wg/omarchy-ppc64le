diff -ruN -x rtcore_config.h -x config.h -x hash.h embree-4.4.1.orig/common/simd/ppc/emulation.h embree-4.4.1/common/simd/ppc/emulation.h
--- embree-4.4.1.orig/common/simd/ppc/emulation.h	1969-12-31 17:00:00.000000000 -0700
+++ embree-4.4.1/common/simd/ppc/emulation.h	2026-09-10 17:33:25.739879937 -0600
@@ -0,0 +1,97 @@
+// Copyright 2009-2021 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+
+// powerpc64le: SSE on VSX.
+//
+// GCC (since 8) and clang ship <xmmintrin.h>, <emmintrin.h>, <pmmintrin.h>,
+// <tmmintrin.h>, <smmintrin.h> and <nmmintrin.h> for powerpc64le that
+// implement the SSE..SSE4.2 intrinsics on top of VSX (POWER8 and later).
+// Embree's SSE2 and SSE4.2 kernels build on those headers unchanged; this
+// file adds the few intrinsics they do not provide, mirroring arm/emulation.h.
+
+#pragma once
+
+#include "../../sys/platform.h"
+
+#ifndef NO_WARN_X86_INTRINSICS
+#define NO_WARN_X86_INTRINSICS 1
+#endif
+
+#include <mmintrin.h>
+#include <xmmintrin.h>
+#include <emmintrin.h>
+#include <pmmintrin.h>
+#include <tmmintrin.h>
+#include <smmintrin.h>
+#include <nmmintrin.h>
+#include <mm_malloc.h>
+
+/* MXCSR does not exist on POWER.  Embree only touches it to enable FTZ/DAZ,
+ * an x86 performance hint; POWER9 handles denormals in hardware at full
+ * speed.  Report both as always on and accept writes as no-ops, so the
+ * FTZ/DAZ warning in Device::print() stays quiet and Scene::commit()'s
+ * save/restore is harmless. */
+#ifndef _MM_FLUSH_ZERO_MASK
+#define _MM_FLUSH_ZERO_MASK 0x8000
+#define _MM_FLUSH_ZERO_ON   0x8000
+#define _MM_FLUSH_ZERO_OFF  0x0000
+#endif
+#ifndef _MM_DENORMALS_ZERO_MASK
+#define _MM_DENORMALS_ZERO_MASK 0x0040
+#define _MM_DENORMALS_ZERO_ON   0x0040
+#define _MM_DENORMALS_ZERO_OFF  0x0000
+#endif
+
+#ifndef _MM_MASK_MASK
+#define _MM_EXCEPT_MASK     0x003f
+#define _MM_MASK_MASK       0x1f80
+#define _MM_MASK_INVALID    0x0080
+#define _MM_MASK_DENORM     0x0100
+#define _MM_MASK_DIV_ZERO   0x0200
+#define _MM_MASK_OVERFLOW   0x0400
+#define _MM_MASK_UNDERFLOW  0x0800
+#define _MM_MASK_INEXACT    0x1000
+#endif
+
+__forceinline unsigned int _mm_getcsr(void) { return _MM_MASK_MASK | _MM_FLUSH_ZERO_ON | _MM_DENORMALS_ZERO_ON; }
+__forceinline void _mm_setcsr(unsigned int) {}
+
+#ifndef _MM_SET_EXCEPTION_MASK
+#define _MM_SET_EXCEPTION_MASK(x) _mm_setcsr((_mm_getcsr() & ~_MM_MASK_MASK) | (x))
+#define _MM_GET_EXCEPTION_MASK()  (_mm_getcsr() & _MM_MASK_MASK)
+#endif
+
+#ifndef _MM_SET_FLUSH_ZERO_MODE
+#define _MM_SET_FLUSH_ZERO_MODE(x) _mm_setcsr((_mm_getcsr() & ~_MM_FLUSH_ZERO_MASK) | (x))
+#define _MM_GET_FLUSH_ZERO_MODE()  (_mm_getcsr() & _MM_FLUSH_ZERO_MASK)
+#endif
+#ifndef _MM_SET_DENORMALS_ZERO_MODE
+#define _MM_SET_DENORMALS_ZERO_MODE(x) _mm_setcsr((_mm_getcsr() & ~_MM_DENORMALS_ZERO_MASK) | (x))
+#define _MM_GET_DENORMALS_ZERO_MODE()  (_mm_getcsr() & _MM_DENORMALS_ZERO_MASK)
+#endif
+
+/* SSE4.1 / SSE4.2 intrinsics the compatibility headers leave out. */
+__forceinline __m128 _mm_dp_ps(__m128 a, __m128 b, const int imm8)
+{
+  float av[4], bv[4], r[4];
+  _mm_storeu_ps(av, a);
+  _mm_storeu_ps(bv, b);
+  float s = 0.0f;
+  for (int i = 0; i < 4; i++) if (imm8 & (0x10 << i)) s += av[i] * bv[i];
+  for (int i = 0; i < 4; i++) r[i] = (imm8 & (1 << i)) ? s : 0.0f;
+  return _mm_loadu_ps(r);
+}
+
+__forceinline __m128 _mm_insert_ps(__m128 a, __m128 b, const int imm8)
+{
+  float av[4], bv[4];
+  _mm_storeu_ps(av, a);
+  _mm_storeu_ps(bv, b);
+  av[(imm8 >> 4) & 3] = bv[(imm8 >> 6) & 3];
+  for (int i = 0; i < 4; i++) if (imm8 & (1 << i)) av[i] = 0.0f;
+  return _mm_loadu_ps(av);
+}
+
+__forceinline int       _mm_popcnt_u32(unsigned int v)       { return __builtin_popcount(v); }
+__forceinline long long _mm_popcnt_u64(unsigned long long v) { return __builtin_popcountll(v); }
+__forceinline __m128i   _mm_stream_load_si128(__m128i* p)    { return _mm_load_si128(p); }
