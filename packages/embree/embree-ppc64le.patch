--- embree-4.4.1.orig/common/sys/sysinfo.cpp	2026-03-17 01:41:53.000000000 -0600
+++ embree-4.4.1/common/sys/sysinfo.cpp	2026-09-10 17:18:01.613161516 -0600
@@ -100,6 +100,8 @@
     return (char*)name;
 #elif defined(__ARM_NEON)
     return "ARM";
+#elif defined(__powerpc64__)
+    return "IBM";
 #else
     return "Unknown";
 #endif
@@ -376,6 +378,15 @@
     cpu_features |= CPU_FEATURE_NEON_2X;
     return cpu_features;
 
+#elif defined(__powerpc64__)
+
+    /* SSE2 and SSE4.2 kernels run on VSX through the compiler's
+       compatibility headers (POWER8 and later). */
+    int cpu_features = CPU_FEATURE_SSE|CPU_FEATURE_SSE2|CPU_FEATURE_SSE3|CPU_FEATURE_SSSE3;
+    cpu_features |= CPU_FEATURE_SSE41|CPU_FEATURE_SSE42|CPU_FEATURE_POPCNT;
+    cpu_features |= CPU_FEATURE_XMM_ENABLED;
+    return cpu_features;
+
 #else
     /* Unknown CPU. */
     return 0;
