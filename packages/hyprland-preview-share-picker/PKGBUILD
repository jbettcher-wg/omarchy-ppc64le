# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# hyprland-preview-share-picker -- the screen-share picker Omarchy configures
# xdg-desktop-portal-hyprland to use (config/hypr/xdph.conf).  Omarchy
# publishes it from their own repository.  Upstream offers only a -git AUR
# package and a sample PKGBUILD in its README, so this recipe is written from
# that sample, pinned to the release Omarchy ships (omarchy.db 0.2.1-1).
#
# What changed for ppc64le:
#
# - arch=(powerpc64le).  Pure Rust on gtk4/gtk4-layer-shell; no architecture-
#   specific code.
# - Built with the repo's stable rust (1:1.98.1).  The README asks for
#   nightly, but the tree uses no #![feature] and edition 2024 has been stable
#   since 1.85.
# - A git source, not a tarball, and not only for the submodule: build.rs runs
#   `git describe --long --tags` and indexes into its output, which panics on
#   the empty output a tarball gives.  The tag is asserted against the commit
#   it pointed to when this recipe was written.
# - lib/hyprland-protocols is a git submodule, fed from a second source the
#   way upstream's sample does, so makepkg can cache it.
# - CARGO_HOME under $srcdir, so the build writes nothing into $HOME.
#
# schema.json is generated by the freshly built binary, as upstream's sample
# and Omarchy's package both do; it documents the config.yaml format.

pkgname=hyprland-preview-share-picker
pkgver=0.2.1
pkgrel=1
pkgdesc='An alternative share picker for hyprland with window and monitor previews'
arch=(powerpc64le)
url='https://github.com/WhySoBad/hyprland-preview-share-picker'
license=(MIT)
depends=(gtk4 gtk4-layer-shell xdg-desktop-portal-hyprland hyprland)
makedepends=(cargo git)
optdepends=('slurp: default tool for selecting share regions')
_commit=211b7890ed3332f4d1bb1f1a96999e18874a9c3c
source=("$pkgname::git+$url.git#tag=v$pkgver"
        "hyprland-protocols::git+https://github.com/hyprwm/hyprland-protocols.git")
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd "$pkgname"
  [[ $(git rev-parse HEAD) == "$_commit" ]] || {
    error "tag v$pkgver no longer points at $_commit"
    return 1
  }
  git submodule init
  git config submodule.lib/hyprland-protocols.url "$srcdir/hyprland-protocols"
  git -c protocol.file.allow=always submodule update

  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
  ./target/release/hyprland-preview-share-picker schema > schema.json
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/hyprland-preview-share-picker "$pkgdir/usr/bin/hyprland-preview-share-picker"
  install -Dm644 schema.json "$pkgdir/usr/share/hyprland-preview-share-picker/schema.json"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
