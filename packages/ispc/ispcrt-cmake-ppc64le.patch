ispc 1.31.0 added the ppc64le/VSX backend (PPC64_ENABLED) but not to the
ispcrt CMake helper (ispcrt/cmake/ispc.cmake, installed as
/usr/lib/cmake/ispcrt-*/ispc.cmake) that OSPRay and friends use to drive the
compiler.  That helper still hard-codes --arch=x86-64 / aarch64 and only
defines ISA options for x86, so on a ppc64le host every consumer invokes
`ispc --arch=x86-64 --target=sse4`, which this build of ispc rejects.

Teach it about the new architecture: detect "ppc64le" in the compiler's
supported-arch list, expose an ISPC_TARGET_VSX option (default vsx-i32x4,
POWER8+ baseline), and pass --arch=ppc64le on ppc64le hosts.

Portability fix, worth sending upstream (github.com/ispc/ispc).
--- a/ispcrt/cmake/ispc.cmake
+++ b/ispcrt/cmake/ispc.cmake
@@ -80,6 +80,7 @@
 
 define_ispc_supported_arch(X86 "x86|x86-64")
 define_ispc_supported_arch(ARM "arm|aarch64")
+define_ispc_supported_arch(PPC64 "ppc64le")
 define_ispc_supported_arch(XE "xe64")
 
 macro(define_ispc_isa_options ISA_NAME)
@@ -95,6 +96,11 @@
   define_ispc_isa_options(AVX512SKX avx512skx-x16 avx512skx-x8)
   define_ispc_isa_options(AVX512SPR avx512spr-x16 avx512spr-x8)
 endif()
+if (ISPC_PPC64_ENABLED)
+  # POWER ISA 2.07 (POWER8) VSX baseline; there is no runtime ISA dispatch on
+  # POWER, so one target is the norm.
+  define_ispc_isa_options(VSX vsx-i32x4 vsx-i32x8 vsx-i16x8 vsx-i16x16 vsx-i8x16 vsx-i8x32)
+endif()
 
 macro(append_ispc_target_list ISA_NAME)
   set(_TARGET_NAME ISPC_TARGET_${ISA_NAME})
@@ -114,6 +120,9 @@
     append_ispc_target_list(AVX512SPR)
   endif()
 endif()
+if (ISPC_PPC64_ENABLED)
+  append_ispc_target_list(VSX)
+endif()
 
 ## Macros ##
 
@@ -149,6 +158,8 @@
   if (CMAKE_SIZEOF_VOID_P EQUAL 8)
     if (${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm64|aarch64")
       set(ISPC_ARCHITECTURE "aarch64")
+    elseif (${CMAKE_SYSTEM_PROCESSOR} MATCHES "ppc64le|powerpc64le")
+      set(ISPC_ARCHITECTURE "ppc64le")
     else()
       set(ISPC_ARCHITECTURE "x86-64")
     endif()
