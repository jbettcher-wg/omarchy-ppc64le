rkcommon 1.15.3 on powerpc64le.

rkcommon is portable C++ except for three x86 leftovers, each guarded by
"#else" rather than an architecture test, so any non-x86, non-NEON target
falls into them:

- math/rkmath.h includes <emmintrin.h>/<xmmintrin.h> for the _mm_rcp_ss /
  _mm_rsqrt_ss based rcp()/rsqrt().  GCC (>= 8) and clang provide those
  headers for powerpc64le on VSX behind -DNO_WARN_X86_INTRINSICS; define it
  and use them, so numerics match x86.  This is a public header, hence the
  define lives in the header rather than in CXXFLAGS.
- memory/malloc.cpp uses _mm_malloc/_mm_free; take the posix_memalign path
  already used for Apple ARM.
- tasking/detail/tasking_system_init.cpp sets MXCSR FTZ/DAZ on every worker
  thread.  POWER has no MXCSR and no denormal penalty; make the setters
  no-ops as the RKCOMMON_NO_SIMD path already does.

Portability fix, worth sending upstream (github.com/RenderKit/rkcommon).

diff -ruN a/rkcommon/math/rkmath.h b/rkcommon/math/rkmath.h
--- a/rkcommon/math/rkmath.h	2026-09-10 17:05:45.033583436 -0600
+++ b/rkcommon/math/rkmath.h	2026-09-10 18:07:13.112639265 -0600
@@ -15,6 +15,13 @@
 #include <intrin.h>
 #elif defined(__ARM_NEON)
 #include "arm/emulation.h"
+#elif defined(__powerpc64__)
+// GCC/clang implement SSE..SSE4.2 on VSX for powerpc64le behind this define
+#ifndef NO_WARN_X86_INTRINSICS
+#define NO_WARN_X86_INTRINSICS 1
+#endif
+#include <emmintrin.h>
+#include <xmmintrin.h>
 #else
 #include <emmintrin.h>
 #include <xmmintrin.h>
diff -ruN a/rkcommon/memory/malloc.cpp b/rkcommon/memory/malloc.cpp
--- a/rkcommon/memory/malloc.cpp	2026-09-10 17:05:45.034936792 -0600
+++ b/rkcommon/memory/malloc.cpp	2026-09-10 18:07:13.112882016 -0600
@@ -9,7 +9,7 @@
 #else
 #ifdef _WIN32
 #include <malloc.h>
-#elif defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))
+#elif (defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))) || defined(__powerpc64__)
 #include <stdlib.h>
 #else
 #include <xmmintrin.h>
@@ -27,7 +27,7 @@
 #else
 #ifdef _WIN32
       return _aligned_malloc(size, align);
-#elif defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))
+#elif (defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))) || defined(__powerpc64__)
       void *ptr = nullptr;
       return (posix_memalign(&ptr, align, size) == 0) ? ptr : nullptr;
 #else  // __UNIX__
@@ -43,7 +43,7 @@
 #else
 #ifdef _WIN32
       _aligned_free(ptr);
-#elif defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))
+#elif (defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))) || defined(__powerpc64__)
       free(ptr);
 #else  // __UNIX__
       _mm_free(ptr);
diff -ruN a/rkcommon/tasking/detail/tasking_system_init.cpp b/rkcommon/tasking/detail/tasking_system_init.cpp
--- a/rkcommon/tasking/detail/tasking_system_init.cpp	2026-09-10 17:05:45.036677928 -0600
+++ b/rkcommon/tasking/detail/tasking_system_init.cpp	2026-09-10 18:07:13.113022519 -0600
@@ -20,7 +20,16 @@
 
 // intrinsics
 #ifndef RKCOMMON_NO_SIMD
-#if !defined(__ARM_NEON)
+#if defined(__powerpc64__)
+/* POWER has no MXCSR; FTZ/DAZ are x86 performance hints, denormals are
+   full speed on POWER9.  Nothing to set. */
+#define _MM_SET_FLUSH_ZERO_MODE(x)                                             \
+  do {                                                                         \
+  } while (0)
+#define _MM_SET_DENORMALS_ZERO_MODE(x)                                         \
+  do {                                                                         \
+  } while (0)
+#elif !defined(__ARM_NEON)
 #include <xmmintrin.h>
 #elif !defined(_WIN32)
 #include "math/arm/emulation.h"
