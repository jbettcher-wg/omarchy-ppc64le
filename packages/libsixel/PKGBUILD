# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Based on the Arch libsixel PKGBUILD (maintainers below).
#
# ppc64le: -Dgd=disabled. meson's gd option defaults to `auto`, so a build
# environment that happens to contain gd links libgd.so.3 even though gd is not
# in depends=(). Our 1.10.5-1 did exactly that, and every libsixel user (mpv)
# failed to start on a system without gd. Arch's clean-chroot build never sees
# gd, so disabling it matches the upstream package.
# Maintainer: Orhun Parmaksız <orhun@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Contributor: BrainDamage

pkgname=libsixel
pkgver=1.10.5
pkgrel=2
pkgdesc="Provides a codec for DEC SIXEL graphics and some converter programs"
arch=('x86_64' 'powerpc64le')
url="https://github.com/libsixel/libsixel"
license=('MIT')
depends=(
  'curl'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'libjpeg-turbo'
  'libpng'
)
makedepends=('meson')
source=("$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('b6654928bd423f92e6da39eb1f40f10000ae2cc6247247fc1882dcff6acbdfc8')

build() {
  meson --prefix=/usr --buildtype=plain -Dtests=enabled -Dlibcurl=enabled -Dgdk-pixbuf2=enabled "${pkgname}-${pkgver}" build
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
  install -Dvm 644 "${pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

