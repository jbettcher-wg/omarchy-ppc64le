# ppc64le changes (local workaround, nothing to send upstream):
#  * arch=() gains powerpc64le.
#  * -DLLVM_DIR=/usr/lib/llvm20/lib/cmake/llvm. lld's standalone CMakeLists
#    does find_package(LLVM HINTS ${LLVM_CMAKE_DIR}), and CMake searches the
#    CMAKE_PREFIX_PATH environment variable BEFORE HINTS. bq exports
#    CMAKE_PREFIX_PATH=/usr, where the host has LLVM 22, so without this lld
#    configures against LLVM 22 (packages/lld21 failed exactly that way).
#    LLVM_DIR as a cache variable outranks every search path.
#
# Maintainer: Evangelos Foutras <foutrelis@archlinux.org>
# Contributor: Jan "heftig" Steffens <jan.steffens@gmail.com>

pkgname=lld20
pkgver=20.1.8
pkgrel=1
pkgdesc="Linker from the LLVM project (Version 20)"
arch=('x86_64' 'powerpc64le')
url="https://lld.llvm.org/"
license=('Apache-2.0 WITH LLVM-exception')
depends=(
  'llvm20-libs'
  'libstdc++'
  'zlib'
  'zstd'
)
makedepends=('llvm20' 'cmake' 'ninja' 'python-sphinx')
checkdepends=('llvm')
_source_base=https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver
source=($_source_base/lld-$pkgver.src.tar.xz{,.sig}
        $_source_base/llvm-$pkgver.src.tar.xz{,.sig}
        $_source_base/libunwind-$pkgver.src.tar.xz{,.sig}
        $_source_base/cmake-$pkgver.src.tar.xz{,.sig})
sha256sums=('8281462d62cae67dfe5fdbb4da0d82bc62e0a86d4d4f758b0b601d44f09fd987'
            'SKIP'
            'e1363888216b455184dbb8a74a347bf5612f56a3f982369e1cba6c7e0726cde1'
            'SKIP'
            '0bced9d701e300f8fe6599523367e214c1f928ac559afceece58f47018e9c4a7'
            'SKIP'
            '3319203cfd1172bbac50f06fa68e318af84dcb5d65353310c0586354069d6634'
            'SKIP')
validpgpkeys=('474E22316ABF4785A88C6E8EA2C794A986419D8A'  # Tom Stellard <tstellar@redhat.com>
              'D574BD5D1D0E98895E3BF90044F2485E45D59042'  # Tobias Hieta <tobias@hieta.se>
              'FFB3368980F3E6BB5737145A316C56D064CACBA5'  # Douglas Yung <douglas.yung@sony.com>
)

prepare() {
  # https://bugs.llvm.org/show_bug.cgi?id=49228
  mv libunwind{-$pkgver.src,}

  mv cmake{-$pkgver.src,}
  cd lld-$pkgver.src
  mkdir build
}

build() {
  cd lld-$pkgver.src/build

  local cmake_args=(
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr/lib/llvm20
    -DCMAKE_SKIP_RPATH=ON
    -DBUILD_SHARED_LIBS=ON
    -DLLVM_CMAKE_DIR=/usr/lib/llvm20/lib/cmake
    -DLLVM_DIR=/usr/lib/llvm20/lib/cmake/llvm
    -DLLVM_CONFIG=/usr/lib/llvm20/bin/llvm-config
    -DLLVM_EXTERNAL_LIT=/usr/bin/lit
    -DLLVM_INCLUDE_TESTS=ON
    -DLLVM_LINK_LLVM_DYLIB=ON
    -DLLVM_MAIN_SRC_DIR="$srcdir/llvm-$pkgver.src"
  )
  cmake .. "${cmake_args[@]}"
  ninja
}

# Disabled as 2 tests fail
# check() {
#   cd lld-$pkgver.src/build
#   ninja check-lld
# }

package() {
  cd lld-$pkgver.src/build

  DESTDIR="$pkgdir" ninja install
  install -Dm644 ../LICENSE.TXT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  local _libname _lib
  for _libname in COFF Common ELF MachO MinGW Wasm; do
    _lib=liblld$_libname.so.20.1
    mv "$pkgdir"/usr/lib/{llvm20/lib/,}$_lib
    ln -s ../../$_lib "$pkgdir/usr/lib/llvm20/lib/$_lib"
  done
}

