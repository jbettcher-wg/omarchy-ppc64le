# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>
# ppc64le port: Omarchy ppc64le tree
#
# Differences from the Arch Linux recipe (see README.md):
#   * arch=() gains powerpc64le.
#   * The source is the official qtwebengine-everywhere-src release tarball
#     rather than a git checkout + qtwebengine-chromium submodule.  The
#     ppc64le patch set is maintained by Fedora against exactly that tarball
#     layout, and the git route costs ~25 GiB of Chromium history for the same
#     tree.
#   * ppc64le patches from Fedora's qt6-qtwebengine (see ppc64le-patches/).
#   * options=(!lto): this host's makepkg.conf enables LTO globally; Chromium's
#     GN build brings its own LTO decisions and the archpower chromium recipe
#     disables it for the same reason.

pkgname=qt6-webengine
_pkgver=6.11.2
pkgver=${_pkgver/-/}
pkgrel=1
arch=(x86_64 powerpc64le)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Provides support for web applications using the Chromium browser project'
depends=(alsa-lib
         dbus
         expat
         ffmpeg
         fontconfig
         freetype2
         glib2
         glibc
         harfbuzz
         icu
         lcms2
         libgcc
         libglvnd
         libjpeg-turbo
         libpng
         libstdc++
         libtiff
         libwebp
         libx11
         libxcb
         libxcomposite
         libxfixes
         libxkbcommon
         libxkbfile
         libxdamage
         libxext
         libxml2
         libxrandr
         libxslt
         libxtst
         mesa
         minizip
         nspr
         nss
         openh264
         openjpeg2
         opus
         qt6-base
         qt6-declarative
         qt6-positioning
         qt6-webchannel
         re2
         snappy
         systemd-libs
         ttf-font
         zlib)
       # pciutils
       # libvpx disabled if VA-API is used
makedepends=(cmake
             git
             gperf
             jsoncpp
             libepoxy
             libpulse
             libva
             libxcursor
             ninja
             nodejs
             perf
             pipewire
             python-html5lib
             qt6-tools
             qt6-websockets)
optdepends=('pipewire: WebRTC desktop sharing under Wayland')
groups=(qt6)
options=(!lto)
_pkgfn=qtwebengine-everywhere-src-$_pkgver
source=(https://download.qt.io/official_releases/qt/${_pkgver%.*}/$_pkgver/submodules/$_pkgfn.tar.xz)
sha256sums=('6101c1aa00ff933d1b65ee5d167f76e8d71b9ac5b378b0111277723ebda7c163')

prepare() {
  cd $_pkgfn

  local _p="$startdir/ppc64le-patches"

  # Portability / toolchain fixes that are not ppc64le-specific but are needed
  # by this host's toolchain (gcc 16, glibc 2.43, kernel 7.2).
  patch -Np1 -i "$_p/qtwebengine-SIOCGSTAMP.patch"
  patch -Np1 -i "$_p/qtwebengine-chromium-141-glibc-2.42-SYS_SECCOMP.patch"
  patch -Np1 -i "$_p/qtwebengine-fix-build-against-gcc16.patch"
  # V8 upstream fix, ppc/s390 code generator only.
  patch -Np1 -i "$_p/qtwebengine-codegen-fix-signed-integer-overflow-in-assembler-growbuffer.patch"

  if [[ $CARCH == powerpc64le ]]; then
    # Non-x86, non-NEON scalar fallback in blink audio: the signature drifted.
    patch -Np1 -i "$_p/qtwebengine-fix-delay-signature.patch"

    # cmake/QtToolchainHelpers.cmake: map Qt's "power64" onto GN's "ppc64".
    patch -Np1 -i "$_p/qtwebengine-6.9-ppc64.patch"

    # The Chromium ppc64le port itself: GN plumbing, seccomp-bpf syscall
    # tables, boringssl ppc64le asm, crashpad, libaom/libvpx configs, dawn
    # detection, partition_alloc.  Derived from Raptor Engineering's
    # openpower-patches and rebased by Fedora onto Qt's Chromium fork.
    patch -Np1 -i "$_p/qtwebengine-chromium-ppc64.patch"
    patch -Np1 -i "$_p/qtwebengine-chromium-ppc64-highway.patch"
    patch -Np1 -i "$_p/qtwebengine-chromium-ppc64-skia-musttail.patch"
    patch -Np1 -i "$_p/qtwebengine-chromium-ppc64-crashpad.patch"

    pushd src/3rdparty/chromium
    patch -Np1 -i "$_p/qtwebengine-chromium-ppc64-libvpx.patch"
    patch -Np1 -i "$_p/qtwebengine-chromium-ppc64-libaom.patch"
    popd
  fi

  # Record what the tree actually is, so the log can be audited later.
  echo "--- bundled Chromium version ---"
  cat src/3rdparty/chromium/chrome/VERSION
}

build() {
  local _extra=()
  if [[ $CARCH == powerpc64le ]]; then
    # PDFium's V8/XFA path does not build on ppc64le (Fedora carries the same
    # switch).  QtPdf itself is still built, without JS form support.
    _extra+=(-DQT_FEATURE_pdf_v8=OFF)
  fi

  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DCMAKE_TOOLCHAIN_FILE=/usr/lib/cmake/Qt6/qt.toolchain.cmake \
    -DQT_FEATURE_webengine_system_ffmpeg=ON \
    -DQT_FEATURE_webengine_system_icu=ON \
    -DQT_FEATURE_webengine_system_re2=ON \
    -DQT_FEATURE_webengine_system_openh264=ON \
    -DQT_FEATURE_webengine_proprietary_codecs=ON \
    -DQT_FEATURE_webengine_kerberos=ON \
    -DQT_FEATURE_webengine_webrtc_pipewire=ON \
    "${_extra[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$srcdir"/${_pkgfn}/src/3rdparty/chromium/LICENSE "$pkgdir"/usr/share/licenses/${pkgname}/LICENSE.chromium

  "${ELF_PATHGUARD:-/bin/true}" "$pkgdir"
}
