# ppc64le: added powerpc64le to arch(). That was the only change needed.
#
# Maintainer: Morten Linderud <foxboron@archlinux.org>
# Contributor: Chad Kunde <Kunde21@gmail.com>

pkgname=gopls
pkgver=0.23.0
pkgrel=1
pkgdesc='Language server for Go programming language'
arch=(x86_64 powerpc64le)
url='https://github.com/golang/tools/tree/master/gopls'
license=(BSD-3-Clause)
depends=(go)
makedepends=(git)
options=(!lto)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/golang/tools/archive/gopls/v${pkgver}.tar.gz")
sha512sums=('f595b7037775f31c2a51e8c8bd178b1e4b21de2e2f559b346eea1d7e0e7013e6cf8b3b0d7e21ea02d3efc2524755e786646e2b32f667120ac989c83b81d8d229')
b2sums=('bafc7f13db5f389e82a60e9005f96ce470a0f133c77358617e617e49e8238ace7952982d0c9c1249fc3d36af0a5c057075e54ca782fdea88d1fa386c4e648d52')

build() {
  cd "tools-${pkgname}-v${pkgver}/${pkgname}"

  # set Go flags
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export GOPATH="${srcdir}"

  go build -v \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-compressdwarf=false \
    -linkmode external \
    -X main.version=v${pkgver} \
    -extldflags \"${LDFLAGS}\"" \
    -o "${pkgname}"
}

package() {
  cd "tools-${pkgname}-v${pkgver}"
  install -Dm755 "${pkgname}/${pkgname}" -t "${pkgdir}"/usr/bin/
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}

