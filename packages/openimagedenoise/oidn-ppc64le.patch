diff -ruN a/common/platform.h b/common/platform.h
--- a/common/platform.h	2026-09-10 17:05:49.559034573 -0600
+++ b/common/platform.h	2026-09-10 18:26:56.492032475 -0600
@@ -13,6 +13,8 @@
   #define OIDN_ARCH_X64
 #elif defined(__aarch64__) || defined(_M_ARM64)
   #define OIDN_ARCH_ARM64
+#elif defined(__powerpc64__)
+  #define OIDN_ARCH_PPC64LE
 #endif
 
 #if defined(SYCL_LANGUAGE_VERSION)
diff -ruN a/devices/cpu/CMakeLists.txt b/devices/cpu/CMakeLists.txt
--- a/devices/cpu/CMakeLists.txt	2026-09-10 17:05:49.562154719 -0600
+++ b/devices/cpu/CMakeLists.txt	2026-09-10 18:26:56.490600955 -0600
@@ -35,6 +35,9 @@
   endif()
 elseif(OIDN_ARCH STREQUAL "ARM64")
   set(OIDN_ISPC_TARGET_LIST neon-i32x8)
+elseif(OIDN_ARCH STREQUAL "PPC64LE")
+  # ispc >= 1.31 VSX targets, same 8-wide layout as NEON
+  set(OIDN_ISPC_TARGET_LIST vsx-i32x8)
 endif()
 set(ISPC_ADDRESSING 64)
 include(oidn_ispc)
@@ -172,6 +175,40 @@
     cpu_upsample_f16.ispc
     TARGET_LIST neon-i16x16
   )
+elseif(OIDN_ARCH STREQUAL "PPC64LE")
+  ispc_target_add_sources(OpenImageDenoise_device_cpu
+    cpu_input_process_f16.ispc
+    cpu_output_process_f16.ispc
+    TARGET_LIST vsx-i32x8
+  )
+
+  ispc_target_add_sources(OpenImageDenoise_device_cpu
+    cpu_pool_f16.ispc
+    cpu_upsample_f16.ispc
+    TARGET_LIST vsx-i16x16
+  )
+
+  # ispc lowers float16 on the VSX targets through LLVM's soft-float helpers
+  # (__extendhfsf2, __truncsfhf2, ...).  libgcc does not provide them on
+  # POWER (GCC has no _Float16 there), so without them the device module
+  # links but fails to dlopen and OIDN sees no CPU device.  Take them from
+  # compiler-rt's builtins archive.
+  if(NOT OIDN_PPC64LE_RT_BUILTINS)
+    file(GLOB _oidn_rt_builtins
+      /usr/lib/clang/*/lib/linux/libclang_rt.builtins-powerpc64le.a
+      /usr/lib/clang/*/lib/powerpc64le-unknown-linux-gnu/libclang_rt.builtins.a)
+    list(SORT _oidn_rt_builtins)
+    if(_oidn_rt_builtins)
+      list(GET _oidn_rt_builtins -1 _oidn_rt_builtins)
+    endif()
+    set(OIDN_PPC64LE_RT_BUILTINS "${_oidn_rt_builtins}" CACHE FILEPATH
+        "compiler-rt builtins archive providing the float16 helpers on ppc64le")
+  endif()
+  if(NOT OIDN_PPC64LE_RT_BUILTINS)
+    message(FATAL_ERROR "ppc64le: compiler-rt builtins archive not found; set OIDN_PPC64LE_RT_BUILTINS")
+  endif()
+  message(STATUS "ppc64le: float16 helpers from ${OIDN_PPC64LE_RT_BUILTINS}")
+  target_link_libraries(OpenImageDenoise_device_cpu PRIVATE ${OIDN_PPC64LE_RT_BUILTINS})
 else()
   ispc_target_add_sources(OpenImageDenoise_device_cpu
     cpu_input_process_f16.ispc
