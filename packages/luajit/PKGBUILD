# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Based on the Arch luajit PKGBUILD by Lukas Fleischer / Daurnimator / Caleb
# Maclennan, and on Arch POWER's by Alexander Baldeck.
#
# Why this exists:
#   Arch POWER's luajit builds PPC64/LuaJIT @ 1401cfb2 -- the IBM ppc64 fork,
#   abandoned 2017-09-04 at 2.1.0-beta3. It gives a GC64/ELFv2 interpreter and
#   FFI, but sets LJ_ARCH_NOJIT, so `jit.status()` returns false and every Lua
#   workload on this machine runs interpreted.  archpower's current master
#   PKGBUILD points at Debian's openresty tarball, which contains no
#   src/vm_ppc64.dasc at all and therefore cannot produce a ppc64le build.
#
#   This package builds our tree: those 15 fork commits rebased onto current
#   upstream LuaJIT v2.1, plus a complete ppc64le JIT backend
#   (lj_target_ppc.h / lj_emit_ppc.h / lj_asm_ppc.h) and ELFv2 aggregate
#   passing for the FFI.  `jit.status()` is true.
#
#   See ../../../power9_development/powerpc64le-handbook/docs/
#       luajit-ppc64le-jit-backend.md

pkgname=luajit
_srcdir=luajit-ppc64le
_branch=ppc64le-modern
pkgver=2.1.1788641781
pkgrel=2
pkgdesc='Just-in-time compiler and drop-in replacement for Lua 5.1 (ppc64le JIT backend)'
arch=(powerpc64le)
url='https://luajit.org/'
license=(MIT)
depends=(glibc libgcc)
makedepends=(git)
provides=(libluajit-5.1.so)

# Our fork: github.com/jbettcher-wg/luajit-ppc64le, branch ${_branch}, pinned
# to a commit so a rebuild packages exactly what was tested.  To update, set
# _commit to the new tip; pkgver follows it.  Note that the clone must keep its
# .git directory: src/Makefile derives the rolling release number from
# `git show -s --format=%ct`, and without it (and without a .relver file) the
# build silently emits a binary that references luaJIT_version_2_1_ROLLING and
# dies at startup with an undefined symbol.
_commit=6c8168d7f1406fece00820b964ac0102eb47335d
source=("${_srcdir}::git+https://github.com/jbettcher-wg/luajit-ppc64le.git#commit=${_commit}"
        nvcr-probe.c)
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd "${_srcdir}"
  # Upstream's rolling scheme, same shape as Arch x86_64's: 2.1.<relver>,
  # where <relver> is the committer timestamp of HEAD.
  printf '2.1.%s' "$(git show -s --format=%ct HEAD)"
}

build() {
  cd "${_srcdir}"

  # C10 (design doc S3.1 / S0): LJ_ARCH_VERSION is taken from the compiler's
  # _ARCH_PWR* macros, so makepkg.conf's -mcpu=power9 would build the
  # *interpreter* with VER=90 -- a build-time gate -- while the JIT's ISA 3.0
  # use stays behind the run-time JIT_F_ISA30 gate (D1).  We deliberately pin
  # the VM to the POWER8 floor and let the JIT detect ISA 3.0 at run time:
  #
  #   * it is the path the 383/3/0 suite and the 122/0/0 trace+opt sets were
  #     measured on, and VER=90 is a second interpreter variant nobody has
  #     shipped;
  #   * the JIT -- where the performance is -- still emits ISA 3.0 whenever
  #     AT_HWCAP2 says the CPU has it, so nothing is lost on POWER9;
  #   * one story, not two: the VM never assumes more than the run-time gate
  #     can check, and the package also runs on POWER8.
  #
  # LUAJIT_PPC_ISA30=0 in the environment turns the run-time gate off, which
  # is how the POWER8 code path is exercised on this box.
  local _vmflags="${CFLAGS/-mcpu=power9/-mcpu=power8}"
  _vmflags="${_vmflags/-mtune=power9/-mtune=power8}"

  # TARGET_STRIP is neutered so makepkg's own debug packaging does the
  # stripping.
  make amalg PREFIX=/usr BUILDMODE=dynamic TARGET_STRIP=" @:" \
    CFLAGS="${_vmflags}"
}

check() {
  cd "${_srcdir}"

  # pkgver must match the commit that was actually packaged.
  test "${pkgver##*.}" = "$(cat src/luajit_relver.txt)"

  cd src
  # The build tree names the shared library libluajit.so, but the binary was
  # linked against the soname, so point a directory with that name at it.
  mkdir -p "$srcdir/ljcheck"
  ln -sf "$PWD/libluajit.so" "$srcdir/ljcheck/libluajit-5.1.so.2"

  # The whole point of the package: the JIT must be on, and the runtime
  # surface neovim/lazy.nvim/snacks.nvim gate on must be present.
  LD_LIBRARY_PATH="$srcdir/ljcheck" ./luajit -e '
    assert(jit.status(), "JIT is off -- this package exists to turn it on")
    assert(jit.arch == "ppc64le", "unexpected jit.arch: "..tostring(jit.arch))
    assert(jit.version:match("^LuaJIT 2%.1%."), jit.version)
    local ffi = require("ffi")
    assert(ffi.sizeof("void *") == 8)
    ffi.cdef[[ double pow(double, double); ]]
    assert(ffi.C.pow(2, 10) == 1024)
    local sb = require("string.buffer")       -- snacks.nvim uses this unguarded
    assert(sb.decode(sb.encode({a = {1, 2, "x"}})).a[3] == "x")
    local s = string.dump(loadstring("return 41 + 1"))  -- vim.loader
    assert(loadstring(s)() == 42)
    local n = 0 for i = 1, 2e6 do n = n + i % 7 end     -- force a few traces
    assert(n == 5999997)
    local co = coroutine.wrap(function() for i = 1, 3 do coroutine.yield(i) end end)
    assert(co() == 1 and co() == 2 and co() == 3)
    io.write("luajit selftest ok  ", jit.version, "  arch=", jit.arch,
             "  jit=", tostring(jit.status()), "  ",
             table.concat({select(2, jit.status())}, ","), "\n")'

  # ELFv2 conformance: CR2, CR3 and CR4 are non-volatile, and GCC keeps
  # long-lived predicates in them across calls -- neovim's do_cmdline()
  # caches `flags & DOCMD_EXCRESET` in CR3 across thousands of instructions.
  # A Lua-only test suite cannot see a CR clobber, so this probe calls into
  # the VM from C and checks the fields afterwards.  It is the regression
  # test for the ELFv2 CR save-slot fix (committed as bd931f25).
  gcc $CFLAGS -o "$srcdir/nvcr-probe" "$srcdir/nvcr-probe.c" \
    -I. -L. -lluajit-5.1 -lm
  LD_LIBRARY_PATH="$srcdir/ljcheck" "$srcdir/nvcr-probe"
}

package() {
  cd "${_srcdir}"
  make install DESTDIR="${pkgdir}" PREFIX=/usr
  install -Dm644 COPYRIGHT "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
  # Upstream's `make install` already symlinks /usr/bin/luajit at the
  # versioned binary and /usr/lib/libluajit-5.1.so.2 (soname, unchanged since
  # beta3, so gamescope-git and mpv keep working) at the versioned library.
}
