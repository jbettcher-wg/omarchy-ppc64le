From: Jordan Bettcher <thebettcher@gmail.com>
Subject: [PATCH] powerpc: enable Rust on 64-bit little-endian

Selects HAVE_RUST for PPC64 && CPU_LITTLE_ENDIAN and generates a
powerpc64le target.json (ELFv2, no AltiVec/VSX), so Rust drivers
such as nova-core build on POWER. Local patch for the Omarchy
ppc64le kernels; upstreamable once proven.
---
--- a/arch/powerpc/Kconfig
+++ b/arch/powerpc/Kconfig
@@ -285,6 +285,7 @@
 	select HAVE_REGS_AND_STACK_ACCESS_API
 	select HAVE_RELIABLE_STACKTRACE
 	select HAVE_RSEQ
+	select HAVE_RUST			if PPC64 && CPU_LITTLE_ENDIAN
 	select HAVE_SAMPLE_FTRACE_DIRECT	if HAVE_DYNAMIC_FTRACE_WITH_DIRECT_CALLS
 	select HAVE_SAMPLE_FTRACE_DIRECT_MULTI	if HAVE_DYNAMIC_FTRACE_WITH_DIRECT_CALLS
 	select HAVE_SETUP_PER_CPU_AREA		if PPC64
--- a/scripts/generate_rust_target.rs
+++ b/scripts/generate_rust_target.rs
@@ -262,6 +262,37 @@
         panic!("loongarch uses the builtin rustc loongarch64-unknown-none-softfloat target");
     } else if cfg.has("S390") {
         panic!("s390 uses the builtin rustc s390x-unknown-none-softfloat target");
+    } else if cfg.has("PPC64") {
+        if cfg.has("CPU_BIG_ENDIAN") {
+            panic!("big-endian 64-bit powerpc is an unsupported architecture");
+        }
+        ts.push("arch", "powerpc64");
+        // rustc's own powerpc64le-unknown-linux-gnu layout and ABI.
+        ts.push(
+            "data-layout",
+            "e-m:e-Fn32-i64:64-i128:128-n32:64-S128-v256:256:256-v512:512:512",
+        );
+        // rustc checks that the LLVM ABI name and cfg(target_abi) agree for
+        // powerpc64le ("invalid PowerPC64 little-endian ABI name and
+        // `cfg(target_abi)` combination"); its own builtin target sets both.
+        ts.push("abi", "elfv2");
+        ts.push("llvm-abiname", "elfv2");
+        // Kernel C is built -msoft-float -mno-altivec -mno-vsx. Rust gets
+        // -altivec,-vsx, so LLVM never uses vector registers for integer work,
+        // but hard-float has to stay: rustc (1.98) refuses to disable it on
+        // ELFv2 ("target feature `hard-float` is required by the ABI") and
+        // offers no soft-float rustc-abi on PowerPC64 ("`rustc_abi` is unused
+        // on PowerPC64"). This matches arm64's aarch64-unknown-none plus
+        // -neon: the FPU is available and kernel Rust code simply has no
+        // floats.
+        ts.push("features", "-altivec,-vsx");
+        ts.push("llvm-target", "powerpc64le-unknown-linux-gnu");
+        ts.push("code-model", "medium");
+        if cfg.rustc_version_atleast(1, 91, 0) {
+            ts.push("target-pointer-width", 64);
+        } else {
+            ts.push("target-pointer-width", "64");
+        }
     } else {
         panic!("Unsupported architecture");
     }
--- a/arch/powerpc/Makefile
+++ b/arch/powerpc/Makefile
@@ -214,6 +214,16 @@
 # Don't emit .eh_frame since we have no use for it
 KBUILD_CFLAGS += -fno-asynchronous-unwind-tables
 
+ifdef CONFIG_RUST
+KBUILD_RUSTFLAGS += --target=$(objtree)/scripts/target.json
+KBUILD_RUSTFLAGS += -Cforce-unwind-tables=n
+# Modules need 64-bit TOC offsets, as KBUILD_CFLAGS_MODULE's -mcmodel=large.
+KBUILD_RUSTFLAGS_MODULE += -Ccode-model=large
+# target.json does not exist yet when rustc-option runs; check flags against
+# the built-in target instead, as x86 does.
+KBUILD_RUSTFLAGS_OPTION_CHKS += --target=powerpc64le-unknown-linux-gnu
+endif
+
 # Never use string load/store instructions as they are
 # often slow when they are implemented at all
 KBUILD_CFLAGS		+= $(call cc-option,-mno-string)
--- a/rust/Makefile
+++ b/rust/Makefile
@@ -437,6 +437,7 @@
 # and some kernel configurations may not work (e.g. `GCC_PLUGIN_RANDSTRUCT`
 # if we end up using one of those structs).
 bindgen_skip_c_flags := -mno-fp-ret-in-387 -mpreferred-stack-boundary=% \
+	-mprofile-kernel -mno-mma -mno-spe -mspe=no -mcall-aixdesc \
 	-mskip-rax-setup -mgeneral-regs-only -msign-return-address=% \
 	-mindirect-branch=thunk-extern -mindirect-branch-register \
 	-mfunction-return=thunk-extern -mrecord-mcount -mabi=lp64 \
@@ -461,6 +462,7 @@
 BINDGEN_TARGET_arm	:= arm-linux-gnueabi
 BINDGEN_TARGET_loongarch	:= loongarch64-linux-gnusf
 BINDGEN_TARGET_s390	:= s390x-linux-gnu
+BINDGEN_TARGET_powerpc	:= powerpc64le-linux-gnu
 # This is only for i386 UM builds, which need the 32-bit target not -m32
 BINDGEN_TARGET_i386	:= i386-linux-gnu
 BINDGEN_TARGET_um	:= $(BINDGEN_TARGET_$(SUBARCH))
@@ -723,7 +725,7 @@
 $(obj)/core.o: $(RUST_LIB_SRC)/core/src/lib.rs \
     $(wildcard $(objtree)/include/config/RUSTC_VERSION_TEXT) FORCE
 	+$(call if_changed_rule,rustc_library)
-ifneq ($(or $(CONFIG_X86_64),$(CONFIG_X86_32)),)
+ifneq ($(or $(CONFIG_X86_64),$(CONFIG_X86_32),$(CONFIG_PPC64)),)
 $(obj)/core.o: scripts/target.json
 endif
 KCOV_INSTRUMENT_core.o := n
--- a/Documentation/rust/arch-support.rst
+++ b/Documentation/rust/arch-support.rst
@@ -18,6 +18,7 @@
 ``arm``        Maintained        ARMv7 Little Endian only.
 ``arm64``      Maintained        Little Endian only.
 ``loongarch``  Maintained        \-
+``powerpc``    Experimental      ``ppc64le`` (64-bit Little Endian) only.
 ``riscv``      Maintained        ``riscv64`` and LLVM/Clang only.
 ``s390``       Maintained        ``CONFIG_EXPOLINE`` must be disabled.
 ``um``         Maintained        \-
--- a/arch/powerpc/include/asm/asm-compat.h
+++ b/arch/powerpc/include/asm/asm-compat.h
@@ -37,7 +37,7 @@
 #define STDX_BE	stringify_in_c(stdbrx)
 #endif
 
-#ifdef CONFIG_CC_IS_CLANG
+#if defined(CONFIG_CC_IS_CLANG) || defined(__BINDGEN__)
 #define DS_FORM_CONSTRAINT "Z<>"
 #else
 #define DS_FORM_CONSTRAINT "YZ<>"
--- a/scripts/Makefile
+++ b/scripts/Makefile
@@ -16,7 +16,7 @@
 sorttable-objs := sorttable.o elf-parse.o
 tracepoint-update-objs := tracepoint-update.o elf-parse.o
 
-ifneq ($(or $(CONFIG_X86_64),$(CONFIG_X86_32)),)
+ifneq ($(or $(CONFIG_X86_64),$(CONFIG_X86_32),$(CONFIG_PPC64)),)
 always-$(CONFIG_RUST)					+= target.json
 filechk_rust_target = $< < include/config/auto.conf
 
