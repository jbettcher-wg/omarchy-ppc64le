--- a/drivers/usb/host/xhci-pci.c
+++ b/drivers/usb/host/xhci-pci.c
@@ -84,6 +84,7 @@
 #define PCI_DEVICE_ID_AMD_PROMONTORYA_3			0x43ba
 #define PCI_DEVICE_ID_AMD_PROMONTORYA_2			0x43bb
 #define PCI_DEVICE_ID_AMD_PROMONTORYA_1			0x43bc
+#define PCI_DEVICE_ID_AMD_PROMONTORY19_XHCI		0x43fc
 
 #define PCI_DEVICE_ID_ATI_NAVI10_7316_XHCI		0x7316
 
@@ -331,6 +332,17 @@
 	if (pdev->vendor == PCI_VENDOR_ID_AMD && pdev->device == 0x43f7)
 		xhci->quirks |= XHCI_DEFAULT_PM_RUNTIME_ALLOW;
 
+	/*
+	 * The Promontory-19 xHCI on AMD 600-series chipsets (ASMedia silicon)
+	 * sets AC64 in HCCPARAMS1 but drops the high bits of the 64-bit DMA
+	 * addresses it is programmed with. On powernv the IOMMU bypass window
+	 * base is bit 59, so every DMA lands at the wrong address and the PHB
+	 * freezes the PE. Keep it on the 32-bit TCE-translated window.
+	 */
+	if (pdev->vendor == PCI_VENDOR_ID_AMD &&
+	    pdev->device == PCI_DEVICE_ID_AMD_PROMONTORY19_XHCI)
+		xhci->quirks |= XHCI_NO_64BIT_SUPPORT;
+
 	if ((pdev->vendor == PCI_VENDOR_ID_AMD) &&
 		((pdev->device == PCI_DEVICE_ID_AMD_PROMONTORYA_4) ||
 		(pdev->device == PCI_DEVICE_ID_AMD_PROMONTORYA_3) ||
