# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# blink.cmp's Rust fuzzy matcher, built natively for ppc64le.
#
# Why this package exists
# -----------------------
# blink.cmp is a Neovim completion plugin.  Its matching engine has two
# implementations: a Rust cdylib (`libblink_cmp_fuzzy.so`) and a much slower
# pure-Lua fallback.  Upstream publishes prebuilt binaries from
# .github/workflows/release.yaml for x86_64 and aarch64 only, so on POWER the
# download step finds no asset for the host triple and blink.cmp silently
# degrades to the Lua matcher.  Nothing else about the plugin is architecture
# dependent -- this one 2.3 MB shared object is the entire gap.
#
# The Lua half of the plugin is *not* packaged here.  It is delivered by
# lazy.nvim as a git clone under ~/.local/share/nvim/lazy/blink.cmp (seeded by
# omarchy-nvim into /etc/skel), and pacman has no business owning a directory
# that lazy.nvim rewrites on every `:Lazy update`.  So this package ships
# exactly the piece that has to be compiled, and nothing else.  That also
# settles arch=(): the payload is a native cdylib, so it is powerpc64le, not
# any.  Splitting out an `any` Lua subpackage would mean packaging the plugin
# itself, which is the thing we deliberately do not do.
#
# Where the .so goes, and why that survives `:Lazy update`
# --------------------------------------------------------
# lua/blink/cmp/fuzzy/rust/init.lua is, in full, two `package.cpath` *appends*
# pointing at <plugin>/target/release/, followed by
#
#     return require('blink_cmp_fuzzy')
#
# The module name is plain `blink_cmp_fuzzy`, and the plugin-local paths are
# appended, not prepended -- so anything already on Neovim's default cpath wins.
# Neovim's default cpath (`nvim --clean -c 'lua print(package.cpath)'`) is
#
#     ./?.so;/usr/local/lib/lua/5.1/?.so;/usr/lib/lua/5.1/?.so;...
#
# so installing to /usr/lib/lua/5.1/blink_cmp_fuzzy.so makes
# require('blink_cmp_fuzzy') resolve system-wide, ahead of the plugin's own
# target/ directory, in a location lazy.nvim neither manages nor can delete.
# That is the whole trick: the matcher stops being build output living inside a
# git clone and becomes an ordinary packaged Lua 5.1 C module, next to the
# lpeg.so and mpack.so that Neovim already loads from there.
#
# blink.cmp's download/init.lua explicitly supports this case -- "no version
# file found, and found the shared rust library, user manually placed the .so
# file" -- and takes the rust implementation without consulting GitHub.
#
# Version coupling
# ----------------
# The .so is a Lua<->Rust ABI boundary that upstream versions in lockstep with
# the plugin, so pkgver tracks the blink.cmp tag lazy-lock.json is pinned to
# (v1.10.2 / 78336bc).  When blink.cmp is updated by :Lazy, bump pkgver here and
# rebuild.  If a stale <plugin>/target/release/version file from an earlier
# hand-build is left behind, blink.cmp will see a sha mismatch and fall back to
# Lua even though a good .so is installed; deleting that target/ directory once
# puts it permanently on the "no version file, library present" path.
#
# No source patches are needed.  build.rs shells out to `git rev-parse HEAD` to
# stamp target/release/version; from a release tarball there is no repository,
# git exits 128 with empty stdout and build.rs writes an empty version file into
# $srcdir that we do not ship.  git is in makedepends only because build.rs
# unwraps the spawn itself, so the binary must exist.

pkgname=blink-cmp-fuzzy
pkgver=1.10.2
pkgrel=1
pkgdesc="Native Rust fuzzy matcher for the blink.cmp Neovim completion plugin"
arch=(powerpc64le)
url='https://github.com/Saghen/blink.cmp'
license=(MIT)
depends=(gcc-libs)
makedepends=(cargo git)
optdepends=('omarchy-nvim: ships the blink.cmp plugin this library accelerates')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Saghen/blink.cmp/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bf76b6f82e91c2fd7920dc71e09d000a3ff79e1bd1262340f9e5287419aa4524')

_src="blink.cmp-$pkgver"

prepare() {
  cd "$srcdir/$_src"

  # The two upstream assumptions this package is built on.  Asserted in
  # prepare() rather than check() because tools/build.sh runs makepkg with
  # --nocheck: a guard that does not run is not a guard.
  #
  # 1. The loader requires the bare module name `blink_cmp_fuzzy`, so a file
  #    named blink_cmp_fuzzy.so on the default cpath satisfies it.  If upstream
  #    ever switches to a dotted name or a hardcoded absolute path, the file we
  #    install stops being found and the fallback is silent -- fail here instead.
  grep -qx "return require('blink_cmp_fuzzy')" lua/blink/cmp/fuzzy/rust/init.lua

  # 2. The crate really is a cdylib named blink-cmp-fuzzy (-> libblink_cmp_fuzzy.so,
  #    exporting luaopen_blink_cmp_fuzzy).
  grep -qx 'name = "blink-cmp-fuzzy"' Cargo.toml
  grep -qx 'crate-type = \["cdylib"\]' Cargo.toml

  # Vendor the dependency tree up front so build() can run --frozen.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_src"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The tree's own .cargo/config.toml supplies [profile.release] lto = true /
  # codegen-units = 1, i.e. the same profile upstream ships its binaries with.
  cargo build --frozen --release
}

check() {
  cd "$srcdir/$_src"
  # Prove the artifact is a loadable Lua 5.1 C module for *this* machine before
  # it is packaged: correct ELF machine, and the entry point require() looks up.
  local so=target/release/libblink_cmp_fuzzy.so
  readelf -hW "$so" | grep -q 'Machine:.*PowerPC64'
  nm -D --defined-only "$so" | grep -q ' T luaopen_blink_cmp_fuzzy$'
  # And that a LuaJIT host can actually dlopen it and call luaopen.
  luajit -e 'package.cpath = "target/release/lib?.so"; local m = require("blink_cmp_fuzzy");
             assert(type(m) == "table" and type(m.fuzzy) == "function", "module did not initialise")'
}

package() {
  cd "$srcdir/$_src"

  # Installed as blink_cmp_fuzzy.so (no lib prefix): package.cpath substitutes
  # the module name for `?`, so the filename *is* the module name.
  install -Dm755 target/release/libblink_cmp_fuzzy.so \
    "$pkgdir/usr/lib/lua/5.1/blink_cmp_fuzzy.so"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Fail the build if any shipped ELF records a build-tree path.
  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"
}
