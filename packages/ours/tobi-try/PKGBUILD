# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# `try` -- fresh scratch directories for every experiment.  One of the ten
# packages Omarchy publishes itself with no PKGBUILD anywhere, so this recipe
# is written from scratch against upstream (github.com/tobi/try).
#
# arch=(any) and it means it: the whole package is three Ruby source files and
# a symlink.  No compiler is invoked, nothing is architecture-dependent, and
# nothing was added to arch=() -- there is no ppc64le change in this recipe at
# all.  This one was a repackage, not a port.
#
# Sourced from a *pinned commit* rather than the v1.8.1 tag, which is the one
# thing here that took working out.  Omarchy labels their package 1.8.1-3, but
# the files they ship are not what tag v1.8.1 contains: the shipped try.rb has
# the Ctrl-G "graduate a try to a permanent project" dialog and TRY_PROJECTS
# support, and the shipped tui.rb renders each frame into a single buffer to
# avoid flicker.  Neither exists at v1.8.1.  Walking upstream's history for the
# blob that matches finds exactly one:
#
#   4bb73376044e1ed8149a66513cec42155bb9f0d3
#   "feat: graduate tries to permanent projects (Ctrl-G)", 2026-02-11
#
# at which all three shipped files match byte-for-byte (try.rb modulo the
# shebang rewrite below).  That commit's own VERSION file says 1.8.2, so
# Omarchy's "1.8.1-3" is a version label applied to post-1.8.1 main.  pkgver is
# kept at 1.8.1-3 anyway so this package is interchangeable with theirs for
# anything that compares versions; _commit is what actually defines the
# contents, and prepare() asserts the bytes.
#
# The single deliberate difference from upstream's file: the shebang.  Omarchy
# ships `#!/usr/bin/ruby`, upstream has `#!/usr/bin/env ruby`.  Distribution
# packages pin the interpreter rather than resolving it through $PATH -- a
# user's rbenv/mise shim must not be what a system package executes -- so we
# make the same substitution and assert the result matches their bytes.

pkgname=tobi-try
pkgver=1.8.1
# pkgrel 3 mirrors Omarchy's own build number for this version.
pkgrel=3
pkgdesc='Fresh directories for every vibe.'
arch=(any)
url='https://github.com/tobi/try'
license=(MIT)
depends=(ruby)
provides=(try)
conflicts=(try)
_commit=4bb73376044e1ed8149a66513cec42155bb9f0d3
source=("${pkgname}-${pkgver}-${_commit:0:12}.tar.gz::https://github.com/tobi/try/archive/${_commit}.tar.gz")
sha256sums=('d5f5df64bb86082c66c5f288400d098067ade251660953c2d278fb0ac96d4a19')

# sha256 of the corresponding members of
# tobi-try-1.8.1-3-any.pkg.tar.zst (itself sha256
# 6359cbb97d7a6986975c90830d470f5d18998272019bafa0c7087f3b13a77558,
# as recorded in https://pkgs.omarchy.org/x86_64/omarchy.db).
# try.rb is listed post-shebang-rewrite, which is what we ship.
_upstream_sha256=(
  '41ee00b30706cfd9c430e50a9dcf5df5fc7d83f1add0c71dd9c2251221de1728  try.rb'
  'cf815ed12c8147bbc7f67008cfc1f3fd05df1638ff290e2079188f1b9bf8f190  lib/fuzzy.rb'
  'b62d2b61445d8266f064e2809e06ebc0a25da401ee5a13dc3a73d215c0a1ea71  lib/tui.rb'
)

prepare() {
  cd "try-${_commit}"

  # Pin the interpreter (see header).  Applied before the assertion so the
  # digest below covers exactly the bytes that get installed.
  sed -i '1s|^#!/usr/bin/env ruby$|#!/usr/bin/ruby|' try.rb
  head -1 try.rb | grep -qx '#!/usr/bin/ruby' || {
    printf '%s: shebang rewrite did not apply -- upstream changed line 1\n' "$pkgname" >&2
    return 1
  }

  # In prepare(), not check(), on purpose: tools/build.sh runs makepkg
  # --nocheck, and "these are the bytes Omarchy ships" is the claim the whole
  # recipe rests on.  It has to be enforced on the path that always runs.
  printf '%s\n' "${_upstream_sha256[@]}" | sha256sum -c --quiet || {
    printf '%s: sources differ from the bytes Omarchy ships -- do not ship this\n' "$pkgname" >&2
    return 1
  }
}

check() {
  cd "try-${_commit}"
  # Ruby parses all three files.  Cheap, and it is the only thing that can go
  # wrong in a package with no build step.
  ruby -c try.rb >/dev/null
  ruby -c lib/fuzzy.rb >/dev/null
  ruby -c lib/tui.rb >/dev/null
}

package() {
  cd "try-${_commit}"

  # Same layout Omarchy uses -- the script lives in /usr/lib/tobi-try and
  # /usr/bin/try is an absolute symlink to it -- which is what makes this a
  # drop-in replacement for their package rather than a second copy.  try.rb
  # resolves its own lib/ relative to __dir__, so the two must stay together.
  install -Dm755 try.rb "${pkgdir}/usr/lib/${pkgname}/try.rb"
  install -Dm644 lib/fuzzy.rb "${pkgdir}/usr/lib/${pkgname}/lib/fuzzy.rb"
  install -Dm644 lib/tui.rb "${pkgdir}/usr/lib/${pkgname}/lib/tui.rb"
  install -d "${pkgdir}/usr/bin"
  ln -sf "/usr/lib/${pkgname}/try.rb" "${pkgdir}/usr/bin/try"

  # Omarchy's package ships no licence file; adding one costs nothing and is
  # the packaging norm here.
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"

  # Fail the build if any shipped ELF records a build-tree path
  # (tools/elf-pathguard.sh -- house policy, applied to every recipe here).
  # There is no ELF in a Ruby package; this is what would catch a future
  # revision quietly gaining one.
  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"
}
