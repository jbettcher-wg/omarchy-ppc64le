# power9 — duotone btop. Static file: omarchy-theme-set-templates skips any
# config already present in the theme folder, so this is not regenerated.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a0e14"

# Main text color
theme[main_fg]="#c3cbd8"

# Title color for boxes
theme[title]="#e6ebf2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9fe870"

# Background color of selected item in processes box
theme[selected_bg]="#1b2230"

# Foreground color of selected item in processes box
theme[selected_fg]="#9fe870"

# Color of inactive/disabled text
theme[inactive_fg]="#3f4a5a"

# Color of text appearing on top of graphs
theme[graph_text]="#e6ebf2"

# Background color of the percentage meters
theme[meter_bg]="#1b2230"

# Misc colors for processes box
theme[proc_misc]="#78a9ff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#0f62fe"
theme[mem_box]="#9fe870"
theme[net_box]="#78a9ff"
theme[proc_box]="#0f62fe"

# Box divider line and small boxes line color
theme[div_line]="#1b2230"

# Temperature graph — kept a real warning ramp so hot hardware still reads hot
theme[temp_start]="#9fe870"
theme[temp_mid]="#d2a106"
theme[temp_end]="#fa4d56"

# CPU graph — green into blue
theme[cpu_start]="#9fe870"
theme[cpu_mid]="#33b1ff"
theme[cpu_end]="#0f62fe"

# Mem/Disk free meter
theme[free_start]="#1b2230"
theme[free_mid]="#3f4a5a"
theme[free_end]="#6b7789"

# Mem/Disk cached meter
theme[cached_start]="#0f62fe"
theme[cached_mid]="#33b1ff"
theme[cached_end]="#78a9ff"

# Mem/Disk available meter
theme[available_start]="#78a9ff"
theme[available_mid]="#0f62fe"
theme[available_end]="#0a3fb8"

# Mem/Disk used meter
theme[used_start]="#9fe870"
theme[used_mid]="#33b1ff"
theme[used_end]="#0f62fe"

# Download graph
theme[download_start]="#78a9ff"
theme[download_mid]="#0f62fe"
theme[download_end]="#0a3fb8"

# Upload graph
theme[upload_start]="#c8f79f"
theme[upload_mid]="#9fe870"
theme[upload_end]="#00893b"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#9fe870"
theme[process_mid]="#33b1ff"
theme[process_end]="#0f62fe"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#0a0e14"
theme[gradient_color_1]="#0d1219"
theme[gradient_color_2]="#1b2230"
theme[gradient_color_3]="#3f4a5a"
theme[gradient_color_4]="#6b7789"
theme[gradient_color_5]="#c3cbd8"
theme[gradient_color_6]="#e6ebf2"
theme[gradient_color_7]="#f4f7fb"
