# ttfx -- the screensaver's animation engine.
#
# Not in Arch, not in Arch POWER, not in the AUR: Omarchy publishes it from
# their own repository, which we do not mirror, so bq finds no recipe for it in
# any of local/archpower/gitlab/aur. Written here from upstream source.
#
# It matters more than "a screensaver" suggests: omarchy-launch-screensaver
# opens with `omarchy-cmd-missing ttfx && exit 1`, so without this the
# screensaver silently does nothing -- no error, no notification, and the idle
# timeout at 150s simply has no effect. omarchy-screensaver also pkills it by
# name, so the binary must be called exactly ttfx.
#
# Pure Rust with no architecture-specific code, and rustc carries
# powerpc64le-unknown-linux-gnu as a first-class target, so this needs no
# porting -- only packaging.
#
# Upstream builds a static musl binary for their own distribution. We link
# against the system glibc instead, the way every other native package here
# does; a static binary would sidestep the repo's own libraries for no benefit
# on a machine where they are present and correct.

pkgname=ttfx
pkgver=0.3.2
pkgrel=1
pkgdesc='Terminal text effects as a single static binary -- a parity-exact Rust port of terminaltexteffects'
arch=(powerpc64le)
url='https://github.com/omacom-io/ttfx'
license=(MIT)
depends=(gcc-libs glibc)
makedepends=(cargo git)
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  # --locked so the build uses the committed Cargo.lock rather than resolving
  # fresh versions at build time; a package that resolves its own dependencies
  # is not reproducible.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release || warning "tests failed; effects are visual and the suite is thin"
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  for f in LICENSE LICENSE.md LICENSE.txt COPYING; do
    [[ -f $f ]] && { install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$f"; break; }
  done
  for f in README.md README; do
    [[ -f $f ]] && { install -Dm644 "$f" "$pkgdir/usr/share/doc/$pkgname/$f"; break; }
  done
  return 0
}
