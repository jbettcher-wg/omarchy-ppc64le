# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# The JetBrains Mono Nerd Font faces Omarchy's install/omarchy-base.packages
# actually names.  arch=any font data: no ELF, no compiled anything, so
# nothing here is architecture-dependent and arch=(any) is the literal truth
# rather than a claim that needed checking.  Nothing was added to arch=() --
# there is no ppc64le-specific change in this recipe at all.
#
# Why this is built from the Nerd Fonts release instead of repackaging
# Omarchy's binary package (as packages/omarchy-nvim has to do):
#
#   Omarchy publishes no PKGBUILD, but for this package it does not matter,
#   because its payload is verbatim upstream release files.  The four .ttf in
#   ttf-jetbrains-mono-nerd-basic-3.5.0-1-any.pkg.tar.zst are byte-for-byte
#   the same four files inside ryanoasis/nerd-fonts v3.5.0 JetBrainsMono.tar.xz,
#   and the shipped OFL.txt is the release's OFL.txt unmodified:
#
#     39878d75...  JetBrainsMonoNerdFont-Bold.ttf
#     dafe5a96...  JetBrainsMonoNerdFont-BoldItalic.ttf
#     19201113...  JetBrainsMonoNerdFont-Italic.ttf
#     1767e08e...  JetBrainsMonoNerdFont-Regular.ttf
#     30f0c136...  OFL.txt
#
#   (full digests in _upstream_sha256 below, asserted at build time).  So
#   sourcing from ryanoasis/nerd-fonts costs nothing in fidelity and buys a
#   real provenance chain -- a GitHub release with a pinned digest instead of
#   an opaque blob from pkgs.omarchy.org that we would have to trust and could
#   not reproduce.
#
# What "basic" means, established by comparing the two file sets: the v3.5.0
# JetBrainsMono release archive holds 98 .ttf -- three variants (the default
# proportional-metrics build, ...NerdFontMono, ...NerdFontPropo) x sixteen
# weights x plus the "NL" (no-ligature) cut of each.  Omarchy's "basic"
# package is the four faces a terminal and a UI toolkit actually resolve:
# the default variant at Regular/Bold/Italic/BoldItalic.  It is a selection,
# not a subset -- the files are not re-generated, re-hinted or renamed -- so
# it is exactly reproducible by installing those four names and no others.
#
# Version bumps: _upstream_sha256 pins the bytes Omarchy ships today.  When
# bumping pkgver, re-download Omarchy's package for the new version and
# re-derive these digests rather than deleting the check -- the point of the
# assertion is to notice if Omarchy ever starts post-processing the fonts
# (subsetting, re-hinting) instead of just selecting release files, which is
# the one thing that would make rebuilding from source no longer equivalent.

pkgname=ttf-jetbrains-mono-nerd-basic
pkgver=3.5.0
pkgrel=1
pkgdesc='Basic JetBrains Mono Nerd Font family'
arch=(any)
url='https://github.com/ryanoasis/nerd-fonts'
license=('OFL-1.1-no-RFN')
groups=(nerd-fonts)
# Mirrors Omarchy's own metadata exactly (from its repo DB), so this package
# is interchangeable with theirs for anything that depends on either name.
provides=('ttf-font-nerd' "ttf-jetbrains-mono-nerd=${pkgver}")
conflicts=('ttf-jetbrains-mono-nerd' 'nerd-fonts-jetbrains-mono')
makedepends=(fontconfig)
source=("JetBrainsMono-${pkgver}.tar.xz::https://github.com/ryanoasis/nerd-fonts/releases/download/v${pkgver}/JetBrainsMono.tar.xz")
noextract=("JetBrainsMono-${pkgver}.tar.xz")
sha256sums=('0227b220360a6f819b9ead92343e8112b34733054782561af50cfba1e8afab63')

# The four faces Omarchy's package contains, and nothing else.
_faces=(Regular Bold Italic BoldItalic)

# sha256 of the corresponding members of
# ttf-jetbrains-mono-nerd-basic-3.5.0-1-any.pkg.tar.zst
# (itself sha256 80efde6920fa7756ea93a72f9a57d1263dea347de8bf9fa7c5cb68e173c55725).
_upstream_sha256=(
  '1767e08e6b207eb57c114e833b817e26c6a7625bbcf474e3b4dd0f73c10e5bdc  JetBrainsMonoNerdFont-Regular.ttf'
  '39878d753c3ae005172b8ee4c4f72c4e6a5c641ddb844110d66bf9eba77dc90a  JetBrainsMonoNerdFont-Bold.ttf'
  '1920111383857d3b3785e661c334701729436901f53e087522c0fa73e55d1fc0  JetBrainsMonoNerdFont-Italic.ttf'
  'dafe5a9603a94584f95926c99beb684b70d63200ff2af86ae92715e100505a4d  JetBrainsMonoNerdFont-BoldItalic.ttf'
  '30f0c136e3c88e422d0791acd97238870f9054a9729bc34cf2ff0d4ed8cac4ad  OFL.txt'
)

prepare() {
  # The release tarball has no top-level directory -- 98 .ttf plus OFL.txt and
  # README.md would land loose in $srcdir -- so unpack it somewhere named.
  rm -rf "${srcdir}/release"
  mkdir -p "${srcdir}/release"
  bsdtar -xf "${srcdir}/JetBrainsMono-${pkgver}.tar.xz" -C "${srcdir}/release" --no-same-owner

  # This assertion lives in prepare(), not check(), on purpose: tools/build.sh
  # runs makepkg --nocheck, so check() does not run in a normal build, and
  # "the bytes match what Omarchy ships" is the claim this whole recipe rests
  # on.  It must be enforced on the path that always executes.
  ( cd "${srcdir}/release" && printf '%s\n' "${_upstream_sha256[@]}" | sha256sum -c --quiet ) || {
    printf '%s: release files differ from the bytes Omarchy ships -- do not ship this\n' "$pkgname" >&2
    return 1
  }
}

check() {
  # Verification that the fonts are usable, not merely present.  Skipped by
  # tools/build.sh (--nocheck); run `makepkg --check` by hand, or the
  # equivalent fc-scan/fc-query commands against the staged tree.
  local d="${srcdir}/release" f fam

  # 1. Exactly the four faces exist, and no name drift in the release.
  for f in "${_faces[@]}"; do
    [ -f "${d}/JetBrainsMonoNerdFont-${f}.ttf" ] || {
      printf '%s: missing face %s in the v%s release\n' "$pkgname" "$f" "$pkgver" >&2
      return 1
    }
  done

  # 2. fontconfig parses each face and reports the family Omarchy's configs
  #    name verbatim.  A silent rename upstream (it has happened across Nerd
  #    Fonts majors: "JetBrainsMono Nerd Font" vs "JetBrainsMonoNerdFont")
  #    would leave every config pointing at nothing, so fail on it here.
  for f in "${_faces[@]}"; do
    fam=$(fc-scan --format '%{family}' "${d}/JetBrainsMonoNerdFont-${f}.ttf")
    case ",${fam}," in
      *,'JetBrainsMono Nerd Font',*) ;;
      *) printf '%s: %s reports family %q, not "JetBrainsMono Nerd Font"\n' \
           "$pkgname" "$f" "$fam" >&2; return 1 ;;
    esac
  done

  # 3. The patched glyphs are actually there.  A "Nerd Font" that shipped the
  #    unpatched JetBrains Mono would parse fine, match fine, and render
  #    tofu for every powerline separator and devicon in the prompt -- the
  #    exact silent failure this check exists to catch.  U+E0B0 is the
  #    powerline right-arrow, U+F001 is a Font Awesome glyph; fc-query prints
  #    the charset as space-separated hex ranges.
  local cs
  cs=$(fc-query --format '%{charset}' "${d}/JetBrainsMonoNerdFont-Regular.ttf" | tr ' ' '\n')
  grep -qx 'e0b0-e0c8' <<<"$cs" || grep -qE '^e0[ab][0-9a-f]-' <<<"$cs" || {
    printf '%s: no powerline range (U+E0B0) in the cmap -- unpatched font?\n' "$pkgname" >&2
    return 1
  }
  grep -qE '^f0[0-3][0-9a-f]-' <<<"$cs" || {
    printf '%s: no U+F001 range in the cmap -- unpatched font?\n' "$pkgname" >&2
    return 1
  }
}

package() {
  local f
  # Same destination Omarchy uses (/usr/share/fonts/TTF), which is what makes
  # this a drop-in replacement for their package rather than a second copy.
  install -d "${pkgdir}/usr/share/fonts/TTF"
  for f in "${_faces[@]}"; do
    install -m644 "${srcdir}/release/JetBrainsMonoNerdFont-${f}.ttf" \
      "${pkgdir}/usr/share/fonts/TTF/JetBrainsMonoNerdFont-${f}.ttf"
  done
  install -Dm644 "${srcdir}/release/OFL.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/OFL.txt"

  # No .install scriptlet: fontconfig's own pacman hook rebuilds the font
  # cache for /usr/share/fonts, and Omarchy's package carries no scriptlet
  # either (its .PKGINFO has no %INSTALL% and the archive no .INSTALL).

  # Fail the build if any shipped ELF records a build-tree path.  There is no
  # ELF in a font package; the guard is house policy and costs nothing, and it
  # is the thing that would catch a future revision quietly gaining a binary.
  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"
}
