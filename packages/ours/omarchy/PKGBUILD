# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Omarchy 4's base package, repackaged for ppc64le.
#
# There is no port here.  The content is architecture-independent: as of 4.0.3
# all 1,169 shipped files are shell, Lua, TOML, desktop entries and PNGs, with
# zero machine code (4.0.2 had 1,561).  Upstream labelled 4.0.2 arch=any and
# relabelled 4.0.3 arch=x86_64 without changing that -- see the note at source=.
# Unlike omarchy-nvim, which declared any while vendoring two x86-64 ELF
# binaries, the content here is honest even where the label is not.  check()
# below enforces zero machine code, so if upstream ever starts vendoring a binary
# the build fails instead of shipping a foreign one.
#
# What this package needs instead is dependency surgery, and it is not
# cosmetic.  Upstream depends on limine, limine-mkinitcpio-hook,
# limine-snapper-sync and snapper.  limine is an x86/aarch64 UEFI+BIOS
# bootloader; POWER9 boots through OPAL/petitboot.  So limine is not merely
# unpackaged for this architecture, it is the wrong component -- the one
# dependency here that could never be satisfied by porting harder.
#
# Changes to the shipped tree are each justified at the point they are made in
# package(), including the AUR install precheck added in 4.0.3-4.  Everything else ships byte-for-byte as upstream built it.
#
# Upstream publishes no PKGBUILD -- the Omarchy repo distributes built packages
# only -- so the source *is* the upstream package, exactly as for omarchy-nvim.
# Its sha256 is the one recorded in https://pkgs.omarchy.org/x86_64/omarchy.db,
# so this recipe is pinned to the artifact upstream actually published.
#
# arch=(any) was correct as it stood.  No architecture change was needed.

pkgname=omarchy
pkgver=4.0.3
# pkgrel above 1 marks this as locally modified: upstream's own build is 4.0.3-1.
pkgrel=4
pkgdesc='Beautiful, modern, and opinionated Arch Linux by DHH (ppc64le: limine and update-guard removed)'
arch=(any)
url='https://github.com/basecamp/omarchy'
license=(MIT)
makedepends=(file)

# Upstream's depends, minus five entries:
#
#   omarchy-keyring          Verifies package signatures from pkgs.omarchy.org.
#                            That repo has no ppc64le tree and is not in this
#                            machine's pacman.conf, so the keyring is never
#                            consulted.  Requiring it would only be a package
#                            that must be built to sit unused.
#   limine                   x86/aarch64 bootloader.  POWER9 boots via
#   limine-mkinitcpio-hook   OPAL/petitboot.  Wrong component, not a missing
#   limine-snapper-sync      port.
#   snapper                  Present only to feed limine-snapper-sync's boot
#                            entries.  Not in the ppc64le repos, and without
#                            limine there is nothing to sync snapshots to.
#                            Demoted to optdepends: snapper itself is useful,
#                            the boot integration is what does not apply.
#
# Everything else is either installed on this machine or already built in this
# repo (hyprland, quickshell, uwsm, xdg-desktop-portal-hyprland), so the
# dependency closure genuinely resolves on ppc64le.
depends=(
  "omarchy-settings=${pkgver}"
  hyprland
  quickshell
  uwsm
  # Every app binding goes through omarchy-launch-*, and 11 of those scripts
  # exec `uwsm-app -- xdg-terminal-exec ...`. Upstream never declares it, so a
  # system without it gets a Hyprland session where SUPER+RETURN and every other
  # launch binding fail silently -- the compositor is fine, nothing starts, and
  # there is no error anywhere the user will look.
  xdg-terminal-exec
  sddm
  xdg-desktop-portal-hyprland
  wireplumber
  pipewire
  gnome-keyring
  gum
  jq
  git
  perl
  fakeroot
  pacman-contrib
  ttf-jetbrains-mono-nerd-basic
)

optdepends=(
  'snapper: btrfs snapshots (omarchy-snapshot); upstream also uses it to feed limine boot entries, which do not apply on OPAL/petitboot'
  'plocate: file indexing for the Omarchy menu search'
  'inxi: system information for omarchy-debug'
)

conflicts=(omarchy-dev)

# Upstream's published artifact. From 4.0.3 upstream labels it arch=x86_64
# (4.0.2 shipped as -any), but the content did not change class: verified for
# 4.0.3-1 -- sha256 matches omarchy.db, 1,169 files, zero ELF or object files,
# identical depends -- and the upstream tree has no packaging or compiled-source
# change between v4.0.2 and v4.0.3. The relabel is in their build pipeline, not
# the source. check() keeps enforcing zero machine code, so this stays arch=(any);
# if upstream ever ships a real binary here, the build fails instead of trusting
# the label.
_upstream_arch=x86_64
_srcpkg="${pkgname}-${pkgver}-1-${_upstream_arch}.pkg.tar.zst"
source=("https://pkgs.omarchy.org/x86_64/${_srcpkg}"
        omarchy-pkg-aur-precheck)
noextract=("${_srcpkg}")
# From %SHA256SUM% in the upstream omarchy.db, not computed from a local copy.
sha256sums=('665e0a63d2fa4943c20dac70f71a7e9f8c315e8f2f321797880bf822428522a5'
            '46a884384a9fc4e4cf787e91a4db0c7b5fe691312b5c9ae04690915bc0d7743b')

_unpack() {
  bsdtar -xf "${srcdir}/${_srcpkg}" -C "$1" \
    --no-same-owner \
    --exclude .PKGINFO --exclude .BUILDINFO --exclude .MTREE --exclude .INSTALL
}

check() {
  # The premise of this package: arch=any is honest, i.e. not one byte of
  # machine code.  Verified true for 4.0.2.  If a future version vendors a
  # prebuilt x86-64 helper the way omarchy-nvim vendored stylua and shfmt,
  # fail here rather than shipping a binary that cannot run.
  local found
  rm -rf "${srcdir}/upstream"
  mkdir -p "${srcdir}/upstream"
  _unpack "${srcdir}/upstream"

  found=$(find "${srcdir}/upstream" -type f -print0 \
    | xargs -0 file -N --mime-type 2>/dev/null \
    | awk -F': ' '$2 ~ /^application\/x-(pie-)?(executable|sharedlib)|x-object|x-archive/ { print $1 }' \
    | sed "s|^${srcdir}/upstream/||" | sort)

  if [ -n "$found" ]; then
    printf 'omarchy %s is not arch=any after all -- ELF payload found:\n%s\n' \
      "$pkgver" "$found" >&2
    return 1
  fi

  # The two files package() removes must actually be there.  If upstream
  # renames or drops them, the removal below would silently no-op and this
  # package would quietly regain the behaviour it exists to remove.
  [ -f "${srcdir}/upstream/usr/share/libalpm/hooks/00-omarchy-update-guard.hook" ]
}

package() {
  _unpack "${pkgdir}"

  # Remove the pacman update guard.
  #
  # 00-omarchy-update-guard.hook triggers on Operation=Upgrade, Target=* with
  # AbortOnFail, and runs omarchy-update-pacman-guard, which exits 1 for any
  # `pacman -Syu` telling the user to run `omarchy update` instead.  That is
  # the right default on x86 Omarchy, where `omarchy update` works.
  #
  # It is the wrong default here.  `omarchy update` expects the Omarchy pacman
  # channel (no ppc64le tree), omarchy-keyring and snapper snapshots -- none of
  # which exist on this machine.  Leaving the hook in place would make the
  # guard fail closed against the *only* working update path on a daily-driver
  # workstation: every `pacman -Syu` would abort, and the alternative it names
  # cannot run.  The escape hatch (OMARCHY_ALLOW_DIRECT_PACMAN=1) exists, but
  # requiring it for every routine upgrade is not a defensible default.
  #
  # Local workaround, not upstreamable: the hook is correct for the platform it
  # was written for.
  rm -f "${pkgdir}/usr/share/libalpm/hooks/00-omarchy-update-guard.hook"

  # The other two libalpm hooks (10-/90- hyprland reload around
  # omarchy-settings upgrades) are kept.  They are not AbortOnFail, so a host
  # with no Hyprland session running fails them harmlessly.

  # Fail the build if any shipped ELF records a build-tree path.  This package
  # ships no ELF at all, so the guard should report zero files -- which is
  # itself the assertion worth keeping, and costs nothing.
  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"

  # ppc64le: pin Claude Code to the last version that can run here.
  #
  # omarchy-default-agent installs coding agents through mise, and for claude it
  # asks mise for the bare `claude` tool -- currently 2.1.263. Everything from
  # 2.1.113 onward ships a prebuilt native binary per platform
  # (@anthropic-ai/claude-code-{darwin,linux,win32}-{arm64,x64}[-musl], eight of
  # them, none for ppc64le) and the npm package is just a wrapper that execs it.
  # Installing one here gets:
  #
  #   Error: claude native binary not installed.
  #
  # 2.1.112 is the last pure-JavaScript release -- verified against the registry:
  # 510 published versions, 2.1.113 is the first with those optionalDependencies.
  # It runs on any Node, so it runs here.
  #
  # mise takes npm: specs, which is how upstream already handles grok and
  # oh-my-pi, so this is their own extension point rather than a new mechanism.
  sed -i \
    's#^claude | claude-code) agent="claude"; name="Claude Code" ;;#claude | claude-code) agent="claude"; name="Claude Code"; agent_package="npm:@anthropic-ai/claude-code@2.1.112" ;;#' \
    "${pkgdir}/usr/bin/omarchy-default-agent"
  grep -q 'claude-code@2.1.112' "${pkgdir}/usr/bin/omarchy-default-agent" ||
    { echo "omarchy: failed to pin claude-code; upstream changed the case line" >&2; return 1; }

  # And give it a ripgrep it can find. The package vendors rg for
  # {arm64,x64}-{linux,darwin} only and looks it up by process.arch, which is
  # "ppc64" on little-endian POWER. The system ripgrep is a real one; point at it.
  sed -i \
    's#^mkdir -p "\$(dirname "\$agent_file")"#if [[ $agent == claude ]]; then\n  _cc=$(mise where "$agent_package" 2>/dev/null) \&\& [[ -d $_cc/vendor/ripgrep ]] \&\&\n    mkdir -p "$_cc/vendor/ripgrep/ppc64-linux" \&\&\n    ln -sf "$(command -v rg)" "$_cc/vendor/ripgrep/ppc64-linux/rg"\nfi\nmkdir -p "$(dirname "$agent_file")"#' \
    "${pkgdir}/usr/bin/omarchy-default-agent"

  # ppc64le: report the omarchy-power* repo as the stable channel.
  #
  # omarchy-version-channel (the channel line under OS in fastfetch) only
  # recognises omarchy.org mirror and pkgs URLs, so a system installed from
  # [omarchy-power9] reports "unknown". Until these packages are served from
  # Omarchy's own URLs, a pacman.conf that enables our repo is the stable
  # channel. Upstreamable form: match the repo section by name, not the URL.
  # The real script is usr/bin; usr/share/omarchy/bin/ holds an absolute symlink
  # to it (as for all 441 entries there), which must stay a symlink.
  local _ch="${pkgdir}/usr/bin/omarchy-version-channel"
  [ -f "$_ch" ] && [ ! -L "$_ch" ] ||
    { echo "omarchy: usr/bin/omarchy-version-channel is not a regular file" >&2; return 1; }
  local _anchor='if [[ $mirror == $pkgs ]]; then'
  grep -qxF "$_anchor" "$_ch" ||
    { echo "omarchy: omarchy-version-channel changed upstream; redo the stable override" >&2; return 1; }
  _OVERRIDE='if grep -qE "^\[omarchy-power[0-9]+\]" /etc/pacman.conf; then
  mirror="stable"
  pkgs="stable"
fi
' awk -v anchor="$_anchor" '$0 == anchor { print ENVIRON["_OVERRIDE"] } { print }' "$_ch" > "${srcdir}/omarchy-version-channel"
  install -m "$(stat -c %a "$_ch")" "${srcdir}/omarchy-version-channel" "$_ch"
  bash -n "$_ch"
  grep -qF '[omarchy-power[0-9]+' "$_ch" ||
    { echo "omarchy: stable channel override did not apply" >&2; return 1; }

  # ppc64le: look before yay builds an AUR package.
  #
  # omarchy-pkg-aur-install passes the picked names straight to
  # `yay -S --noconfirm`. yay then builds x86-only binary repacks anyway (it
  # passes --ignorearch; AUR openarena installed the release zip's .x86_64
  # binaries, labelled powerpc64le, runnable only through FEX's binfmt), and
  # stops mid-build on dependencies that are official Arch packages not yet built
  # for POWER. omarchy-pkg-aur-precheck reports both before anything builds and
  # asks before continuing. Upstreamable in spirit: the same check keyed on the
  # machine's own architecture helps Omarchy on ARM too.
  install -Dm755 "${srcdir}/omarchy-pkg-aur-precheck" "${pkgdir}/usr/bin/omarchy-pkg-aur-precheck"
  # usr/share/omarchy/bin holds an absolute symlink for every command.
  ln -sf /usr/bin/omarchy-pkg-aur-precheck "${pkgdir}/usr/share/omarchy/bin/omarchy-pkg-aur-precheck"
  local _aur="${pkgdir}/usr/bin/omarchy-pkg-aur-install"
  [ -f "$_aur" ] && [ ! -L "$_aur" ] ||
    { echo "omarchy: usr/bin/omarchy-pkg-aur-install is not a regular file" >&2; return 1; }
  local _aur_anchor='if [[ -n $pkg_names ]]; then'
  grep -qxF "$_aur_anchor" "$_aur" ||
    { echo "omarchy: omarchy-pkg-aur-install changed upstream; redo the precheck hook" >&2; return 1; }
  _PRECHECK='  # ppc64le: report binary repacks and unbuildable dependencies first.
  omarchy-pkg-aur-precheck $pkg_names || exit 1
' awk -v anchor="$_aur_anchor" '{ print } $0 == anchor { printf "%s", ENVIRON["_PRECHECK"] }' "$_aur" > "${srcdir}/omarchy-pkg-aur-install"
  install -m "$(stat -c %a "$_aur")" "${srcdir}/omarchy-pkg-aur-install" "$_aur"
  bash -n "$_aur"
  grep -qF 'omarchy-pkg-aur-precheck $pkg_names' "$_aur" ||
    { echo "omarchy: precheck hook did not apply" >&2; return 1; }
}
