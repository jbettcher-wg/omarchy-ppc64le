# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Contributor: Jon Kinney
#
# tensaku -- screenshot annotation tool for Wayland.  Started from the AUR
# `tensaku` recipe at 0.29.0 (aur.git d4039ece), which is upstream's own
# packaging file copied to the AUR by their release workflow.  0.29.0 is also
# the version Omarchy ships (omarchy.db tensaku 0.29.0-1).
#
# What changed for ppc64le:
#
# - arch=(powerpc64le).  Pure Rust on gtk4/libadwaita/gtk4-layer-shell, all of
#   which our repo carries; no architecture-specific code.
# - The repo's rust (1:1.98.1) builds it.  Upstream's rust-toolchain.toml pins
#   1.95.0 for CI lint stability; without rustup that file is inert, and the
#   AUR's RUSTUP_TOOLCHAIN=stable is dropped for the same reason.
# - CARGO_HOME under $srcdir, so the build writes nothing into $HOME.

pkgname=tensaku
pkgver=0.29.0
pkgrel=1
pkgdesc='Modern screenshot annotation tool for Wayland'
arch=(powerpc64le)
url='https://github.com/jondkinney/tensaku'
license=(MPL-2.0)
depends=(gtk4 gtk4-layer-shell libadwaita libepoxy fontconfig)
makedepends=(rust)
# Window snapping and pin placement ask the compositor where its windows are.
optdepends=('hyprland: window snapping and pin placement'
            'sway: window snapping and pin placement')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('31595a8b4600107a63c1e5889f50f40e1ef832e51cfc038c1a7750b987fd34d0')

prepare() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --features ci-release
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --features ci-release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/tensaku "$pkgdir/usr/bin/tensaku"
  install -Dm755 assets/tensaku-edit "$pkgdir/usr/bin/tensaku-edit"
  install -Dm644 dev.tensaku.Tensaku.desktop "$pkgdir/usr/share/applications/dev.tensaku.Tensaku.desktop"
  install -Dm644 assets/tensaku.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.tensaku.Tensaku.svg"
  install -Dm644 man/tensaku.1 "$pkgdir/usr/share/man/man1/tensaku.1"
  install -Dm644 completions/tensaku.bash "$pkgdir/usr/share/bash-completion/completions/tensaku"
  install -Dm644 completions/tensaku.fish "$pkgdir/usr/share/fish/vendor_completions.d/tensaku.fish"
  install -Dm644 completions/_tensaku "$pkgdir/usr/share/zsh/site-functions/_tensaku"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
