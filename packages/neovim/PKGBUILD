prepare() {
  cd ${pkgname}
  git apply -v ../0001-findlpeg-link-by-name-not-absolute-path.patch
}

build() {
  local cmake_options=(
    -B build
    -G Ninja
    -D CMAKE_BUILD_TYPE=RelWithDebInfo
    -D CMAKE_INSTALL_PREFIX=/usr
    -D USE_BUNDLED=OFF
    -D ENABLE_TRANSLATIONS=ON
    -W no-dev
    # Pin dependency discovery to the real system prefix.
    #
    # tools/build.sh exports CMAKE_PREFIX_PATH=$SYSROOT/usr so packages we built
    # ourselves are visible without root. CMake searches CMAKE_PREFIX_PATH ahead
    # of the system prefixes, so find_library returns paths under
    # ~/omarchy-work/sysroot -- and anything CMake bakes into the binary then
    # points at a scratch directory in $HOME. That is how 0.12.5-1 came to ship
    # a DT_NEEDED into the sysroot, and how it was configured against whichever
    # LuaJIT happened to be staged there rather than the installed one.
    #
    # Naming these explicitly makes discovery reproducible and keeps every
    # recorded path under /usr. tools/build.sh builds under a bwrap overlay that
    # presents the sysroot at /usr, so these resolve whether or not the
    # dependency is also installed system-wide.
    -D LPEG_LIBRARY=/usr/lib/lua/5.1/lpeg.so
    -D LUAJIT_INCLUDE_DIR=/usr/include/luajit-2.1
    -D LUAJIT_LIBRARY=/usr/lib/libluajit-5.1.so
    -D LUA_PRG=/usr/bin/luajit
    -D LUA_GEN_PRG=/usr/bin/luajit
  )

  cd ${pkgname}
  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

check() {
  cd ${pkgname}
  ./build/bin/nvim --version
  ./build/bin/nvim --headless -u NONE -i NONE +q

  # These assert the LuaJIT nvim *loads* is JIT-capable. Note what they do not
  # prove: LUAJIT_VERSION lives only in libluajit-5.1.so.2, never in the nvim
  # binary, so `nvim --version` and jit.status() report the library present at
  # run time and cannot distinguish which headers the build used. That is why
  # 0.12.5-1 passed exactly these checks while having been configured against
  # the old LuaJIT. The build-time identity is pinned by LUAJIT_INCLUDE_DIR
  # above and is auditable in .BUILDINFO; this only catches a broken runtime.
  ./build/bin/nvim --headless -u NONE -i NONE \
    +'lua assert(jit and jit.status(), "LuaJIT built without a working JIT")' \
    +'lua assert(pcall(require, "string.buffer"), "LuaJIT lacks string.buffer")' \
    +q
}

package() {
  install -Dm644 -t "${pkgdir}"/usr/share/libalpm/hooks/ nvimdoc.hook
  install -Dt "${pkgdir}"/usr/share/libalpm/scripts/ nvimdoc

  cd ${pkgname}
  DESTDIR="${pkgdir}" cmake --install build

  install -Dm644 LICENSE.txt -t "${pkgdir}"/usr/share/licenses/${pkgname}/
  install -Dm644 runtime/nvim.desktop -t "${pkgdir}"/usr/share/applications/
  install -Dm644 runtime/nvim.appdata.xml -t "${pkgdir}"/usr/share/metainfo/
  install -Dm644 runtime/nvim.png -t "${pkgdir}"/usr/share/pixmaps/

  # Tree-sitter grammars are packaged separately and installed into
  # /usr/lib/tree_sitter.
  ln -s /usr/lib/tree_sitter "${pkgdir}"/usr/share/nvim/runtime/parser

  # Include system-wide Vim directory in runtimepath
  mkdir -p "${pkgdir}"/etc/xdg/nvim
  echo 'source /usr/share/nvim/archlinux.lua' > "${pkgdir}"/etc/xdg/nvim/sysinit.vim

  mkdir -p "${pkgdir}"/usr/share/vim
  cat > "${pkgdir}"/usr/share/nvim/archlinux.lua << EOF
-- Modify runtimepath to also search the system-wide Vim directory
-- (eg. for Vim runtime files from Arch Linux packages)
vim.opt.runtimepath:append({ '/usr/share/vim/vimfiles', '/usr/share/vim/vimfiles/after' })
EOF

  # Fail the build if any shipped ELF records a build-tree path in DT_NEEDED,
  # RPATH or RUNPATH. 0.12.5-1 shipped one and nothing noticed until somebody
  # read `readelf -d`. Fail-closed: if the guard cannot be located, this errors.
  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"
}
