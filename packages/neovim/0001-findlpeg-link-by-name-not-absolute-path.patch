Link lpeg by name instead of by absolute path.

Portability fix, worth sending upstream. Not ppc64le-specific.

lua51-lpeg ships /usr/lib/lua/5.1/lpeg.so with no DT_SONAME. cmake/FindLpeg.cmake
resolves it with find_library and hands the resulting absolute path to the linker
via an UNKNOWN IMPORTED target. GNU ld records a SONAME-less shared object in
DT_NEEDED under the exact spelling it saw, so that absolute path is baked into
the nvim binary. Arch official builds ship
  NEEDED [/usr/lib/lua/5.1/lpeg.so]
which merely looks odd; but any build that resolves lpeg under a staging prefix
ships a DT_NEEDED into that prefix and stops working when it is removed. That is
what happened to omarchy-ppc64le neovim 0.12.5-1, which shipped
  NEEDED [/home/jbettcher/omarchy-work/sysroot/usr/lib/lua/5.1/lpeg.so]

Emit "-L<dir> -l:<file>" plus an rpath for the same directory instead. ld then
records NEEDED [lpeg.so] and the loader resolves it through RUNPATH; Lua module
directories are not on the default search path, so the rpath is required.
Static archives keep the old direct-path link, which records nothing.

diff --git a/cmake/FindLpeg.cmake b/cmake/FindLpeg.cmake
index 7657bdac9e..51cff6b386 100644
--- a/cmake/FindLpeg.cmake
+++ b/cmake/FindLpeg.cmake
@@ -12,7 +12,26 @@ endif()
 find_package_handle_standard_args(Lpeg DEFAULT_MSG LPEG_LIBRARY)
 mark_as_advanced(LPEG_LIBRARY)
 
-# Workaround: use an imported library to prevent cmake from modifying library
-# link path. See #23395.
-add_library(lpeg UNKNOWN IMPORTED)
-set_target_properties(lpeg PROPERTIES IMPORTED_LOCATION ${LPEG_LIBRARY})
+# Link a shared lpeg by name, not by the absolute path find_library returned.
+#
+# lpeg.so is a Lua C module and carries no DT_SONAME. GNU ld records a
+# SONAME-less shared object in DT_NEEDED under the exact spelling it was given
+# on the command line, so handing it an absolute path bakes that path into the
+# executable. A distro build gets NEEDED [/usr/lib/lua/5.1/lpeg.so]; a build
+# that resolved lpeg under a staging prefix gets NEEDED [<prefix>/lpeg.so] and
+# stops working the moment that directory is removed.
+#
+# "-L<dir> -l:<file>" makes ld record the bare name instead, and an rpath entry
+# for the same directory lets the loader find it -- Lua module directories are
+# not on the default search path.
+if(LPEG_LIBRARY MATCHES "\\.a$")
+  # Static archive: nothing of the path is recorded, link it directly.
+  add_library(lpeg UNKNOWN IMPORTED)
+  set_target_properties(lpeg PROPERTIES IMPORTED_LOCATION ${LPEG_LIBRARY})
+else()
+  get_filename_component(LPEG_LIBRARY_DIR "${LPEG_LIBRARY}" DIRECTORY)
+  get_filename_component(LPEG_LIBRARY_NAME "${LPEG_LIBRARY}" NAME)
+  add_library(lpeg INTERFACE IMPORTED)
+  set_target_properties(lpeg PROPERTIES INTERFACE_LINK_LIBRARIES
+    "-L${LPEG_LIBRARY_DIR};-l:${LPEG_LIBRARY_NAME};-Wl,-rpath,${LPEG_LIBRARY_DIR}")
+endif()
