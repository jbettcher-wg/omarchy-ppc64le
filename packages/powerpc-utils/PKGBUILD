# Maintainer: Alexander Baldeck <alex.bldck@gmail.com>
pkgname=powerpc-utils
pkgver=1.3.8
pkgrel=1.1
pkgdesc="Contains utilities which are intended for maintenance of IBM powerpc platforms"
arch=(powerpc64le powerpc64 powerpc)
url="https://github.com/ibm-power-utilities/powerpc-utils"
license=('GPL')
depends=(librtas)
makedepends=(git)
source=("${pkgname}-${pkgver}::git+https://github.com/ibm-power-utilities/powerpc-utils.git?#tag=v${pkgver}")
md5sums=('SKIP')

prepare() {
	cd "$srcdir/${pkgname}-${pkgver}"
	sh autogen.sh
}

build() {
	cd "$srcdir/${pkgname}-${pkgver}"
	# GCC 15 defaults to C23, where an empty parameter list means (void)
	# rather than "unspecified". This tree predates that and declares its
	# rtas callbacks the old way, so every call and function-pointer
	# initialiser mismatches. Build it as the C it was written in.
	CFLAGS+=" -std=gnu17"
	./configure --prefix=/usr \
                    --sbindir=/usr/bin \
		    --with-systemd=/usr/lib/systemd/system \
		    --disable-werror
	make
}

check() {
	cd "$srcdir/${pkgname}-${pkgver}"
	make -k check
}

package() {
	cd "$srcdir/${pkgname}-${pkgver}"
	make DESTDIR="$pkgdir/" install
}
