# ppc64le: arch=any JavaScript, but it does not build out of the box here.
# Three changes from Arch upstream, all of them forced by the same underlying
# fact -- pnpm's build assumes prebuilt native helpers that only exist for
# x86_64/aarch64, and assumes a pnpm already installed to run the build with.
#
# 1. Bootstrap (makedepends, _bootstrap_pnpm).
#    Arch builds this with `makedepends=(pnpm)`: pnpm compiles itself. Arch
#    POWER has no pnpm to start from, so the build was refused before it began:
#
#      [1/1] pnpm ... FAIL [missing-dep] not in Arch POWER and not yet built: pnpm
#
#    pnpm is published on the npm registry as a self-contained, architecture-
#    independent .mjs -- no native code, nothing to compile -- so npm, which
#    Arch POWER does ship, can drop one into $srcdir and break the cycle.
#    node's own `corepack` would serve equally well, but Arch's nodejs 26
#    package no longer installs it, so npm it is.
#
# 2. supportedArchitectures (prepare, and --cpu in the bundle script).
#    pnpm 11 pins its own Node.js toolchain via `devEngines.runtime` in the
#    workspace root package.json and downloads it during install. It takes each
#    variant's cpu straight from the Node.js tarball filename -- "ppc64le" --
#    and then matches that against `process.arch`, which node reports as
#    "ppc64" on little-endian POWER. Those never compare equal, so install died
#    with the tarball it wanted sitting right there in the list it printed:
#
#      [ERR_PNPM_NO_RESOLUTION_MATCHED] Cannot find a resolution variant for the
#      current platform in these resolutions: [... {"cpu":"ppc64le","os":"linux"} ...]
#
#    Naming the cpu explicitly makes the ppc64le variant win. This is an
#    upstream pnpm bug worth reporting, not a POWER quirk: no linux-ppc64le
#    host can resolve a `node@runtime:` dependency without this override.
#
# 3. Compile-script edits (prepare).
#    `pnpm run compile` runs two steps that cannot work here; both are edited
#    out of pnpm/package.json rather than hand-expanding the whole chain, so a
#    pkgver bump still picks up upstream's other compile steps. The edits are
#    reverted before package() ships package.json. See prepare() for each.
#
# Maintainer: Daniel M. Capella <polyzen@archlinux.org>
# Contributor: Severen Redwood <me@severen.dev>
# Contributor: Tomasz Jakub Rup <tomasz.rup@gmail.com>

pkgname=pnpm
pkgver=11.3.0
pkgrel=1
pkgdesc='Fast, disk space efficient package manager'
arch=(any)
url=https://pnpm.io
license=(MIT)
depends=(node-gyp)
makedepends=(
  git
  npm
  python
)
source=("git+https://github.com/$pkgname/$pkgname.git#tag=v$pkgver?signed")
b2sums=('f4678c4d2f5d628bf0c829f2ea7d1aa3201f0b7b99b07ef326976011b8b9b8d7e8dfa583aaa5899611eb0b73646dcf323cc349b455b3e1cccae438c2d102a48a')
validpgpkeys=(7B74D1299568B586BA9962B5649E4D4AF74E7DEC) # Zoltan Kochan <z@kochan.io>

# Fetch the bootstrap pnpm from the npm registry and put it first on PATH.
# Pinned to $pkgver so the compiler is the same release as the source being
# compiled; the workspace's own `devEngines.packageManager` then swaps in
# whatever exact pnpm upstream develops with, which is what we want.
_bootstrap_pnpm() {
  local boot="$srcdir/bootstrap"
  [[ -x $boot/bin/pnpm ]] || npm install -g --prefix "$boot" "pnpm@$pkgver"
  export PATH="$boot/bin:$PATH"
}

prepare() {
  _bootstrap_pnpm
  cd $pkgname/$pkgname

  # See note 2. Applied to the workspace manifest rather than passed as
  # `pnpm install --cpu=ppc64le`, because every later in-workspace pnpm call
  # (`pnpm run`, and the dependency re-verification that `verifyDepsBeforeRun`
  # triggers) has to resolve the same node runtime and would fail on its own.
  cat >>../pnpm-workspace.yaml <<'EOF'

supportedArchitectures:
  cpu:
    - ppc64le
EOF

  pnpm install --frozen-lockfile

  # See note 3. Keep upstream's package.json for the package; only the build
  # runs on the edited one.
  cp package.json package.json.upstream

  # tsgo is @typescript/native-preview, a Go binary Microsoft publishes only
  # for linux/darwin/win x64+arm64:
  #
  #   Error: Unable to resolve @typescript/native-preview-linux-ppc64.
  #   Either your platform is unsupported, or you are missing the package on disk.
  #
  # tsc from the typescript devDependency the workspace already installs does
  # the same `--build` over the same project references and compiles the whole
  # 205-project workspace clean, just slower (~11 min).
  sed -i 's/tsgo --build/tsc --build/' package.json

  # eslint cannot load either: its resolver ships a napi native binding with no
  # ppc64le build, and blames npm's optional-dependency bug for the miss --
  #
  #   Error: Cannot find native binding. npm has a bug related to optional
  #   dependencies (https://github.com/npm/cli/issues/4828).
  #
  # Linting is a developer step; dropping it changes nothing in the artifact.
  sed -i 's/ && pn lint --fix//' package.json

  # The bundle step shells out to `pnx node@runtime:24.6.0`, and pnpm runs dlx
  # in a scratch directory outside the workspace, so the pnpm-workspace.yaml
  # override above does not reach it. Same fix, spelled as a CLI flag.
  sed -i 's/pnx node@runtime:/pnx --cpu=ppc64le node@runtime:/' package.json
}

build() {
  _bootstrap_pnpm
  cd $pkgname/$pkgname
  pnpm run compile
}

package() {
  local mod_dir=/usr/lib/node_modules/$pkgname

  install -d "$pkgdir"/{usr/bin,$mod_dir/dist}
  ln -s $mod_dir/bin/$pkgname.mjs "$pkgdir"/usr/bin/$pkgname
  ln -s $mod_dir/bin/$pkgname.mjs "$pkgdir"/usr/bin/pn
  ln -s $mod_dir/bin/pnpx.mjs "$pkgdir"/usr/bin/pnpx
  ln -s $mod_dir/bin/pnpx.mjs "$pkgdir"/usr/bin/pnx

  cd $pkgname/$pkgname
  cp -r bin package.json "$pkgdir"/$mod_dir
  # Ship upstream's scripts, not the build-only edits from prepare().
  cp package.json.upstream "$pkgdir"/$mod_dir/package.json
  install -Dt "$pkgdir"/usr/share/licenses/$pkgname LICENSE
  cd dist
  cp -r $pkgname.mjs pnpmrc templates worker.js "$pkgdir"/$mod_dir/dist
}
