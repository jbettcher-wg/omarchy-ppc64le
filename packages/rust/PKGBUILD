# Make sure the duplication in rust-wasm is found
COMPRESSZST+=(--long)

prepare() {
  cd rustc-$pkgver-src

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  sed -i 's/\("files":{[^,]*\),[^}]*}/\1}/' vendor/*/.cargo-checksum.json

  _rust_target="\"${CHOST}\""
  # POWER9 codegen unless the POWER8 builder asks for POWER8:
  # tools/makepkg.conf.d/00-power8.conf exports _power8=1. libstd is statically
  # linked into every Rust binary, so consumer RUSTFLAGS cannot undo this pin;
  # it has to change here. docs/power8-secondary-target.md, section 4.
  local _rust_cpu=pwr9
  (( ${_power8:-0} )) && _rust_cpu=pwr8

  # Arch POWER turns LTO off for 32-bit powerpc; powerpc64le is the only arch
  # here, so it is always fat.
  _lto="fat"

  cat >bootstrap.toml <<END
# see src/bootstrap/defaults/
profile = "dist"

[llvm]
download-ci-llvm = false
link-shared = true

[build]
target = [
  ${_rust_target},
  "wasm32-unknown-unknown",
  "wasm32-wasip1",
  "wasm32-wasip1-threads",
  "wasm32-wasip2",
  "wasm32v1-none"
]
cargo = "/usr/bin/cargo"
description = "Omarchy ppc64le $pkgbase $epoch:$pkgver-$pkgrel"
rustc = "/usr/bin/rustc"
rustfmt = "/usr/bin/rustfmt"
locked-deps = true
vendor = true
tools = [
  "cargo",
  "clippy",
  "rustdoc",
  "rustfmt",
  "rust-analyzer-proc-macro-srv",
  "analysis",
  "src",
]
sanitizers = true
profiler = true

# Generating docs fails with the wasm32-* targets
docs = false

[install]
prefix = "/usr"

[rust]
codegen-units = 1
codegen-units-std = 1
debuginfo-level = 0
debuginfo-level-std = 0
incremental = true 
channel = "stable"
rpath = false
frame-pointers = true
lld = false
#use-lld = "external"
llvm-bitcode-linker = false
deny-warnings = false
backtrace-on-ice = true
jemalloc = false
remap-debuginfo = false
lto = "${_lto}"

[dist]
compression-formats = ["gz"]
compression-profile = "fast"

[target.${_rust_target}]
cc = "/usr/bin/${CHOST}-gcc"
cxx = "/usr/bin/${CHOST}-g++"
ar = "/usr/bin/${CHOST}-gcc-ar"
ranlib = "/usr/bin/${CHOST}-gcc-ranlib"
llvm-config = "/usr/bin/llvm-config"
linker = "${CHOST}-gcc"
# Build the compiler we ship, its std and its tools for POWER9 (POWER8 when
# _power8=1, see prepare()). Per-target so
# the wasm32 std does not see it: an unrecognised CPU on wasm32 is "ignored"
# by LLVM but wipes the target's default feature set (bulk-memory, sign-ext,
# ...), which RUSTFLAGS_NOT_BOOTSTRAP -- the stage-scoped alternative -- did
# to rust-wasm in the first 1.98.1 build. See README.md. Applies at every
# stage, so the throwaway stage-1 compiler is POWER9 code too; that costs
# nothing here.
rustflags = ["-Ctarget-cpu=${_rust_cpu}"]

[target.wasm32-unknown-unknown]
cc = "/usr/bin/clang"
cxx = "/usr/bin/clang++"
ar = "/usr/bin/llvm-ar"
ranlib = "/usr/bin/llvm-ranlib"
linker = "/usr/bin/wasm-ld"
default-linker = "wasm-ld"
sanitizers = false
profiler = false

[target.wasm32v1-none]
cc = "/usr/bin/clang"
cxx = "/usr/bin/clang++"
ar = "/usr/bin/llvm-ar"
ranlib = "/usr/bin/llvm-ranlib"
linker = "/usr/bin/wasm-ld"
default-linker = "wasm-ld"
sanitizers = false
profiler = false

[target.wasm32-wasip1]
cc = "/usr/bin/clang"
cxx = "/usr/bin/clang++"
ar = "/usr/bin/llvm-ar"
ranlib = "/usr/bin/llvm-ranlib"
linker = "/usr/bin/wasm-ld"
default-linker = "wasm-ld"
sanitizers = false
profiler = false
wasi-root = "/usr/share/wasi-sysroot"

[target.wasm32-wasip1-threads]
cc = "/usr/bin/clang"
cxx = "/usr/bin/clang++"
ar = "/usr/bin/llvm-ar"
ranlib = "/usr/bin/llvm-ranlib"
linker = "/usr/bin/wasm-ld"
default-linker = "wasm-ld"
sanitizers = false
profiler = false
wasi-root = "/usr/share/wasi-sysroot"

[target.wasm32-wasip2]
cc = "/usr/bin/clang"
cxx = "/usr/bin/clang++"
ar = "/usr/bin/llvm-ar"
ranlib = "/usr/bin/llvm-ranlib"
linker = "/usr/bin/wasm-ld"
default-linker = "wasm-ld"
sanitizers = false
profiler = false
wasi-root = "/usr/share/wasi-sysroot"
END
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

build() {
  cd rustc-$pkgver-src

  export RUST_BACKTRACE=1
  unset CFLAGS CXXFLAGS LDFLAGS

  # The POWER9 target-cpu for the shipped compiler is set per target in
  # bootstrap.toml above (prepare()), not through RUSTFLAGS here. bootstrap
  # (src/bootstrap/src/core/builder/cargo.rs) builds CARGO_ENCODED_RUSTFLAGS
  # for each cargo run from: bootstrap's own flags, the [target.*] rustflags
  # for the target being compiled, then the environment's RUSTFLAGS and
  # RUSTFLAGS_{,NOT_}BOOTSTRAP (stage 0 / stage >= 1). Nothing overrides
  # anything; they concatenate.
  #
  # Do not rely on makepkg's RUSTFLAGS for this: /etc/makepkg.conf.d/rust.conf
  # is a local edit on the build box (Arch POWER's own 1.97.1 binaries are plain
  # POWER8 code), and bq's makepkg --config never loads makepkg.conf.d at all.
  # The recipe has to carry the flag itself. README.md has the measurements.
  #
  # -vv hands cargo -v, so every rustc command line -- flags included, out-dir
  # naming the stage -- is in the makepkg log. That log is the evidence for the
  # claims above; keep it.
  DESTDIR="$srcdir/dest-rust" python ./x.py install -vv -j "$(nproc)"

  cd ../dest-rust

  # delete unnecessary files, e.g. files only used for the uninstall script
  rm -v usr/lib/rustlib/{components,install.log,rust-installer-version,uninstall.sh}
  rm -v usr/lib/rustlib/manifest-*

  # licenses for main rust package
  local ldir="usr/share/licenses/rust" f d
  mkdir -p "$ldir"
  for f in usr/share/doc/*/{COPYRIGHT,LICENSE}*; do
    d="$(dirname "$f")"
    case $f in
      */LICENSE-APACHE) rm -v "$f" ;;
      *) mv -v "$f" "$ldir/${f##*/}.${d##*/}" ;;
    esac
    rmdir -p --ignore-fail-on-non-empty "$d"
  done

  _pick dest-src  usr/lib/rustlib/src
  _pick dest-wasm usr/lib/rustlib/wasm32{,v1}-*
}

package_rust() {
  optdepends=(
    'gdb: rust-gdb script'
    'lldb: rust-lldb script'
  )
  provides=(
    cargo
    rustfmt
  )
  conflicts=(
    cargo
    'rust-docs<1:1.56.1-3'
    rustfmt
  )
  replaces=(
    cargo
    cargo-tree
    'rust-docs<1:1.56.1-3'
    rustfmt
  )

  cp -a dest-rust/* "$pkgdir"
}

package_rust-wasm() {
  pkgdesc="WebAssembly targets for Rust"
  depends=(
    lld
    rust
    wasm-component-ld
  )

  cp -a dest-wasm/* "$pkgdir"

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
    rustc-$pkgver-src/{COPYRIGHT,LICENSE-MIT}
}

package_rust-src() {
  pkgdesc="Source code for the Rust standard library"
  depends=(rust)

  cp -a dest-src/* "$pkgdir"

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
    rustc-$pkgver-src/{COPYRIGHT,LICENSE-MIT}
}

