# ppc64le: Omarchy ppc64le -- see README.md.  Arch POWER's recipe, narrowed to
# little-endian POWER9: the big-endian ELFv2 hotfix and the powerpc/espresso
# branches are gone, and the shipped compiler is built -C target-cpu=pwr9.

# LTO passes may not produce any output for quite some time
# especially on slower systems
apb_output_timeout=7200

pkgbase=rust
pkgname=(
  rust
  rust-src
  rust-wasm
)
epoch=1
pkgver=1.98.1
pkgrel=1
pkgdesc="Systems programming language focused on safety, speed and concurrency"
url=https://www.rust-lang.org/
arch=(powerpc64le)
license=("Apache-2.0 OR MIT")
options=(
  !emptydirs
  !lto
)
depends=(
  curl
  gcc
  gcc-libs
  libgit2
  libssh2
  llvm-libs
)
makedepends=(
  clang
  cmake
  libffi
  lld
  llvm
  llvm-libs
  ninja
  perl
  python
  rust
  wasi-libc
  wasm-component-ld
)
checkdepends=(
  gdb
  procps-ng
)
source=(
  # Upstream ships .tar.gz and .tar.xz of the same tree, each with its own
  # .asc from the same key; Arch POWER fetches the .gz, this takes the .xz.
  "https://static.rust-lang.org/dist/rustc-$pkgver-src.tar.xz"{,.asc}
  # Patch bootstrap so that rust-analyzer-proc-macro-srv
  # is in /usr/lib instead of /usr/libexec
  0001-bootstrap-Change-libexec-dir.patch

  # Put bash completions where they belong
  0002-bootstrap-Change-bash-completion-dir.patch

  # Fix build with system rustc
  # https://github.com/rust-lang/rust/issues/143735
  0003-bootstrap-Workaround-for-system-stage0.patch

  # Use our *-pc-linux-gnu targets, making LTO with clang simpler
  0004-compiler-Change-LLVM-targets.patch

  # Use our aarch64-linux-gnu-gcc
  0005-compiler-Use-aarch64-linux-gnu-gcc-to-link-aarch64-t.patch

  # Prefer "lib" over "lib64"
  0006-compiler-Swap-primary-and-secondary-lib-dirs.patch

  # Arch POWER also carries hotfix-abi.powerpc64.elfv2.patch, which flips the
  # big-endian powerpc64 target from ELFv1 to ELFv2. That is their BE target's
  # problem; powerpc64le is ELFv2 in upstream rustc already, and the patch does
  # not apply to 1.98.1 anyway. Dropped.
)
