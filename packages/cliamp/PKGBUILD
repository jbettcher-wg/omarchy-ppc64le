# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
# Contributor: bjarneo <https://github.com/bjarneo>
#
# cliamp -- terminal music player.  Started from the AUR `cliamp` recipe at
# its 2.0.1 revision (aur.git 0e012cbf).
#
# Pinned to 2.0.1, not the AUR's current 2.2.0: Omarchy's install manifest is
# pinned to what Omarchy ships, and omarchy.db carries cliamp 2.0.1-1.
#
# What changed for ppc64le:
#
# - arch=(powerpc64le).  Go and every cgo dependency here (alsa-lib through
#   oto) build natively; no architecture-specific code.
# - go.mod at v2.0.1 declares `go 1.26.6`; the system go is 1.26.5.  With the
#   default GOTOOLCHAIN=auto, go resolves that by silently downloading a
#   prebuilt go1.26.6 from proxy.golang.org and building with it instead of the
#   repo's toolchain.  So GOTOOLCHAIN=local, and prepare() lowers the directive
#   to the system go's version.  A patch release carries no language or
#   standard-library API changes, so this is safe.  Local workaround, not an
#   upstream fix; drop it once the system go reaches 1.26.6.  The sed matches
#   the exact line, so a future go.mod bump fails loudly instead of being
#   silently rewritten.
# - GOPATH and GOCACHE under $srcdir, so the build writes nothing into $HOME.
# - Arch Go packaging flags (CGO_*FLAGS from makepkg, -mod=readonly,
#   -modcacherw, external link with makepkg's LDFLAGS) instead of the AUR's
#   `-s -w`; makepkg strips anyway.

pkgname=cliamp
pkgver=2.0.1
pkgrel=1
pkgdesc='A retro terminal music player inspired by Winamp 2.x'
arch=(powerpc64le)
url='https://github.com/bjarneo/cliamp'
license=(MIT)
depends=(alsa-lib flac libvorbis libogg mpg123 ffmpeg yt-dlp)
optdepends=('pipewire-alsa: audio output on PipeWire systems'
            'pulseaudio-alsa: audio output on PulseAudio systems')
makedepends=(go)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2c5885665dba5ed2e8dc156bce64751199a92efed7f63959c65e985759b73732')

_goenv() {
  export GOTOOLCHAIN=local
  export GOPATH="$srcdir/gopath"
  export GOCACHE="$srcdir/gocache"
  export CGO_ENABLED=1
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
}

prepare() {
  cd "$pkgname-$pkgver"
  _goenv
  local sysgo
  sysgo=$(go env GOVERSION | sed 's/^go//; s/-.*//')
  if [[ $(vercmp "$sysgo" 1.26.6) -lt 0 ]]; then
    sed -i "s/^go 1\.26\.6\$/go $sysgo/" go.mod
    grep -qx "go $sysgo" go.mod || {
      error "go.mod no longer says 'go 1.26.6' -- revisit the toolchain workaround"
      return 1
    }
  fi
  go mod download
}

build() {
  cd "$pkgname-$pkgver"
  _goenv
  go build \
    -ldflags "-linkmode=external -extldflags '$LDFLAGS' -X main.version=v$pkgver" \
    -o cliamp .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 cliamp "$pkgdir/usr/bin/cliamp"
  install -Dm644 cliamp.desktop "$pkgdir/usr/share/applications/cliamp.desktop"
  install -Dm644 Cliamp.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/cliamp.png"
  install -Dm644 Cliamp.png "$pkgdir/usr/share/pixmaps/cliamp.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
