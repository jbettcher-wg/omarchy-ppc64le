# ppc64le: arch(), plus dropping -buildmode=pie on this architecture only --
# and yay is broken here without that second change.
#
# yay 13 no longer binds libalpm through cgo.  It reaches it via
# github.com/Jguer/dyalpm, which dlopen()s libalpm and calls into it through
# github.com/ebitengine/purego's hand-written FFI trampoline.  purego's ppc64le
# backend is new (sys_ppc64le.s carries a 2026 copyright).  Built the way
# upstream's Makefile builds it, the result compiles cleanly, links cleanly,
# starts, prints a correct answer -- and then dies:
#
#   $ yay --version
#   yay v13.0.1 - libalpm v16.0.1
#   SIGSEGV: segmentation violation
#   PC=0x121d813d8 m=0 sigcode=1 addr=0x1000000cd
#   signal arrived during cgo execution
#   github.com/ebitengine/purego.RegisterFunc.func4(...)  purego@v0.10.1/func.go:312
#   github.com/Jguer/dyalpm.(*handle).Release(...)        handle.go:208
#
# Every command dies the same way, in whatever libalpm call it makes:
# `--version` in alpm_release() on the way out, `-Ss` in alpm_db_search(),
# `-Si` in alpm_find_group_pkgs().  This is precisely the failure a
# build-only check cannot see, and the reason the rule in this repo is that a
# package has to RUN before it counts.
#
# Bisected to a single build flag.  Same source, same purego, same Go 1.26.5,
# on the same machine:
#
#   go build                                  -> works, exit 0, -Ss returns AUR hits
#   go build -trimpath                        -> works
#   go build -ldflags=-linkmode=external      -> works
#   go build -buildmode=pie                   -> SIGSEGV
#
# So it is PIE, not cgo, not external linking, and not the module versions.
# Reading the two disassemblies of purego's `syscall15X` shows what PIE
# changes: the Go assembler prepends the ELFv2 global-entry-point sequence
#
#   addis r2,r12,<hi> ; addi r2,r2,<lo> ; ... ; std r2,24(r1)
#
# to the trampoline, so the function now carries a live TOC pointer that it
# saves and restores across `bctrl` into the foreign library.  Non-PIE has
# neither the prologue nor the TOC dance and the trampoline is otherwise
# instruction-for-instruction identical.  Something in that interaction between
# purego's hand-rolled ELFv2 frame and Go's PIE TOC handling is wrong; pinning
# it to an instruction would be upstream's job (ebitengine/purego), and the
# reproducer above is the useful half of the report.
#
# So on powerpc64le we build without PIE.  That is a real, if small, cost --
# this one binary loses load-address randomisation -- and it is recorded here
# rather than hidden: a correct non-PIE yay beats a hardened one that segfaults
# on every invocation.  Every other architecture builds exactly what upstream
# builds; EXTRA_FLAGS is upstream's own knob (Makefile line 28,
# `EXTRA_FLAGS ?= -buildmode=pie`), so no patch is needed.
#
# A first attempt patched purego's sys_ppc64le.s, which saves the caller's LR
# into 16(R1) -- the ELFv2 linkage-area slot a callee writes its own return
# address into, the same trap as the LuaJIT SAVE_CR bug in packages/luajit.
# That reading was wrong and the patch is not here: Go wraps the function in
# its own prologue/epilogue (`mflr R31; stdu R31,-32(R1)` ... `ld R31,0(R1);
# mtlr R31`), so LR really comes back from R31 and purego's slot is dead
# stores.  Noted because it is a plausible wrong answer and the control
# experiment -- unpatched purego, non-PIE, fully working -- is what ruled it
# out.
#
# READ docs/aur-on-ppc64le.md BEFORE ASSUMING THIS GETS YOU THE AUR.
#
# yay works here for searching, inspecting and fetching: `yay -Ss`, `yay -Si`,
# `yay -Sia`, `yay -Gp` all return correct AUR results.  What it cannot do is
# *install* an AUR package whose arch=() lacks powerpc64le, which is most of
# them, and that block is in libalpm rather than in yay: makepkg's
# -A/--ignorearch will happily produce a correctly-tagged powerpc64le package,
# and the install step then refuses it, because alpm deliberately will not
# install a package built for another architecture.  `yay --mflags=-A` moves
# that failure, it does not remove it.  The working path is to own the pipeline
# -- fetch, rewrite arch=(), regenerate .SRCINFO, makepkg, local repo -- so
# nothing carrying a foreign architecture ever reaches alpm.
#
# Matches the version Omarchy publishes (yay-13.0.1-1); 13.0.1 is also the
# current AUR revision.
#
# Maintainer: Jguer <pkgbuilds at jguer.space>
pkgname=yay
pkgver=13.0.1
# pkgrel 2 marks this as locally modified: the AUR/Omarchy build is 13.0.1-1.
pkgrel=2
pkgdesc="Yet another yogurt. Pacman wrapper and AUR helper written in go."
arch=('i686' 'pentium4' 'x86_64' 'arm' 'armv7h' 'armv6h' 'aarch64' 'riscv64' 'powerpc64le')
url="https://github.com/Jguer/yay"
options=(!lto)
license=('GPL-3.0-or-later')
depends=(
  'pacman>6.1'
  'git'
)
optdepends=(
  'sudo: privilege elevation'
  'doas: privilege elevation'
)
makedepends=('go>=1.24')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Jguer/yay/archive/v${pkgver}.tar.gz")
sha256sums=('b77454bce87110180a1b6664c2d260de78124c9894b71101610ba84f551eb0d0')

build() {
  export GOPATH="$srcdir"/gopath
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export CGO_ENABLED=1

  # See the header: -buildmode=pie makes purego's ppc64le FFI trampoline
  # segfault on the first call into libalpm.  Empty EXTRA_FLAGS drops it and
  # changes nothing else about the build.
  local extra_flags='-buildmode=pie'
  [[ "$CARCH" == powerpc64le ]] && extra_flags=''

  cd "$srcdir/$pkgname-$pkgver"
  make VERSION=$pkgver DESTDIR="$pkgdir" PREFIX="/usr" EXTRA_FLAGS="$extra_flags" build
}

check() {
  # Not a formality.  The bug this recipe works around let the binary start,
  # read /etc/pacman.conf, open every sync database and print a correct version
  # banner before dying -- so anything short of "did the process exit 0" would
  # have passed.  `--version` calls alpm_version() and then alpm_release() on
  # the way out, which is the call that crashed.
  cd "$srcdir/$pkgname-$pkgver"
  ./yay --version
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make VERSION=$pkgver DESTDIR="$pkgdir" PREFIX="/usr" install

  # Fail the build if any shipped ELF records a build-tree path
  # (tools/elf-pathguard.sh -- house policy, applied to every recipe here).
  "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"
}
