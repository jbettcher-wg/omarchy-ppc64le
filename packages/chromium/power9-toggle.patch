# Adds a _power8_compat toggle to the ppc64le chromium PKGBUILD so one recipe
# builds both artifacts: a POWER9 / ISA 3.0 package for POWER9 hardware
# (_power8_compat=0, the default here) and the POWER8-legal package for Arch
# POWER's multi-architecture repo (_power8_compat=1).
#
# The default is 0 because this tree targets POWER9 hardware only and the
# POWER8-legal build is already carried upstream -- defaulting to 1 here just
# means silently shipping the compat build by forgetting a flag.
#
# LOCAL BUILD-CONFIGURATION CHANGE, not upstreamable as-is: Arch POWER's repo
# wants the POWER8-legal default, so an upstream submission must flip this back
# to 1 (or pass it explicitly). The parts that
# ARE worth sending upstream are the two bugs it fixes, both of which make the
# shipped "POWER8-legal" recipe emit ISA 3.0 in practice:
#
#   1. The ppc64le -mcpu/-mtune strip in build() was dropped in the 150->151
#      rebase. GN's unbundle toolchain passes $CFLAGS/$CXXFLAGS through verbatim
#      and appends them after GN's own flags, so a build host with
#      -mcpu=power9 in makepkg.conf silently produces an ISA 3.0 package.
#   2. skia-vsx-instructions.patch injects -mcpu=power9 -mtune=power9 into
#      skia's config("default") -- all of skia -- unconditionally.
#
# Source stays POWER8-compliant in both branches; no POWER9-only instruction is
# written into any source file.
#
# Apply with: patch -p0 -i power9-toggle.patch PKGBUILD
--- PKGBUILD
+++ PKGBUILD.new
@@ -11,6 +11,21 @@
 _launcher_ver=8
 _manual_clone=0
 _system_clang=1
+
+# ppc64le ISA level.
+#   0 = POWER9 (ISA 3.0). THE DEFAULT IN THIS TREE. Drops the POWER8 forcing
+#       patch so third-party code takes its POWER9 paths, and lets
+#       -mcpu=power9 stand.
+#   1 = POWER8-legal (ISA 2.07). The floor Arch POWER's multi-architecture
+#       repo needs; pass this explicitly when building for upstream.
+#
+# Source stays POWER8-compliant either way: no POWER9-only instruction is
+# written into any source file. The difference is compiler flags and which
+# build-system feature gates get set -- the LuaJIT model, POWER8 ISA floor
+# with ISA 3.0 paths selected at build/runtime rather than hardcoded.
+#
+# Override per build:  _power8_compat=1 makepkg -e   (POWER8-legal artifact)
+_power8_compat=${_power8_compat:-0}
 pkgdesc="A web browser built for speed, simplicity, and security"
 arch=('x86_64' 'powerpc64le')
 url="https://www.chromium.org/Home"
@@ -285,9 +300,35 @@
     while IFS= read -r _p; do
       [[ -z $_p || $_p == \#* ]] && continue
       [[ $_p == ppc64le/* ]] || continue
+
+      # POWER9 build: skip the patch that pins v8's GN toolchain config to
+      # -mcpu=power8 -maltivec -mvsx, so v8 follows the command-line -mcpu.
+      if (( ! _power8_compat )) && [[ $_p == *Force-baseline-POWER8-AltiVec-VSX* ]]; then
+        msg2 "Skipping (POWER9 build): $_p"
+        continue
+      fi
+
       msg2 "Applying ppc64le patch: $_p"
       patch -Np1 -i "$srcdir/ppc64le-patches/${_p#ppc64le/}"
     done < "$srcdir/ppc64le-patches/debian-series"
+
+    # core/baseline-isa-3-0.patch is commented out of debian-series because it
+    # is POWER9-only (build/config/compiler_cpu_abi.gn, v8, libvpx). Apply it
+    # explicitly for the POWER9 build.
+    if (( ! _power8_compat )); then
+      msg2 "Applying ppc64le patch (POWER9 build): core/baseline-isa-3-0.patch"
+      patch -Np1 -i "$srcdir/ppc64le-patches/core/baseline-isa-3-0.patch"
+    fi
+
+    # skia-vsx-instructions.patch hardcodes -mcpu=power9 -mtune=power9 into
+    # skia's config("default") -- all of skia, not just the vsx TU. Undo that
+    # for the POWER8 build so POWER8-legality does not silently depend on what
+    # the build host's makepkg.conf happens to set.
+    if (( _power8_compat )); then
+      msg2 "Pinning skia back to POWER8 (_power8_compat=1)"
+      sed -i -e 's/-mcpu=power9/-mcpu=power8/g' -e 's/-mtune=power9/-mtune=power8/g' \
+        third_party/skia/gn/skia/BUILD.gn third_party/skia/BUILD.gn
+    fi
   fi
 
   # Link to system tools required by the build. Go lives under a CIPD-arch
@@ -455,6 +496,25 @@
     CXXFLAGS="${CXXFLAGS/-march=*([^ ]) }"
   fi
 
+  if [[ $CARCH == powerpc64le ]]; then
+    # GN's unbundle toolchain (custom_toolchain= below) passes $CFLAGS and
+    # $CXXFLAGS through verbatim and appends them AFTER GN's own config flags,
+    # so the last -mcpu on the command line wins. Set it here explicitly rather
+    # than inheriting whatever the build host's makepkg.conf carries -- the
+    # ppc64le -mcpu strip that used to live here was dropped in the 150->151
+    # rebase, which is how a "POWER8-legal" recipe started emitting ISA 3.0.
+    CFLAGS="${CFLAGS/-mcpu=*([^ ]) }";     CFLAGS="${CFLAGS/-mtune=*([^ ]) }"
+    CXXFLAGS="${CXXFLAGS/-mcpu=*([^ ]) }"; CXXFLAGS="${CXXFLAGS/-mtune=*([^ ]) }"
+    if (( _power8_compat )); then
+      CFLAGS+=" -mcpu=power8 -mtune=power8"
+      CXXFLAGS+=" -mcpu=power8 -mtune=power8"
+    else
+      CFLAGS+=" -mcpu=power9 -mtune=power9"
+      CXXFLAGS+=" -mcpu=power9 -mtune=power9"
+    fi
+    msg2 "ppc64le ISA level: _power8_compat=$_power8_compat"
+  fi
+
   # Arch POWER's packaged gn (0.2324) doesn't support several dotfile/tool
   # attributes chromium 151 uses (expand_directory_allowlist,
   # expand_directory(), inputs= on rust_* tools, c_additional_outputs).
