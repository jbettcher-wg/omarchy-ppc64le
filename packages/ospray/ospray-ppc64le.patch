OSPRay 3.2.0 on powerpc64le.

OSPRay derives its ISPC target list from the ISAs Embree and Open VKL were
built with and only knows the x86 and NEON names.  Add a VSX ISA: enabled
when Embree reports its SSE4.2 kernels (that is what the ppc64le Embree port
builds, on VSX) and Open VKL reports OPENVKL_ISA_VSX; maps to ispc's
vsx-i32x4 target; is exempt from the "add a dummy second target" rule like
NEON, since the ppc64le Embree is single-ISA; and is named in the ISA
report.  OSPRay drives ispc through its own copy of ispcrt's helper
(cmake/compiler/ispc.cmake), which hard-codes --arch=x86-64 for every
non-ARM host; teach it ppc64le as well.

Portability fix, worth sending upstream (github.com/RenderKit/ospray).
diff -ruN a/cmake/compiler/ispc.cmake b/cmake/compiler/ispc.cmake
--- a/cmake/compiler/ispc.cmake	2026-09-10 17:05:50.941409754 -0600
+++ b/cmake/compiler/ispc.cmake	2026-09-10 18:26:56.492844321 -0600
@@ -60,6 +60,7 @@
 
 define_ispc_supported_arch(X86 "x86|x86-64")
 define_ispc_supported_arch(ARM "arm|aarch64")
+define_ispc_supported_arch(PPC64 "ppc64le")
 define_ispc_supported_arch(XE "xe64")
 
 macro(define_ispc_isa_options ISA_NAME)
@@ -136,6 +137,8 @@
   if (CMAKE_SIZEOF_VOID_P EQUAL 8)
     if (${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm64|aarch64")
       set(ISPC_ARCHITECTURE "aarch64")
+    elseif (${CMAKE_SYSTEM_PROCESSOR} MATCHES "ppc64le|powerpc64le")
+      set(ISPC_ARCHITECTURE "ppc64le")
     else()
       set(ISPC_ARCHITECTURE "x86-64")
     endif()
diff -ruN a/cmake/ospray_macros.cmake b/cmake/ospray_macros.cmake
--- a/cmake/ospray_macros.cmake	2026-09-10 17:05:50.941664857 -0600
+++ b/cmake/ospray_macros.cmake	2026-09-10 18:26:56.492509620 -0600
@@ -75,7 +75,8 @@
   list(LENGTH OSPRAY_ISPC_TARGET_LIST NUM_TARGETS)
   if (NUM_TARGETS EQUAL 1
       AND NOT OSPRAY_ISPC_TARGET_LIST STREQUAL "neon-i32x4"
-      AND NOT OSPRAY_ISPC_TARGET_LIST STREQUAL "neon-i32x8")
+      AND NOT OSPRAY_ISPC_TARGET_LIST STREQUAL "neon-i32x8"
+      AND NOT OSPRAY_ISPC_TARGET_LIST STREQUAL "vsx-i32x4")
     if (EMBREE_ISA_SSE42 AND
             NOT OSPRAY_ISPC_TARGET_LIST STREQUAL "sse4")
       list(APPEND OSPRAY_ISPC_TARGET_LIST sse4)
@@ -102,7 +103,7 @@
 macro(ospray_configure_ispc_isa)
 
   set(OSPRAY_BUILD_ISA "ALL" CACHE STRING
-    "Target ISA (SSE4, AVX, AVX2, AVX512SKX, NEON, NEON2X, or ALL)")
+    "Target ISA (SSE4, AVX, AVX2, AVX512SKX, NEON, NEON2X, VSX, or ALL)")
   string(TOUPPER ${OSPRAY_BUILD_ISA} OSPRAY_BUILD_ISA)
 
   if(EMBREE_ISA_SSE42 AND OPENVKL_ISA_SSE4)
@@ -123,6 +124,10 @@
   if(EMBREE_ISA_NEON2X AND OPENVKL_ISA_NEON2X)
     set(OSPRAY_SUPPORTED_ISAS ${OSPRAY_SUPPORTED_ISAS} NEON2X)
   endif()
+  # ppc64le: Embree's SSE4.2 kernels run on VSX, Open VKL builds vsx-i32x4
+  if(EMBREE_ISA_SSE42 AND OPENVKL_ISA_VSX)
+    set(OSPRAY_SUPPORTED_ISAS ${OSPRAY_SUPPORTED_ISAS} VSX)
+  endif()
 
   set_property(CACHE OSPRAY_BUILD_ISA PROPERTY STRINGS
                ALL ${OSPRAY_SUPPORTED_ISAS})
@@ -154,6 +159,10 @@
       set(OSPRAY_ISPC_TARGET_LIST ${OSPRAY_ISPC_TARGET_LIST} neon-i32x8)
       message(STATUS "OSPRay NEON2X ISA target enabled.")
     endif()
+    if(EMBREE_ISA_SSE42 AND OPENVKL_ISA_VSX)
+      set(OSPRAY_ISPC_TARGET_LIST ${OSPRAY_ISPC_TARGET_LIST} vsx-i32x4)
+      message(STATUS "OSPRay VSX ISA target enabled.")
+    endif()
 
   elseif (OSPRAY_BUILD_ISA STREQUAL "AVX512SKX")
 
@@ -215,6 +224,15 @@
     endif()
     set(OSPRAY_ISPC_TARGET_LIST neon-i32x8)
 
+  elseif (OSPRAY_BUILD_ISA STREQUAL "VSX")
+    if (NOT EMBREE_ISA_SSE42)
+      message(FATAL_ERROR "Your Embree build does not support SSE4.2-on-VSX!")
+    endif()
+    if (NOT OPENVKL_ISA_VSX)
+      message(FATAL_ERROR "Your OpenVKL build does not support VSX!")
+    endif()
+    set(OSPRAY_ISPC_TARGET_LIST vsx-i32x4)
+
   else()
     message(FATAL_ERROR "Invalid OSPRAY_BUILD_ISA value. "
                   "Please select one of ${OSPRAY_SUPPORTED_ISAS}, or ALL.")
diff -ruN a/cmake/ospray_options.cmake b/cmake/ospray_options.cmake
--- a/cmake/ospray_options.cmake	2026-09-10 17:05:50.941664857 -0600
+++ b/cmake/ospray_options.cmake	2026-09-10 18:26:56.493062150 -0600
@@ -101,6 +101,7 @@
     set(OPENVKL_ISA_AVX512SKX TRUE)
     set(OPENVKL_ISA_NEON TRUE)
     set(OPENVKL_ISA_NEON2X TRUE)
+    set(OPENVKL_ISA_VSX TRUE)
 endif()
 
