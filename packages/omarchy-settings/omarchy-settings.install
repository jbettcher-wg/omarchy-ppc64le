# omarchy-settings.install -- replaces upstream's .INSTALL scriptlet.
#
# Upstream's post_install/post_upgrade runs _etc_overrides_apply, which is
# destructive by design.  Its own comment says so:
#
#   "NOTE: these cp -f's are intentionally destructive on every install/upgrade.
#    Users who customize /etc/os-release, /etc/plymouth/plymouthd.conf, ...
#    WILL have their changes reset to Omarchy defaults each time
#    omarchy-settings is upgraded."
#
# Concretely it does `rm -f /etc/os-release` and then overwrites
# /etc/os-release, /etc/security/faillock.conf, /etc/nsswitch.conf,
# /etc/plymouth/plymouthd.conf, /etc/skel/.bashrc and (when present) two CUPS
# configs -- files pacman does not track, on every upgrade.
#
# That is the correct behaviour on a machine installed *as* Omarchy.  This
# machine is not one: it is an existing Arch ppc64le workstation running COSMIC,
# where Omarchy is being back-filled package by package.  Two specifics:
#
#   - /etc/os-release here is a symlink to ../usr/lib/os-release.  The scriptlet
#     would replace it with a regular file declaring ID=omarchy, changing the
#     system's advertised identity for every tool that reads it.
#   - /etc/nsswitch.conf would be replaced.  The shipped version happens to be
#     benign on this host (it adds mdns_minimal, and nss-mdns is installed), but
#     nsswitch.conf is the file that decides whether the machine can resolve
#     names at all, and rewriting it unattended is not something a back-fill
#     package should do.
#
# So the overrides are still shipped, at /usr/share/omarchy/etc-overrides/, and
# still applied by exactly the same commands -- but by the user, deliberately,
# once they have read what changes.  Nothing about the theming layer, which is
# what this package is being installed for, depends on any of it.
#
# Local workaround, not upstreamable.

_omarchy_overrides_notice() {
  cat <<'EOF'

omarchy-settings (ppc64le): /etc overrides were NOT applied automatically.

Upstream's scriptlet rewrites these unconditionally on every install and
upgrade. They are shipped but left for you to apply deliberately:

  /usr/share/omarchy/etc-overrides/os-release              -> /etc/os-release
  /usr/share/omarchy/etc-overrides/nsswitch.conf           -> /etc/nsswitch.conf
  /usr/share/omarchy/etc-overrides/security-faillock.conf  -> /etc/security/faillock.conf
  /usr/share/omarchy/etc-overrides/plymouth-plymouthd.conf -> /etc/plymouth/plymouthd.conf
  /usr/share/omarchy/etc-overrides/dot.bashrc              -> /etc/skel/.bashrc
  /usr/share/omarchy/etc-overrides/cups-cups-browsed.conf  -> /etc/cups/cups-browsed.conf
  /usr/share/omarchy/etc-overrides/cups-cups-files.conf    -> /etc/cups/cups-files.conf

Note /etc/os-release is currently a symlink into /usr/lib; replacing it makes
the machine report ID=omarchy. To undo: ln -sf ../usr/lib/os-release /etc/os-release

None of this is needed for Omarchy theming. Themes work without it.

EOF
}

post_install() {
  _omarchy_overrides_notice
}

post_upgrade() {
  _omarchy_overrides_notice
}
