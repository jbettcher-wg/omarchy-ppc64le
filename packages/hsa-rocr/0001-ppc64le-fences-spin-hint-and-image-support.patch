      * Iterate through the program headers of the loaded lib and check for PT_DYNAMIC program
diff -ruN a/runtime/hsa-runtime/core/util/utils.h b/runtime/hsa-runtime/core/util/utils.h
--- a/runtime/hsa-runtime/core/util/utils.h	2026-05-19 16:18:44.000000000 -0600
+++ b/runtime/hsa-runtime/core/util/utils.h	2026-09-10 23:33:22.751162655 -0600
@@ -78,6 +78,33 @@
 #if defined(__GNUC__)
 #if defined(__i386__) || defined(__x86_64__)
 #include <x86intrin.h>
+#elif defined(__powerpc64__)
+// The runtime spells its device-visibility fences in x86 terms: _mm_sfence()
+// before a doorbell or ring-buffer header store, _mm_sfence()/_mm_mfence()
+// around a write-then-read-back that pushes write-combined stores out over
+// PCIe.  On POWER the KFD-mapped doorbell and VRAM pages are caching-inhibited,
+// and the only barrier that orders a cacheable store before a subsequent
+// caching-inhibited one is a full `sync` (Power ISA 3.0B Book II 4.6.1: the
+// lightweight `lwsync` explicitly excludes Caching Inhibited storage, which is
+// also why the Linux kernel's writel() on powerpc is `sync; stw`).  A release
+// fence would compile but leave the packet body racing the doorbell.
+static __inline__ __attribute__((always_inline)) void _mm_sfence(void) {
+  __asm__ __volatile__("sync" ::: "memory");
+}
+static __inline__ __attribute__((always_inline)) void _mm_mfence(void) {
+  __asm__ __volatile__("sync" ::: "memory");
+}
+// Cache-line write-back and invalidate, one line at a time; the caller in
+// FlushCacheLines() strides by sysconf(_SC_LEVEL1_DCACHE_LINESIZE), which is
+// 128 on POWER9, so this is dcbf per line, not per 64 bytes.
+static __inline__ __attribute__((always_inline)) void _mm_clflush(const void* p) {
+  __asm__ __volatile__("dcbf 0,%0" : : "r"(p) : "memory");
+}
+// Spin-loop hint: drop SMT thread priority while waiting, then restore it.
+// Same idiom as the powerpc kernel's cpu_relax() (HMT_low; HMT_medium).
+static __inline__ __attribute__((always_inline)) void _mm_pause(void) {
+  __asm__ __volatile__("or 1,1,1\n\tor 2,2,2" ::: "memory");
+}
 #endif
 
 #define __forceinline __inline__ __attribute__((always_inline))
diff -ruN a/runtime/hsa-runtime/image/util.h b/runtime/hsa-runtime/image/util.h
--- a/runtime/hsa-runtime/image/util.h	2026-05-19 16:18:44.000000000 -0600
+++ b/runtime/hsa-runtime/image/util.h	2026-09-10 21:49:11.801492198 -0600
@@ -77,7 +77,7 @@
 #include "mm_malloc.h"
