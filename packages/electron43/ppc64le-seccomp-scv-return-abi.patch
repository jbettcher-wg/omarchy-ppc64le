From: Jordan Bettcher <thebettcher@gmail.com>
Subject: sandbox: ppc64: return emulated syscall results in the caller's convention (sc vs scv)

The ppc64 seccomp-bpf support carried in the Debian chromium-team ppc64le
series (sandbox/0001-sandbox-Enable-seccomp_bpf-for-ppc64.patch, from Raptor
Engineering) writes the result of a system call emulated in the SIGSYS trap
handler back into the interrupted context using only the `sc` convention.
powerpc64 has two:

                 error return                 success return
  sc     0xc00   r3 = +errno, CR0.SO set      r3 = value, CR0.SO clear
  scv 0  0x3000  r3 = -errno                  r3 = value   (CR0.SO unused)

glibc makes system calls with `scv 0` on POWER9 and later, so for every
glibc caller Syscall::PutValueInUcontext() turns an emulated error into a
positive return. A broker-denied open() (-ENOENT) comes back as file
descriptor 2. Chromium then adopts and closes descriptors it does not own.

Seen in the GPU process on the software path (--disable-gpu, i.e.
--use-gl=disabled: headless, no accelerated driver, Electron with hardware
acceleration off): "Crashing due to FD ownership violation", SIGSEGV on
corrupted IPC state on the IO thread, and finally
"GPU process isn't usable. Goodbye." --disable-gpu-sandbox or --no-sandbox
make it go away. The same encoding also mishandles the first-argument
workaround below for scv callers.

The trap value in the saved registers records which instruction the caller
used. Use it:

 * Syscall::PutValueInUcontext(): for scv callers store the result as-is
   (-errno on error) and leave CR0.SO untouched; keep the sc encoding for
   sc callers.
 * Trap::SigSys(): apply the existing ppc64 first-argument negation
   workaround only to sc callers. scv callers' arguments are already
   correct, and negating them turns a valid directory fd into an invalid one.
 * SIGSYSFstatatHandler(): apply its fd fixup only to sc callers, via the new
   Trap::IsEmulatingScvSyscall(), set for the duration of the handler.

sc behaviour is unchanged. Tested with a standalone reproducer that runs this
encoding against glibc, raw `sc` and raw `scv 0` callers, and with the
Chromium GPU process on --disable-gpu with the sandbox enabled.

Upstreamable: Debian chromium-team ppc64le series, and Chromium upstream if
the ppc64 sandbox code is carried there.

--- a/sandbox/linux/bpf_dsl/seccomp_macros.h
+++ b/sandbox/linux/bpf_dsl/seccomp_macros.h
@@ -363,6 +363,11 @@
 #define SECCOMP_RESULT(_ctx) SECCOMP_REG(_ctx, 3)
 #define SECCOMP_SYSCALL(_ctx) SECCOMP_REG(_ctx, 0)
 #define SECCOMP_IP(_ctx) (_ctx)->uc_mcontext.regs->nip
+// Which instruction the caller used to make the system call, from the trap
+// value in the saved registers (low bits masked): 0xc00 for sc, 0x3000 for
+// scv. The two have different argument and return-value conventions.
+#define SECCOMP_PPC64_TRAP(_ctx) ((_ctx)->uc_mcontext.regs->trap & ~0x1fUL)
+#define SECCOMP_PPC64_IS_SCV(_ctx) (SECCOMP_PPC64_TRAP(_ctx) == 0x3000)
 #define SECCOMP_PARM1(_ctx) SECCOMP_REG(_ctx, 3)
 #define SECCOMP_PARM2(_ctx) SECCOMP_REG(_ctx, 4)
 #define SECCOMP_PARM3(_ctx) SECCOMP_REG(_ctx, 5)
--- a/sandbox/linux/seccomp-bpf/syscall.cc
+++ b/sandbox/linux/seccomp-bpf/syscall.cc
@@ -493,12 +493,22 @@
   }
 #endif
 #if defined(__powerpc64__)
-  // Same as MIPS, need to invert ret and set error register (cr0.SO)
-  if (ret_val <= -1 && ret_val >= -4095) {
-    ret_val = -ret_val;
-    ctx->uc_mcontext.regs->ccr |= (1 << 28);
-  } else {
-    ctx->uc_mcontext.regs->ccr &= ~(1 << 28);
+  // powerpc64 has two system call conventions, and the result written here
+  // must use the one the interrupted caller used:
+  //   sc     (trap 0xc00):  error is +errno in r3 with CR0.SO set.
+  //   scv 0  (trap 0x3000): result or -errno in r3; CR0.SO is not part of
+  //                         the convention and is left alone.
+  // glibc makes system calls with scv on POWER9 and later. Encoding those
+  // results the sc way turns an emulated error into a small positive return,
+  // e.g. a denied open() (-ENOENT) into file descriptor 2.
+  if (!SECCOMP_PPC64_IS_SCV(ctx)) {
+    // Same as MIPS, need to invert ret and set error register (cr0.SO)
+    if (ret_val <= -1 && ret_val >= -4095) {
+      ret_val = -ret_val;
+      ctx->uc_mcontext.regs->ccr |= (1 << 28);
+    } else {
+      ctx->uc_mcontext.regs->ccr &= ~(1 << 28);
+    }
   }
 #endif
   SECCOMP_RESULT(ctx) = static_cast<greg_t>(ret_val);
--- a/sandbox/linux/seccomp-bpf/trap.cc
+++ b/sandbox/linux/seccomp-bpf/trap.cc
@@ -149,6 +149,18 @@
   global_trap_->SigSys(nr, info, ctx);
 }
 
+#if defined(__powerpc64__)
+namespace {
+// See Trap::IsEmulatingScvSyscall().
+thread_local bool g_emulating_scv_syscall = false;
+}  // namespace
+
+// static
+bool Trap::IsEmulatingScvSyscall() {
+  return g_emulating_scv_syscall;
+}
+#endif  // defined(__powerpc64__)
+
 void Trap::SigSys(int nr, LinuxSigInfo* info, ucontext_t* ctx) {
   // Signal handlers should always preserve "errno". Otherwise, we could
   // trigger really subtle bugs.
@@ -241,9 +253,15 @@
     // parameter which causes checks against it to fail. For now, manually
     // negate them back.
     // TODO(sanastasio@raptorengineering.com): investigate this issue further
+    //
+    // This applies only to callers that used the sc instruction. Callers that
+    // used scv (glibc on POWER9 and later) arrive with their arguments intact,
+    // and negating them would turn a valid directory fd into an invalid one.
+    const bool emulating_scv = SECCOMP_PPC64_IS_SCV(ctx);
     auto nr = SECCOMP_SYSCALL(ctx);
-    if (nr == __NR_openat || nr == __NR_mkdirat || nr == __NR_faccessat || nr == __NR_readlinkat ||
-        nr == __NR_renameat || nr == __NR_renameat2 || nr == __NR_newfstatat || nr == __NR_unlinkat) {
+    if (!emulating_scv &&
+        (nr == __NR_openat || nr == __NR_mkdirat || nr == __NR_faccessat || nr == __NR_readlinkat ||
+         nr == __NR_renameat || nr == __NR_renameat2 || nr == __NR_newfstatat || nr == __NR_unlinkat)) {
         if (static_cast<int>(SECCOMP_PARM1(ctx)) > 0) {
             SECCOMP_PARM1(ctx) = -SECCOMP_PARM1(ctx);
         }
@@ -266,7 +284,14 @@
 
     // Now call the TrapFnc callback associated with this particular instance
     // of SECCOMP_RET_TRAP.
+#if defined(__powerpc64__)
+    const bool was_emulating_scv = g_emulating_scv_syscall;
+    g_emulating_scv_syscall = emulating_scv;
+#endif
     rc = trap.fnc(data, reinterpret_cast<void*>(trap.aux));
+#if defined(__powerpc64__)
+    g_emulating_scv_syscall = was_emulating_scv;
+#endif
   }
 
   // Update the CPU register that stores the return code of the system call
--- a/sandbox/linux/seccomp-bpf/trap.h
+++ b/sandbox/linux/seccomp-bpf/trap.h
@@ -43,6 +43,13 @@
   // "CHROME_SANDBOX_DEBUGGING" environment variable is set.
   static bool SandboxDebuggingAllowedByUser();
 
+#if defined(__powerpc64__)
+  // True while a trap handler is emulating a system call that its caller made
+  // with the scv instruction rather than sc. Handlers that adjust arguments
+  // for the sc convention must not do so for scv callers.
+  static bool IsEmulatingScvSyscall();
+#endif
+
  private:
   using HandlerToIdMap = std::map<TrapRegistry::Handler, uint16_t>;
 
