# Possible replacements are listed in build/linux/unbundle/replace_gn_files.py
# Keys are the names in the above script; values are the dependencies in Arch.
# Arch electron43's list, not packages/chromium's: chromium also unbundles
# dav1d, openh264 and libwebp. Electron's //third_party/libavif:libavif_enc
# needs libwebp's bundled sharpyuv, and Arch keeps dav1d and openh264 bundled
# for Electron too; neither was retested here.
declare -gA _system_libs=(
  [brotli]=brotli
  [flac]=flac
  [fontconfig]=fontconfig
  [freetype]=freetype2
  [harfbuzz]=harfbuzz
  [libdrm]=libdrm
  [libjpeg]=libjpeg-turbo
  [libxml]=libxml2
  [libxslt]=libxslt
  [opus]=opus
  [zlib]=minizip
)
_unwanted_bundled_libs=(
  $(printf "%s\n" ${!_system_libs[@]} | sed 's/^libjpeg$/&_turbo/')
)
depends+=(${_system_libs[@]})

prepare() {
  sed -i "s|@ELECTRON@|${pkgname}|" electron-launcher.sh

  # Build a fresh gn: Arch POWER's `gn` package (0.2324) predates attributes
  # Chromium 150 uses. Same as packages/chromium and reference/chromium-150.
  msg2 "Building gn..."
  pushd "$srcdir/gn" >/dev/null
  python3 build/gen.py --no-last-commit-position
  cat > out/last_commit_position.h <<EOF
#ifndef OUT_LAST_COMMIT_POSITION_H_
#define OUT_LAST_COMMIT_POSITION_H_
#define LAST_COMMIT_POSITION_NUM 1
#define LAST_COMMIT_POSITION "1 (arch-power-local)"
#endif
EOF
  sed -i 's/-Werror//g' out/build.ninja
  ninja -C out gn
  popd >/dev/null

  # Assemble the tree gclient would have produced. A fresh extraction always
  # recreates chromium-$_tarball_ver, so a leftover src/ is stale.
  msg2 "Assembling the Electron source tree"
  if [[ -d chromium-$_tarball_ver ]]; then
    rm -rf src
    mv chromium-$_tarball_ver src
  fi
  rm -rf src/electron src/third_party/electron_node src/third_party/nan
  mv electron-$pkgver src/electron
  mv node-$_node_ver src/third_party/electron_node
  mv nan-$_nan_commit src/third_party/nan

  cd src

  msg2 "Applying chromium-150.0.7871.222-250.patch"
  patch -Np1 -i ../chromium-150.0.7871.222-250.patch

  # Revision stamps the release tarball generated from its own checkout
  # (chrome://version, the GPU blocklist version, skia and dawn hashes).
  printf 'LASTCHANGE=%s-refs/branch-heads/7871@{#%s}\nLASTCHANGE_YEAR=2026\n' \
    "$_chromium_commit" "$_chromium_commit_position" > build/util/LASTCHANGE
  printf '%s' "$_chromium_commit_time" > build/util/LASTCHANGE.committime
  printf '%s' "$_dawn_revision" > gpu/webgpu/DAWN_VERSION
  sed -i -E "s/\"[0-9a-f]{40}\"/\"$_skia_revision\"/" skia/ext/skia_commit_hash.h
  sed -i -E "s/\"[0-9a-f]{40}\"/\"$_chromium_commit\"/" gpu/config/gpu_lists_version.h
  sed -i -E "s/\"[0-9a-f]{40}\"/\"$_dawn_revision\"/" gpu/webgpu/dawn_commit_hash.h

  # electron/DEPS sets generate_location_tags=False, and its
  # gclient_gn_args_from='src' takes Chromium's list with Electron's values.
  sed -i 's/^generate_location_tags = true$/generate_location_tags = false/' \
    build/config/gclient_args.gni

  # gclient hook patch_chromium: Electron's patch series.
  msg2 "Applying Electron's patches"
  python3 "$srcdir/electron-apply-patches.py" "$PWD"

  # gclient hook electron_npm_deps: the JS build tooling (typescript, webpack,
  # the typings generators). --mode=skip-build: electron/.yarnrc.yml sets
  # enableScripts: false, but Yarn still builds the packages package.json
  # opts back in (@sentry/cli, whose postinstall downloads a prebuilt binary
  # that has no ppc64le build and fails, plus spec-fixture native addons).
  # None of them are part of building Electron. Caches stay inside $srcdir.
  msg2 "Installing Electron's build-time npm dependencies"
  pushd electron >/dev/null
  YARN_ENABLE_GLOBAL_CACHE=false YARN_ENABLE_TELEMETRY=0 \
  YARN_CACHE_FOLDER="$srcdir/yarn-cache" YARN_GLOBAL_FOLDER="$srcdir/yarn-global" \
    node "$(sed -n 's/^yarnPath: //p' .yarnrc.yml)" install --immutable --mode=skip-build
  popd >/dev/null

  # https://github.com/nodejs/node/issues/48444
  export UV_USE_IO_URING=0

  # https://crbug.com/893950
  sed -i -e 's/\<xmlMalloc\>/malloc/' -e 's/\<xmlFree\>/free/' \
         -e '1i #include <cstdlib>' \
    third_party/blink/renderer/core/xml/*.cc \
    third_party/blink/renderer/core/xml/parser/xml_document_parser.cc \
    third_party/libxml/chromium/*.cc

  # Upstream fixes

  # Fixes from Gentoo
  patch -Np1 -i ../chromium-138-nodejs-version-check.patch

  # Allow libclang_rt.builtins from compiler-rt >= 16 to be used
  patch -Np1 -i ../compiler-rt-adjust-paths.patch

  # Increase _FORTIFY_SOURCE level to match Arch's default flags
  patch -Np1 -i ../increase-fortify-level.patch

  # clang 22 lacks -fsanitize-ignore-for-ubsan-feature; drop the
  # sanitize_c_array_bounds cflags block. Can be dropped with LLVM 23.
  patch -Np1 -i ../chromium-149-drop-unknown-clang-flag.patch

  # Causes a build failure with our clang version
  patch -Np1 -i ../chromium-147-revert-clang-no-lifetime-dse-flag.patch

  # https://crbug.com/456218403
  patch -Np1 -i ../chromium-145-fix-SYS_SECCOMP.patch

  patch -Np1 -i ../chromium-149-build-with-wasm-rollup.patch

  patch -Np1 -i ../chromium-147-rust-1.95-bytemuck.patch

  # https://crbug.com/456677057
  patch -Np1 -i ../glibc-2.42-baud-rate-fix.patch

  # Chromium bundles a patched minizip with extra features.
  patch -Np1 -i ../chromium-149-unbundle-minizip-undo-unicode.patch

  patch -Np1 -i ../chromium-149-use-of-undeclared-identifier-ERROR.patch

  # Fix issue about missing AR file
  # Credit: https://github.com/ungoogled-software/ungoogled-chromium/pull/3837
  patch -Np1 -i ../chromium-150-fix-ar-unbundle.patch

  # Fix issue about missing sysroot path
  # Credit: https://github.com/ungoogled-software/ungoogled-chromium/pull/3837#issuecomment-4836756738
  patch -Np1 -i ../chromium-150-fix-sysroot-path-error.patch

  # Fix issue about missing AVX functions
  # Credit: https://github.com/ungoogled-software/ungoogled-chromium/pull/3837
  patch -Np1 -i ../chromium-150-revert-avx-flag-change.patch

  # Electron specific fixes (Arch electron43)
  patch -Np1 -i "${srcdir}/jinja-python-3.10.patch" -d "third_party/electron_node/tools/inspector_protocol/jinja2"
  patch -Np1 -i "${srcdir}/use-system-libraries-in-node.patch"

  if [[ $CARCH == powerpc64le ]]; then
    # swiftshader's bundled LLVM PPC target subclasses the XCOFF writer and
    # asm-info base classes without compiling them; the vtables must resolve.
    patch -Np1 -i ../swiftshader-ppc-xcoff-baseclasses.patch

    # ppc64le patches (Debian chromium-team, series-ordered), r3 for 150.
    local _p
    while IFS= read -r _p; do
      [[ -z $_p || $_p == \#* ]] && continue
      [[ $_p == ppc64le/* ]] || continue

      # POWER9 build: skip the patch that pins v8's GN toolchain config to
      # -mcpu=power8 -maltivec -mvsx, so v8 keeps stock 150's -mcpu=pwr9.
      if (( ! _power8_compat )) && [[ $_p == *Force-baseline-POWER8-AltiVec-VSX* ]]; then
        msg2 "Skipping (POWER9 build): $_p"
        continue
      fi

      msg2 "Applying ppc64le patch: $_p"
      patch -Np1 -i "$srcdir/ppc64le-patches/${_p#ppc64le/}"
    done < "$srcdir/ppc64le-patches/debian-series"

    # core/baseline-isa-3-0.patch is commented out of debian-series because it
    # is POWER9-only; apply it for the POWER9 build. r3's copy is rebased to
    # 150 and has no v8 hunk (reference/chromium-150/README.md).
    if (( ! _power8_compat )); then
      msg2 "Applying ppc64le patch (POWER9 build): core/baseline-isa-3-0.patch"
      patch -Np1 -i "$srcdir/ppc64le-patches/core/baseline-isa-3-0.patch"
    fi

    # Debian/Raptor's ppc64 seccomp-bpf support writes emulated syscall results
    # back with the sc convention only. glibc uses scv on POWER9, so a denied
    # broker call reads back as success (e.g. -ENOENT as fd 2), which crashes
    # the GPU process on --disable-gpu. Standalone so it reads and upstreams
    # cleanly; see docs/chromium-software-raster-crash.md.
    msg2 "Applying ppc64le patch: ppc64le-seccomp-scv-return-abi.patch"
    patch -Np1 -i "$srcdir/ppc64le-seccomp-scv-return-abi.patch"

    # skia-vsx-instructions.patch hardcodes -mcpu=power9 -mtune=power9 into
    # all of skia; pin it back for the POWER8 build.
    if (( _power8_compat )); then
      msg2 "Pinning skia back to POWER8 (_power8_compat=1)"
      sed -i -e 's/-mcpu=power9/-mcpu=power8/g' -e 's/-mtune=power9/-mtune=power8/g' \
        third_party/skia/gn/skia/BUILD.gn third_party/skia/BUILD.gn
    fi
  fi

  # Link to system tools required by the build
  mkdir -p third_party/node/linux/node-linux-x64/bin \
           third_party/rust-toolchain/bin \
           third_party/jdk/current/bin \
           third_party/gperf/cipd/bin

  ln -sf /usr/bin/node third_party/node/linux/node-linux-x64/bin/
  ln -sf /usr/bin/rustc third_party/rust-toolchain/bin/
  ln -sf /usr/bin/java third_party/jdk/current/bin/
  # the tarball carries an x86_64 gperf here
  rm -f third_party/gperf/cipd/bin/gperf
  ln -s /usr/bin/gperf third_party/gperf/cipd/bin/

  # Allow building against system libraries in official builds
  sed -i 's/OFFICIAL_BUILD/GOOGLE_CHROME_BUILD/' \
    tools/generate_shim_headers/generate_shim_headers.py

  # Remove bundled libraries for which we will use the system copies; this
  # *should* do what the remove_bundled_libraries.py script does, with the
  # added benefit of not having to list all the remaining libraries
  local _lib
  for _lib in ${_unwanted_bundled_libs[@]}; do
    find "third_party/$_lib" -type f \
      \! -path "third_party/$_lib/chromium/*" \
      \! -path "third_party/$_lib/google/*" \
      \! -path "third_party/harfbuzz-ng/utils/hb_scoped.h" \
      \! -regex '.*\.\(gn\|gni\|isolate\)' \
      -delete
  done

  ./build/linux/unbundle/replace_gn_files.py \
    --system-libraries "${!_system_libs[@]}"

  # https://gitlab.archlinux.org/archlinux/packaging/packages/electron41/-/merge_requests/1#note_459770
  sed -i '/single_group_per_study_prefer_existing_behavior_seed/d' chrome/test/BUILD.gn
}

build() {
  cd src

  export CC=clang
  export CXX=clang++
  export AR=ar
  export NM=nm

  local _flags=(
    'custom_toolchain="//build/toolchain/linux/unbundle:default"'
    'host_toolchain="//build/toolchain/linux/unbundle:default"'
    'is_official_build=true' # implies is_cfi=true on x86_64
    'symbol_level=0' # sufficient for backtraces on x86(_64)
    'treat_warnings_as_errors=false'
    'fatal_linker_warnings=false'
    'disable_fieldtrial_testing_config=true'
    'blink_enable_generated_code_formatting=false'
    'ffmpeg_branding="Chrome"'
    'proprietary_codecs=true'
    'rtc_use_pipewire=true'
    'link_pulseaudio=true'
    'use_custom_libcxx=true' # https://github.com/llvm/llvm-project/issues/61705
    'use_sysroot=false'
    'use_system_libffi=true'
    'enable_hangout_services_extension=true'
    'enable_widevine=false'
    'use_qt5=false'
    'use_qt6=true'
    'moc_qt6_path="/usr/lib/qt6"'
    'use_clang_modules=false'
    'v8_builtins_profiling_log_file=""'
    # electron/BUILD.gn otherwise derives the version from electron/.git
    # (script/get-git-ref-paths.py), and a tag archive has none: "When
    # building from a source code tarball ... builders must explicitly pass
    # override_electron_version".
    "override_electron_version=\"$pkgver\""
  )

  if [[ -n ${_system_libs[icu]+set} ]]; then
    _flags+=('icu_use_data_file=false')
  fi

  local _clang_version=$(
    clang --version | grep -m1 version | sed 's/.* \([0-9]\+\).*/\1/')

  _flags+=(
    'clang_base_path="/usr"'
    'clang_use_chrome_plugins=false'
    "clang_version=\"$_clang_version\""
    'chrome_pgo_phase=0' # needs newer clang to read the bundled PGO profile
  )

  # Allow the use of nightly features with stable Rust compiler
  # https://github.com/ungoogled-software/ungoogled-chromium/pull/2696#issuecomment-1918173198
  export RUSTC_BOOTSTRAP=1

  _flags+=(
    'rust_sysroot_absolute="/usr"'
    'rust_bindgen_root="/usr"'
    "rustc_version=\"$(rustc --version | awk '{ print $2 ;}')\""
  )

  # Facilitate deterministic builds (taken from build/config/compiler/BUILD.gn)
  CFLAGS+='   -Wno-builtin-macro-redefined'
  CXXFLAGS+=' -Wno-builtin-macro-redefined'
  CPPFLAGS+=' -D__DATE__=  -D__TIME__=  -D__TIMESTAMP__='

  # Do not warn about unknown warning options
  CFLAGS+='   -Wno-unknown-warning-option'
  CXXFLAGS+=' -Wno-unknown-warning-option'

  # Let Chromium set its own symbol level
  CFLAGS=${CFLAGS/-g }
  CXXFLAGS=${CXXFLAGS/-g }

  # https://github.com/ungoogled-software/ungoogled-chromium-archlinux/issues/123
  CFLAGS=${CFLAGS/-fexceptions}
  CFLAGS=${CFLAGS/-fcf-protection}
  CXXFLAGS=${CXXFLAGS/-fexceptions}
  CXXFLAGS=${CXXFLAGS/-fcf-protection}

  # This appears to cause random segfaults when combined with ThinLTO
  # https://bugs.archlinux.org/task/73518
  CFLAGS=${CFLAGS/-fstack-clash-protection}
  CXXFLAGS=${CXXFLAGS/-fstack-clash-protection}

  # https://crbug.com/957519#c122
  CXXFLAGS=${CXXFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS}

  if [[ $CARCH == aarch64 ]]; then
    # On aarch64, certain files (e.g. in libvpx and libyuv) needs to be compiled
    # with additional arch features (e.g. dotprod, sve, sme)
    # Having an arch setting in the C(XX)FLAGS overrides those
    # and causes compilation failure
    CFLAGS="${CFLAGS/-march=*([^ ]) }"
    CXXFLAGS="${CXXFLAGS/-march=*([^ ]) }"
  fi

  if [[ $CARCH == powerpc64le ]]; then
    # GN's unbundle toolchain appends $CFLAGS/$CXXFLAGS after its own config
    # flags, so the last -mcpu wins. Set it explicitly per toggle value rather
    # than inheriting the build host's makepkg.conf (packages/chromium).
    CFLAGS="${CFLAGS/-mcpu=*([^ ]) }";     CFLAGS="${CFLAGS/-mtune=*([^ ]) }"
    CXXFLAGS="${CXXFLAGS/-mcpu=*([^ ]) }"; CXXFLAGS="${CXXFLAGS/-mtune=*([^ ]) }"
    if (( _power8_compat )); then
      CFLAGS+=" -mcpu=power8 -mtune=power8"
      CXXFLAGS+=" -mcpu=power8 -mtune=power8"
    else
      CFLAGS+=" -mcpu=power9 -mtune=power9"
      CXXFLAGS+=" -mcpu=power9 -mtune=power9"
    fi
    msg2 "ppc64le ISA level: _power8_compat=$_power8_compat"
  fi

  export CHROMIUM_BUILDTOOLS_PATH="${PWD}/buildtools"
  # The gn built in prepare() serves the whole build: gn gen below, and the
  # `gn args` Node's tools/generate_config_gypi.py runs from PATH mid-build.
  export PATH="$srcdir/gn/out:$PATH"
  "$srcdir/gn/out/gn" gen out/Release \
      --args="import(\"//electron/build/args/release.gn\") ${_flags[*]}"
  # NINJAFLAGS carries the -j bq was given; ninja otherwise takes every CPU.
  ninja ${NINJAFLAGS:-} -C out/Release electron electron_dist_zip
}

package() {
  install -dm755 "${pkgdir:?}/usr/lib/${pkgname}"
  bsdtar -xf src/out/Release/dist.zip -C "${pkgdir}/usr/lib/${pkgname}"

  chmod u+s "${pkgdir}/usr/lib/${pkgname}/chrome-sandbox"

  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -sr -t "${pkgdir}"/usr/share/licenses/${pkgname} \
    "${pkgdir}"/usr/lib/${pkgname}/{LICENSE,LICENSES.chromium.html}

  install -Dm755 "${srcdir}/electron-launcher.sh" \
    "${pkgdir}/usr/bin/${pkgname}"

  # Install icon file
  install -Dm644 src/electron/default_app/icon.png \
          "${pkgdir}/usr/share/pixmaps/${pkgname}.png"  # hicolor has no 1024x1024
}
