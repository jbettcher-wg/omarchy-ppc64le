# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Obsidian on powerpc64le. Arch's recipe repacks the x86_64 release tarball's
# resources/ onto the system electron43, and this one does the same. The
# difference is that the tarball's resources/app.asar.unpacked holds two x86-64
# native modules, and this recipe replaces both with ppc64le builds from
# btime.c and get-fonts.c. README.md covers what those modules are, how their
# interface was worked out without source, and what was verified. Nothing
# else from the tarball is compiled code: its Electron runtime, obsidian-cli
# and the .so files outside resources/ are never installed. package() refuses
# any ELF in $pkgdir that isn't powerpc64le.
#
# Distributed as part of Omarchy for POWER, which bundles Obsidian.
#
# Recipe otherwise unchanged from Arch's obsidian 1.13.7-2
# (gitlab.archlinux.org/archlinux/packaging/packages/obsidian); credits below.
#
# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Gennadiy Mykhailiuta <gmykhailiuta@gmail.com>
# Contributor: Xuanwo <xuanwo@archlinuxcn.org>

pkgname=obsidian
pkgver=1.13.7
pkgrel=1
_electron_ver=43.7.0   # electron43's version; its node headers build the modules
pkgdesc="A powerful knowledge base that works on top of a local folder of plain text Markdown files"
arch=('powerpc64le')
url="https://obsidian.md"
license=('LicenseRef-Obsidian')
depends=('fontconfig' 'bash' 'zlib' 'hicolor-icon-theme' 'electron43' 'glibc')
makedepends=('file' 'node-gyp' 'nodejs' 'python')
install=obsidian.install
options=(!strip)
source=("obsidian.sh"
        "obsidian.desktop"
        "LICENSE-Obsidian"
        # resources/ only: JS, asar archives, icon (x86_64 is the linux build
        # whose unpacked modules match the Linux code paths)
        "https://github.com/obsidianmd/obsidian-releases/releases/download/v${pkgver}/obsidian-${pkgver}.tar.gz"
        # Electron's node headers, as node-gyp --target=${_electron_ver} would fetch
        "electron-v${_electron_ver}-headers.tar.gz::https://artifacts.electronjs.org/headers/dist/v${_electron_ver}/node-v${_electron_ver}-headers.tar.gz"
        "btime.c"
        "btime.gyp"
        "get-fonts.c"
        "get-fonts.gyp")
sha256sums=('0df6f2b28187a84917eaf33e089abe980a407fd4b195d69eab1f2a70ad2234ca'
            '99c075af3f34cb358d6e93565686792c45562b17f8002fce0e8a63b83cbbe786'
            'd9fdc14f9c2fb95bb38310281268fdad413c1b49fa93213df3184f9b0ca1175c'
            'd3cbe375cbfa4024db1910b98191649f4134c5c48aee5e60b6e7713987dcdb28'
            'b82c12cc4cc09794e3c0ddc7609f2738f3e927207809d4198296b9e8618043bf'
            'f7d0a9599465b6c5a45c1d38af95de71c8666cc0938b7b75d0d9b1e6f5297f64'
            '01743e8241cc6a81a131b18a584a6c8d9d3c3392b58aa62d44d2113916ab835f'
            '16a4d09457a4e2855ee97c424aade215f7bfbdcaa3c1bdb506f0282125be7782'
            '64f146875ff0fffc5fb6102137d6b026434f0e9de9045fd8a08f8d421b3ee1e1')

build() {
  # node-gyp against the extracted headers: no download, nothing under $HOME.
  export npm_config_devdir="$srcdir/node-gyp-devdir"
  local _m
  for _m in btime get-fonts; do
    rm -rf "native-$_m"
    mkdir "native-$_m"
    cp "$_m.c" "native-$_m/"
    cp "$_m.gyp" "native-$_m/binding.gyp"
    (cd "native-$_m" && node-gyp rebuild --release --nodedir="$srcdir/node_headers")
  done
}

package() {
    cd "$srcdir"

    # Install executable file
    install -Dm755 "$pkgname".sh "$pkgdir"/usr/bin/obsidian

    # Install desktop file
    install -Dm644 "$pkgname".desktop -t "$pkgdir"/usr/share/applications/

    # Most of the release package is electron, but we use system's default one
    # So strip away asar packages and put them to /usr/lib/
    cd "${pkgname}-${pkgver}"/resources/
    install -dm0755 "$pkgdir"/usr/lib/obsidian
    # install icon
    install -Dm644 icon.png "$pkgdir"/usr/share/icons/hicolor/512x512/apps/obsidian.png
    find . -type d -exec install -d {,"$pkgdir"/usr/lib/obsidian/}{} \;
    # ... except the x86-64 native modules, replaced by the ones built above
    find . -type f ! -name '*.node' -exec install -D {,"$pkgdir"/usr/lib/obsidian/}{} \;
    local _m
    for _m in btime get-fonts; do
      install -Dm755 "$srcdir/native-$_m/build/Release/binding.node" \
        "$pkgdir/usr/lib/obsidian/app.asar.unpacked/node_modules/$_m/binding.node"
    done

    # Ship no foreign code.
    local _foreign
    _foreign=$(find "$pkgdir" -type f -exec file -N {} + | grep ': ELF' | grep -v 'PowerPC' || true)
    if [[ -n $_foreign ]]; then
      error "non-powerpc64le ELF in the package:"
      printf '%s\n' "$_foreign"
      return 1
    fi

    install -Dm644 "$srcdir"/LICENSE-Obsidian "$pkgdir"/usr/share/licenses/$pkgname/LICENSE-Obsidian
}
