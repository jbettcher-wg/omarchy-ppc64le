# ppc64le: two changes.
#
#   1. powerpc64le added to arch().
#   2. prepare() bumps three crates in Cargo.lock so that `ring` moves off
#      0.16.20.  This is the only package in this batch that needed real work,
#      and the reason is worth stating precisely because it will recur.
#
# ring 0.16.20's build.rs maps the target triple to a per-architecture asset
# list through a fixed table, and that table has no powerpc64le row.  The
# lookup is an unconditional `.unwrap()`:
#
#   thread 'main' panicked at ring-0.16.20/build.rs:358:10:
#   called `Option::unwrap()` on a `None` value
#
# so the build dies in the build script, before a single line of ring is
# compiled.  ring 0.17 replaced that table with a portable fallback path and
# builds on POWER9 unmodified -- 0.17.14 compiles clean here.  So there is
# nothing to patch: the fix is entirely a dependency-version question.
#
# tzupdate 3.1.0 does not depend on ring at all directly.  It arrives four
# levels down:
#
#   tzupdate -> ureq 2.7.1 -> rustls 0.21.2 -> sct 0.7.0 -> ring 0.16.20
#
# and `cargo update -p ring` alone cannot fix it: rustls 0.21.2 requires
# ring ^0.16.20, and even after bumping rustls, sct 0.7.0 still pins ring 0.16
# and the old and new ring end up in the tree together (which fails exactly the
# same way, because the 0.16 build script still runs).  Updating ureq, rustls
# and sct together is the minimal set that leaves ring 0.17.14 as the only
# copy; the assertion in prepare() enforces that rather than trusting it.
#
# Kept as a lockfile bump rather than switching ureq to the native-tls/OpenSSL
# backend, which would also have avoided ring: that changes the TLS stack the
# binary actually uses relative to what Omarchy ships, and this way the crate
# graph stays the one upstream chose.
#
# 3.1.0 is upstream's newest tag (checked against github.com/cdown/tzupdate),
# so there is no newer release that would carry the bump already, and it is the
# version Omarchy publishes (tzupdate-3.1.0-1).
#
# Maintainer: Chris Down <chris@chrisdown.name>

pkgname=tzupdate
pkgver=3.1.0
pkgrel=1
pkgdesc='Set the system timezone based on IP geolocation'
url=https://github.com/cdown/tzupdate
arch=('x86_64' 'powerpc64le')
options=(!lto)
license=('MIT')
makedepends=('cargo')
source=("$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('aebf678afd261852bd3ebf4689a9a7382c3e4e43a92864b77cbee2d26ec62e22')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"

    # See the header.  Semver-compatible bumps only -- no Cargo.toml
    # requirement is relaxed, so this is a lockfile refresh, not a dependency
    # change.
    cargo update -p ureq -p rustls -p sct

    # Enforce the outcome instead of assuming it: if a future crates.io state
    # leaves any ring 0.16.x in the graph, the build must fail here with a
    # clear message rather than 200 lines deep in a build script.
    if grep -A1 '^name = "ring"$' Cargo.lock | grep -q '^version = "0\.16\.'; then
        printf '%s: ring 0.16.x still in Cargo.lock; its build.rs has no powerpc64le case\n' \
            "$pkgname" >&2
        cargo tree -i ring@0.16.20 >&2 || true
        return 1
    fi
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo install --no-track --locked --root "$pkgdir/usr" --path .
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"

    # Fail the build if any shipped ELF records a build-tree path
    # (tools/elf-pathguard.sh -- house policy, applied to every recipe here).
    "${ELF_PATHGUARD:-$startdir/../../tools/elf-pathguard.sh}" "$pkgdir"
}
