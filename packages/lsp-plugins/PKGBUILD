package_lsp-plugins-standalone() {
  pkgdesc+=" - JACK standalone"
  groups=(pro-audio)
  depends=(
    cairo
    fontconfig
    freetype2
    glibc
    hicolor-icon-theme
    libglvnd libGL.so
    libsndfile libsndfile.so
    libstdc++
    libx11
    libxrandr
  )
  optdepends=(
    'liblsp-audio-pipewire-lib: for PipeWire support'
    'liblsp-audio-jack-lib: for JACK support'
  )

  mv -v $pkgname/* "$pkgdir"
}

