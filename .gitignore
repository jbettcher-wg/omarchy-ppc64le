# Built artifacts — the recipes are the asset, not the output.
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.log

# makepkg working directories
packages/**/src/
packages/**/pkg/
packages/**/*.tar.gz
packages/**/*.tar.xz
packages/**/*.tar.zst

# Local repo database (regenerate with repo-add)
repo/*.db*
repo/*.files*

# POWER8 secondary-target artifacts. Holding folder, not a published repo --
# same reasoning as repo/: reproducible from the recipes, which are tracked.
repo-power8/*.db*
repo-power8/*.files*

# Upstream Omarchy is tracked as its own clone, not vendored.
upstream/

# bq run state -- ephemeral, references /tmp paths and timings.
.bq-state.json

# Installer QEMU rig: disk images, extracted ISO/firmware pieces and serial
# logs. Multi-GB and reproducible from run-guest.sh + the ISO, like repo/.
installer/test/images/
installer/test/logs/
installer/test/run/
installer/test/work/

# bq state backups and Python bytecode.
.bq-state.json.*
__pycache__/

# bq's repo-add lock, held while it writes a package db. Created next to the db
# it guards (repo/, or a BQ_REPO side pool); ephemeral, never a recipe.
.bq-repo-add.lock

# makepkg VCS mirrors, cloned next to the recipe when SRCDEST is unset.
packages/luajit/luajit-ppc64le/
packages/neovim/neovim/
packages/qwen-code/qwen-code/
packages/ours/omarchy-theme-power9/power9.bak.*

# Built ISO images (multi-GB). Reproducible from iso/build.sh + the repo.
iso/out/
