# Built artifacts — the recipes are the asset, not the output.
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.log

# Build scripts moved to their own repository (omarchy-ppc64le-packaging), so
# there is no recipe tree here any more. These rules stay only to keep the
# leftover makepkg working trees in packages/ from showing up as untracked
# until that directory is cleared; the packaging repo carries its own
# .gitignore for the same residue.
packages/

# Local repo database (regenerate with repo-add)
repo/*.db*
repo/*.files*

# Baseline pool artifacts (repo-ppc64le/: POWER8-legal, runs on every ppc64le
# machine) -- same reasoning as repo/: reproducible from the recipes, which are
# tracked.
repo-ppc64le/*.db*
repo-ppc64le/*.files*

# Upstream Omarchy is tracked as its own clone, not vendored.
upstream/

# bq run state -- ephemeral, references /tmp paths and timings.
.bq-state.json

# Installer QEMU rig: disk images, extracted ISO/firmware pieces and serial
# logs. Multi-GB and reproducible from run-guest.sh + the ISO, like repo/.
installer/test/images/
installer/test/logs/
installer/test/run/
installer/test/work/

# bq state backups and Python bytecode.
.bq-state.json.*
__pycache__/

# bq's repo-add lock, held while it writes a package db. Created next to the db
# it guards (repo/, or a BQ_REPO side pool); ephemeral, never a recipe.
.bq-repo-add.lock

# Built ISO images (multi-GB). Reproducible from iso/build.sh + the repo.
iso/out/

# Local agent notes: machine-specific operational detail (paths, current build
# state, what is broken today). The tracked docs/ carry the design; this file
# is deliberately untracked so it can be edited freely as the machine changes.
CLAUDE.local.md
