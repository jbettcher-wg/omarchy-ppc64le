-ANGLE_INSTANTIATE_TEST_ES2_AND_ES3(VulkanImageTest);
+ANGLE_INSTANTIATE_TEST_ES2_AND_ES3_AND(VulkanImageTest,
+                                       ES3_VULKAN().enable(Feature::ForceFallbackFormat));
 ANGLE_INSTANTIATE_TEST_ES2_AND_ES3_AND(
