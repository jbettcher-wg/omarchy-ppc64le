# Maintainer: Jordan Bettcher <thebettcher@gmail.com>
#
# Reference recipe, not a bq package (README.md). Chromium 150 for powerpc64le
# at 150.0.7871.250, the release Electron 43.7.0 pins; electron43 in the
# packaging tree is built on this.
#
# Sources. Google published no release tarball for 150.0.7871.250; the newest
# 150 tarball is .222. So source[0] is Google's 150.0.7871.222 -lite tarball,
# and chromium-150.0.7871.222-250.patch is the verbatim upstream difference
# between the two tags for chromium/src, v8, angle, dawn and skia, filtered to
# the files the -lite tarball ships (mkdelta.py generated it). prepare()
# rewrites the revision stamps generated into the .222 tarball to .250.
#
# Changes from 150.0.7871.128-1 (the previous commit has it verbatim), each one
# something the packaging tree's chromium learned on 151:
#   - the _power8_compat toggle, with the same values and semantics
#   - build() sets -mcpu/-mtune per toggle value; it no longer strips them
#   - chromium-launcher's Makefile version is pinned to pkgver-pkgrel
#   - ppc64le patches r3: r1 with core/baseline-isa-3-0.patch rebased to 150
#     (README.md has the r1/r2 comparison)
#
# Maintainer: Christian Heusel <gromit@archlinux.org>
# Maintainer: Jonathan Grotelüschen <tippfehlr@archlinux.org>
# Contributor: Evangelos Foutras <foutrelis@archlinux.org>
# Contributor: Pierre Schmitz <pierre@archlinux.de>
# Contributor: Jan "heftig" Steffens <jan.steffens@gmail.com>
# Contributor: Daniel J Griffiths <ghost1227@archlinux.us>

pkgname=chromium
pkgver=150.0.7871.250
pkgrel=1
_launcher_ver=8
_manual_clone=0
_system_clang=1

# Google's release tarball this recipe starts from, and what the .250 revision
# stamps are (github.com/chromium/chromium tag 150.0.7871.250, and its DEPS).
_tarball_ver=150.0.7871.222
_chromium_commit=f916f1b7136907af19d96b95b891533d091d932a
_chromium_commit_position=4305
_chromium_commit_time=1786991556
_skia_revision=9c7b2dffb2433f5a0cc2b77f06025a09126807ed
_dawn_revision=b8cea1289d76a80e877e0d751ef3a35088256e89

# ppc64le ISA level.
#   0 = POWER9 (ISA 3.0). THE DEFAULT IN THIS TREE. Drops the POWER8 forcing
#       patch so third-party code takes its POWER9 paths, and lets
#       -mcpu=power9 stand.
#   1 = POWER8-legal (ISA 2.07). The floor Arch POWER's multi-architecture
#       repo needs; pass this explicitly when building for upstream.
#
# Source stays POWER8-compliant either way: no POWER9-only instruction is
# written into any source file. The difference is compiler flags and which
# build-system feature gates get set -- the LuaJIT model, POWER8 ISA floor
# with ISA 3.0 paths selected at build/runtime rather than hardcoded.
#
# Override per build:  _power8_compat=1 makepkg -e   (POWER8-legal artifact)
_power8_compat=${_power8_compat:-0}
pkgdesc="A web browser built for speed, simplicity, and security"
