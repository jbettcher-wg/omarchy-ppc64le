   # Credit: https://github.com/ungoogled-software/ungoogled-chromium/pull/3837
   patch -Np1 -i ../chromium-150-revert-avx-flag-change.patch
 
+  # Arch's gn 0.2324 doesn't recognize the newer top-level `expand_directory_allowlist`
+  # dotfile directive, so the assignment in .gn is flagged as a dead store. Drop it.
+  sed -i '/^expand_directory_allowlist = build_dotfile_settings\.expand_directory_allowlist$/d' .gn
+
+  # Same gn-version gap: `inputs =` is not recognized as a valid attribute for
+  # rust_* tool() blocks in this gn, so it errors as a dead store. Loses input
+  # tracking for the rustc wrapper (fine for one-shot builds).
+  sed -i '/inputs = rustc_wrapper_inputs$/d' build/toolchain/gcc_toolchain.gni
+
+  # Same gn-version gap: `expand_directory()` is a newer builtin used by the
+  # C++ modules build. We set `use_clang_modules=false`, but gn still evaluates
+  # the linux branch of build/modules/BUILD.gn during gen. Neutralize with [].
+  sed -i 's|system_headers += expand_directory("${sysroot}/${root_include_dir}", true)|system_headers += []|' \
+    build/modules/BUILD.gn
+
+  # swiftshader bundles a stripped LLVM 10.0. Its PPC target compiles
+  # PPCXCOFFObjectWriter.cpp and PPCMCAsmInfo.cpp, which subclass
+  # MC{XCOFFObjectTargetWriter,AsmInfoXCOFF} — but the base-class .cpp files
+  # are not in the source set, producing undefined symbols at link time.
+  # Linux ppc64le uses ELF, but the vtables still need to resolve.
+  if [[ $CARCH == powerpc64le ]]; then
+    patch -Np1 -i ../swiftshader-ppc-xcoff-baseclasses.patch
+  fi
+
+  # ppc64le patches (Raptor Engineering / Debian chromium-team, series-ordered).
+  # Applied on a Chromium version four security releases newer than Debian's
+  # baseline; expect the vast majority to apply cleanly since they touch
+  # arch-specific files upstream rarely modifies in point releases.
+  if [[ $CARCH == powerpc64le ]]; then
+    local _p
+    while IFS= read -r _p; do
+      [[ -z $_p || $_p == \#* ]] && continue
+      [[ $_p == ppc64le/* ]] || continue
+      msg2 "Applying ppc64le patch: $_p"
+      patch -Np1 -i "$srcdir/ppc64le-patches/${_p#ppc64le/}"
+    done < "$srcdir/ppc64le-patches/debian-series"
+  fi
+
   # Link to system tools required by the build
   mkdir -p third_party/node/linux/node-linux-x64/bin \
            third_party/rust-toolchain/bin \
@@ -391,8 +434,34 @@ build() {
     CXXFLAGS="${CXXFLAGS/-march=*([^ ]) }"
