-  gn gen out/Release --args="${_flags[*]}"
-  ninja -C out/Release chrome chrome_sandbox chromedriver.unstripped
+  if [[ $CARCH == powerpc64le ]]; then
+    # Same rationale as aarch64/riscv64: the ppc64le patch set (esp. libvpx,
+    # skia, pffft) uses per-TU -mcpu selection; a global -mcpu/-mtune overrides
+    # those and breaks the build. Baseline is forced to POWER8 by
+    # 0001-Force-baseline-POWER8-AltiVec-VSX-CPU-features-when-.patch.
+    CFLAGS="${CFLAGS//-mcpu=*([^ ]) }"
+    CFLAGS="${CFLAGS//-mtune=*([^ ]) }"
+    CXXFLAGS="${CXXFLAGS//-mcpu=*([^ ]) }"
+    CXXFLAGS="${CXXFLAGS//-mtune=*([^ ]) }"
+  fi
+
+  # Arch's packaged gn (0.2324) is behind what Chromium 150 needs:
+  #   - top-level `expand_directory_allowlist` dotfile directive
+  #   - `expand_directory()` builtin (used by C++ modules build)
+  #   - `inputs` attribute on rust_* tool() blocks
+  #   - `c_additional_outputs` attribute on config() blocks
+  # Prefer a locally-built gn if one is provided next to the package dir.
+  local _gn=gn
+  if [[ -x "$startdir/../gn-newer/gn" ]]; then
+    _gn="$startdir/../gn-newer/gn"
+    msg2 "Using newer gn: $($_gn --version)"
+  fi
+
+  "$_gn" gen out/Release --args="${_flags[*]}"
+  # Cap parallelism to keep chromium's thinLTO link steps from OOMing.
+  # Each thinLTO link uses --thinlto-jobs=all internally, so total thread
+  # count balloons when multiple links run in parallel.
+  ninja -j "${_ninja_jobs:-64}" -C out/Release chrome chrome_sandbox chromedriver.unstripped
